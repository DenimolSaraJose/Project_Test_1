        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Review_Submitted_Other</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4) AND (5 AND 6)</conditionLogic>
            <conditions>

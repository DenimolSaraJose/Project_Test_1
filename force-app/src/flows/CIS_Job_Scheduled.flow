<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>The Job Application Deadline has been reached and the Job Community Status equals &apos;Published&apos;</description>
        <name>IsJobApplicationDeadlineReached</name>
        <label>Job Application Deadline Reached</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsJobApplicationDeadlineReachedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Deadline__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>extendJobApplicationDeadline</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>TalentRover Phase Out</description>
    <environments>Default</environments>
    <formulas>
        <name>ApplicationDeadlineExtendedDate</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Application_Deadline__c} + 14</expression>
    </formulas>
    <interviewLabel>CIS Job Scheduled {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CIS Job Scheduled</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Extend the Job Application Deadline</description>
        <name>extendJobApplicationDeadline</name>
        <label>Extend Application Deadline</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Application_Deadline__c</field>
            <value>
                <elementReference>ApplicationDeadlineExtendedDate</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsJobApplicationDeadlineReached</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Community_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Published</stringValue>
            </value>
        </filters>
        <object>CIS_Job__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-01-12</startDate>
            <startTime>02:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>

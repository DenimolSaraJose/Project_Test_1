<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Where Valid to Date = TODAY’S DATE, change External Accreditation Report Status to Expired.</description>
        <name>External_Accreditation_Report_Status_is_Expired</name>
        <label>External Accreditation Report Status is Expired?</label>
        <locationX>182</locationX>
        <locationY>276</locationY>
        <defaultConnector>
            <targetReference>Mark_Membership_for_Renewal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>yes</name>
            <conditionLogic>1 AND 2 AND 3 AND 4 AND (5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Valid_to_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Valid_to_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.External_Accreditation_Report_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Expired</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Name__r.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>School</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Applicant</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_External_Accreditation_Report_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Eligible for renewal = true and application status does not equal renewal. 
Set Application status and add count.</description>
        <name>Mark_Membership_for_Renewal</name>
        <label>Mark Membership for Renewal</label>
        <locationX>182</locationX>
        <locationY>612</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RenewalWithinThreeMonths</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.isEligibleForRenewal__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Application_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Renewal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Application_Status_to_Renewal_and_add_renewal_Count</targetReference>
            </connector>
            <label>RenewalWithinThreeMonths</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>MembershipRenewalCountPlusOne</name>
        <dataType>Number</dataType>
        <expression>IF(ISNULL({!$Record.Membership_Renewal_Count__c}),1,{!$Record.Membership_Renewal_Count__c} + 1)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>OneYearAfter</name>
        <dataType>Date</dataType>
        <expression>DATE( YEAR( {!$Record.Status_to_Active__c} ) + 1, MONTH( {!$Record.Status_to_Active__c} ), DAY( {!$Record.Status_to_Active__c} ) )</expression>
    </formulas>
    <formulas>
        <name>OneYearAfterInclLeapYear</name>
        <dataType>Date</dataType>
        <expression>IF(
AND(
MONTH({!$Flow.CurrentDate}) = 2,
DAY({!$Flow.CurrentDate}) = 29
),
DATE(
YEAR({!$Flow.CurrentDate})+1,
3,
1),
DATE(
YEAR({!$Flow.CurrentDate})+1,
MONTH({!$Flow.CurrentDate}),
DAY({!$Flow.CurrentDate})
)
)</expression>
    </formulas>
    <interviewLabel>Membership_Scheduled_Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Membership_Scheduled_Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Set Application Status to &apos;Renewal&apos; and add renewal Count</description>
        <name>Set_Application_Status_to_Renewal_and_add_renewal_Count</name>
        <label>Set Application Status to &apos;Renewal&apos; and add renewal Count</label>
        <locationX>50</locationX>
        <locationY>732</locationY>
        <inputAssignments>
            <field>Application_Status__c</field>
            <value>
                <stringValue>Renewal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Renewal_Count__c</field>
            <value>
                <elementReference>MembershipRenewalCountPlusOne</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <description>Where Valid to Date = TODAY’S DATE, change External Accreditation Report Status to Expired.</description>
        <name>Update_External_Accreditation_Report_Status</name>
        <label>Update External Accreditation Report Status</label>
        <locationX>50</locationX>
        <locationY>396</locationY>
        <connector>
            <targetReference>Mark_Membership_for_Renewal</targetReference>
        </connector>
        <inputAssignments>
            <field>External_Accreditation_Report_Status__c</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>External_Accreditation_Report_Status_is_Expired</targetReference>
        </connector>
        <object>Membership__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2023-03-15</startDate>
            <startTime>03:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>

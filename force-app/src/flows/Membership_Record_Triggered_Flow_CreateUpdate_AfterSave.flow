            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>OrderApi__Badge__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordDeletes>
        <name>Delete_Badge</name>
        <label>Delete Badge</label>
        <locationX>1590</locationX>
        <locationY>1835</locationY>

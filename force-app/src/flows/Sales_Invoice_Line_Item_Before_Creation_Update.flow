<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>It sets the Tax Code according with the product Output VAT/GST Code field (NL-O-EXM).</description>
        <name>SetTaxCodefield</name>
        <label>Set &quot;Tax Code&quot; field</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.c2g__TaxCode1__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.c2g__Product__r.c2g__CODATaxCode__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>WhichAccountTaxStatus</name>
        <label>Which Account Tax Status?</label>
        <locationX>380</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>ECRegisteredTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.c2g__Invoice__r.c2g__Account__r.c2g__CODAVATStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>EC Registered</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>WhichProductOutputVATGSTCode</targetReference>
            </connector>
            <label>EC Registered</label>
        </rules>
    </decisions>
    <decisions>
        <name>WhichProductOutputVATGSTCode</name>
        <label>Which Product Output VAT/GST Code?</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>N/A</defaultConnectorLabel>
        <rules>
            <name>NL_O_EXM_TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.c2g__Product__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.c2g__Product__r.c2g__CODATaxCode__r.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NL-O-EXM</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetTaxCodefield</targetReference>
            </connector>
            <label>NL-O-EXM</label>
        </rules>
    </decisions>
    <description>Originally migrated from PB Sales Invoice Line Item, this flow is responsible for setting the Tax Code based on the Account Tax Status and the product&apos;s output VAT/GST Code</description>
    <environments>Default</environments>
    <interviewLabel>Sales Invoice Line Item Before Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sales Invoice Line Item Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>WhichAccountTaxStatus</targetReference>
        </connector>
        <object>c2g__codaInvoiceLineItem__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

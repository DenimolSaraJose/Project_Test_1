        <fields>
            <name>Additional_Languages_leading_text</name>
            <fieldText>&lt;h4&gt;English requirement&amp;nbsp;&lt;/h4&gt;&lt;p&gt;All CIS evaluators must be confident using English during an evaluation visit. All reports and official notes will be written in English. You have already provided sufficient information about your English Language skills.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;h4&gt;Why we ask about other languages&lt;/h4&gt;&lt;p&gt;We collect information about additional languages to understand whether you can confidently use them in real professional situations during a school visit. This might include having conversations, participating in meetings, or reading documents in that language.&amp;nbsp;You do not need to write reports in any language other than English.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>

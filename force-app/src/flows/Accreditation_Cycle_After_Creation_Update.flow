    <decisions>
        <name>IsAccreditationTrackChanged</name>
        <label>Accreditation Track Changed</label>
        <locationX>182</locationX>
        <locationY>1331</locationY>
        <defaultConnector>
            <targetReference>StatusChangedToCancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationTrackChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccreditationTrack__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>

    <decisions>
        <description>If the line item contains brackets, it includes the Event Name. Therefore, it should update the Sales Order. If not, it should end the flow.</description>
        <name>Item_Name_Contains_Brackets</name>
        <label>Item Name Contains Brackets</label>
        <locationX>1766</locationX>
        <locationY>1187</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Item_Name_Contains_Brackets</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>(</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>)</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Sales_Order_with_Event_Name_Currency</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>

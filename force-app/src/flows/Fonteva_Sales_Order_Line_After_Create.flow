    <decisions>
        <description>The Sales Order Line is a Tax Line</description>
        <name>Sales_Order_Line_Tax</name>
        <label>Sales Order Line = Tax</label>
        <locationX>842</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Get_Event</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_SOR_is_a_Tax_Line</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item_Class__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Tax</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item__r.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Tax</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Event_from_Tax_Line</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Taxable_NL_Ticket</name>
        <label>Taxable NL Ticket?</label>
        <locationX>974</locationX>
        <locationY>863</locationY>
        <defaultConnector>
            <targetReference>Assign_NL_SOL_Values_Tax_Free</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tax Free</defaultConnectorLabel>
        <rules>
            <name>Yes_Taxable_NL_Ticket</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item__r.OrderApi__Is_Taxable__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OrderApi__Item__r.OrderApi__Tax_Class__r.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_NL_SOL_Values</targetReference>
            </connector>
            <label>Yes</label>

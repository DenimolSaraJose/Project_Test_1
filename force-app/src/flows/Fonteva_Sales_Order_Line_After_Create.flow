    <decisions>
        <description>This checks if the Netherlands Tax Rate was ticked on the Event.</description>
        <name>NL_Tax_Rate_Ticked_SOL</name>
        <label>NL Tax Rate Ticked?</label>
        <locationX>1502</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>Taxable_Ticket</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FinancialForce Tax Rate</defaultConnectorLabel>
        <rules>
            <name>Yes_NL_Tax_Rate_Ticked_SOL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Event.NL_Tax_Rate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Taxable_NL_Ticket</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>This checks if the Netherlands Tax Rate was ticked on the Event.</description>
        <name>NL_Tax_Rate_Ticked_Tax_Line</name>

    <description>This updates the Sales Order Lines with the tax rate from FinancialForce</description>
    <environments>Default</environments>
    <formulas>
        <description>Retrieves the Event Name from the Item Name on the Sales Order Line for inserting on the Sales Order</description>
        <name>formula_EventName</name>
        <dataType>String</dataType>
        <expression>MID({!$Record.OrderApi__Item_Name__c}, 
    FIND(&quot;(&quot;, {!$Record.OrderApi__Item_Name__c}) + 1, 
    FIND(&quot;)&quot;, {!$Record.OrderApi__Item_Name__c}) - FIND(&quot;(&quot;, {!$Record.OrderApi__Item_Name__c}) - 1)</expression>
    </formulas>
    <formulas>
        <description>The financial amount of NL tax</description>
        <name>formula_NLTaxAmount</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__List_Price__c} * ({!Get_NL_Tax_Rate.Tax_Rate__c} / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the tax amount based on the parent Sales Order Line&apos;s amount and the NL tax rate.</description>
        <name>formula_NLTaxAmountFromParentSOL</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__Sales_Order_Line__r.OrderApi__Sale_Price__c} * ({!Get_NL_Tax_Rate.Tax_Rate__c} / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the NL tax on the Sales Order Line</description>
        <name>formula_NLTotalAmountIncludingTax</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__List_Price__c} * (1 + ({!Get_NL_Tax_Rate.Tax_Rate__c} / 100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>The financial amount of tax</description>
        <name>formula_TaxAmount</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__List_Price__c} * (({!Get_Accounting_Tax_Rate.c2g__Rate__c} / 100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the tax amount based on the parent Sales Order Line&apos;s amount and the tax rate.</description>
        <name>formula_TaxAmountFromParentSOL</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__Sales_Order_Line__r.OrderApi__Sale_Price__c} * ({!Get_Accounting_Tax_Rate.c2g__Rate__c} / 100)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <description>Calculates the tax on the Sales Order Line</description>
        <name>formula_TotalAmountIncludingTax</name>
        <dataType>Number</dataType>
        <expression>{!$Record.OrderApi__List_Price__c} * (1 + ({!Get_Accounting_Tax_Rate.c2g__Rate__c} / 100))</expression>
        <scale>2</scale>
    </formulas>

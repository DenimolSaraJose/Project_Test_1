<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Updates &apos;AYF updated hidden&apos; -field to TRUE.</description>
        <name>SetAYFUpdated</name>
        <label>Set AYF Updated</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.AYF_updated_hidden__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Set AYF record name</description>
        <name>SetRecordName</name>
        <label>Set Record Name</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>forAnnualFiguresRecordName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>IsNewRecord</name>
        <label>New Record?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>SetAYFUpdated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNewRecordTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetRecordName</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>Flow responsible to set record name and update the field &quot;AYF updated hidden&quot; when inserted.</description>
    <environments>Default</environments>
    <formulas>
        <name>forAnnualFiguresRecordName</name>
        <dataType>String</dataType>
        <expression>IF(
LEN(TEXT($Record.Year__c)) + LEN($Record.Account__r.Name) &gt;= 80,
LEFT(TEXT($Record.Year__c), 11) &amp; &apos; &apos; &amp; LEFT($Record.Account__r.Name, 66 - LEN(TEXT($Record.Year__c))) &amp; &apos;...&apos;,
TEXT($Record.Year__c) &amp; &apos; &apos; &amp; ($Record.Account__r.Name)
)</expression>
    </formulas>
    <interviewLabel>Annual Figures Before Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Annual Figures Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsNewRecord</targetReference>
        </connector>
        <object>Annual_Figures__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

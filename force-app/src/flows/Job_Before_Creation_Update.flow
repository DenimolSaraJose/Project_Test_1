<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Record_Assignments_1</name>
        <label>Record Assignments</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Start_Date_del__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varJobStartDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.End_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varJobEndDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AccreditationTrack__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varJobAccreditationTrack</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TR1__Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varJobAccount</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsApplicationDeadlineChanged</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Record_Assignments_2</name>
        <label>Record Assignments</label>
        <locationX>314</locationX>
        <locationY>719</locationY>
        <assignmentItems>
            <assignToReference>$Record.TR1__Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getUser.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsApplicationDeadlineChanged</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Record_Assignments_5</name>
        <label>Record Assignments</label>
        <locationX>369</locationX>
        <locationY>1187</locationY>
        <assignmentItems>
            <assignToReference>$Record.Application_deadline_changed__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>IsAccreditationJob</name>
        <label>Is Accreditation Job?</label>
        <locationX>248</locationX>
        <locationY>395</locationY>
        <defaultConnector>
            <targetReference>getUser</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationJobTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accreditation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignments_1</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsApplicationDeadlineChanged</name>
        <label>Application Deadline Changed?</label>
        <locationX>501</locationX>
        <locationY>1079</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsApplicationDeadlineChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Deadline__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignments_5</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNew</name>
        <label>Is New?</label>
        <locationX>501</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>IsApplicationDeadlineChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNewTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsAccreditationJob</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUserAccountLookupSet</name>
        <label>User Account Lookup Set?</label>
        <locationX>446</locationX>
        <locationY>611</locationY>
        <defaultConnector>
            <targetReference>IsApplicationDeadlineChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsUserAccountLookupSetTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getUser.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignments_2</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>varJobAccount</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.TR1__Account__c}, {!$Record.AccreditationCycleStage__r.Accreditation__r.Account__c})</expression>
    </formulas>
    <formulas>
        <name>varJobAccreditationTrack</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.AccreditationTrack__c}, {!$Record.AccreditationCycleStage__r.AccreditationCycle__r.AccreditationTrack__c})</expression>
    </formulas>
    <formulas>
        <description>In case the Job End Date is blank it is set to the Accreditation Cycle Stage Completed Date.</description>
        <name>varJobEndDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.End_Date__c}, {!$Record.AccreditationCycleStage__r.CompletedDate__c})</expression>
    </formulas>
    <formulas>
        <description>In case the Job End Date is blank it is set to the Accreditation Cycle Stage Start Date.</description>
        <name>varJobStartDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!$Record.Start_Date_del__c}, {!$Record.AccreditationCycleStage__r.StartDate__c})</expression>
    </formulas>
    <interviewLabel>Job Before Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Job Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getUser</name>
        <label>Get User</label>
        <locationX>446</locationX>
        <locationY>503</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsUserAccountLookupSet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>User</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>375</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsNew</targetReference>
        </connector>
        <filterFormula>!{!$Setup.Org_Exceptions__c.BypassJobLightningFlow__c}</filterFormula>
        <object>TR1__Job__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

    <environments>Default</environments>
    <formulas>
        <name>varAccreditationCycleStatus</name>
        <dataType>String</dataType>
        <expression>IF(YEAR({!SemesterStartDate}) = YEAR(TODAY()) &amp;&amp; MONTH({!SemesterStartDate}) = MONTH(TODAY()), &apos;In Progress&apos;, &apos;Planned&apos;)</expression>
    </formulas>
    <formulas>
        <name>varAccreditationCycleUrl</name>
        <dataType>String</dataType>
        <expression>{!GetUrls.orgDomainUrl} + &apos;/&apos; + {!varAccreditationCycle.Id}</expression>
    </formulas>
    <formulas>
        <name>varDefaultAccreditationCycleStatus</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!SemesterStartDate}), IF(MONTH({!SemesterStartDate}) = MONTH(TODAY()) &amp;&amp; YEAR({!SemesterStartDate}) = YEAR(TODAY()), &apos;In Progress&apos;, &apos;Planned&apos;), &apos;&apos;)</expression>
    </formulas>
    <formulas>
        <description>Translates the Next Semester field value back to a date, either starting January or July. The value is used as a threshold value when getting the semesters from Salesforce.</description>
        <name>varSemesterNextCycle</name>
        <dataType>Date</dataType>
        <expression>DATE(VALUE(&apos;20&apos; + LEFT({!GetAccreditation.CurrentAccreditationCycle__r.SemesterNextCycle__c},2)),
CASE(VALUE(MID({!GetAccreditation.CurrentAccreditationCycle__r.SemesterNextCycle__c}, FIND(&apos;-&apos;, {!GetAccreditation.CurrentAccreditationCycle__r.SemesterNextCycle__c}) +1, 1)), 1, 1, 2, 7, 1),
1)</expression>
    </formulas>
    <interviewLabel>New Accreditation Cycle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Accreditation Cycle</label>

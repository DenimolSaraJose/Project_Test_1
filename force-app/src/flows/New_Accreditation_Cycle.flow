                </fields>
                <fields>
                    <name>txtCurrentAccreditationCycleName</name>
                    <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(94, 95, 94); font-size: 10px;&quot;&gt;Current Accreditation Cycle Name&lt;/span&gt;&lt;/p&gt;&lt;p&gt;{!GetAccreditation.CurrentAccreditationCycle__r.Name}&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Set the Membership Engagement Visit</description>
        <name>SetMembership</name>
        <label>SetMembership</label>
        <locationX>314</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>GetMembership.Membership_Engagement_Visit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Create_Engagement_Activity</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Membership_Record</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Check if there is already a Membership Engagement Visit</description>
        <name>Visit_Already_Present</name>
        <label>Visit Already Present?</label>
        <locationX>182</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Create_Membership_Engagement_Visit</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Create New Visit</defaultConnectorLabel>
        <rules>
            <name>IsPresent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetMembership.Membership_Engagement_Visit__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Creation_is_not_allowed</targetReference>
            </connector>
            <label>Is Present</label>
        </rules>
    </decisions>
    <description>Fixed Formula when Accountname is too long</description>
    <environments>Default</environments>
    <formulas>
        <description>Engagement Nae</description>
        <name>FormulaEngagementName</name>
        <dataType>String</dataType>
        <expression>IF (LEN({!GetMembership.Account_Name__r.Name}) + 18 &gt; 80, &apos;Engagement &apos;  + TRIM(LEFT({!GetMembership.Account_Name__r.Name}, 59)) + &apos;...&apos;, 
&apos;Engagement &apos; + {!GetMembership.Account_Name__r.Name}
)</expression>
    </formulas>
    <formulas>
        <description>FormulaEngagementVisitName</description>
        <name>FormulaEngagementVisitName</name>
        <dataType>String</dataType>
        <expression>IF (LEN({!GetMembership.Account_Name__r.Name}) + 18 &gt; 80, &apos;Visit &apos;  + TRIM(LEFT({!GetMembership.Account_Name__r.Name}, 59)) + &apos;...&apos;, 
&apos;Visit &apos; + {!GetMembership.Account_Name__r.Name}
)</expression>
    </formulas>
    <interviewLabel>Engagement Screen Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Engagement Screen Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Engagement_Activity</name>
        <label>Create Engagement Activity</label>
        <locationX>314</locationX>
        <locationY>674</locationY>
        <connector>
            <targetReference>SetMembership</targetReference>
        </connector>
        <inputAssignments>
            <field>Activity_Status__c</field>
            <value>
                <stringValue>Scheduled</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Engagement_Visit_Date__c</field>
            <value>
                <elementReference>Screen_Engagement_Visit_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Engagement__c</field>
            <value>
                <elementReference>Create_Engagement_Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership__c</field>
            <value>
                <elementReference>GetMembership.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>FormulaEngagementVisitName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Notes__c</field>
            <value>
                <elementReference>ScreenNotes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <stringValue>0120Y0000002ReBQAU</stringValue>
            </value>
        </inputAssignments>
        <object>Engagement_Activity__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <name>Create_Engagement_Record</name>
        <label>Create Engagement Record</label>
        <locationX>314</locationX>
        <locationY>566</locationY>
        <connector>
            <targetReference>Create_Engagement_Activity</targetReference>
        </connector>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>FormulaEngagementName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <stringValue>0121n00000035mtAAA</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>School_Name__c</field>
            <value>
                <elementReference>GetMembership.Account_Name__r.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Engagement__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>GetMembership</name>
        <label>GetMembership</label>
        <locationX>182</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Visit_Already_Present</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Membership__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Get RecordType from the Engagement and Engagement Activity object</description>
        <name>GetRecordTypes</name>
        <label>GetRecordTypes</label>
        <locationX>314</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Engagement_Record</targetReference>
        </connector>
        <filterLogic>(1 AND 2 ) OR (3 AND 4)</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Membership</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Engagement__c</stringValue>
            </value>
        </filters>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Membership_Evaluation</stringValue>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Engagement_Activity__c</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Membership_Record</name>
        <label>Update Membership Record</label>
        <locationX>314</locationX>
        <locationY>890</locationY>
        <inputReference>GetMembership</inputReference>
    </recordUpdates>
    <screens>
        <name>Create_Membership_Engagement_Visit</name>
        <label>Create Membership Engagement Visit</label>
        <locationX>314</locationX>
        <locationY>350</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>true</allowPause>
        <connector>
            <targetReference>GetRecordTypes</targetReference>
        </connector>
        <fields>
            <name>Create_Membership_Engagement_Visit_Section1</name>
            <fieldType>RegionContainer</fieldType>
            <fields>
                <name>Create_Membership_Engagement_Visit_Section1_Column1</name>
                <fieldType>Region</fieldType>
                <inputParameters>
                    <name>width</name>
                    <value>
                        <stringValue>12</stringValue>
                    </value>
                </inputParameters>
                <isRequired>false</isRequired>
            </fields>
            <isRequired>false</isRequired>
            <regionContainerType>SectionWithoutHeader</regionContainerType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Membership_Engagement_Visit_ScreenHeader</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(0, 0, 0); font-size: 16px;&quot;&gt;Membership Engagement Visit&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Screen_Engagement_Visit_Date</name>
            <dataType>Date</dataType>
            <fieldText>Engagement Visit Date</fieldText>
            <fieldType>InputField</fieldType>
            <helpText>&lt;p&gt;&lt;span style=&quot;background-color: white; color: rgb(23, 43, 77); font-family: &amp;quot;Segoe UI&amp;quot;, sans-serif; font-size: 10.5pt;&quot;&gt;This is the date agreed with the school when their membership engagement visit will take place.&lt;/span&gt;&lt;/p&gt;</helpText>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>true</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <validationRule>
                <errorMessage>&lt;p&gt;Date must be in the future.&lt;/p&gt;</errorMessage>
                <formulaExpression>{!Screen_Engagement_Visit_Date} &gt;=TODAY()</formulaExpression>
            </validationRule>
        </fields>
        <fields>
            <name>ScreenNotes</name>
            <dataType>String</dataType>
            <fieldText>Notes</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>Visit_Status</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;&lt;em&gt;Note:&lt;/em&gt;&lt;/strong&gt; Visit Status is defaulted to Scheduled. Please open the Engagement Visit to change the Visit Status.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Create</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Creation_is_not_allowed</name>
        <label>Creation is not allowed</label>
        <locationX>50</locationX>
        <locationY>350</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>ErrorMessage</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;Creation is not allowed&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Please note that if there is a Membership Engagement Visit already present, it is not possible to create a new Visit.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetMembership</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>

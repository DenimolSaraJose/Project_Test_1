        <name>Send_Contact_Removed_From_University_Notification</name>
        <label>Send Contact Removed Notification</label>
        <locationX>314</locationX>
        <locationY>1955</locationY>
        <actionName>Contact.Contact_removed_from_University</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Contact.Contact_removed_from_University</nameSegment>
        <offset>0</offset>

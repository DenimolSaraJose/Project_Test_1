    <actionCalls>
        <name>Send_HES_Form_2</name>
        <label>Send HES Form 2</label>
        <locationX>446</locationX>
        <locationY>1139</locationY>
        <actionName>Contact.CIS_HE_Send_extended_form_contact</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>Log_HES_Form_2_Email_Activity</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>

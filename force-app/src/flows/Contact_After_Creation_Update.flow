            <value>
                <elementReference>coll_Contacts</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processingMethod</name>
            <value>
                <stringValue>CREATE</stringValue>
            </value>
        </inputParameters>
        <nameSegment>PrivilegeServiceInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Send_Contact_Removed_From_School_Notification</name>

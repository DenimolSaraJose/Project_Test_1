    <actionCalls>
        <name>Sync_with_LearnWorlds</name>
        <label>Sync with LearnWorlds</label>
        <locationX>446</locationX>
        <locationY>1547</locationY>
        <actionName>LearnWorldsSyncInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>IsUpdateContactAccountCounterChanged</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>contact</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>LearnWorldsSyncInvocable</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_to_collection</name>
        <label>Add Contact to collection</label>
        <locationX>248</locationX>
        <locationY>539</locationY>
        <assignmentItems>
            <assignToReference>coll_Contacts</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateAccountBasedPrivileges</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Variable_Assignments</name>
        <label>Variable Assignments</label>
        <locationX>578</locationX>
        <locationY>923</locationY>
        <assignmentItems>
            <assignToReference>varAccountRecordType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Account.RecordType.DeveloperName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsSendHEForm</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Member has active Membership(s) and is a School or University, integrations must be enabled.</description>
        <name>IsAccountHasActiveMemberships</name>
        <label>Account has active Memberships?</label>
        <locationX>380</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Variable_Assignments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>IsAccountHasActiveMembershipsTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Is_Active_Membership__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsSchoolOrUniversity</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Setup.Org_Exceptions__c.BypassCreatingNewPrivileges__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Contact_to_collection</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsSendHEForm</name>
        <label>Send HE Form?</label>
        <locationX>578</locationX>
        <locationY>1031</locationY>
        <defaultConnector>
            <targetReference>IsSyncWithLearnWorlds</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SendHEFormTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CIS_Lead_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High Ed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Don_t_send_HE_form_2_c__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_HES_Form_2</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Contact has a LearnWorlds User Id, changes in Full Name and/or Email have to be synced (a-synchronous).</description>
        <name>IsSyncWithLearnWorlds</name>
        <label>Sync with LearnWorlds?</label>
        <locationX>578</locationX>
        <locationY>1439</locationY>
        <defaultConnector>
            <targetReference>IsUpdateContactAccountCounterChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsSyncWithLearnWorldsTRUE</name>
            <conditionLogic>1 AND 2 AND (3 OR (4 AND 5))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.LearnWorldsUserId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.LearnWorldsUserId__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Full_Name__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sync_with_LearnWorlds</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUpdateContactAccountCounterChanged</name>
        <label>Update-Contact-Account-Counter Changed?</label>
        <locationX>578</locationX>
        <locationY>1739</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>UpdateContactAccountCounterChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.XUpdateContactAccountCounter__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SwitchOnAssociatedAccountRecordType</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>checks the formula function ISNEW()</description>
        <name>NewContact</name>
        <label>New Contact?</label>
        <locationX>578</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Variable_Assignments</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_NewContact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fm_IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsAccountHasActiveMemberships</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>SwitchOnAssociatedAccountRecordType</name>
        <label>Switch On Associated Account RecordType</label>
        <locationX>314</locationX>
        <locationY>1847</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>School</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccountRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>School</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Contact_Removed_From_School_Notification</targetReference>
            </connector>
            <label>School</label>
        </rules>
        <rules>
            <name>University</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccountRecordType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>University</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Contact_Removed_From_University_Notification</targetReference>
            </connector>
            <label>University</label>
        </rules>
    </decisions>
    <description>Remove Account Owner Update</description>
    <environments>Default</environments>
    <formulas>
        <name>CreatedByCommunityUser</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;CustomerSuccess&apos;) || ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;PowerCustomerSuccess&apos;) || ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;CSPLitePortal&apos;)</expression>
    </formulas>
    <formulas>
        <name>fm_ExecutionTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 1</expression>
    </formulas>
    <formulas>
        <name>fm_IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>fm_TODAY</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>isCommunityUser</name>
        <dataType>Boolean</dataType>
        <expression>IF(TEXT({!$User.UserType}) = &apos;CustomerSuccess&apos; || TEXT({!$User.UserType}) = &apos;PowerCustomerSuccess&apos; || TEXT({!$User.UserType}) = &apos;CSPLitePortal&apos;, true, false)</expression>
    </formulas>
    <formulas>
        <name>IsSchoolOrUniversity</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.Account.RecordType.DeveloperName} = &apos;School&apos; || {!$Record.Account.RecordType.DeveloperName} = &apos;University&apos;, true, false)</expression>
    </formulas>
    <interviewLabel>Contact After Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact After Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_HES_Form_2_Email_Activity</name>
        <label>Log HES Form 2 Email Activity</label>
        <locationX>446</locationX>
        <locationY>1247</locationY>
        <connector>
            <targetReference>IsSyncWithLearnWorlds</targetReference>
        </connector>
        <inputAssignments>
            <field>CurrencyIsoCode</field>
            <value>
                <stringValue>EUR</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>Normal</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <stringValue>HES Form 2 Email Sent</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>WhatId</field>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </inputAssignments>
        <object>Task</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <start>
        <locationX>452</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>NewContact</targetReference>
        </connector>
        <filterFormula>!{!$Setup.Org_Exceptions__c.BypassContactLightningFlow__c}</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>coll_Contacts</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Contact</objectType>
    </variables>
    <variables>
        <name>var_ContactIds</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>var_ExecutedDateTime</name>
        <dataType>DateTime</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varAccountRecordType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

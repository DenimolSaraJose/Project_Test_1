<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Accreditation RecordType &apos;External&apos;</description>
        <name>Get_Accreditation_RecordType_External</name>
        <label>Get Accreditation RecordType External</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <actionName>FlowGetRecordType</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Assign_Accreditation_Values</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>RecordTypeDeveloperName</name>
            <value>
                <stringValue>External</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>SObjectTypeName</name>
            <value>
                <stringValue>Accreditation__c</stringValue>
            </value>
        </inputParameters>
        <nameSegment>FlowGetRecordType</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <description>Accreditation RecordType &apos;Internal&apos;</description>
        <name>Get_Accreditation_RecordType_Internal</name>
        <label>Get Accreditation RecordType Internal</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>FlowGetRecordType</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_Accreditation_RecordType_External</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>RecordTypeDeveloperName</name>
            <value>
                <stringValue>Internal</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>SObjectTypeName</name>
            <value>
                <stringValue>Accreditation__c</stringValue>
            </value>
        </inputParameters>
        <nameSegment>FlowGetRecordType</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Accreditation_Values</name>
        <label>Assign Accreditation Values</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>varAccreditation.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varMembership.Account_Name__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccreditation.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAccreditationStatus</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccreditation.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAccreditationRecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccreditation.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varAccreditationName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccreditation.OriginatingMembership__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varMembership.Id</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Create_Accreditation</targetReference>
        </connector>
    </assignments>
    <description>Subflow to create Accreditation record for Membership or Account. Inputs are Membership or Account record, output is the newly created Accreditation record.</description>
    <environments>Default</environments>
    <formulas>
        <name>varAccreditationName</name>
        <dataType>String</dataType>
        <expression>IF (LEN({!varMembership.Account_Name__r.Name}) + 18 &gt; 80, &apos;Accreditation for &apos; + TRIM(LEFT({!varMembership.Account_Name__r.Name}, 59)) + &apos;...&apos;, 
&apos;Accreditation for &apos; + {!varMembership.Account_Name__r.Name}
)</expression>
    </formulas>
    <formulas>
        <description>Return the RecordTypeId for the Accreditation record, based on the Membership External Accreditation Agency -field.</description>
        <name>varAccreditationRecordTypeId</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!varMembership.External_Accreditation_Agency__c}) == NULL, {!Get_Accreditation_RecordType_Internal.recordTypeId}, {!Get_Accreditation_RecordType_External.recordTypeId})</expression>
    </formulas>
    <formulas>
        <name>varAccreditationStatus</name>
        <dataType>String</dataType>
        <expression>IF(TEXT({!varMembership.External_Accreditation_Agency__c}) == NULL, &apos;Prospect&apos;, &apos;Not Required&apos;)</expression>
    </formulas>
    <interviewLabel>Create Accreditation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Create Accreditation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Accreditation</name>
        <label>Create Accreditation</label>
        <locationX>176</locationX>
        <locationY>458</locationY>
        <inputReference>varAccreditation</inputReference>
    </recordCreates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Accreditation_RecordType_Internal</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varAccount</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Account</objectType>
    </variables>
    <variables>

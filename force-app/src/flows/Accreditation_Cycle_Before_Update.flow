    <decisions>
        <name>IsRolledBackStatusCompleted</name>
        <label>Rolled Back Status &apos;Completed&apos;</label>
        <locationX>336</locationX>
        <locationY>1079</locationY>
        <defaultConnector>
            <targetReference>StatusChangedToCancelled</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsRolledBackStatusCompletedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ClearCompletedDate</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsStartDateEmpty</name>
        <label>Start Date Empty</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <defaultConnector>

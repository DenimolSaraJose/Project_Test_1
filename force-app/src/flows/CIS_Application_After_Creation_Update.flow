            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Job.Selected_Candidate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Applicant__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Job.Community_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Application</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsApplicationNotSelected</targetReference>
        </connector>

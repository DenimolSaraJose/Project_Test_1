        <assignmentItems>
            <assignToReference>Get_Job.Application_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Application_status__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>

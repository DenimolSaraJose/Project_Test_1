<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>This update should not trigger any Apex Account updates.</description>
        <name>Bypass_Account_Trigger_Handler</name>
        <label>Bypass Account Trigger Handler</label>
        <locationX>182</locationX>
        <locationY>335</locationY>
        <actionName>TriggerHandlerInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Is_the_Position_applicable</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>handlerName</name>
            <value>
                <stringValue>AccountTriggerHandler</stringValue>
            </value>
        </inputParameters>
        <nameSegment>TriggerHandlerInvocable</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_the_Position_applicable</name>
        <label>Is the Position applicable?</label>
        <locationX>182</locationX>
        <locationY>455</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7 OR 8) AND 9</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation Team Chair</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation Co-Chair</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation Team Member</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation Team Secretary</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Peer Evaluator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reader</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Business Manager</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Position__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Evaluation Team Facilitator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>virtual</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Job_on_Virtual_Visit_checkbox_on_Contact_0</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Added Bypass Account Trigger Handler</description>
    <environments>Default</environments>
    <interviewLabel>Job {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Job_RecordTriggered_CreateUpdate_AfterSave</label>
    <processMetadataValues>
        <name>BuilderType</name>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Document outstanding value changed for a Sales Credit Note (SCR)</description>
        <name>IsDocumentOutstandingValueChangedSCR</name>
        <label>Document Outstanding Value Changed (SCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>IsDocumentOutstandingValueChangedSIN</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsDocumentOutstandingValueChangedSCRTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.c2g__DocumentOutstandingTotal__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.c2g__DocumentNumber__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>SCR</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Payment_Status_SCR</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsDocumentOutstandingValueChangedSIN</name>
        <label>Document Outstanding Value Changed (SIN)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsDocumentOutstandingValueChangedSINTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.c2g__DocumentOutstandingTotal__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.c2g__DocumentNumber__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>SIN</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Payment_Status_SIN</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>isSCRPaid</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.c2g__DocumentNumber__c}, &apos;SCR&apos;) &amp;&amp; {!$Record.c2g__DocumentOutstandingTotal__c} = 0</expression>
    </formulas>
    <formulas>
        <name>isSCRPartPaid</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!$Record.c2g__DocumentNumber__c}, &apos;SCR&apos;) 
&amp;&amp; {!$Record.c2g__DocumentTotal__c} != 0
&amp;&amp; {!$Record.c2g__AccountOutstandingTotal__c} &gt; {!$Record.c2g__DocumentTotal__c}</expression>
    </formulas>
    <formulas>
        <name>isSINPaid</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.c2g__DocumentOutstandingTotal__c} = 0
&amp;&amp; BEGINS({!$Record.c2g__DocumentNumber__c}, &apos;SIN&apos;)</expression>
    </formulas>
    <formulas>
        <name>isSINPartPaid</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.c2g__DocumentOutstandingTotal__c} &lt; {!$Record.c2g__DocumentTotal__c}
&amp;&amp; {!$Record.c2g__DocumentOutstandingTotal__c} != 0
&amp;&amp; BEGINS({!$Record.c2g__DocumentNumber__c}, &apos;SIN&apos;)</expression>
    </formulas>
    <interviewLabel>Transaction After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Transaction After Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Payment_Status_SCR</name>
        <label>Update Payment Status (SCR)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsDocumentOutstandingValueChangedSIN</targetReference>
        </connector>
        <inputAssignments>
            <field>CIS_Paid__c</field>
            <value>
                <elementReference>isSCRPaid</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CIS_Part_Paid__c</field>
            <value>
                <elementReference>isSCRPartPaid</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.c2g__SalesCreditNote__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Payment_Status_SIN</name>
        <label>Update Payment Status (SIN)</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Paid__c</field>
            <value>
                <elementReference>isSINPaid</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Part_Paid__c</field>
            <value>
                <elementReference>isSINPartPaid</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.c2g__SalesInvoice__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsDocumentOutstandingValueChangedSCR</targetReference>
        </connector>
        <object>c2g__codaTransaction__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

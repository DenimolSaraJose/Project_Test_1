    <choices>
        <name>choice_ScheduleType_InSequence</name>
        <choiceText>Schedule In Sequence</choiceText>
        <dataType>Boolean</dataType>
        <value>
            <booleanValue>true</booleanValue>
        </value>
    </choices>
    <choices>
        <name>choice_ScheduleType_Parallel</name>
        <choiceText>Schedule Parallel</choiceText>
        <dataType>Boolean</dataType>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </choices>
    <decisions>
        <name>IsAccreditationCycleNotClosed</name>
        <label>Accreditation Cycle not Closed</label>
        <locationX>336</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationCycleNotClosedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accreditation_Cycle.IsClosed__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Accreditation_Cycle_Stages</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccreditationCycleRecordIdProvided</name>
        <label>Accreditation Cycle record Id provided?</label>
        <locationX>545</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationCycleRecordIdProvidedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Accreditation_Cycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsScheduleTypeInSequence</name>
        <label>Schedule Type In Sequence?</label>
        <locationX>182</locationX>
        <locationY>1598</locationY>
        <defaultConnector>
            <targetReference>Insert_new_Accreditation_Cycle_Stage</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsScheduleTypeInSequenceTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inSequence</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>choice_ScheduleType_InSequence</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Selected_Cycle_Stage</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsStageStatusNotPlanned</name>
        <label>Stage Status Not Planned</label>
        <locationX>402</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Loop_Accreditation_Cycle_Stages</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsStageStatusNotPlannedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Accreditation_Cycle_Stages.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Planned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_to_OrderBlockList</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>Screen flow for guiding the process of creating a new Accreditation Cycle Stage</description>
    <dynamicChoiceSets>
        <description>Accreditation Stages</description>
        <name>choiceSetAccreditationStages</name>
        <collectionReference>Get_Accreditation_Stages</collectionReference>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <object>AccreditationStage__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>DurationType</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>DurationType__c</picklistField>
        <picklistObject>AccreditationTrackStage__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>CurrentCycleStageOrderText</name>
        <dataType>String</dataType>
        <expression>TEXT({!Loop_Accreditation_Cycle_Stages.Order__c})</expression>
    </formulas>
    <formulas>
        <name>newStageDueDate</name>
        <dataType>Date</dataType>
        <expression>IF({!Get_Selected_Cycle_Stage.Id} != NULL,
    IF({!Duration_Type} = &apos;Day(s)&apos;, {!Get_Selected_Cycle_Stage.StartDate__c} + {!Duration}, 
    IF({!Duration_Type} = &apos;Week(s)&apos;, {!Get_Selected_Cycle_Stage.StartDate__c} + ({!Duration} *7) -1, 
    IF({!Duration_Type} = &apos;Month(s)&apos;, ADDMONTHS({!Get_Selected_Cycle_Stage.StartDate__c}, {!Duration}) -1, 
    IF({!Duration_Type} = &apos;Year(s)&apos;, ADDMONTHS({!Get_Selected_Cycle_Stage.StartDate__c}, {!Duration} *12) -1, 
    {!Get_Selected_Cycle_Stage.DueDate__c}
)))),
    IF({!Duration_Type} = &apos;Day(s)&apos;, {!nextStartDate} + {!Duration}, 
    IF({!Duration_Type} = &apos;Week(s)&apos;, {!nextStartDate} + ({!Duration} *7) -1, 
    IF({!Duration_Type} = &apos;Month(s)&apos;, ADDMONTHS({!nextStartDate}, {!Duration}) -1, 
    IF({!Duration_Type} = &apos;Year(s)&apos;, ADDMONTHS({!nextStartDate}, {!Duration} *12) -1, 
   {!nextDueDate}
)))))</expression>
    </formulas>
    <formulas>
        <name>newStageStartDate</name>
        <dataType>Date</dataType>
        <expression>IF({!Get_Selected_Cycle_Stage.Id} != NULL,
    {!Get_Selected_Cycle_Stage.StartDate__c},
   {!nextStartDate}
)</expression>
    </formulas>
    <formulas>
        <description>Defaults to nexStartDate plus six months</description>
        <name>nextDueDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!nextStartDate},6)</expression>
    </formulas>
    <formulas>
        <name>nextOrder</name>
        <dataType>Number</dataType>
        <expression>{!Get_Accreditation_Cycle.nStages__c} +1</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>nextStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(!ISBLANK({!Get_Accreditation_Cycle.EstimatedCompletionDate__c}), {!Get_Accreditation_Cycle.EstimatedCompletionDate__c} +1, {!Get_Accreditation_Cycle.StartDate__c})</expression>
    </formulas>
    <formulas>
        <name>OrderTextVersion</name>
        <dataType>String</dataType>
        <expression>TEXT({!Order})</expression>
    </formulas>
    <formulas>
        <name>varCycleStartDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_Accreditation_Cycle.StartDate__c}</expression>
    </formulas>
    <interviewLabel>New Accreditation Cycle Stage {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Accreditation Cycle Stage</label>
    <loops>

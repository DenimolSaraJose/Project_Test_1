    <recordLookups>
        <description>Get Accreditation Cycle based on recordId</description>
        <name>Get_Accreditation_Cycle</name>
        <label>Get Accreditation Cycle</label>
        <locationX>336</locationX>
        <locationY>242</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsAccreditationCycleNotClosed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccreditationCycle__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Accreditation_Cycle_Stages</name>
        <label>Get Accreditation Cycle Stages</label>
        <locationX>182</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Accreditation_Cycle_Stages</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccreditationCycle__c</field>

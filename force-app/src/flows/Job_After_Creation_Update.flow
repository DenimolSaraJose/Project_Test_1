    <recordUpdates>
        <name>Update_Application_Records_1</name>
        <label>Update Application Records</label>
        <locationX>50</locationX>
        <locationY>839</locationY>
        <connector>
            <targetReference>IsCandidateSelected</targetReference>
        </connector>
        <inputAssignments>
            <field>Contact_Email__c</field>
            <value>
                <elementReference>$Record.TR1__Contact_Email__c</elementReference>

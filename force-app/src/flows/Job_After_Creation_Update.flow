            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUpdateTriggeringRecord</name>
        <label>Update Triggering Record?</label>
        <locationX>182</locationX>
        <locationY>1331</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsUpdateTriggeringRecordTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Update_Record</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bypass_JobTriggerHandler</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ShortenedJobName</name>
        <dataType>String</dataType>
        <expression>MID({!$Record.Name}, 7, LEN({!$Record.Name}))</expression>
    </formulas>

    <recordUpdates>
        <name>Update_Application_Records_2</name>
        <label>Update Application Records</label>
        <locationX>50</locationX>
        <locationY>1139</locationY>
        <connector>
            <targetReference>IsUpdateTriggeringRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Application_status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Applied</stringValue>
            </value>
        </filters>
        <filters>
            <field>TR1__Applicant__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.XSelected_Candidate__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Application_status__c</field>
            <value>
                <stringValue>Not Selected</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.TR1__Application__r</inputReference>
    </recordUpdates>
    <recordUpdates>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Update Street value to Address Lines 1-3 combined.</description>
        <name>Set_Street</name>
        <label>Set Street</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Street</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>normalizedStreet</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <description>Address lines 1-3</description>
        <name>normalizedStreet</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.Address_line_1__c}), {!$Record.Address_line_1__c} + &apos; &apos;, &apos;&apos;) + 
IF(!ISBLANK({!$Record.Address_line_2__c}), {!$Record.Address_line_2__c} + &apos; &apos;, &apos;&apos;) + 
{!$Record.Address_line_3__c}</expression>
    </formulas>
    <interviewLabel>Lead Before Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Street</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

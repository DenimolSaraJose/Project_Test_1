<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Clear_Account_Hierarchy_Fields</name>
        <label>Clear Account Hierarchy Fields</label>
        <locationX>50</locationX>
        <locationY>2603</locationY>
        <assignmentItems>
            <assignToReference>$Record.IsPartOfAccountHierarchy__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.TopLevelAccount__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Fill in account closed date</description>
        <name>Set_Account_Closed_Date</name>
        <label>Set Account Closed Date</label>
        <locationX>50</locationX>
        <locationY>695</locationY>
        <assignmentItems>
            <assignToReference>$Record.Closed_date_opportunity__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Closed_Date</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Finance_Contact_Set_But_No_Invoice_Email</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Set Account Currency based on Account RecordType</description>
        <name>Set_Account_Currency</name>
        <label>Set Account Currency</label>
        <locationX>50</locationX>
        <locationY>1703</locationY>
        <assignmentItems>
            <assignToReference>$Record.CurrencyIsoCode</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Account_Currency</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsRecordTypeCampus</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Areas_Of_Interest_For_Report</name>
        <label>Set Areas Of Interest For Report</label>
        <locationX>50</locationX>
        <locationY>1295</locationY>
        <assignmentItems>
            <assignToReference>$Record.Areas_of_Interest_for_Report__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Areas_of_Interest__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_RecordType_Set_Or_Changed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Institution_Type</name>
        <label>Set Institution Type</label>
        <locationX>50</locationX>
        <locationY>1595</locationY>
        <assignmentItems>
            <assignToReference>$Record.Institution_type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>RecordType_Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Set_Account_Currency</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Invoice_Email</name>
        <label>Set Invoice Email</label>
        <locationX>50</locationX>
        <locationY>995</locationY>
        <assignmentItems>
            <assignToReference>$Record.c2g__CODAInvoiceEmail__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Invoice_Email</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Areas_Of_Interest_Set_Or_Changed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Owner_SF_Admin</name>
        <label>Set Owner SF Admin</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SFAdminId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_HE_Extended_Form_Complete</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Related_School</name>
        <label>Set Related School</label>
        <locationX>50</locationX>
        <locationY>2003</locationY>
        <assignmentItems>
            <assignToReference>$Record.Campus_Related_School__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.ParentId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsSetOrUpdateAccountTradingCurrencyHelper</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>SetAccountTradingCurrencyHelper</name>
        <label>Set Account Trading Currency Helper</label>
        <locationX>50</locationX>
        <locationY>2303</locationY>
        <assignmentItems>
            <assignToReference>$Record.AccountTradingCurrencyHelper__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.c2g__CODAAccountTradingCurrency__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsParentAccountCleared</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>SFAdminId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0050Y000000YI4aQAG</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Is_Areas_Of_Interest_Set_Or_Changed</name>
        <label>Areas Of Interest Set Or Changed?</label>
        <locationX>182</locationX>
        <locationY>1187</locationY>
        <defaultConnector>
            <targetReference>Is_RecordType_Set_Or_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Areas_Of_Interest_Set_Or_Changed</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Areas_of_Interest__c</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Areas_of_Interest__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Areas_Of_Interest_For_Report</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Finance_Contact_Set_But_No_Invoice_Email</name>
        <label>Finance Contact Set But No Invoice Email?</label>
        <locationX>182</locationX>
        <locationY>887</locationY>
        <defaultConnector>
            <targetReference>Is_Areas_Of_Interest_Set_Or_Changed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Finance_Contact_Set_But_No_Invoice_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.c2g__CODAFinanceContact__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.c2g__CODAInvoiceEmail__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Invoice_Email</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_HE_Extended_Form_Complete</name>
        <label>HE Extended Form Complete?</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <defaultConnector>
            <targetReference>Is_Finance_Contact_Set_But_No_Invoice_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>HE_Extended_Form_Completed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Account_Closed_Date</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_RecordType_Set_Or_Changed</name>
        <label>RecordType Set Or Changed?</label>
        <locationX>182</locationX>
        <locationY>1487</locationY>
        <defaultConnector>
            <targetReference>IsRecordTypeCampus</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>RecordType_Set_Or_Changed</name>
            <conditionLogic>(1 AND 2) OR 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>WasSet</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Institution_Type</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsParentAccountCleared</name>
        <label>Parent Account Cleared?</label>
        <locationX>182</locationX>
        <locationY>2495</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsParentAccountClearedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ParentId</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ParentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Account_Hierarchy_Fields</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsRecordTypeCampus</name>
        <label>RecordType Campus?</label>
        <locationX>182</locationX>
        <locationY>1895</locationY>
        <defaultConnector>
            <targetReference>IsSetOrUpdateAccountTradingCurrencyHelper</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsRecordTypeCampusTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Campus</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Related_School</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsSetOrUpdateAccountTradingCurrencyHelper</name>
        <label>Set or Update Account Trading Currency Helper?</label>
        <locationX>182</locationX>
        <locationY>2195</locationY>
        <defaultConnector>
            <targetReference>IsParentAccountCleared</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsSetOrUpdateAccountTradingCurrencyHelperTRUE</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccountTradingCurrencyHelper__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.c2g__CODAAccountTradingCurrency__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetAccountTradingCurrencyHelper</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Account</name>
        <label>New Account</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>Is_HE_Extended_Form_Complete</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Owner_SF_Admin</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Deleted Update Related Jobs from flow as part of TalentRover removal</description>
    <environments>Default</environments>
    <formulas>
        <description>Fill in account closed date</description>
        <name>Account_Closed_Date</name>
        <dataType>Date</dataType>
        <expression>{!$Record.CreatedDate} + 90</expression>
    </formulas>
    <formulas>
        <description>Set Account Currency for RecordType with fallback to &quot;EUR&quot;</description>
        <name>Account_Currency</name>
        <dataType>String</dataType>
        <expression>CASE({!RecordType_Name}, &quot;School&quot;, &quot;EUR&quot;, &quot;University&quot;, &quot;USD&quot;, &quot;EUR&quot;)</expression>
    </formulas>
    <formulas>
        <name>Invoice_Email</name>
        <dataType>String</dataType>
        <expression>{!$Record.c2g__CODAFinanceContact__r.Email}</expression>
    </formulas>
    <formulas>
        <name>RecordType_Name</name>
        <dataType>String</dataType>
        <expression>{!$Record.RecordType.Name}</expression>
    </formulas>
    <interviewLabel>Account_Before_Creation_Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>New_Account</targetReference>
        </connector>
        <filterFormula>!{!$Setup.Org_Exceptions__c.BypassAccountLightningFlow__c}</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

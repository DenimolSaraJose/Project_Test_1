<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Compare selected Privileges with those referenced from the available Account Privileges to determine if new Account Privileges should be created. For unique Ids we need to create Account Privileges and Contact Privileges, for common (shared) Ids we only need to create Contact Privileges.</description>
        <name>Compare_Selected_Privileges</name>
        <label>Compare Selected Privileges</label>
        <locationX>468</locationX>
        <locationY>4070</locationY>
        <actionName>FlowCompareCollectionVariables</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Get_Privileges_to_Assign</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Rollback</targetReference>
        </faultConnector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>var1</name>
            <value>
                <elementReference>varPrivilegesToAssign</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>var2</name>
            <value>
                <elementReference>varPrivilegeIdsReferencedByAccountPrivileges</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FlowCompareCollectionVariables</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>varCommonPrivilegeIds</assignToReference>
            <name>common</name>
        </outputParameters>
        <outputParameters>
            <assignToReference>varUniquePrivilegeIds</assignToReference>
            <name>uniqueVar1</name>
        </outputParameters>
    </actionCalls>

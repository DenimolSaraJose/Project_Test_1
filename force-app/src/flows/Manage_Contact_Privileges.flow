    <decisions>
        <name>Distribution_Type</name>
        <label>Distribution Type?</label>
        <locationX>1084</locationX>
        <locationY>974</locationY>
        <defaultConnector>
            <targetReference>Assign_Privilege_to_Privilege_Ids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact</defaultConnectorLabel>
        <rules>
            <name>Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_current_Contact_Privileges.Distribution_Type__c</leftValueReference>
                <operator>EqualTo</operator>

    <collectionProcessors>
        <name>Filter_Privileges_Contact_based_only</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Privileges: Contact-based only</label>
        <locationX>864</locationX>
        <locationY>1682</locationY>
        <assignNextValueToReference>currentItem_Filter_Privileges_Contact_based_only</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>GetPrivileges</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Privileges_Contact_based_only.Distribution_Type__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <stringValue>Contact based</stringValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Privileges_Contact_based_only.Delegated_Admin__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <conditions>
            <leftValueReference>currentItem_Filter_Privileges_Contact_based_only.IsDefault__c</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <booleanValue>false</booleanValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>IsMemberHasActiveMemberships</targetReference>
        </connector>
    </collectionProcessors>

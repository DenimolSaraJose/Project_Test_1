                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Planned</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.InitialStartDate__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetInitialStartDate</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsStatusChangedToCompleted</name>
        <label>Status Changed to &apos;Completed&apos;</label>
        <locationX>336</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>IsRolledBackStatusCompleted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsStatusChangedToCompletedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsCompletedDateEmpty</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <description>Semester calculation based on either the Evaluation Visit Start Date or the School Report Due Date</description>
        <name>varSemester</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!$Record.EvaluationVisitStartDate__c}) || !ISBLANK({!$Record.SchoolReportDueDate__c}),
RIGHT(TEXT(YEAR(DATEVALUE(TEXT(YEAR(BLANKVALUE({!$Record.EvaluationVisitStartDate__c}, {!$Record.SchoolReportDueDate__c}))) &amp; &quot;-&quot; &amp; TEXT(MONTH(BLANKVALUE({!$Record.EvaluationVisitStartDate__c}, {!$Record.SchoolReportDueDate__c}))) &amp; &quot;-1&quot;))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(DATEVALUE(TEXT(YEAR(BLANKVALUE({!$Record.EvaluationVisitStartDate__c}, {!$Record.SchoolReportDueDate__c}))) &amp; &quot;-&quot; &amp; TEXT(MONTH(BLANKVALUE({!$Record.EvaluationVisitStartDate__c}, {!$Record.SchoolReportDueDate__c}))) &amp; &quot;-1&quot;)) &lt;= 6, &quot;1&quot;, &quot;2&quot;),
&quot;N/A&quot;)</expression>
    </formulas>
    <interviewLabel>Accreditation Cycle Stage Before Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Accreditation Cycle Stage Before Update</label>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Application_Deadline</name>
        <label>Check Application Deadline</label>
        <locationX>361</locationX>
        <locationY>231</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Job_is_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>job.Community_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_status_to_withdrawn</targetReference>
            </connector>
            <label>Job is active</label>
        </rules>
        <rules>
            <name>Job_is_not_active</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>job.Community_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Published</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Withdraw_Process</targetReference>
            </connector>
            <label>Job is not active</label>
        </rules>
    </decisions>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>Today()</expression>
    </formulas>
    <interviewLabel>Withdraw Accreditation Application {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Withdraw Accreditation Application</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Extract_Accreditation_Application</name>
        <label>Extract Accreditation Application</label>
        <locationX>196</locationX>
        <locationY>101</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Extract_Job_records</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>TR1__Application__c</object>
        <outputReference>application</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>TR1__Job__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Extract_Job_records</name>
        <label>Extract Job records</label>
        <locationX>368</locationX>
        <locationY>51</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Application_Deadline</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>application.TR1__Job__c</elementReference>
            </value>
        </filters>
        <object>TR1__Job__c</object>
        <outputReference>job</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Community_Status__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Update_status_to_withdrawn</name>
        <label>Update status to withdrawn</label>
        <locationX>583</locationX>
        <locationY>231</locationY>
        <connector>
            <targetReference>JobWithdrawConfirmationScreen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Application_status__c</field>
            <value>
                <stringValue>Withdrawn</stringValue>
            </value>
        </inputAssignments>
        <object>TR1__Application__c</object>
    </recordUpdates>
    <screens>
        <name>JobWithdrawConfirmationScreen</name>
        <label>JobWithdrawConfirmationScreen</label>
        <locationX>608</locationX>
        <locationY>465</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>WithdrawCompleteMsg</name>
            <fieldText>&lt;p&gt;Your application for this job has been successfully withdrawn.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Withdraw_Process</name>
        <label>Withdraw Process</label>
        <locationX>369</locationX>
        <locationY>467</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>UnableToWithdrawMsg</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(23, 43, 77); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, Oxygen, Ubuntu, &amp;quot;Fira Sans&amp;quot;, &amp;quot;Droid Sans&amp;quot;, &amp;quot;Helvetica Neue&amp;quot;, sans-serif; font-size: 14px; background-color: rgb(255, 255, 255);&quot;&gt;At this time you are no longer able to withdraw from this position through the platform. If you are not able to join this evaluation team, please write to School Support &amp;amp; Evaluation (accreditation@cois.org).&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <startElementReference>Extract_Accreditation_Application</startElementReference>
    <status>Active</status>
    <variables>
        <name>application</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>TR1__Application__c</objectType>
    </variables>
    <variables>
        <name>job</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <objectType>TR1__Job__c</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>StatusWithdrawn</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>Withdrawn</stringValue>
        </value>
    </variables>
</Flow>

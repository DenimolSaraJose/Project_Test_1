    <decisions>
        <name>Is_Bounced_Email</name>
        <label>Is Bounced Email</label>
        <locationX>578</locationX>
        <locationY>431</locationY>
        <defaultConnector>
            <targetReference>Is_Email_Scenario</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Bounced</defaultConnectorLabel>
        <rules>
            <name>Bounced</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact.IsEmailBounced</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Contact</targetReference>
            </connector>
            <label>Bounced</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Email_Scenario</name>
        <label>Is Email Scenario</label>
        <locationX>578</locationX>
        <locationY>779</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Send_Received</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EventApi__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Waiting</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Contact__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Waitlist_Received</targetReference>
            </connector>
            <label>Send Received</label>
        </rules>
        <rules>
            <name>Send_Invite</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EventApi__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Notified</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Contact__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Waitlist_Invitation</targetReference>
            </connector>
            <label>Send Invite</label>
        </rules>
    </decisions>
    <description>Fault path with Error Email
Bounced Email correction</description>
    <environments>Default</environments>
    <interviewLabel>Fonteva Waitlist Email Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fonteva Waitlist Email Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>

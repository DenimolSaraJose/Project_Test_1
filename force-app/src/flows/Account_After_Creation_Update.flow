<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>BypassAccreditationTriggerHandler</name>
        <label>Bypass &apos;AccreditationTriggerHandler&apos;</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <actionName>TriggerHandlerInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>UpdateAccreditationRecords</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>handlerName</name>
            <value>
                <stringValue>AccreditationTriggerHandler</stringValue>
            </value>
        </inputParameters>
        <nameSegment>TriggerHandlerInvocable</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>IsAccountNameChanged</name>
        <label>Account Name changed?</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountNameChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Name</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>BypassAccreditationTriggerHandler</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>forAccreditationName</name>
        <dataType>String</dataType>
        <expression>IF (LEN({!$Record.Name}) + 18 &gt; 80, &apos;Accreditation for &apos; + TRIM(LEFT({!$Record.Name}, 59)) + &apos;...&apos;, 
&apos;Accreditation for &apos; + {!$Record.Name}
)</expression>
    </formulas>
    <interviewLabel>Account After Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account After Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <description>Update the Accreditation Name according to the updated Account Name. It uses the VRBypassDateTime field to bypass the validation rule; otherwise Accreditation record names cannot be changed.</description>
        <name>UpdateAccreditationRecords</name>
        <label>Update Accreditation record(s)</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>forAccreditationName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ValidationBypassDateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Accreditations__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsAccountNameChanged</targetReference>
        </connector>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Create Billing Contract for Membership.</description>
        <name>Create_Billing_Contract</name>
        <label>Create Billing Contract</label>
        <locationX>50</locationX>
        <locationY>1139</locationY>
        <actionName>MembershipInvocable</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>IsAccountSchool</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>billingContractType</name>
            <value>
                <stringValue>Annual Membership Fee</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>membership</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputParameters>
        <nameSegment>MembershipInvocable</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Email_Alert_Application_Review</name>
        <label>Email Alert Application Review</label>
        <locationX>204</locationX>
        <locationY>731</locationY>
        <actionName>Membership__c.CIS_Membership_Application_Review_Assignee</actionName>
        <actionType>emailAlert</actionType>
        <connector>
            <targetReference>IsStatusActive</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Membership__c.CIS_Membership_Application_Review_Assignee</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <description>Gets the most recent membership record based, active or based on the record with the most recent status update.</description>
        <name>Get_Most_Recent_Membership</name>
        <label>Get Most Recent Membership</label>
        <locationX>204</locationX>
        <locationY>431</locationY>
        <actionName>MembershipSelector</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>IsAssigneeChanged</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>accountId</name>
            <value>
                <elementReference>$Record.Account_Name__c</elementReference>
            </value>
        </inputParameters>
        <nameSegment>MembershipSelector</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>IsAccountBadge</name>
        <label>Account Badge?</label>
        <locationX>182</locationX>
        <locationY>2147</locationY>
        <defaultConnector>
            <targetReference>IsMostRecentMembership2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountBadgeTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_Badge</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Delete_Account_Badge</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccountLookupEmpty</name>
        <label>Account ID empty?</label>
        <locationX>336</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>IsAssigneeChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountLookupEmptyFALSE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Name__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Most_Recent_Membership</targetReference>
            </connector>
            <label>False</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccountSchool</name>
        <label>Account is a School?</label>
        <locationX>182</locationX>
        <locationY>1331</locationY>
        <defaultConnector>
            <targetReference>Check_Badge</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccountSchoolTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsSchool</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Accreditation</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Only applies to most recent Membership record.</description>
        <name>IsAssigneeChanged</name>
        <label>Assignee has changed?</label>
        <locationX>336</locationX>
        <locationY>623</locationY>
        <defaultConnector>
            <targetReference>IsStatusActive</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAssigneeChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Assignee__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsMostRecentMembership</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Alert_Application_Review</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsFeeAgreement</name>
        <label>Fee Agreement?</label>
        <locationX>182</locationX>
        <locationY>1031</locationY>
        <defaultConnector>
            <targetReference>IsAccountSchool</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsFeeAgreementTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Fee_Agreement__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Default</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Billing_Contract</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsMostRecentMembership2</name>
        <label>Most Recent Membership?</label>
        <locationX>336</locationX>
        <locationY>2531</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsMostRecentMembership2TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsMostRecentMembership</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Aggregate_Result</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Membership Status changed to &apos;Active&apos;. Only applies to updates.</description>
        <name>IsStatusActive</name>
        <label>Update Status to Active?</label>
        <locationX>336</locationX>
        <locationY>923</locationY>
        <defaultConnector>
            <targetReference>IsStatusWithdrawn</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsStatusActiveTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsFeeAgreement</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Membership Status changed to &apos;Membership Withdrawn by CIS&apos; or &apos;Membership Withdrawn by Member&apos;. Only applies to updates.</description>
        <name>IsStatusWithdrawn</name>
        <label>Update Status to Withdrawn?</label>
        <locationX>336</locationX>
        <locationY>1823</locationY>
        <defaultConnector>
            <targetReference>IsMostRecentMembership2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsStatusWithdrawnTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <stringValue>Membership Withdrawn</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Membership_Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNewRecord</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Accreditation</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>IsMostRecentMembership</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record.Id} = {!Get_Most_Recent_Membership.membership.Id}</expression>
    </formulas>
    <formulas>
        <name>IsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>{!$Record__Prior.Id} = NULL</expression>
    </formulas>
    <formulas>
        <name>IsSchool</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.Account_Name__r.RecordType.DeveloperName} = &apos;School&apos;, true, false)</expression>
    </formulas>
    <formulas>
        <name>originalMembershipStartDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISNULL({!$Record.Account_Name__r.Aggregate_Result__r.Original_Membership_Start_Date__c}), 
{!$Record.Status_to_Active__c}, 
{!$Record.Account_Name__r.Aggregate_Result__r.Original_Membership_Start_Date__c}
)</expression>
    </formulas>
    <interviewLabel>Membership After Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Membership After Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Delete_Account_Badge</name>
        <label>Delete Account Badge</label>
        <locationX>50</locationX>
        <locationY>2255</locationY>
        <connector>
            <targetReference>IsMostRecentMembership2</targetReference>
        </connector>
        <inputReference>Get_Account_Badge</inputReference>
    </recordDeletes>
    <recordLookups>
        <name>Get_Account_Badge</name>
        <label>Get Account Badge</label>
        <locationX>182</locationX>
        <locationY>2039</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsAccountBadge</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account_Name__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>OrderApi__Is_Active__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OrderApi__Badge__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Updates the Accreditation record, set it&apos;s status to Closed.</description>
        <name>Update_Accreditation</name>
        <label>Update Accreditation</label>
        <locationX>182</locationX>
        <locationY>1931</locationY>
        <connector>
            <targetReference>Get_Account_Badge</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3)</filterLogic>
        <filters>
            <field>OriginatingMembership__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Prospect</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Not Required</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ValidationBypassDateTime__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <object>Accreditation__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Aggregate_Result</name>
        <label>Update Aggregate Result</label>
        <locationX>204</locationX>
        <locationY>2639</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account_Name__r.Aggregate_Result__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Membership_Rejoin_Date__c</field>
            <value>
                <elementReference>$Record.Membership_Rejoin_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Renewal_Date__c</field>
            <value>
                <elementReference>$Record.Membership_Renewal_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Status__c</field>
            <value>
                <elementReference>$Record.Membership_Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Membership_Withdrawal_Date__c</field>
            <value>
                <elementReference>$Record.Membership_Withdrawal_Date__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Original_Membership_Start_Date__c</field>
            <value>
                <elementReference>originalMembershipStartDate</elementReference>
            </value>
        </inputAssignments>
        <object>AggregateResult__c</object>
    </recordUpdates>
    <start>
        <locationX>210</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsAccountLookupEmpty</targetReference>
        </connector>
        <object>Membership__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Checks and creates badge when applicable.</description>
        <name>Check_Badge</name>
        <label>Check Badge</label>
        <locationX>182</locationX>
        <locationY>1631</locationY>
        <connector>
            <targetReference>IsStatusWithdrawn</targetReference>
        </connector>
        <flowName>Create_Badge</flowName>
        <inputAssignments>
            <name>varAccountId</name>
            <value>
                <elementReference>$Record.Account_Name__c</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <subflows>
        <description>Create Accreditation based on Membership record.</description>
        <name>Create_Accreditation</name>
        <label>Create Accreditation</label>
        <locationX>50</locationX>
        <locationY>1439</locationY>
        <connector>
            <targetReference>Check_Badge</targetReference>
        </connector>
        <flowName>Create_Accreditation</flowName>
        <inputAssignments>
            <name>varMembership</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>varMostRecentMembership</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <objectType>Membership__c</objectType>
    </variables>
</Flow>

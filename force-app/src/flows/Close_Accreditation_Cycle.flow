    <decisions>
        <name>IsCloseAccreditationCycle</name>
        <label>Close Accreditation Cycle?</label>
        <locationX>1128</locationX>
        <locationY>1646</locationY>
        <defaultConnector>
            <targetReference>IsNewOutcomeRegistered</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsCloseAccreditationCycleTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccreditationCycleEligibleForClosure</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsNewAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNewAccreditationCycle</name>
        <label>New Accreditation Cycle?</label>
        <locationX>446</locationX>
        <locationY>1754</locationY>
        <defaultConnector>
            <targetReference>IsPlannedAccreditationCycleChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNewAccreditationCycleTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsPlannedAccreditationCycle</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNewOutcomeRegistered</name>
        <label>New Outcome Registered?</label>
        <locationX>1128</locationX>
        <locationY>3050</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNewOutcomeRegisteredTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccreditationOutcome.CreatedDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>CreateAccreditationOutcome</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsPlannedAccreditationCycleChanged</name>
        <label>Planned Accreditation Cycle Changed?</label>
        <locationX>842</locationX>
        <locationY>1862</locationY>
        <defaultConnector>
            <targetReference>BypassAccreditationCycleTriggerHandler</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsPlannedAccreditationCycleChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>SemesterStartDate</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>varSemesterDefault</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateNextAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>

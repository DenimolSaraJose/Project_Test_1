                <fields>
                    <name>txtNewAccreditationCycle</name>
                    <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;New Accreditation Cycle&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Schedule a new Accreditation Cycle for {!Get_Accreditation_Cycle.AccountName__c}. Likely the new Accreditation Cycle will start in semester {!Get_Accreditation_Cycle.SemesterNextCycle__c}. Please confirm or adjust the semester and select the applicable track for the next Accreditation Cycle. Submitting will &lt;u&gt;close&lt;/u&gt; the current Accreditation Cycle &apos;{!Get_Accreditation_Cycle.Name}&apos; and create a new one based on the values entered.&lt;/p&gt;</fieldText>
                    <fieldType>DisplayText</fieldType>
                    <styleProperties>
                        <verticalAlignment>
                            <stringValue>top</stringValue>
                        </verticalAlignment>
                        <width>
                            <stringValue>12</stringValue>
                        </width>
                    </styleProperties>
                    <visibilityRule>
                        <conditionLogic>1 AND 2 AND (3 OR 4)</conditionLogic>
                        <conditions>
                            <leftValueReference>varAccreditationCycleEligibleForClosure</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>true</booleanValue>
                            </rightValue>
                        </conditions>
                        <conditions>
                            <leftValueReference>IsPlannedAccreditationCycle</leftValueReference>
                            <operator>EqualTo</operator>
                            <rightValue>
                                <booleanValue>false</booleanValue>
                            </rightValue>
                        </conditions>
                        <conditions>
                            <leftValueReference>varAccreditationOutcome.Result__c</leftValueReference>
                            <operator>StartsWith</operator>
                            <rightValue>
                                <stringValue>A.</stringValue>
                            </rightValue>
                        </conditions>
                        <conditions>
                            <leftValueReference>varAccreditationOutcome.Result__c</leftValueReference>
                            <operator>StartsWith</operator>
                            <rightValue>
                                <stringValue>B.</stringValue>
                            </rightValue>
                        </conditions>
                    </visibilityRule>
                </fields>
                <fields>
                    <name>txtPlannedAccreditationCycle</name>
                    <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Planned Accreditation Cycle found&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: 12px; color: rgb(47, 47, 47);&quot;&gt;T&lt;/span&gt;&lt;span style=&quot;font-size: 12px; color: rgb(47, 47, 47); background-color: rgb(255, 255, 255);&quot;&gt;he next Accreditation Cycle was already created, however it is possible to adjust the semester. Submitting will also &lt;/span&gt;&lt;u style=&quot;font-size: 12px; color: rgb(47, 47, 47); background-color: rgb(255, 255, 255);&quot;&gt;close&lt;/u&gt;&lt;span style=&quot;font-size: 12px; color: rgb(47, 47, 47); background-color: rgb(255, 255, 255);&quot;&gt; the current Accreditation Cycle.&lt;/span&gt;&lt;/p&gt;</fieldText>

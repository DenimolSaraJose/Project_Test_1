    <environments>Default</environments>
    <formulas>
        <description>Close Accreditation Cycle once outcome &apos;A&apos; or &apos;B&apos; and new cycle values are submitted.</description>
        <name>IsCloseCycleAndCreateNew</name>
        <dataType>Boolean</dataType>
        <expression>true</expression>
    </formulas>
    <formulas>
        <description>Close Accreditation Cycle once outcome &apos;C&apos; or &apos;D&apos; is submitted.</description>
        <name>IsCloseCycleOnly</name>
        <dataType>Boolean</dataType>
        <expression>(
  CONTAINS(LEFT(TEXT({!varAccreditationOutcome.Result__c}), 1), &apos;C&apos;) ||
  CONTAINS(LEFT(TEXT({!varAccreditationOutcome.Result__c}), 1), &apos;D&apos;)
)</expression>
    </formulas>
    <formulas>
        <name>IsPlannedAccreditationCycle</name>
        <dataType>Boolean</dataType>
        <expression>IF({!GetPlannedAccreditationCycle.Id} != NULL, true, false)</expression>
    </formulas>
    <formulas>
        <name>txtAccreditationStagesHeader</name>
        <dataType>String</dataType>
        <expression>IF( {!nStages} = {!Get_Accreditation_Cycle.nCompletedStages__c}, &apos;All Accreditation Stages have been completed, this Accreditation Cycle can be closed.&apos;, &apos;This Accreditation Cycle cannot be closed because not all related Accreditation Stages are marked as &quot;Completed&quot;. Please review the following Accreditation Stages:&apos; )</expression>
    </formulas>
    <formulas>
        <description>Label displayed next to toggle for closing the current Accreditation Cycle.</description>
        <name>txtCloseAccreditationCycle</name>
        <dataType>String</dataType>
        <expression>&quot;Close &quot; + {!Get_Accreditation_Cycle.Name}</expression>
    </formulas>
    <formulas>
        <description>Indicates if a Accreditation Cycle is eligible for closure; based on completed and/or cancelled stages.</description>
        <name>varAccreditationCycleEligibleForClosure</name>
        <dataType>Boolean</dataType>
        <expression>!{!Get_Accreditation_Cycle.IsClosed__c} &amp;&amp; 
{!nStages} = ({!Get_Accreditation_Cycle.nCompletedStages__c} + {!Get_Accreditation_Cycle.nCancelledStages__c}) &amp;&amp; {!Get_Accreditation_Cycle.IsCompleted__c}</expression>
    </formulas>
    <formulas>
        <name>varAccreditationOutcomeName</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR(TODAY())) + LPAD(TEXT(MONTH(TODAY())), 2,&apos;0&apos;) + LPAD(TEXT(DAY(TODAY())), 2,&apos;0&apos;) + &apos;__&apos; + {!Get_Accreditation_Cycle.Name} + &apos;_Outcome&apos;</expression>
    </formulas>
    <formulas>
        <name>varAccreditationTrackDefault</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!GetPlannedAccreditationCycle.AccreditationTrack__c}, {!GetDefaultAccreditationTrack.Id})</expression>
    </formulas>
    <formulas>
        <name>varNextAccreditationCycleCurrentIACFullName</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!GetNextAccreditationCycle.CurrentIAC__c}, &apos;N/A&apos;)</expression>
    </formulas>
    <formulas>
        <description>Default value for the consecutive Accreditation Cycle, it adds 18 months to the completed date of the current Accreditation Cycle.</description>
        <name>varNextAccreditationCycleStartDateDefault</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!Get_Accreditation_Cycle.CompletedDate__c},18)</expression>
    </formulas>
    <formulas>
        <name>varNextAccreditationCycleUrl</name>
        <dataType>String</dataType>
        <expression>{!GetUrls.orgDomainUrl} + &apos;/&apos; + {!NextAccreditationCycle.recordId}</expression>
    </formulas>
    <formulas>
        <name>varSemesterDefault</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE(DATE(YEAR({!GetPlannedAccreditationCycle.StartDate__c}), MONTH({!GetPlannedAccreditationCycle.StartDate__c}), 1), ADDMONTHS(DATE(YEAR({!Get_Accreditation_Cycle.CompletedDate__c}), MONTH({!Get_Accreditation_Cycle.CompletedDate__c}), 1), 18))</expression>
    </formulas>
    <interviewLabel>Close Accreditation Cycle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Close Accreditation Cycle</label>

    <decisions>
        <description>Route A has a different update in comparrison to when different a different route is selected</description>
        <name>Application_Route_Check</name>
        <label>Application Route Check</label>
        <locationX>941</locationX>
        <locationY>2003</locationY>
        <defaultConnector>
            <targetReference>Supporting_Documents_Schools_Updated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Routes</defaultConnectorLabel>
        <rules>
            <name>Route_A_Fast_Track</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_Route__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Route A</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>External_Accreditation_Report_Status_Updated</targetReference>
            </connector>
            <label>Route A (Fast Track)</label>
        </rules>
    </decisions>
    <decisions>
        <description>Are all supporting documents complete or complete with remark?</description>
        <name>Complete_or_Complete_with_Remark</name>

    <decisions>
        <name>External_Accreditation_Report_Status_Updated</name>
        <label>External Accreditation Report Status Updated</label>
        <locationX>446</locationX>
        <locationY>2111</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>All_accepted</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>FormulaExternalAccreditationReportStatusChanged</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.External_Accreditation_Report_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.External_Accreditation_Report_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted with Remark</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Application_Status_to_Complete_1</targetReference>
            </connector>
            <label>All accepted</label>
        </rules>
        <rules>
            <name>In_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>FormulaFastTrackInProgress</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Application_Status_into_In_Progress</targetReference>
            </connector>
            <label>In Progress</label>
        </rules>
    </decisions>

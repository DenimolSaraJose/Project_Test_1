    <description>The VAT Registration Number is populated by VAT Registration Number on Account</description>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND
(
FALSE,
OR
(
(NOT(ISNULL([Account].npe01__One2OneContact__r.Id  )) )
,
(ISCHANGED([Account].npe01__One2OneContact__r.Id ))
)
,
([Account].RecordType.Name  ) = &apos;University&apos;
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>AND
(
FALSE,
OR
(
(NOT(ISNULL({!myVariable_current.npe01__One2OneContact__r.Id}  )) )
,
(ISCHANGED({!myVariable_current.npe01__One2OneContact__r.Id} ))
)
,
({!myVariable_current.RecordType.Name}  ) = &apos;University&apos;
)</expression>
    </formulas>

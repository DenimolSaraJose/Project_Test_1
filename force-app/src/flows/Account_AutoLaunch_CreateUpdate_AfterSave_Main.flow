    <decisions>
        <name>Tax_Status</name>
        <label>Tax Status</label>
        <locationX>710</locationX>
        <locationY>839</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>NL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ShippingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TS_Home</targetReference>
            </connector>
            <label>NL</label>
        </rules>
        <rules>
            <name>Export</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ShippingCountry</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Find_EU_Countries.Label</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TS_Export</targetReference>
            </connector>
            <label>Export</label>
        </rules>
        <rules>
            <name>EC_Registered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_EU_Countries.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAT_Registration_Number</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_EU_Countries.Label</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Greece</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TS_EC_Registered</targetReference>
            </connector>
            <label>EC Registered</label>
        </rules>
        <rules>
            <name>EU_Non_Registered</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_EU_Countries.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAT_Registration_Number</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TS_EC_Non_Registered</targetReference>
            </connector>
            <label>EU Non-Registered</label>
        </rules>
        <rules>
            <name>EC_Registered_Greece</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_EU_Countries.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>VAT_Registration_Number</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Find_EU_Countries.Label</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Greece</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>TS_EC_Registered_Greece</targetReference>
            </connector>
            <label>EC Registered - Greece</label>
        </rules>
    </decisions>
    <decisions>
        <description>Is the Record a University?</description>
        <name>University_or_School</name>
        <label>University or School</label>
        <locationX>710</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>University</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>University</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>University_fields</targetReference>
            </connector>
            <label>University</label>
        </rules>
        <rules>
            <name>School</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>School</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Supporting_Member</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CIS_Affiliated_Consultants</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Schools</targetReference>
            </connector>
            <label>School</label>
        </rules>
    </decisions>
    <description>Flow Clean Up</description>
    <environments>Default</environments>
    <formulas>
        <name>VAT_Registration_Number</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!$Record.CIS_ALL_VAT_Registration_Number__c})</expression>
    </formulas>
    <interviewLabel>Account_AutoLaunch_CreateUpdate_AfterSave_Main {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account_AutoLaunch_CreateUpdate_AfterSave_Main</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_EU_Countries</name>
        <label>Find EU Countries</label>
        <locationX>710</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>University_or_School</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ShippingCountry</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>European_Union__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetDimension3</name>
        <label>GetDimension3</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Find_EU_Countries</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.ShippingCity</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>c2g__codaDimension3__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update</name>
        <label>Update</label>
        <locationX>710</locationX>
        <locationY>1139</locationY>
        <inputReference>recAccount</inputReference>
    </recordUpdates>
    <start>
        <locationX>584</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetDimension3</targetReference>
        </connector>
        <filterFormula>!{!$Setup.Org_Exceptions__c.BypassAccountLightningFlow__c}</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>

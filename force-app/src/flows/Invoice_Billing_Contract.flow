<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Record_Id_to_Collection</name>
        <label>Add Record Id to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>eligibleRecordIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Billing_Contract.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Billing_Contract.link_CliC2g_State__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Processing</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Billing_Contract.link_CliC2g_Errors__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Billing_Contract</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Record_Ids_to_Collection</name>
        <label>Add Record Id&apos;s to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>eligibleRecordIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Billing_Contracts.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Billing_Contracts.link_CliC2g_State__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Processing</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Loop_Billing_Contracts.link_CliC2g_Errors__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Billing_Contracts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Eligible_Record_Ids</name>
        <label>Count Eligible Record Id&apos;s</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>eligibleRecordIdsCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>eligibleRecordIds</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>scrAction</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Provided_Record_Id</name>
        <label>Count Provided Record Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>providedRecordIdsCount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Billing_Contract</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Count_Provided_Record_Ids</name>
        <label>Count Provided Record Id&apos;s</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>providedRecordIdsCount</assignToReference>
            <operator>AssignCount</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsLimitExceeded</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>IsBillingContractEligible</name>
        <label>Billing Contract Eligible?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Count_Eligible_Record_Ids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsBillingContractEligibleTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Billing_Contract.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Record_Id_to_Collection</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>The total number of provided Billing Contracts must be less or equal to 10.</description>
        <name>IsLimitExceeded</name>
        <label>Limit Exceeded?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Billing_Contracts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsLimitExceededTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>providedRecordIdsCount</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>scrAction</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsSingleRecord</name>
        <label>Single Record?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Count_Provided_Record_Ids</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>False</defaultConnectorLabel>
        <rules>
            <name>IsSingleRecordTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ids</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>recordId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Count_Provided_Record_Id</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>forEligibleForProcessing</name>
        <dataType>Boolean</dataType>
        <expression>IF(
!{!Get_Billing_Contract.Sales_Invoice_Created2__c} &amp;&amp; !ISBLANK({!Get_Billing_Contract.Invoice_Date__c}
), TRUE, FALSE)</expression>
    </formulas>
    <interviewLabel>Invoice Billing Contract {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Invoice Billing Contract</label>
    <loops>
        <name>Loop_Billing_Contracts</name>
        <label>Loop Billing Contracts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Billing_Contracts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Record_Ids_to_Collection</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Count_Eligible_Record_Ids</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Billing_Contract</name>
        <label>Get Billing Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsBillingContractEligible</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5) AND 6 AND 7 AND 8 AND 9</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Invoice_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Sales_Invoice_Created2__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>link_CliC2g_State__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>link_CliC2g_State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <filters>
            <field>Accounting_Currency__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Company__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Number_of_contract_lines__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Billing_Contract__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Billing_Contracts</name>
        <label>Get Billing Contracts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Billing_Contracts</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND 3 AND (4 OR 5) AND 6</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>ids</elementReference>
            </value>
        </filters>
        <filters>
            <field>Invoice_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>Sales_Invoice_Created2__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>link_CliC2g_State__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>link_CliC2g_State__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Error</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Billing_Contract__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Billing_Contract</name>
        <label>Update Billing Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Count_Eligible_Record_Ids</targetReference>
        </connector>
        <inputReference>Get_Billing_Contract</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Billing_Contracts</name>
        <label>Update Billing Contracts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_Billing_Contracts</targetReference>
        </connector>
        <inputReference>Get_Billing_Contracts</inputReference>
    </recordUpdates>
    <screens>
        <name>scrAction</name>
        <label>Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actions>
            <name>Publish_BillingContractToInvoice_Messages</name>
            <actionName>Publish_BillingContractToInvoice_Messages</actionName>
            <actionType>flow</actionType>
            <inputParameters>
                <name>ids</name>
                <value>
                    <elementReference>eligibleRecordIds</elementReference>
                </value>
            </inputParameters>
            <label>Publish BillingContractToInvoice Messages</label>
            <nameSegment>Publish_BillingContractToInvoice_Messages</nameSegment>
        </actions>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>txtProcessing</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Processing&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;A &apos;BillingContractToInvoice&apos; message is published for each eligible Billing Contract under the following conditions:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;em&gt;The Status is &apos;Active&apos;.&lt;/em&gt;&lt;/li&gt;&lt;li&gt;&lt;em&gt;The Sales Invoice lookup is blank.&lt;/em&gt;&lt;/li&gt;&lt;li&gt;&lt;em&gt;The Invoice Date is on or before today&apos;s date.&lt;/em&gt;&lt;/li&gt;&lt;li&gt;&lt;em&gt;The Processing State is either blank or marked as &apos;Error&apos;.&lt;/em&gt;&lt;/li&gt;&lt;li&gt;&lt;em&gt;The Accounting Company and Accounting Currency are set.&lt;/em&gt;&lt;/li&gt;&lt;li&gt;&lt;em&gt;The Billing Contract has at least one Billing Contract Line.&lt;/em&gt;&lt;/li&gt;&lt;/ul&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>eligibleRecordIdsCount</leftValueReference>
                    <operator>GreaterThanOrEqualTo</operator>
                    <rightValue>
                        <numberValue>0.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>eligibleRecordIdsCount</leftValueReference>
                    <operator>LessThanOrEqualTo</operator>
                    <rightValue>
                        <numberValue>10.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>txtOverProcessingLimit</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;color: rgb(209, 15, 14); font-size: 14px;&quot;&gt;Limit reached...&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(209, 15, 14);&quot;&gt;Over 10 Billing Contracts have been selected for processing. This wizard has a maximum record limit of 10, n&lt;/span&gt;&lt;span style=&quot;color: rgb(209, 15, 14); background-color: rgb(255, 255, 255);&quot;&gt;one of the provided Billing Contracts will be processed&lt;/span&gt;&lt;span style=&quot;color: rgb(209, 15, 14);&quot;&gt;. The &apos;BillingContractToInvoiceBatch&apos;, which runs every three hours, will automatically pick up the eligible Billing Contracts and generate the invoices.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>eligibleRecordIdsCount</leftValueReference>
                    <operator>GreaterThan</operator>
                    <rightValue>
                        <numberValue>10.0</numberValue>
                    </rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>nRecordsProvided</name>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>  {!providedRecordIdsCount}</stringValue>
            </defaultValue>
            <fieldText># Billing Contracts provided</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isDisabled>
                <booleanValue>true</booleanValue>
            </isDisabled>
            <isReadOnly>
                <booleanValue>true</booleanValue>
            </isReadOnly>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>nRecordsEligible</name>
            <dataType>String</dataType>
            <defaultValue>
                <stringValue>  {!eligibleRecordIdsCount}</stringValue>
            </defaultValue>
            <fieldText># Eligible Billing Contracts</fieldText>
            <fieldType>InputField</fieldType>
            <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
            <isDisabled>
                <booleanValue>true</booleanValue>
            </isDisabled>
            <isReadOnly>
                <booleanValue>true</booleanValue>
            </isReadOnly>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <fields>
            <name>txtClose</name>
            <fieldText>&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The eligible Billing Contract(s) will be automatically updated with a Sales Invoice once Certinia successfully processes the messages. Any issues that arise will also be reflected on the Billing Contract(s). If you need assistance, please reach out to IT support.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;You can now close this wizard.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <helpText>&lt;p&gt;This wizard streamlines the invoicing process by handling Billing Contracts through Certinia&apos;s messaging system. For each eligible Billing Contract, a &apos;BillingContractToInvoice&apos; message is generated. The wizard accommodates both individual record and bulk processing, with a maximum limit of 10 records.&lt;/p&gt;</helpText>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <triggers>
            <eventName>flow__screeninit</eventName>
            <eventSource>scrAction</eventSource>
            <handlers>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>eligibleRecordIdsCount</leftValueReference>
                    <operator>GreaterThanOrEqualTo</operator>
                    <rightValue>
                        <numberValue>1.0</numberValue>
                    </rightValue>
                </conditions>
                <conditions>
                    <leftValueReference>eligibleRecordIdsCount</leftValueReference>
                    <operator>LessThanOrEqualTo</operator>
                    <rightValue>
                        <numberValue>50.0</numberValue>
                    </rightValue>
                </conditions>
                <initBehavior>onload</initBehavior>
                <screenActionName>Publish_BillingContractToInvoice_Messages</screenActionName>
            </handlers>
        </triggers>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsSingleRecord</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>eligibleRecordIds</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>eligibleRecordIdsCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>ids</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>providedRecordIdsCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

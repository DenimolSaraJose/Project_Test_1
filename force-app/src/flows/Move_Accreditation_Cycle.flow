<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Get_Semesters</name>
        <label>Get Semesters</label>
        <locationX>314</locationX>
        <locationY>542</locationY>
        <actionName>FlowGetSemesters</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Move_Accreditation_Cycle</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>thresholdDate</name>
            <value>
                <elementReference>varEarliestStartDate</elementReference>
            </value>
        </inputParameters>
        <nameSegment>FlowGetSemesters</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>61.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>IsAccreditationCycleEligible</name>
        <label>Accreditation Cycle Eligible?</label>
        <locationX>314</locationX>
        <locationY>758</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationCycleEligibleTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsAccreditationCycleEligible</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsPreviousAccreditationCycleSet</name>
        <label>Previous Accreditation Cycle Set?</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Get_Semesters</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsPreviousAccreditationCycleSetTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAccreditationCycle.PreviousAccreditationCycle__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetPreviousAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>SemesterCollectionChoiceSet</name>
        <collectionReference>Get_Semesters.semesters</collectionReference>
        <dataType>Date</dataType>
        <displayField>label</displayField>
        <object xsi:nil="true"/>
        <valueField>monthStart</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <description>The earliest Start Date while moving the Accreditation Cycle, it is used as a threshold for the Get Semesters -invocable method.</description>
        <name>varEarliestStartDate</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(ADDMONTHS(BLANKVALUE({!varPreviousAccreditationCycle.CompletedDate__c}, {!varPreviousAccreditationCycle.EstimatedCompletionDate__c}),1)),MONTH(ADDMONTHS(BLANKVALUE({!varPreviousAccreditationCycle.CompletedDate__c}, {!varPreviousAccreditationCycle.EstimatedCompletionDate__c}),1)),1)</expression>
    </formulas>
    <formulas>
        <name>varIsAccreditationCycleEligible</name>
        <dataType>Boolean</dataType>
        <expression>!ISBLANK({!GetAccreditationCycle.Name})</expression>
    </formulas>
    <formulas>
        <description>Default value for the Semester picklist, using months.</description>
        <name>varSemesterDefault</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!varEarliestStartDate},
IF(DAY({!$Flow.CurrentDate}) &lt;= 15,
DATE(
YEAR(ADDMONTHS({!$Flow.CurrentDate},1)),
MONTH(ADDMONTHS({!$Flow.CurrentDate},1)),
1
),
DATE(
YEAR(ADDMONTHS({!$Flow.CurrentDate},2)),
MONTH(ADDMONTHS({!$Flow.CurrentDate},2)),
1
)
)
)</expression>
    </formulas>
    <interviewLabel>Move Accreditation Cycle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Move Accreditation Cycle</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <description>Retrieve Accreditation Cycle from Salesforce database.</description>
        <name>GetAccreditationCycle</name>
        <label>Get Accreditation Cycle</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsPreviousAccreditationCycleSet</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Planned</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>AccreditationCycle__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GetPreviousAccreditationCycle</name>
        <label>Get Previous Accreditation Cycle</label>
        <locationX>182</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Semesters</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetAccreditationCycle.PreviousAccreditationCycle__c</elementReference>
            </value>
        </filters>
        <object>AccreditationCycle__c</object>
        <outputReference>varPreviousAccreditationCycle</outputReference>
        <queriedFields>Name</queriedFields>
        <queriedFields>StartDate__c</queriedFields>
        <queriedFields>EstimatedCompletionDate__c</queriedFields>
        <queriedFields>CompletedDate__c</queriedFields>
        <queriedFields>SemesterNextCycle__c</queriedFields>
        <queriedFields>NextAccreditationCycle__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>UpdateAccreditationCycle</name>
        <label>Update Accreditation Cycle</label>
        <locationX>50</locationX>
        <locationY>866</locationY>
        <faultConnector>
            <targetReference>Fault_Message</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>StartDate__c</field>
            <value>
                <elementReference>SemesterStartDate</elementReference>
            </value>
        </inputAssignments>
        <object>AccreditationCycle__c</object>
    </recordUpdates>
    <screens>
        <name>Fault_Message</name>
        <label>Display Error</label>
        <locationX>314</locationX>
        <locationY>974</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>FaultMessage</name>
            <fieldText>&lt;p&gt;&lt;span style=&quot;color: rgb(219, 16, 17);&quot;&gt;{!$Flow.FaultMessage}&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>

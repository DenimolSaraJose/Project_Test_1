    <collectionProcessors>
        <description>Exclude Accreditation Cycle Stages with status &apos;Planned&apos;</description>
        <name>Filter_Cycle_Stages</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Cycle Stages</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <assignNextValueToReference>currentItem_Filter_Cycle_Stages</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>Get_Accreditation_Cycle_Stages</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Cycle_Stages.Status__c</leftValueReference>
            <operator>NotEqualTo</operator>
            <rightValue>
                <stringValue>Planned</stringValue>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Variable_Assignments1</targetReference>
        </connector>
    </collectionProcessors>
    <description>TTP Changes</description>
    <dynamicChoiceSets>
        <name>choiceSetAccreditationTracks</name>
        <dataType>String</dataType>
        <displayField>Name</displayField>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Get_Accreditation_Cycle.AccreditationTrack__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsActive__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>AccreditationTrack__c</object>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>txtAccreditationStagesHeader</name>
        <dataType>String</dataType>
        <expression>IF( {!nStages} = {!Get_Accreditation_Cycle.nCompletedStages__c}, &apos;All Accreditation Stages have been completed, this Accreditation Cycle can be closed.&apos;, &apos;This Accreditation Cycle cannot be closed because not all related Accreditation Stages are marked as &quot;Completed&quot;. Please review the following Accreditation Stages:&apos; )</expression>
    </formulas>
    <formulas>
        <description>Indicates if a Accreditation Cycle is eligible for updating the Accreditation Track</description>
        <name>varAccreditationCycleEligibleForUpdatingTrack</name>
        <dataType>Boolean</dataType>
        <expression>{!nStages} != {!Get_Accreditation_Cycle.nCompletedStages__c} &amp;&amp; !{!Get_Accreditation_Cycle.IsCompleted__c}</expression>
    </formulas>
    <formulas>
        <description>Default value for the consecutive Accreditation Cycle, it adds 18 months to the completed date of the current Accreditation Cycle.</description>
        <name>varNextAccreditationCycleStartDateDefault</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!Get_Accreditation_Cycle.CompletedDate__c},18)</expression>
    </formulas>

                        </value>
                    </inputParameters>
                    <inputParameters>
                        <name>marginBottom</name>
                        <value>
                            <stringValue>xx-small</stringValue>
                        </value>
                    </inputParameters>
                    <inputParameters>
                        <name>color</name>
                        <value>
                            <stringValue>#FFFFFF</stringValue>
                        </value>
                    </inputParameters>
                    <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                    <isRequired>true</isRequired>
                    <storeOutputAutomatically>true</storeOutputAutomatically>
                    <styleProperties>

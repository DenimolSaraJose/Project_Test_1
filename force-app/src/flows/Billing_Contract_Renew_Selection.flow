            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>outputEndDate</name>
        <dataType>Date</dataType>
        <expression>IF({!outputIsOverrideDates}, ADDMONTHS({!StartDate},12)-1, NULL)</expression>
    </formulas>
    <formulas>
        <description>InvoiceDate for Apex, returns a NULL value when if varIsOverrideProduct is set to FALSE.</description>
        <name>outputInvoiceDate</name>
        <dataType>Date</dataType>
        <expression>IF({!outputIsOverrideDates}, {!InvoiceDate}, NULL)</expression>
    </formulas>
    <formulas>
        <description>Product2Id for Apex, returns a NULL value when if varIsOverrideProduct is set to FALSE.</description>
        <name>outputProductId</name>
        <dataType>String</dataType>
        <expression>IF({!outputIsOverrideProduct}, {!Product2Selector.value}, NULL)</expression>
    </formulas>
    <formulas>
        <description>StartDate for Apex, returns a NULL value when if varIsOverrideProduct is set to FALSE.</description>
        <name>outputStartDate</name>
        <dataType>Date</dataType>
        <expression>IF({!outputIsOverrideDates}, {!StartDate}, NULL)</expression>
    </formulas>
    <formulas>
        <description>Avoids a NULL value in case the checkbox is hidden.</description>
        <name>OverrideDatesHelper</name>
        <dataType>Boolean</dataType>
        <expression>IF({!IsOverrideDates}, true, false)</expression>
    </formulas>
    <formulas>
        <name>Today</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE(now())</expression>
    </formulas>

        <locationX>578</locationX>
        <locationY>350</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AccreditationCycle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetSObjectTypeName.sObjectTypeName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>AccreditationCycle__c</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetAccreditationCycle</targetReference>
            </connector>
            <label>Accreditation Cycle</label>
        </rules>

<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_Attendee</name>
        <label>Assign Attendee</label>
        <locationX>50</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>varAttendeeCollection.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAttendeeCollection.Event_URL_for_Community_User__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>forCreateCommunityURL</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Attendee</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Is_Source_Invitation</name>
        <label>Is Source Invitation</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Update_Attendee</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Invitation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EventApi__Invitation_Source__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Manual Add Attendees</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Is_Invitation_Not_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EventApi__Is_Invitation_Sent__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Theme</targetReference>
            </connector>
            <label>Is Invitation</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>forCreateCommunityURL</name>
        <dataType>String</dataType>
        <expression>&apos;&apos;&amp;{!varSiteURL}&amp;&apos;/s/lt-event?attendee=&apos;&amp;{!$Record.Id}&amp;&apos;&amp;id=&apos;&amp;{!$Record.EventApi__Attendee_Event__c}&amp;&apos;&amp;site=&apos;&amp;{!varSite}&amp;&apos;&amp;theme=&apos;&amp;{!varTheme}</expression>
    </formulas>
    <formulas>
        <name>forDetermineCommunity</name>
        <dataType>String</dataType>
        <expression>IF (CONTAINS({!$Record.EventApi__Ticket_Type__r.Name},&apos;niversity&apos;), &apos;Universities&apos;,
IF (CONTAINS({!$Record.EventApi__Ticket_Type__r.Name},&apos;chool&apos;), &apos;Schools&apos;,
IF (CONTAINS({!$Record.EventApi__Ticket_Type__r.Name},&apos;ducator&apos;), &apos;Educators&apos;,
 &apos;Start&apos; 
)))</expression>
    </formulas>
    <interviewLabel>Fonteva Attendee After Creation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fonteva Attendee After Creation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Site</name>
        <label>Get Site</label>
        <locationX>50</locationX>
        <locationY>539</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Attendee</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>forDetermineCommunity</elementReference>
            </value>
        </filters>
        <object>PagesApi__Site__c</object>
        <outputAssignments>
            <assignToReference>varSite</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varSiteURL</assignToReference>
            <field>PagesApi__Site_URL__c</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Theme</name>
        <label>Get Theme</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Site</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>Contains</operator>
            <value>
                <elementReference>forDetermineCommunity</elementReference>
            </value>
        </filters>
        <object>PagesApi__Theme__c</object>
        <outputAssignments>
            <assignToReference>varTheme</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordUpdates>
        <name>Update_Attendee</name>
        <label>Update Attendee</label>
        <locationX>182</locationX>
        <locationY>839</locationY>
        <inputReference>varAttendeeCollection</inputReference>
    </recordUpdates>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Source_Invitation</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EventApi__Status__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>EventApi__Attendee__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varAttendeeCollection</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>EventApi__Attendee__c</objectType>
    </variables>
    <variables>
        <name>varSite</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varSiteURL</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varTheme</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

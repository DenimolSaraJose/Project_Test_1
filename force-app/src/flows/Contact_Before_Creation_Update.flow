<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Record_Assignments_1</name>
        <label>Record Assignments</label>
        <locationX>50</locationX>
        <locationY>719</locationY>
        <assignmentItems>
            <assignToReference>$Record.Community_Access__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CommunityAccess</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.AccountId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getAssociatedContact.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Create_Community_User__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.npe01__WorkEmail__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.npe01__Preferred_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Work</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Active_C_R_Evaluator_Candidate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>None</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.RecordTypeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>getAssociatedContact.RecordTypeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsCreateCommunityUserChanged</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Record_Assignments_2</name>
        <label>Record Assignments</label>
        <locationX>50</locationX>
        <locationY>1211</locationY>
        <assignmentItems>
            <assignToReference>$Record.Active_C_R_Evaluator_Candidate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>None</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Community_Access__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Evaluator_Role_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsClearDataChecked</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Record_Assignments_5</name>
        <label>Record Assignments</label>
        <locationX>204</locationX>
        <locationY>1595</locationY>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Appointed_CIS_School__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Appointed_Non_CIS_Institution__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Expected_Start_Date__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Expected_Work_E_mail_Address__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Stay_in_touch_with_CIS_Email__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Transitioning_School_Notes__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.SG4531304_Transitioning_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Contact_updated_Clear_data__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Owner_SF_Admin</name>
        <label>Set Owner SF Admin</label>
        <locationX>182</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>SFAdminId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsNewRecordCreatedByCommunityUser</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>SFAdminId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0050Y000000YI4aQAG</stringValue>
        </value>
    </constants>
    <decisions>
        <name>IsClearDataChecked</name>
        <label>Clear Data Checked</label>
        <locationX>336</locationX>
        <locationY>1487</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>ClearDataCheckedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_updated_Clear_data__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Contact_updated_Clear_data__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignments_5</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsCreateCommunityUserChanged</name>
        <label>Create Community User Changed?</label>
        <locationX>336</locationX>
        <locationY>995</locationY>
        <defaultConnector>
            <targetReference>IsClearDataChecked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreateCommunityUserChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Create_Community_User__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsCreateCommunityUserUnchecked</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsCreateCommunityUserUnchecked</name>
        <label>Create Community User Unchecked?</label>
        <locationX>182</locationX>
        <locationY>1103</locationY>
        <defaultConnector>
            <targetReference>IsClearDataChecked</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CreateCommunityUserUncheckedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Create_Community_User__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Assignments_2</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNewRecordCreatedByCommunityUser</name>
        <label>New Record Created By Community User?</label>
        <locationX>182</locationX>
        <locationY>503</locationY>
        <defaultConnector>
            <targetReference>IsCreateCommunityUserChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NewRecordCreatedByCommunityUserTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsCommunityUser</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getAssociatedContact</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>NewContact</name>
        <label>New Contact</label>
        <locationX>336</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>IsCreateCommunityUserChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Owner_SF_Admin</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Assign SF Admin as Owner</description>
    <environments>Default</environments>
    <formulas>
        <name>AssociatedContactId</name>
        <dataType>String</dataType>
        <expression>{!$User.ContactId}</expression>
    </formulas>
    <formulas>
        <name>CISTrained</name>
        <dataType>Boolean</dataType>
        <expression>IF({!$Record.CIS_trained__c} &gt;= 1, true, false)</expression>
    </formulas>
    <formulas>
        <name>CommunityAccess</name>
        <dataType>String</dataType>
        <expression>CASE({!getAssociatedContact.Account.RecordType.DeveloperName}, &apos;School&apos;, &apos;Schools&apos;, &apos;University&apos;, &apos;Universities&apos;, null)</expression>
    </formulas>
    <formulas>
        <name>CreatedByCommunityUser</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;CustomerSuccess&apos;) || ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;PowerCustomerSuccess&apos;) || ISPICKVAL({!$Record.CreatedBy.UserType}, &apos;CSPLitePortal&apos;)</expression>
    </formulas>
    <formulas>
        <name>IsCommunityUser</name>
        <dataType>Boolean</dataType>
        <expression>ISPICKVAL({!$User.UserType}, &apos;CustomerSuccess&apos;) || ISPICKVAL({!$User.UserType}, &apos;PowerCustomerSuccess&apos;) || ISPICKVAL({!$User.UserType}, &apos;CSPLitePortal&apos;)</expression>
    </formulas>
    <formulas>
        <name>OwnerId</name>
        <dataType>String</dataType>
        <expression>IF({!getAssociatedContact.Owner.IsActive}, {!getAssociatedContact.OwnerId}, IF({!getAssociatedContact.Account.Owner.IsActive}, {!getAssociatedContact.Account.OwnerId}, null))</expression>
    </formulas>
    <formulas>
        <name>PreferredEmail</name>
        <dataType>String</dataType>
        <expression>IF(
ISPICKVAL({!$Record.npe01__Preferred_Email__c},&quot;Personal&quot;),
IF(NOT(ISBLANK({!$Record.npe01__HomeEmail__c})), {!$Record.npe01__HomeEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__WorkEmail__c})), {!$Record.npe01__WorkEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__AlternateEmail__c})), {!$Record.npe01__AlternateEmail__c},
IF(NOT(ISBLANK({!$Record.Email})),{!$Record.Email},
NULL)))),

IF(
ISPICKVAL({!$Record.npe01__Preferred_Email__c},&quot;Work&quot;),
IF(NOT(ISBLANK({!$Record.npe01__WorkEmail__c})), {!$Record.npe01__WorkEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__HomeEmail__c})), {!$Record.npe01__HomeEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__AlternateEmail__c})), {!$Record.npe01__AlternateEmail__c},
IF(NOT(ISBLANK({!$Record.Email})),{!$Record.Email},
NULL)))),

IF(
ISPICKVAL({!$Record.npe01__Preferred_Email__c},&quot;Alternate&quot;),
IF(NOT(ISBLANK({!$Record.npe01__AlternateEmail__c})), {!$Record.npe01__AlternateEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__WorkEmail__c})), {!$Record.npe01__WorkEmail__c},
IF(NOT(ISBLANK({!$Record.npe01__HomeEmail__c})), {!$Record.npe01__HomeEmail__c},
IF(NOT(ISBLANK({!$Record.Email})),{!$Record.Email},
NULL)))),

NULL)))</expression>
    </formulas>
    <interviewLabel>Contact Before Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Before Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getAssociatedContact</name>
        <label>Get Associated Contact</label>
        <locationX>50</locationX>
        <locationY>611</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Record_Assignments_1</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>AssociatedContactId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>210</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>NewContact</targetReference>
        </connector>
        <filterFormula>!{!$Setup.Org_Exceptions__c.BypassContactLightningFlow__c}</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>

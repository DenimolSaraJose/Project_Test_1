        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Thankyou</name>
        <label>Thankyou</label>
        <locationX>974</locationX>
        <locationY>3866</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>RedirectToMyAccreditationRecord</targetReference>
        </connector>
        <fields>
            <name>Thank_you</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Thank you for completing the CIS International Accreditation registration process.&lt;/strong&gt; &lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;You will now be directed to the portal page where you can manage your school’s accreditation.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>Welcome_screen</name>
        <label>Welcome screen</label>
        <locationX>1078</locationX>
        <locationY>1622</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>IsEligibleForRegistration</targetReference>
        </connector>
        <fields>
            <name>Welcome</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;You are about to register your school for CIS International Accreditation.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;To get started, please review and update information about your school’s governance, student enrolment and campuses.&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;By completing this registration, you agree to a one-time accreditation registration fee and an annual accreditation fee. These fees are in addition to your annual membership fee.&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;https://www.cois.org/about-cis/membership-fees&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Read more about CIS fees&lt;/a&gt;.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <start>
        <locationX>952</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Urls</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>EmailToApplicant</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!Get_Contact.Full_Name__c},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Thank you for your application for CIS accreditation!&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Our colleagues will reach out to you as soon as possible with further information on the process and next steps. &lt;/p&gt;&lt;p&gt;In the meantime, feel free to explore our portal for more information about what services CIS can provide you!&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Kind regards, &lt;/p&gt;&lt;p&gt;Your CIS Team&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailToMembership</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Hello Membership team!&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;New contacts have been requested in the Accreditation Application form. Please see their details below and add them to {!varAccount.Name}.&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Head of School:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!HoSName.firstName} {!HoSName.lastName}&lt;/li&gt;&lt;li&gt;{!HoSEmail.value}&lt;/li&gt;&lt;li&gt;{!Job_CategoryHoS}&lt;/li&gt;&lt;li&gt;{!Job_Title_HoS}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Accreditation Coordinator:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!AccCo_Name.firstName} {!AccCo_Name.lastName}&lt;/li&gt;&lt;li&gt;{!AccCo_Email.value}&lt;/li&gt;&lt;li&gt;{!Job_CategoryAC}&lt;/li&gt;&lt;li&gt;{!Job_Title_AC}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;For the Campuses we have received the following information:&lt;/p&gt;&lt;p&gt;Principal:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Campus_Principal_Name.firstName} {!Campus_Principal_Name.lastName}&lt;/li&gt;&lt;li&gt;{!Campus_Principal_Email.value}&lt;/li&gt;&lt;li&gt;{!Principal_Campus_Job_Category}&lt;/li&gt;&lt;li&gt;{!Principal_Campus_Job_Title}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Accreditation Coordinator:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;{!Campus_AC.firstName} {!Campus_AC.lastName}&lt;/li&gt;&lt;li&gt;{!Campus_AC_Email.value}&lt;/li&gt;&lt;li&gt;{!AC_Campus_Job_Category}&lt;/li&gt;&lt;li&gt;{!AC_Campus_Job_Title}&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Kind regards, &lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>EmailToMET</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear MET,&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;We have received a new Accreditation Application form! View the responses below:&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;User Information&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;User: &lt;/p&gt;&lt;p&gt;User Account: &lt;/p&gt;&lt;p&gt;User Address: &lt;/p&gt;&lt;p&gt;List Other Campuses and Locations: &lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;If this location has their own accreditation coordinator please provide their name, email address and curricula or academic program below.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Name: &lt;/p&gt;&lt;p&gt;Email: &lt;/p&gt;&lt;p&gt;Curricula or Academic program: &lt;/p&gt;&lt;p&gt;Secondary Campus: &lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;If this location has their own accreditation coordinator please provide their name, email address and curricula or academic program below.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Name: &lt;/p&gt;&lt;p&gt;Email: &lt;/p&gt;&lt;p&gt;Curricula or Academic program: &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong style=&quot;font-size: 14px;&quot;&gt;Coordinator Information&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;Accreditation Coordinator Lookup:&lt;/p&gt;&lt;p&gt;Is this the current Accreditation Coordinator? &lt;/p&gt;&lt;p&gt;(If no)&lt;/p&gt;&lt;p&gt;Accreditation Coordinator - First/Given&lt;/p&gt;&lt;p&gt;Accreditation Coordinator - Last/Surname&lt;/p&gt;&lt;p&gt;Accreditation Coordinator - Position&lt;/p&gt;&lt;p&gt;Accreditation Coordinator - Email&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Head of School lookup: &lt;/p&gt;&lt;p&gt;Is the above shown Head of School your current Head of School?&lt;/p&gt;&lt;p&gt;(If no)&lt;/p&gt;&lt;p&gt;Name:&lt;/p&gt;&lt;p&gt;Email: &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Current year student enrolment: &lt;/p&gt;&lt;p&gt;Are any of the enrolled students in residential accommodation or homestay, even if there is no boarding facility at the school? &lt;/p&gt;&lt;p&gt;Youngest Enrolment Age:&lt;/p&gt;&lt;p&gt;Oldest age for leaving or graduating:&lt;/p&gt;&lt;p&gt;Student Enrolment Gender: &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Curricula &lt;/strong&gt;&lt;/p&gt;&lt;p&gt;GCE Advanced Level (A Level)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Advanced Intl Certificate of Educ (AICE)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Advanced Placement (AP)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Advanced Subsidiary Level (AS Level)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;General Cert of Secondary Edu (GCSE)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;IB Career-related Programme (CP)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;IB Diploma Programme (DP)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;IB Middle Years Programme (MYP)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;IB Primary Years Programme (PYP)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Cambridge IGCSE&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;IEYC&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Intl Middle Years Curriculum (IMYC)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;Intl Primary Curriculum (IPC)&lt;span style=&quot;background-color: rgb(255, 255, 255); color: rgb(68, 68, 68);&quot;&gt;: &lt;/span&gt;&lt;/p&gt;&lt;p&gt;LSP:&lt;/p&gt;&lt;p&gt;Montessori: &lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Will you synchronise your CIS Accreditation with one of our partner agencies?&lt;/p&gt;&lt;p&gt;Email confirmation to: &lt;/p&gt;</text>
    </textTemplates>

    <recordCreates>
        <description>Decoupling the application form here, the Campus(es) creation will be published and processed as SF Admin.</description>
        <name>Create_Accounts_via_Platform_Event</name>
        <label>6) Create Accounts via Platform Event</label>
        <locationX>842</locationX>
        <locationY>3242</locationY>
        <connector>
            <targetReference>Assign_Accreditation_To_Update</targetReference>
        </connector>
        <inputAssignments>
            <field>BypassSObjectTriggerHandler__c</field>
            <value>
                <elementReference>False</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>DMLOperation__c</field>
            <value>
                <stringValue>CREATE</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>SerializedSObject__c</field>
            <value>
                <elementReference>Serialize_Accounts.serializedSObjectString</elementReference>
            </value>
        </inputAssignments>
        <object>SerializedSObjectEvent__e</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordCreates>
        <description>Decoupling the application form here, the account record update will be published and processed as SF Admin.</description>
        <name>Update_Account_via_Platform_Event</name>
        <label>2) Update Account via Platform Event</label>
        <locationX>974</locationX>
        <locationY>2702</locationY>
        <connector>
            <targetReference>Serialize_AYF</targetReference>

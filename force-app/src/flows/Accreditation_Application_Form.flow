    <decisions>
        <name>Add_Campus_Yes_No</name>
        <label>Add Campus Yes No</label>
        <locationX>644</locationX>
        <locationY>2378</locationY>
        <defaultConnector>
            <targetReference>Page_4_Fee_confirmation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Add</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>C_plus_1</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Nr_Campus</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Campus_RecordType</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsCreateCampuses</name>
        <label>Create Campuses?</label>
        <locationX>974</locationX>
        <locationY>3026</locationY>
        <defaultConnector>
            <targetReference>Assign_Accreditation_To_Update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsCreateCampusesTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCampusAccountCollection</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Serialize_Accounts</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsEligibleForRegistration</name>
        <label>Eligible For Registration?</label>
        <locationX>1078</locationX>
        <locationY>1730</locationY>
        <defaultConnector>
            <targetReference>Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsEligibleForRegistrationTRUE</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Accreditation.RegistrationDate__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accreditation.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Prospect</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Accreditation.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Required</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsRequiredDataMissing</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsGroupOrMemberAdmin</name>
        <label>Group-/Member Admin?</label>
        <locationX>1078</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Get_Accreditation</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsGroupOrMemberAdminTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.Group_Member_Admin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Accounts_in_Hierarchy</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsRequiredDataMissing</name>
        <label>Required Data Missing?</label>
        <locationX>347</locationX>
        <locationY>1838</locationY>
        <defaultConnector>
            <targetReference>Account_Info_to_Validate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsRequiredDataMissingTRUE</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>GetCurrentAYFRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varAccount.AccountTradingCurrencyHelper__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>InvalidCriteria</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>

    <environments>Default</environments>
    <formulas>
        <description>This formula returns the current School Accreditation Lead if the value in the flow is blank, and otherwise fills the selected value in the account assignment.</description>
        <name>Account_AL</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!AC_Please_choose_the_correct_person_from_this_list_or_provide_their_details.selectedChoiceValues}), {!varAccount.School_Accreditation_Lead__c}, {!AC_Please_choose_the_correct_person_from_this_list_or_provide_their_details.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>HoS_Account</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!HoS_Please_choose_the_correct_person_from_this_list_or_provide_their_details.selectedChoiceValues}), {!varAccount.Head_of_School__c}, {!HoS_Please_choose_the_correct_person_from_this_list_or_provide_their_details.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>MyAccreditationRecordRedirectURL</name>
        <dataType>String</dataType>
        <expression>{!Get_Urls.experienceCloudSitesDomainUrl} +  &quot;/schools/s/international-accreditation/my-accreditation/accreditation/&quot; + {!Get_Accreditation.Id}</expression>
    </formulas>
    <formulas>
        <name>MyAccreditationRedirectURL</name>
        <dataType>String</dataType>
        <expression>{!Get_Urls.experienceCloudSitesDomainUrl} + &quot;/schools/s/international-accreditation/my-accreditation/&quot;</expression>
    </formulas>
    <formulas>
        <name>varRegisteredByName</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Contact.Name} + &apos; (&apos; + {!Get_Contact.Account.Name} + &apos;)&apos;, 255)</expression>
    </formulas>

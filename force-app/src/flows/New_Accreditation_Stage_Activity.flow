    <formulas>
        <description>When the IAC field is blank this formula returns TRUE</description>
        <name>UpdateIAC</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!Get_Accreditation_Cycle_Stage.IAC__c})</expression>
    </formulas>
    <formulas>
        <description>When the Report Manager and/or the IAA is blank this formula returns TRUE</description>
        <name>UpdateReportManagerOrIAA</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!Get_Account.ReportManager__c}) || ISBLANK({!Get_Account.IAA__c})</expression>
    </formulas>
    <formulas>
        <description>Evaluation Visit Start Date - or School Report Due Date - normalized, to beginning of the month for semester calculations.</description>
        <name>varEvaluationVisitDateOrSchoolReportDueDateNormalized</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR(BLANKVALUE({!Get_Accreditation_Cycle_Stage.EvaluationVisitStartDate__c}, {!Get_Accreditation_Cycle_Stage.SchoolReportDueDate__c})),MONTH(BLANKVALUE({!Get_Accreditation_Cycle_Stage.EvaluationVisitStartDate__c}, {!Get_Accreditation_Cycle_Stage.SchoolReportDueDate__c})),1)</expression>
    </formulas>
    <formulas>
        <name>varNewActivityStartDateDefault</name>
        <dataType>Date</dataType>
        <expression>IF (!ISNULL({!varEvaluationVisitDateOrSchoolReportDueDateNormalized}) &amp;&amp; ({!varEvaluationVisitDateOrSchoolReportDueDateNormalized} &gt;= {!varStageStartDate}), {!varEvaluationVisitDateOrSchoolReportDueDateNormalized}, {!varStageStartDate})</expression>
    </formulas>
    <formulas>
        <name>varOutputValueIAA</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Account.IAA__c}, {!IAA.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>varOutputValueReportManager</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Account.ReportManager__c}, {!ReportManager.selectedChoiceValues})</expression>
    </formulas>
    <formulas>
        <name>varStageStartDate</name>
        <dataType>Date</dataType>
        <expression>{!Get_Accreditation_Cycle_Stage.StartDate__c}</expression>
    </formulas>

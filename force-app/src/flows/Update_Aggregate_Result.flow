<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>DetermineSObject</name>
        <label>Determine SObject</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <defaultConnectorLabel>Unsupported SObject or no Aggregate Result record</defaultConnectorLabel>
        <rules>
            <name>Membership</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varMembership</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varAccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetAccount.Aggregate_Result__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <label>Membership</label>
        </rules>
        <rules>
            <name>Accreditation</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varAccreditation</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAggregateResultFromAccreditation</targetReference>
            </connector>
            <label>Accreditation</label>
        </rules>
    </decisions>
    <description>TTP Changes</description>
    <environments>Default</environments>
    <formulas>
        <description>Gets the Account ID, either from the Accreditation -record or the Membership -record.</description>
        <name>varAccountId</name>
        <dataType>String</dataType>
        <expression>IF(!ISBLANK({!varAccreditation.Account__c}), {!varAccreditation.Account__c}, IF(!ISBLANK({!varMembership.Account_Name__c}), {!varMembership.Account_Name__c}, NULL))</expression>
    </formulas>
    <interviewLabel>Update Aggregate Result {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Aggregate Result</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetAccount</name>
        <label>Get Account</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DetermineSObject</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varAccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Account</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update the Aggregate Result record with Accreditation record values.</description>
        <name>UpdateAggregateResultFromAccreditation</name>
        <label>Update Aggregate Result from Accreditation</label>
        <locationX>176</locationX>
        <locationY>350</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>GetAccount.Aggregate_Result__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AccreditationOutcome__c</field>
            <value>
                <elementReference>varAccreditation.AccreditationOutcome__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Accreditation_Status__c</field>
            <value>
                <elementReference>varAccreditation.Status__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrentAccreditationTrackName__c</field>
            <value>
                <elementReference>varAccreditation.CurrentAccreditationTrack__r.Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrentIAC__c</field>
            <value>
                <elementReference>varAccreditation.CurrentIAC__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>CurrentStageName__c</field>
            <value>
                <elementReference>varAccreditation.CurrentStageName__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Original_Accreditation_Date__c</field>
            <value>
                <elementReference>varAccreditation.OriginalAccreditationDate__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reaccreditation_Date__c</field>
            <value>
                <elementReference>varAccreditation.ReaccreditationDate__c</elementReference>
            </value>
        </inputAssignments>
        <object>AggregateResult__c</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>GetAccount</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>varAccreditation</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Accreditation__c</objectType>
    </variables>
    <variables>
        <name>varMembership</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
        <objectType>Membership__c</objectType>
    </variables>
</Flow>

    <decisions>
        <name>IsDuplicateContactSelected1</name>
        <label>Duplicate Contact Selected?</label>
        <locationX>732</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>IsEmailChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsDuplicateContactSelected1TRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactCheckEmail.selectedDuplicateRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_Email_And_User_On_Duplicate_Contact</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>

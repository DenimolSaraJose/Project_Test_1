    <decisions>
        <name>IsAccreditationCycleInProgress</name>
        <label>Accreditation Cycle &apos;In Progress&apos;?</label>
        <locationX>710</locationX>
        <locationY>1979</locationY>
        <defaultConnector>
            <targetReference>IsIACChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationCycleInProgressTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetAccreditationCycle.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FlagUpdates5</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsAccreditationCycleStatusIsPlanned</name>
        <label>Accreditation Cycle Status is &apos;Planned&apos;</label>
        <locationX>330</locationX>
        <locationY>971</locationY>
        <defaultConnector>
            <targetReference>FlagUpdates1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationCycleStatusIsPlannedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AccreditationCycle__r.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Planned</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetAccreditationCycleStatus</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Current Cycle Stage in progress is NULL or of a higher sequence</description>
        <name>IsCurrentCycleStageNullOrHigherSequence</name>
        <label>Current Cycle Stage is NULL or of a higher sequence</label>
        <locationX>484</locationX>
        <locationY>863</locationY>
        <defaultConnector>
            <targetReference>IsStageStatusChangedFromInProgressToCompleted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsCurrentCycleStageNullOrHigherSequenceTRUE</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CycleStageInProgress</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CycleStageInProgress.Order__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>$Record.Order__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsAccreditationCycleStatusIsPlanned</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Handover; this changes the current SSA on Cycle, Accreditation and Account if changes are made for the current stage only.</description>
        <name>IsIACChanged</name>
        <label>IAC Changed</label>
        <locationX>649</locationX>
        <locationY>2639</locationY>
        <defaultConnector>
            <targetReference>IsUpdateAccreditationCycle</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsSSAChangedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IAC__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>GetAccreditationCycle.CurrentCycleStageName__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FlagUpdates4</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsNextCycleStageAvailable</name>
        <label>Next Cycle Stage available</label>
        <locationX>512</locationX>
        <locationY>1871</locationY>
        <defaultConnector>
            <targetReference>IsAccreditationCycleInProgress</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNextCycleStageAvailableTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetNextCycleStageWithStatusPlanned</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Next_Stage</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsOtherCycleStageInProgress</name>
        <label>Other Cycle Stage In Progress</label>
        <locationX>281</locationX>
        <locationY>1763</locationY>
        <defaultConnector>
            <targetReference>IsNextCycleStageAvailable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsOtherCycleStageInProgressTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>CycleStageInProgress</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>FlagUpdates2</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsStageStatusChangedFromInProgressToCompleted</name>
        <label>Stage Status Changed from &apos;In Progress&apos; to &apos;Completed&apos;</label>
        <locationX>649</locationX>
        <locationY>1655</locationY>
        <defaultConnector>
            <targetReference>IsIACChanged</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsStageStatusChangedFromInProgressToCompletedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsOtherCycleStageInProgress</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUpdateAccreditationCycle</name>
        <label>Update Accreditation Cycle</label>
        <locationX>649</locationX>
        <locationY>3047</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsUpdateAccreditationCycleTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsAccreditationCycleToUpdate</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UpdateAccreditationCycle</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>StageStatusChangedToInProgress</name>
        <label>Stage Status Changed to &apos;In Progress&apos;</label>
        <locationX>649</locationX>
        <locationY>755</locationY>
        <defaultConnector>
            <targetReference>IsStageStatusChangedFromInProgressToCompleted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>StageStatusChangedToInProgressTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Progress</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsCurrentCycleStageNullOrHigherSequence</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <description>TTP Changes</description>
    <environments>Default</environments>
    <formulas>
        <description>Represents the consecutive order of the previous Cycle Activity within the Accreditation Cycle</description>
        <name>PreviousCycleActivityOrder</name>
        <dataType>Number</dataType>
        <expression>{!$Record.Order__c} - 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Accreditation Cycle Stage After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Accreditation Cycle Stage After Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>

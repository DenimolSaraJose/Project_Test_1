    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Retrieve associated Job record from database</description>
        <name>getJobRecord</name>
        <label>Get associated Job</label>
        <locationX>336</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>IsNewApplication</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.TR1__Job__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>TR1__Job__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Update associated Job record</description>
        <name>updateJobRecord</name>
        <label>Update associated Job</label>
        <locationX>369</locationX>
        <locationY>2879</locationY>
        <inputReference>getJobRecord</inputReference>
    </recordUpdates>
    <start>
        <locationX>375</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>IsRecordTypeAccreditation</targetReference>
        </connector>
        <object>TR1__Application__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <description>Create manual Job Share (Read) for Applicant. Jobs and Applications are shared based on Public Group membership and the Job Community Status. This flow adds an additional Job Share with Read access so that the records stay visible when the Job Community Status changes from &apos;Published&apos; to something else.</description>
        <name>Create_Job_Share_for_Applicant</name>
        <label>Create Job Share for Applicant</label>
        <locationX>204</locationX>
        <locationY>647</locationY>
        <connector>
            <targetReference>Email_First_Response</targetReference>
        </connector>
        <flowName>Create_Job_Share_for_Applicant</flowName>
        <inputAssignments>
            <name>varApplication</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>varRunningUser</name>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <description>Boolean that indicates if the associated Job record should be updated or not</description>
        <name>updateAssociatedJob</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
</Flow>

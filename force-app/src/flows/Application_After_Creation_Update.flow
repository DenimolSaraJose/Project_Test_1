    <constants>
        <description>Clears Date value</description>
        <name>ClearDate</name>
        <dataType>Date</dataType>
    </constants>
    <decisions>
        <name>IsAccreditationAccepted</name>
        <label>Accreditation Accepted?</label>
        <locationX>336</locationX>
        <locationY>2171</locationY>
        <defaultConnector>
            <targetReference>IsUpdateAssociatedJob</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAccreditationAcceptedTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accepted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Accreditation_Accepted</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsApplicationNotSelected</name>
        <label>Application Not Selected?</label>
        <locationX>336</locationX>
        <locationY>1463</locationY>
        <defaultConnector>
            <targetReference>IsAccreditationAccepted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsApplicationNotSelectedTRUE</name>
            <conditionLogic>1 AND 2 AND (3 OR  4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Not Selected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Selected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Applied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Under Revision</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Application_Not_Selected</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Compare &apos;Selected Candidate&apos; on the associated Job with the current Job Application&apos;s &apos;Applicant&apos;, also the Job Community Status must equal &apos;Application&apos;</description>
        <name>IsAssociatedJobEligableForUpdating</name>
        <label>Check associated Job</label>
        <locationX>182</locationX>
        <locationY>1679</locationY>
        <defaultConnector>
            <targetReference>IsAccreditationAccepted</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsAssociatedJobEligableForUpdatingTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>getJobRecord.XSelected_Candidate__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.TR1__Applicant__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>getJobRecord.Community_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Application</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Variable_Assignments_2</targetReference>
            </connector>
            <label>Eligable for Update</label>
        </rules>
    </decisions>
    <decisions>
        <description>New Application registered, Application Status changed to &apos;Applied&apos;</description>
        <name>IsNewApplication</name>
        <label>New Application?</label>
        <locationX>336</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>IsSelectCandidate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsNewApplicationTRUE</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Applied</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Job_Share_for_Applicant</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsRecordTypeAccreditation</name>
        <label>RecordType equals Accreditation?</label>
        <locationX>501</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>IsUpdateAssociatedJob</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsRecordTypeAccreditationTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Accreditation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getJobRecord</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Applicant Status changes to &apos;Selected&apos; and Selected Candidate is checked</description>
        <name>IsSelectCandidate</name>
        <label>Select Candidate?</label>
        <locationX>336</locationX>
        <locationY>947</locationY>
        <defaultConnector>
            <targetReference>IsApplicationNotSelected</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsSelectCandidateTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Selected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Application_status__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Email_Selected_Candidate</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <decisions>
        <name>IsUpdateAssociatedJob</name>
        <label>Update associated Job?</label>
        <locationX>501</locationX>
        <locationY>2771</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IsUpdateAssociatedJobTRUE</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>updateAssociatedJob</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>updateJobRecord</targetReference>
            </connector>
            <label>True</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Application After Creation Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Application After Creation Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>

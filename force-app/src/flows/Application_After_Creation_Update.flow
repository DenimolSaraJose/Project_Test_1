    <assignments>
        <description>Copy values from Job Application to the associated Job record</description>
        <name>Record_Assignments_1</name>
        <label>Record Assignments</label>
        <locationX>204</locationX>
        <locationY>1271</locationY>
        <assignmentItems>
            <assignToReference>getJobRecord.Application_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Application_status__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>getJobRecord.Applied_on__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Applied_on__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>getJobRecord.XSelected_Candidate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.TR1__Applicant__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>getJobRecord.Community_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Application</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>IsApplicationNotSelected</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Record_Assignments_2</name>

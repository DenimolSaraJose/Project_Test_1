<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Increment_Overall_Total</name>
        <label>Increment Overall Total</label>
        <locationX>138</locationX>
        <locationY>1055</locationY>
        <assignmentItems>
            <assignToReference>var_OverallTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_Sales_Order_Lines.OrderApi__Total_with_Tax__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_Sales_Order_Lines</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Increment_Overall_Total_Not_Taxable</name>
        <label>Increment Overall Total (Not Taxable)</label>
        <locationX>490</locationX>
        <locationY>1055</locationY>
        <assignmentItems>
            <assignToReference>var_OverallTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Through_Sales_Order_Lines_Not_Taxable.OrderApi__Subtotal__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Through_Sales_Order_Lines_Not_Taxable</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Variable_to_True</name>
        <label>Set Variable to True</label>
        <locationX>94</locationX>
        <locationY>647</locationY>
        <assignmentItems>
            <assignToReference>var_Taxable</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Taxable_Sales_Order</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Found_a_Taxable_Sales_Order_Line</name>
        <label>Found a Taxable Sales Order Line?</label>
        <locationX>226</locationX>
        <locationY>539</locationY>
        <defaultConnector>
            <targetReference>Taxable_Sales_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Found_a_Taxable_Sales_Order_Line</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Taxable_Sales_Order_Line.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Variable_to_True</targetReference>
            </connector>
            <label>Yes Found a Taxable Sales Order Line</label>
        </rules>
    </decisions>
    <decisions>
        <name>Taxable_Sales_Order</name>
        <label>Taxable Sales Order?</label>
        <locationX>226</locationX>
        <locationY>839</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Sales_Order_Lines_Not_Taxable</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not a Taxable Sales Order</defaultConnectorLabel>
        <rules>
            <name>Yes_Taxable_Sales_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>var_Taxable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_Sales_Order_Lines</targetReference>
            </connector>
            <label>Yes Taxable Sales Order</label>
        </rules>
    </decisions>
    <description>This calculates the overall total, including tax, from all the sales order lines attached to a sales order.</description>
    <environments>Default</environments>
    <formulas>
        <description>This holds the criteria for an unpaid Sales Order. This formula equals true when a user has checked out in Fonteva. This flow should not trigger when this formula equals true.</description>
        <name>formula_UnpaidSO</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    {!$Record.OrderApi__Balance_Due__c} &gt; 0,
    {!$Record.OrderApi__Is_Closed__c},
    {!$Record.OrderApi__Is_Posted__c},
    NOT({!$Record.OrderApi__Is_Voided__c})
)</expression>
    </formulas>
    <interviewLabel>Fonteva Sales Order After Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fonteva Sales Order After Update</label>
    <loops>
        <name>Loop_through_Sales_Order_Lines</name>
        <label>Loop through Sales Order Lines</label>
        <locationX>50</locationX>
        <locationY>947</locationY>
        <collectionReference>Get_Sales_Order_Line</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Overall_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Overall_Total</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <description>Loops</description>
        <name>Loop_Through_Sales_Order_Lines_Not_Taxable</name>
        <label>Loop Through Sales Order Lines (Not Taxable)</label>
        <locationX>402</locationX>
        <locationY>947</locationY>
        <collectionReference>Get_Sales_Order_Line</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Overall_Total_Not_Taxable</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Overall_Total_Not_Taxable</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Sales_Order_Line</name>
        <label>Get Sales Order Line</label>
        <locationX>226</locationX>
        <locationY>323</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Taxable_Sales_Order_Line</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Sales_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Send_to_FinancialForce__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>OrderApi__Sales_Order_Line__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Taxable_Sales_Order_Line</name>
        <label>Get Taxable Sales Order Line</label>
        <locationX>226</locationX>
        <locationY>431</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Found_a_Taxable_Sales_Order_Line</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OrderApi__Sales_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Send_to_FinancialForce__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>OrderApi__Sales_Order_Line__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Overall_Total</name>
        <label>Update Overall Total</label>
        <locationX>50</locationX>
        <locationY>1247</locationY>
        <inputAssignments>
            <field>OrderApi__Overall_Total__c</field>
            <value>
                <elementReference>var_OverallTotal</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Overall_Total_Not_Taxable</name>
        <label>Update Overall Total (Not Taxable)</label>
        <locationX>402</locationX>
        <locationY>1247</locationY>
        <inputAssignments>
            <field>OrderApi__Overall_Total__c</field>
            <value>
                <elementReference>var_OverallTotal</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>100</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Sales_Order_Line</targetReference>
        </connector>
        <filterFormula>NOT(
    AND(
        {!$Record.OrderApi__Balance_Due__c} &gt; 0,
        {!$Record.OrderApi__Is_Closed__c},
        {!$Record.OrderApi__Is_Posted__c},
        NOT({!$Record.OrderApi__Is_Voided__c})
    )
)</filterFormula>
        <object>OrderApi__Sales_Order__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>var_Fonteva_Sales_Order_Id</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <description>Variable to hold the overall total, which each sales order line will increment in the loop.</description>
        <name>var_OverallTotal</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>var_Taxable</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>

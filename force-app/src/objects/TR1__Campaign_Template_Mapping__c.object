        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>TR1__Maximum_Number_of_Additional_Channels__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of additional message channels that can be selected when sending a message. When this limit is reached, all other additional channels are greyed out and cannot be selected.</description>
        <externalId>false</externalId>
        <inlineHelpText>The number of additional message channels that can be selected when sending a message. When this limit is reached, all other additional channels are greyed out and cannot be selected.</inlineHelpText>
        <label>Maximum Number of Additional Channels</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Use_Personalization_Strings__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>When activated, you are able to add personalization strings to the template to allow for personalization and edits where applicable. However, the email body will no longer be editable. Please note that links added into editable email bodies and links added to personalization strings can not be tracked by SFMC.</description>
        <inlineHelpText>When activated, you are able to add personalization strings to the template to allow for personalization and edits where applicable. However, the email body will no longer be editable. Please note that links added into editable email bodies and links added to personalization strings can not be tracked by SFMC.</inlineHelpText>
        <label>Use Personalization Strings</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

        <fullName>TR1__External_Id__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>The unique identifier of the Campaign Template Mapping record to distinguish multiple records referring to the same Campaign Unique Name.</description>
        <externalId>true</externalId>
        <inlineHelpText>The unique identifier of the Campaign Template Mapping record to distinguish multiple records referring to the same Campaign Unique Name.</inlineHelpText>

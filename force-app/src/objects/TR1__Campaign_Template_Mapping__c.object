    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>TR1__Available_Languages__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores language codes to be displayed within the BH4SF Email Editor which allows users to select the language of the preview of the email template.</description>
        <inlineHelpText>Stores language codes to be displayed within the BH4SF Email Editor which allows users to select the language of the preview of the email template.</inlineHelpText>
        <label>Available Languages</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>TR1__Available_Languages</valueSetName>
        </valueSet>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Campaign_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>Id of related campaign</description>
        <externalId>false</externalId>
        <inlineHelpText>Id of related campaign</inlineHelpText>
        <label>(deprecated) Campaign Id</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Campaign_Unique_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Campaign Unique Name field value of related campaign</description>
        <externalId>false</externalId>
        <inlineHelpText>Campaign Unique Name field value of related campaign</inlineHelpText>
        <label>Campaign Unique Name</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Email_Editor_Template_Label__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the name of the custom label of an email template to be displayed within the template selector of the BH4SF Email Editor (when the template preview from SFMC cloud page is enabled). If the used custom label has translations, then the label will be displayed in the user&apos;s language.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the name of the custom label of an email template to be displayed within the template selector of the BH4SF Email Editor (when the template preview from SFMC cloud page is enabled). If the used custom label has translations, then the label will be displayed in the user&apos;s language.</inlineHelpText>
        <label>Email Editor Template Label</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Email_Editor_Template_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the name of the email template to be displayed within the template selector of the BH4SF Email Editor (when the template preview from SFMC cloud page is enabled).</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the name of the email template to be displayed within the template selector of the BH4SF Email Editor (when the template preview from SFMC cloud page is enabled).</inlineHelpText>
        <label>Email Editor Template Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Email_Template_Folders__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores names of the folders under which the current email template related to a specific campaign should appear. Note: it doesn’t represent the SF Folder on the org.</description>
        <inlineHelpText>Stores names of the folders under which the current email template related to a specific campaign should appear. Note: it doesn’t represent the SF Folder on the org.</inlineHelpText>
        <label>Email Template Folders</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>TR1__Email_Template_Folders</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>

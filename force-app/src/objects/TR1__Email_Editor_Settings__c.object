<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>This custom setting controls the Email Editor behavior.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Alternative_Contact_Email_Fields__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of a Contact object field (or multiple fields separated by a comma). These fields are intended for storing alternative email addresses, one of which can be selected as the recipient&apos;s email address when sending. Supported field types: Email, Text.</description>
        <externalId>false</externalId>
        <inlineHelpText>The API name of a Contact object field (or multiple fields separated by a comma). These fields are intended for storing alternative email addresses, one of which can be selected as the recipient&apos;s email address when sending. Supported field types: Email, Text.</inlineHelpText>
        <label>Alternative Contact Email Fields</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Alternative_User_Email_field__c</fullName>
        <deprecated>false</deprecated>
        <description>User object field Api name. This field is intended to store an alternate email address that will be used as the sender&apos;s email address. Supported field types: Picklist, Picklist (Multi-Select), Text (might be several emails divided by semicolon).</description>
        <externalId>false</externalId>
        <inlineHelpText>User object field Api name. This field is intended to store an alternate email address that will be used as the sender&apos;s email address. Supported field types: Picklist, Picklist (Multi-Select), Text (might be several emails divided by semicolon).</inlineHelpText>
        <label>Alternative User Email field</label>
        <length>60</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Bulk_Processing_Has_No_Callouts__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines whether an email send is not triggered by an HTTP callout (Salesforce Messaging.send() is treated as a callout as well).</description>
        <inlineHelpText>Determines whether an email send is not triggered by an HTTP callout (Salesforce Messaging.send() is treated as a callout as well).</inlineHelpText>
        <label>Bulk Processing Has No Callouts</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Custom_Email_Provider_Class_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Apex class which implements the custom logic of Email Sending instead of the standard package email provider-related logic.</description>
        <externalId>false</externalId>
        <inlineHelpText>Apex class which implements the custom logic of Email Sending instead of the standard package email provider-related logic.</inlineHelpText>
        <label>Custom Email Provider Class Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Do_Not_Use_Rich_Text_For_Preview__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines whether an email preview component is using lightning-formatted-rich-text or direct DOM manipulation to apply CSS styles from the email template.</description>
        <inlineHelpText>Determines whether an email preview component is using lightning-formatted-rich-text or direct DOM manipulation to apply CSS styles from the email template.</inlineHelpText>
        <label>Do Not Use LWC Rich Text For Preview</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Enable_SFMC_Campaign_Template_Mapping__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines whether dependencies based on Campaign Template Mapping records for Email Editor should be enabled (affects the UI of template selector and displaying of additional message channels and personalization strings).</description>
        <inlineHelpText>Determines whether dependencies based on Campaign Template Mapping records for Email Editor should be enabled (affects the UI of template selector and displaying of additional message channels and personalization strings).</inlineHelpText>
        <label>Enable SFMC Campaign Template Mapping</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Multiple_Recipients_per_sendEmail__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines whether the email provider supports sending a message to multiple recipients at a time (sending of email for all recipients are processed within the same transaction).</description>
        <inlineHelpText>Determines whether the email provider supports sending a message to multiple recipients at a time (sending of email for all recipients are processed within the same transaction).</inlineHelpText>
        <label>Multiple Recipients per sendEmail()</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Email Editor Settings</label>
    <visibility>Public</visibility>
</CustomObject>

        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>AccreditationTaskName__c</fullName>
        <externalId>false</externalId>
        <formula>AccreditationTask__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accreditation Task Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccreditationTask__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Accreditation Task</label>
        <referenceTo>AccreditationTask__c</referenceTo>
        <relationshipName>Stage_Activity_Task</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CorrelationField__c</fullName>
        <description>The Correlation Field contains the Field API Name of a field on the Accreditation Activity record that correlates with the Task once it is complete. The referenced field is set; a checkbox is checked, date(time) fields are set to the date(time) when the Task gets completed. Only fields with the following field types are supported: checkbox, date and datetime; other fields types will be ignored.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Correlation Field contains the Field API Name of a field on the Accreditation Activity record that correlates with the Task once it is complete. The referenced field is set; a checkbox is checked, date(time) fields are set to the date(time) when the Task gets completed. Only fields with the following field types are supported: checkbox, date and datetime; other fields types will be ignored.</inlineHelpText>
        <label>Correlation Field</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>DefaultOwner__c</fullName>
        <label>Default Owner</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>ReportManager</fullName>
                    <default>false</default>
                    <label>Report Manager</label>
                </value>
                <value>
                    <fullName>SSEDirector</fullName>
                    <default>false</default>
                    <label>SSE Director</label>
                </value>
                <value>
                    <fullName>IAC</fullName>
                    <default>false</default>
                    <label>IAC</label>
                </value>
                <value>
                    <fullName>IAA</fullName>
                    <default>false</default>
                    <label>IAA</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>DerivedDateField__c</fullName>
        <description>Field API Name of a date(time) field on the Accreditation Stage Activity record, related Accreditation Cycle Stage - or related Accreditation Cycle record for populating the Task&apos;s due date. The referenced field&apos;s value is used together with Duration and Duration Type. When referring to a field on the Accreditation Cycle Stage use &apos;AccreditationCycleStage__r.&apos; as prefix before the field API Name, when referring to a field on the Accreditation Cycle use &apos;AccreditationCycle__r.&apos;.</description>
        <externalId>false</externalId>
        <inlineHelpText>Field API Name of a date(time) field on the Accreditation Stage Activity record, related Accreditation Cycle Stage - or related Accreditation Cycle record for populating the Task&apos;s due date. The referenced field&apos;s value is used together with Duration and Duration Type. When referring to a field on the Accreditation Cycle Stage use &apos;AccreditationCycleStage__r.&apos; as prefix before the field API Name, when referring to a field on the Accreditation Cycle use &apos;AccreditationCycle__r.&apos;.</inlineHelpText>
        <label>Derived Date Field</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Digest__c</fullName>
        <caseSensitive>false</caseSensitive>
        <externalId>true</externalId>
        <label>Digest</label>
        <length>32</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>DurationType__c</fullName>
        <description>Unit used in calculating the task&apos;s Due date.</description>
        <inlineHelpText>Unit used in calculating the task&apos;s Due date.</inlineHelpText>
        <label>Duration Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>DAY</fullName>
                    <default>false</default>
                    <label>Day(s)</label>
                </value>
                <value>
                    <fullName>WEEK</fullName>
                    <default>false</default>
                    <label>Week(s)</label>
                </value>
                <value>
                    <fullName>MONTH</fullName>
                    <default>true</default>
                    <label>Month(s)</label>
                </value>
                <value>
                    <fullName>YEAR</fullName>
                    <default>false</default>
                    <label>Year(s)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Duration__c</fullName>
        <description>Multiplier used with Duration Type for calculating the task&apos;s Due date.</description>
        <externalId>false</externalId>
        <inlineHelpText>Multiplier used with Duration Type for calculating the task&apos;s Due date.</inlineHelpText>
        <label>Duration</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsAutoCreate__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When checked a Salesforce activity or task will be created and linked to the Accreditation Stage Activity.</description>
        <inlineHelpText>When checked a Salesforce activity or task will be created and linked to the Accreditation Stage Activity.</inlineHelpText>
        <label>Create Automatically</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsCreateTaskComplete__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Create Completed Task</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TaskOrder__c</fullName>
        <defaultValue>0</defaultValue>
        <description>Task Order within specified grouping of Accreditation Stage and Accreditation Activity.</description>
        <externalId>false</externalId>
        <inlineHelpText>Task Order within specified grouping of Accreditation Stage and Accreditation Activity.</inlineHelpText>
        <label>Task Order</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>

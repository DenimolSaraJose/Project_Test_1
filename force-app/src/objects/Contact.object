    <fields>
        <fullName>Additional_Information__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;IMPORTANT: We will begin to contact new references as soon as you add their details and save the form to expedite the screening process. Please do contact them in advance to inform them of your search and alert them to our impending contact. Please upload new or updated documentation in the box marked Files. Ensure each document has the appropriate label, observing the following naming conventions: CV, Cover Letter, CBC [country in which the Criminal Background Check was carried out], Teaching Qualification, [Degree Type/Title], Photo.&quot;&amp;br()&amp;&quot;Once you have added all the documents requested, please email your CIS Search Consultant or educatorrecruitment@cois.org to confirm that you have done this. We will be in touch if we require any additional information. Please note, this information must be completed when you enter the final stages of a search process.&quot;</formula>
        <label>Additional Information</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>

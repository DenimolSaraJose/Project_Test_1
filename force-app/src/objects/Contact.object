    <fields>
        <fullName>TR1__Off_Limit_Reason__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF($Setup.TR1__Executive_Search__c.TR1__Enable_Off_Limit_Policies__c, TR1__Off_Limit_Info__r.TR1__Off_Limit_Reason__c,&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Off Limit Reason</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Off_Limit__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(AND(TR1__Off_Limit_Info__r.TR1__Active__c, $Setup.TR1__Executive_Search__c.TR1__Enable_Off_Limit_Policies__c),IMAGE(IF(NOT(ISBLANK(TR1__Off_Limit_Custom_Icon__c)),TR1__Off_Limit_Custom_Icon__c, IF(ISPICKVAL(TR1__Off_Limit_Info__r.TR1__Behavior__c, &quot;Block&quot;),IF(NOT(ISBLANK($Setup.TR1__Executive_Search__c.TR1__Default_Off_Limit_Icon__c)),$Setup.TR1__Executive_Search__c.TR1__Default_Off_Limit_Icon__c, &apos;/resource/TR1__Lock_icon_svg&apos;),IF(NOT(ISBLANK($Setup.TR1__Executive_Search__c.TR1__Default_Off_Limit_Warning_Icon__c)),$Setup.TR1__Executive_Search__c.TR1__Default_Off_Limit_Warning_Icon__c, &apos;/resource/TR1__Warning_icon_svg&apos;))),&apos;Lock&apos;,30, 30),&apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Off Limit</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>

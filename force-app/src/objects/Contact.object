    <fields>
        <fullName>TR1__Imported_At__c</fullName>
        <deprecated>false</deprecated>
        <description>When the Candidate was imported.</description>
        <inlineHelpText>When the Candidate was imported.</inlineHelpText>
        <label>Imported At</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>TR1__Imported_By_Current_User__c</fullName>
        <deprecated>false</deprecated>
        <description>Boolean formula indicating if the current user initiated the import.</description>
        <formula>IF( TR1__Imported_By__c = $User.Id, TRUE, FALSE)</formula>
        <inlineHelpText>Boolean formula indicating if the current user initiated the import.</inlineHelpText>
        <label>Imported By You</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>

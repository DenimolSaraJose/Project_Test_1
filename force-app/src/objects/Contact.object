    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Block_Changing_Account_Directly</fullName>
        <active>true</active>
        <description>This validation rule disallows direct editing of the Account lookup field.</description>
        <errorConditionFormula>!ISNEW()
&amp;&amp; !ISBLANK(User__c)
&amp;&amp; ISCHANGED(AccountId)
&amp;&amp; !IsVRBypassed__c
&amp;&amp; !$Permission.Modify_Contact</errorConditionFormula>
        <errorMessage>Please use the wizard &apos;Modify Contact&apos; to update the Account lookup. If you don&apos;t have access please contact the Membership Engagement Team for assistance.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Block_Changing_Email_Directly</fullName>
        <active>true</active>
        <description>This validation rule disallows direct editing of the Email field.</description>
        <errorConditionFormula>!ISNEW()
&amp;&amp; ISCHANGED(Email)
&amp;&amp; !IsVRBypassed__c
&amp;&amp; !$Permission.Modify_Contact</errorConditionFormula>
        <errorMessage>Please use the wizard &apos;Modify Contact&apos; to update the Email address. If you don&apos;t have access please contact the Membership Engagement Team for assistance.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Block_Update_Of_Critical_Fields</fullName>
        <active>true</active>
        <description>This validation rule is used to block all portal users from updating critical fields (like name, email, etc)  from being updated by their colleagues</description>
        <errorConditionFormula>AND
(
   NOT(ISNEW()),
   NOT(ISBLANK($User.ContactId)),
   NOT(Id = $User.ContactId),
   OR
  (
     ISCHANGED(FirstName),
     ISCHANGED(LastName), 
     ISCHANGED(npe01__WorkEmail__c)
  )
)</errorConditionFormula>
        <errorMessage>Name and email can only be changed by the user associated with this contact</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_For_Valid_Email</fullName>
        <active>true</active>
        <description>Checks the email, unfortunately so called &apos;plus addressing&apos; is not allowed</description>
        <errorConditionFormula>!ISBLANK(Email) &amp;&amp; NOT(REGEX(Email, &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_For_Valid_Personal_Email</fullName>
        <active>true</active>
        <description>Checks the personal email, unfortunately so called &apos;plus addressing&apos; is not allowed</description>
        <errorConditionFormula>!ISBLANK(npe01__HomeEmail__c) &amp;&amp; NOT(REGEX(npe01__HomeEmail__c, &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>npe01__HomeEmail__c</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_For_Valid_Work_Email</fullName>
        <active>true</active>
        <description>Checks the work email, unfortunately so called &apos;plus addressing&apos; is not allowed</description>
        <errorConditionFormula>!ISBLANK(npe01__WorkEmail__c) &amp;&amp; NOT(REGEX(npe01__WorkEmail__c, &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>npe01__WorkEmail__c</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_not_blank_if_Community_created</fullName>
        <active>false</active>
        <errorConditionFormula>AND(Create_Community_User__c = TRUE, 
OR(
ISBLANK( Email ),
ISPICKVAL( Active_C_R_Evaluator_Candidate__c, &apos;&apos;)
 )
)</errorConditionFormula>
        <errorMessage>You must at least fill in the Email field AND the &quot;Active Evaluator Candidate&quot; field if you want to create a Community User</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Job_Title_Exceeds_Maximum_Length</fullName>
        <active>true</active>
        <errorConditionFormula>LEN( Job_Title__c ) &gt; 80</errorConditionFormula>
        <errorMessage>The job title exceeds the maximum length of 80 characters!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_CIS_Category</fullName>
        <active>false</active>
        <description>Validate CIS Category dependency with parent Account&apos;s designated Contact(s)</description>
        <errorConditionFormula>!ISNEW() &amp;&amp;
!ISBLANK(AccountId) &amp;&amp;
Account.RecordType.DeveloperName = &apos;School&apos; &amp;&amp;
ISCHANGED(CIS_Category__c) &amp;&amp;
((!INCLUDES(CIS_Category__c, &apos;Accreditation Coordinator&apos;) &amp;&amp; Account.Accreditation_Coordinator_Contact__c == Id) ||
(!INCLUDES(CIS_Category__c, &apos;Billing/Invoice Contact&apos;) &amp;&amp; Account.Invoice_Contact_Schools__c == Id))</errorConditionFormula>
        <errorDisplayField>CIS_Category__c</errorDisplayField>
        <errorMessage>You cannot remove the CIS Category for this contact because this is the designated contact for this role. You must first indicate the new designated contact (via the school profile) before adjusting the CIS Category.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_Job_Category</fullName>
        <active>true</active>
        <description>Validate Job Category dependency with parent Account&apos;s designated Contact(s)</description>
        <errorConditionFormula>!ISNEW() &amp;&amp;
!ISBLANK(AccountId) &amp;&amp;
Account.RecordType.DeveloperName = &apos;School&apos; &amp;&amp;
ISCHANGED(Job_Category__c) &amp;&amp;
((!INCLUDES(Job_Category__c, &apos;Head of School&apos;) &amp;&amp; Account.Head_of_School__c == Id) ||
(!INCLUDES(Job_Category__c, &apos;Board Chair/CEO&apos;) &amp;&amp; Account.School_Board_Chair__c == Id))</errorConditionFormula>
        <errorDisplayField>Job_Category__c</errorDisplayField>
        <errorMessage>You cannot remove the Job Category for this contact because this is the designated contact for this role. You must first indicate the new designated contact (via the school profile) before adjusting the Job Category.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>APXTConga4__Conga_Composer_OAuth</fullName>
        <availability>online</availability>
        <description>*** DO NOT USE THIS BUTTON ON A PAGE LAYOUT *** 

OAuth buttons require additional setup. Please see the Composer Installation Guide for more details.

COPY THE URL FROM THIS BUTTON and paste it into your own custom button or link. Then add optional parameters to finely tune the button&apos;s behavior. See the Composer Configuration Guide for details.</description>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>660</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Conga Composer (OAuth)</masterLabel>
        <openType>newWindow</openType>

    <fields>
        <fullName>Signed_SRS_is_active__c</fullName>
        <formula>IF ( OR(
IF(
  AND(
    MONTH(  Date_of_signing_the_SRS__c ) = 2,
    DAY(  Date_of_signing_the_SRS__c ) = 29,
    NOT( 
      OR( 
        MOD( YEAR(  Date_of_signing_the_SRS__c ), 400 ) = 0, 
        AND( 
          MOD( YEAR(  Date_of_signing_the_SRS__c ), 4 ) = 0,
          MOD( YEAR(  Date_of_signing_the_SRS__c ), 100 ) != 0
        )
      )
    ) 
  ),
  DATE( YEAR(  Date_of_signing_the_SRS__c ) + 5, 3, 1),
  DATE( YEAR(  Date_of_signing_the_SRS__c  ) + 5, MONTH(  Date_of_signing_the_SRS__c  ), DAY(  Date_of_signing_the_SRS__c ) )
) &lt; TODAY(),
ISBLANK(Date_of_signing_the_SRS__c  ))
, false, true)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Signed SRS is active?</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>

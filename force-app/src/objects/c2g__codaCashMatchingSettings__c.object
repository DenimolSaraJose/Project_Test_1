<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Cash Matching Settings</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__AllowDifferentMatchingGLAs__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, different GLAs can be used during cash matching. However, using different GLAs might not be suitable for all the matches that include values for currency write off. If deselected, all matched cash entry and transaction lines must have the same GLA.</description>
        <inlineHelpText>If selected, different GLAs can be used during cash matching. However, using different GLAs might not be suitable for all the matches that include values for currency write off. If deselected, all matched cash entry and transaction lines must have the same GLA.</inlineHelpText>
        <label>Allow Different Matching GLAs</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__AsynchMatchingThreshold__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Asynch Matching Threshold</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__AsynchUndoMatchThreshold__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Asynch Undo Match Threshold</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__BackgroundMatchingBatchSize__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Background Matching Batch Size</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__EnableExtendedCashMatching__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enables Extended Cash Matching. Redirects users from the Classic Cash Matching pages.</description>
        <label>DEPRECATED:Enable Extended Cash Matching</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__EnableMatchToIntercompanyCash__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Allows matching of cash entry intercompany accounts.</description>
        <inlineHelpText>If selected, allows matching of cash entry intercompany accounts.</inlineHelpText>
        <label>Enable Match To Intercompany Cash</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__MatchingLinesThreshold__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Background Matching Lines Threshold</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__MatchingReferencesThreshold__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Background Matching References Threshold</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__ShowAnalysisSectionByDefault__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <label>Show Analysis Section by Default</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ShowAuxiliaryGLAValues__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, the Auxiliary GLA column is displayed in the Cash Entries and Transactions grids on the Extended Cash Matching page.</description>
        <inlineHelpText>If selected, the Auxiliary GLA column is displayed in the Cash Entries and Transactions grids on the Extended Cash Matching page.</inlineHelpText>
        <label>Show Auxiliary GLA Values</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ShowDiscountValues__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that you want to show Discount values on the Extended Cash Matching page (Other Transactions pane).</description>
        <label>Show Discount Values</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ShowRemainingValues__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that you want to show Remaining values on the Extended Cash Matching page (Other Transactions pane).</description>
        <label>Show Remaining Values</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ShowWriteoffValues__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that the Write-Off values located in the Other Transactions pane, on the Extended Cash Matching page can be edited. Also found on the Accounts Receivable Write-Off.</description>
        <label>Edit Write-Off Values</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Cash Matching Settings</label>
    <visibility>Public</visibility>
</CustomObject>

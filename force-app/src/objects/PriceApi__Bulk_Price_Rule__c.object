    <fields>
        <fullName>PriceApi__Discount_Percentage__c</fullName>
        <defaultValue>0.00</defaultValue>
        <deprecated>false</deprecated>
        <description>This defines the percent discount that will be applied against the default price of the defined items.</description>
        <inlineHelpText>This defines the percent discount that will be applied against the default price of the defined items.</inlineHelpText>
        <label>Price Rule Percentage</label>
        <precision>7</precision>
        <required>false</required>
        <scale>4</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>PriceApi__End_Date__c</fullName>

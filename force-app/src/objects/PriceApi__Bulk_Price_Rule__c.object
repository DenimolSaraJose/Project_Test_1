    <webLinks>
        <fullName>PriceApi__Delete_Price_Rules</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Delete Price Rules</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/30.0/connection.js&quot;)} 
{!REQUIRESCRIPT(&quot;/soap/ajax/24.0/apex.js&quot;)} 

alert(sforce.apex.execute(&quot;PriceApi.WebServiceBulkDataExecute&quot;, &quot;deletePriceRules&quot;,{bulkPriceRuleId:&quot;{!PriceApi__Bulk_Price_Rule__c.Id}&quot;}));</url>
    </webLinks>

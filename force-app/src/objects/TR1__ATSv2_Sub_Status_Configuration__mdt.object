<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Defines a sub status for the specified stages of an ATSv2 Application.</description>
    <fields>
        <fullName>TR1__ATS_Stages__c</fullName>
        <deprecated>false</deprecated>
        <description>A comma separated list of ATS Stages that this sub status applies to, as found on the ApplicationV2.Stage__c picklist.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>A comma separated list of ATS Stages that this sub status applies to, as found on the ApplicationV2.Stage__c picklist.</inlineHelpText>
        <label>ATS Stages</label>
        <required>true</required>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines whether the metadata instance is active or not.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Determines whether the metadata instance is active or not.</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Color_Code__c</fullName>
        <deprecated>false</deprecated>
        <description>The color code e.g. &quot;#f3c099&quot; or &quot;rgb(75, 202, 129)&quot;</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The color code e.g. &quot;#f3c099&quot; or &quot;rgb(75, 202, 129)&quot;</inlineHelpText>
        <label>Color Code</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Hover_Color_Code__c</fullName>
        <deprecated>false</deprecated>
        <description>The color code shown when hovering a chevron e.g. &quot;#f3c099&quot; or &quot;rgb(75, 202, 129)&quot;</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The color code shown when hovering a chevron e.g. &quot;#f3c099&quot; or &quot;rgb(75, 202, 129)&quot;</inlineHelpText>
        <label>Hover Color Code</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Job_Record_Types__c</fullName>
        <deprecated>false</deprecated>
        <description>A comma-separated list of the API names of Job Record Types to which this sub status applies. Leave blank to apply to all.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>A comma-separated list of the API names of Job Record Types to which this sub status applies. Leave blank to apply to all.</inlineHelpText>
        <label>Job Record Types</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Sub_Status_Text__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of the sub status that this record applies to. Must match the API name of one of the picklist values in the Sub_Status__c.Value__c field.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of the sub status that this record applies to. Must match the API name of one of the picklist values in the Sub_Status__c.Value__c field.</inlineHelpText>
        <label>Sub Status</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Sub_Status__c</fullName>
        <deprecated>false</deprecated>
        <description>DEPRECATED</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>DEPRECATED</inlineHelpText>
        <label>DEPRECATED</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>In Progress</fullName>
                    <default>true</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Done</fullName>
                    <default>false</default>
                    <label>Done</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>ATSv2 Sub Status Configuration</label>
    <pluralLabel>ATSv2 Sub Status Configuration</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

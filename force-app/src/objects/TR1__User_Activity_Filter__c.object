    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>TR1__Activity_Types__c</fullName>
        <defaultValue>&apos;all, Email, ListEmail, Call, Events, Task&apos;</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>This field contains a list of activity types that will be displayed by default in the activity timeline.
The standard field value is &apos;all, Email, ListEmail, Call, Events, Task&apos;</inlineHelpText>
        <label>Activity Types</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Date_Range__c</fullName>
        <defaultValue>&apos;allTime&apos;</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The field contains a time range that contains the displayed activities..
The standard field value is &apos;allTime&apos;</inlineHelpText>
        <label>Date Range</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Show_All_Activities__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Boolean value, according to which either all activities related to the candidate will be displayed, or only those that the current user is the owner of.
The standard field value is &apos;true&apos;</inlineHelpText>
        <label>Show All Activities</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__UserId__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>UserId</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <label>User Activity Filter</label>
    <nameField>
        <displayFormat>A-{0000}</displayFormat>
        <label>Activity Filter Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>User Activity Filter</pluralLabel>

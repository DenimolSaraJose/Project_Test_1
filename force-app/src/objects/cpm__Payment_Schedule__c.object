    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__Collection_Date_must_be_in_the_future</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
  AND(
     NOT(ISPICKVAL( cpm__Status__c , &apos;Verified&apos;))
   , NOT(ISPICKVAL( cpm__Status__c , &apos;Done&apos;))
   , NOT(ISPICKVAL( cpm__Status__c , &apos;Pending Verification&apos;))
   , OR(
      ISPICKVAL( cpm__PaymentMethod__c, &apos;Direct Debit&apos;)
      ,ISPICKVAL( cpm__PaymentMethod__c, &apos;Credit Transfer&apos;)
    )
   , OR(
       ISPICKVAL( cpm__Payment_Processor__c, &apos;PaymentHub-CH-DD&apos;)
     , ISPICKVAL( cpm__Payment_Processor__c, &apos;PaymentHub-LSV&apos;)
     , ISPICKVAL( cpm__Payment_Processor__c, &apos;PaymentHub-BACS&apos;)
   )
   , NOT(ISNULL( cpm__Collection_Date__c ))
   , NOT(ISCHANGED(cpm__Report_Summary__c))
   , NOT(ISCHANGED(cpm__Total_Value__c))
   , NOT(ISCHANGED(cpm__Nr_Of_Installments__c))
   , cpm__Collection_Date__c &lt;= TODAY()
) , true, false )</errorConditionFormula>
        <errorDisplayField>cpm__Collection_Date__c</errorDisplayField>
        <errorMessage>Collection Date must be in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Collection_cant_be_in_the_past_for_SEPA</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
    AND(
        NOT(ISPICKVAL( cpm__Status__c , &apos;Verified&apos;)),
        NOT(ISPICKVAL( cpm__Status__c , &apos;Done&apos;)),
        NOT(ISPICKVAL( cpm__Status__c , &apos;Pending Verification&apos;)),
        OR(
            ISPICKVAL( cpm__PaymentMethod__c, &apos;Direct Debit&apos;),
            ISPICKVAL( cpm__PaymentMethod__c, &apos;Credit Transfer&apos;)
        ),
        OR(
            ISPICKVAL( cpm__Payment_Processor__c, &apos;PaymentHub-SEPA&apos;),
            ISPICKVAL( cpm__Payment_Processor__c, &apos;DummyExtension-PSP&apos;)
        ),
        NOT(ISNULL( cpm__Collection_Date__c )),
        cpm__Collection_Date__c &lt; TODAY()
    ),
    true,
    false
)</errorConditionFormula>
        <errorDisplayField>cpm__Collection_Date__c</errorDisplayField>
        <errorMessage>Collection Date can&apos;t be in the past</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Lock_Fiscal_Period</fullName>
        <active>true</active>
        <errorConditionFormula>cpm__Collection_Date__c &lt;= $Setup.cpm__Lock_Fiscal_Periods__c.cpm__Lock_Payments_Up_To__c</errorConditionFormula>
        <errorMessage>Fiscal period is closed. You can&apos;t edit this record</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Mandatory_Field_Check</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( OR ( ISBLANK(TEXT(cpm__Payment_Processor__c)) , ISBLANK (TEXT(cpm__PaymentMethod__c)) , ISBLANK(TEXT(cpm__Source__c)) ), true, false )</errorConditionFormula>
        <errorMessage>Payment Method, Payment Processor and Source are required</errorMessage>
    </validationRules>

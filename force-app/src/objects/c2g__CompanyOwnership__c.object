    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>c2g__CompanyOwnershipCompactLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>c2g__CompanyOwnershipCompactLayout</fullName>
        <fields>c2g__CompanyName__c</fields>

        <label>Company Ownership Compact Layout</label>
    </compactLayouts>
    <customHelpPage>c2g__companyownershiphelp</customHelpPage>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Stores information about a company&apos;s ownership structure.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>c2g__CompanyName__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>If(c2g__ExternalCompany__c != null,  c2g__ExternalCompany__c , c2g__InternalCompany__r.Name)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Investor Company</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__Company__c</fullName>
        <deprecated>false</deprecated>
        <description>Master-Detail link to the Investment Company.</description>
        <label>Investment Company</label>
        <referenceTo>c2g__codaCompany__c</referenceTo>
        <relationshipLabel>Company Ownership</relationshipLabel>
        <relationshipName>CompanyOwnership</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>c2g__EndDateOfOwnership__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates the end date of the ownership.</description>
        <label>End Date of Ownership</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__ExternalCompany__c</fullName>
        <deprecated>false</deprecated>
        <description>External Investor.</description>
        <externalId>false</externalId>
        <label>External Investor</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__InternalCompany__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the Internal Investor.</description>
        <label>Internal Investor</label>
        <referenceTo>c2g__codaCompany__c</referenceTo>
        <relationshipLabel>Company Ownership (Internal Investor)</relationshipLabel>
        <relationshipName>ParentCompany</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__Internal__c</fullName>
        <deprecated>false</deprecated>
        <formula>c2g__InternalCompany__c != null</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Internal</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__IsActive__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Checkbox to indicate if a company ownership is active.</description>
        <inlineHelpText>You cannot deselect this field. If selected, you can only edit the end date field for this record.</inlineHelpText>
        <label>Is Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__OwnershipCategory__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates the category of the ownership.</description>
        <label>Ownership Category</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Control</fullName>
                    <default>false</default>
                    <label>Control</label>
                </value>
                <value>
                    <fullName>Significant Influence</fullName>
                    <default>false</default>
                    <label>Significant Influence</label>
                </value>
                <value>
                    <fullName>Joint Venture</fullName>
                    <default>false</default>
                    <label>Joint Venture</label>
                </value>
                <value>
                    <fullName>Joint Operation</fullName>
                    <default>false</default>
                    <label>Joint Operation</label>
                </value>
                <value>
                    <fullName>Minority Interest</fullName>
                    <default>false</default>
                    <label>Minority Interest</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__PercentageOwnership__c</fullName>
        <deprecated>false</deprecated>
        <label>Ownership (%)</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>c2g__StartDateOfOwnership__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates the start date of the ownership.</description>
        <label>Start Date of Ownership</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <label>Company Ownership</label>
    <listViews>
        <fullName>c2g__All</fullName>
        <columns>NAME</columns>
        <columns>c2g__InternalCompany__c</columns>
        <columns>c2g__ExternalCompany__c</columns>
        <columns>c2g__Company__c</columns>
        <columns>c2g__OwnershipCategory__c</columns>

    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Refunds are amounts returned to customers for various reasons.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>cpm__Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The account that requested the refund, taken from the related original Payment record.</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipName>Refunds</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>The refund amount. This may be less than or equal to Amount of the Originating Payment record amount.</description>
        <inlineHelpText>The amount of the refund. This must be less than or equal to the amount of the Originating Payment record.</inlineHelpText>
        <label>Amount</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>cpm__Comments__c</fullName>
        <deprecated>false</deprecated>
        <description>Optional free text field for a more detailed explanation of the refund event. This field can be used as input, for example, for later follow up as part of an internal review process.</description>
        <label>Comments</label>
        <length>1000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>cpm__Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The contact that requested the refund, taken from the related original Payment record.</description>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipName>Refunds</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Installment__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Installment record related to the refund request.</description>
        <inlineHelpText>The installment linked ot the originating payment.</inlineHelpText>
        <label>Installment</label>
        <referenceTo>cpm__Installment__c</referenceTo>
        <relationshipLabel>Refunds</relationshipLabel>
        <relationshipName>Refunds</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Last_Status_Reason__c</fullName>
        <deprecated>false</deprecated>
        <description>Details about the latest Status update for the record, received from the PSP or provided by FinDock.</description>
        <label>Last Status Reason</label>
        <length>32000</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>cpm__Original_Payment_Reference__c</fullName>
        <deprecated>false</deprecated>
        <description>Payment reference of the original payment being refunded, taken from the Payment record of the linked Installment record.</description>
        <externalId>false</externalId>
        <formula>cpm__Originating_Payment__r.cpm__Payment_Reference__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The unique reference from the original, collected payment to be refunded.</inlineHelpText>
        <label>Original Payment Reference</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Originating_Payment__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The Payment record that represents the original receivable transaction to be refunded.</description>
        <inlineHelpText>The original, positive payment, linked to a collected installment, that needs to be refunded.</inlineHelpText>
        <label>Originating Payment</label>
        <referenceTo>cpm__Payment__c</referenceTo>
        <relationshipLabel>Refunds</relationshipLabel>
        <relationshipName>Refunds</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Payment_Method__c</fullName>
        <deprecated>false</deprecated>
        <description>The payment method used to pay the refund.</description>
        <inlineHelpText>The payment method used to pay the refund.</inlineHelpText>
        <label>Payment Method</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>None</fullName>
                    <default>false</default>
                    <label>None</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Payment_Processor__c</fullName>
        <deprecated>false</deprecated>
        <description>The payment processor used to process the refund transaction.</description>
        <inlineHelpText>The payment processor used to process the refund.</inlineHelpText>
        <label>Payment Processor</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>cpm__Payment_Method__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>None</fullName>
                    <default>false</default>
                    <label>None</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Processor_Reference__c</fullName>
        <deprecated>false</deprecated>
        <description>Refund payment reference provided by the PSP.</description>
        <externalId>true</externalId>
        <label>Processor Reference</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Refund_Date__c</fullName>
        <deprecated>false</deprecated>
        <description>Date the refund was confirmed.</description>
        <label>Refund Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>cpm__Refund_Payment__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The Payment record the represents that refund transaction.</description>
        <inlineHelpText>The negative payment that records the successful refund to the payer.</inlineHelpText>
        <label>Refund Payment</label>
        <referenceTo>cpm__Payment__c</referenceTo>
        <relationshipLabel>Refund Payment</relationshipLabel>
        <relationshipName>RefundPayments</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Refund_Reason__c</fullName>
        <deprecated>false</deprecated>
        <description>Customizable picklist of refund reasons. Default values include Customer request, Duplicate and Other.</description>
        <inlineHelpText>The reason the refund has been created.</inlineHelpText>
        <label>Refund Reason</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Duplicate</fullName>
                    <default>false</default>
                    <label>Duplicate</label>
                </value>
                <value>
                    <fullName>Customer request</fullName>
                    <default>false</default>
                    <label>Customer request</label>
                </value>
                <value>
                    <fullName>Other</fullName>
                    <default>false</default>
                    <label>Other</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Refund_Reference__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>Final payment reference for the refund transaction.</description>
        <externalId>false</externalId>
        <inlineHelpText>The unique reference for tracking the refund.</inlineHelpText>
        <label>Refund Reference</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>cpm__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Status of the refund transaction. Once the transaction is complete, the Refund record status is Refunded, and a Payment record is created and linked to the Refund record.</description>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New</fullName>
                    <default>true</default>
                    <label>New</label>
                </value>
                <value>
                    <fullName>Pending Processing</fullName>
                    <default>false</default>
                    <label>Pending Processing</label>
                </value>
                <value>
                    <fullName>Completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Target__c</fullName>
        <deprecated>false</deprecated>
        <description>The target (merchant account) from which the refund payment is made.</description>
        <inlineHelpText>The (merchant) account used to pay the refund.</inlineHelpText>
        <label>Target</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>cpm__Payment_Processor__c</controllingField>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>None</fullName>
                    <default>false</default>
                    <label>None</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Refund</label>
    <listViews>
        <fullName>cpm__All</fullName>
        <columns>NAME</columns>
        <columns>cpm__Originating_Payment__c</columns>
        <columns>cpm__Status__c</columns>
        <columns>cpm__Amount__c</columns>
        <columns>cpm__Payment_Processor__c</columns>
        <columns>cpm__Payment_Method__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>RFND-{000000}</displayFormat>
        <label>Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Refunds</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>cpm__Originating_Payment__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>cpm__Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>cpm__Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>cpm__Payment_Processor__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>cpm__Payment_Method__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATED_DATE</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__Refund_Amount_Validation</fullName>
        <active>true</active>
        <description>Refund amount must be greater than 0 and cannot exceed the original payment amount.</description>
        <errorConditionFormula>OR(cpm__Amount__c &lt;= 0, cpm__Amount__c &gt; cpm__Originating_Payment__r.cpm__Amount__c)</errorConditionFormula>
        <errorDisplayField>cpm__Amount__c</errorDisplayField>
        <errorMessage>Refund amount must be greater than 0 and cannot exceed the original payment amount.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

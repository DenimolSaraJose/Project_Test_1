    <fields>
        <fullName>c2g__AccountType__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF( c2g__Account__r.c2g__CODAIntercompanyAccount__c, &apos;Intercompany&apos;,
		IF(AND(c2g__Account__r.c2g__CODAAccountsPayableControl__c != NULL, c2g__Account__r.c2g__CODAAccountsReceivableControl__c != NULL, c2g__Account__r.c2g__CODAAccountsPayableControl__c = c2g__Account__r.c2g__CODAAccountsReceivableControl__c),
		&apos;Customer - Vendor&apos;,
		IF(AND(c2g__Account__r.c2g__CODAAccountsPayableControl__c != NULL, c2g__Account__r.c2g__CODAAccountsPayableControl__c =  c2g__GeneralLedgerAccount__c) ,
		&apos;Vendor&apos;,
		IF(AND(c2g__Account__r.c2g__CODAAccountsReceivableControl__c != NULL, c2g__Account__r.c2g__CODAAccountsReceivableControl__c = c2g__GeneralLedgerAccount__c),
		&apos;Customer&apos;,
		NULL))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

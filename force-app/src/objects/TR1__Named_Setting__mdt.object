<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows specifically named settings in BH4SF to be provided by an org admin. The permitted names and allowed configuration is covered in product documentation.</description>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Enable or disable the setting. Inactive settings are treated as if they don’t exist.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Enable or disable the setting. Inactive settings are treated as if they don’t exist.</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Configuration__c</fullName>
        <deprecated>false</deprecated>
        <description>The value of the named setting. The format and content varies by name.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The value of the named setting. The format and content varies by name.</inlineHelpText>
        <label>Configuration</label>
        <length>131072</length>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Schema__c</fullName>
        <deprecated>false</deprecated>
        <description>Where the configuration must adhere to a specific schema, the schema&apos;s URL can be specified here.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Where the configuration must adhere to a specific schema, the schema&apos;s URL can be specified here.</inlineHelpText>
        <label>Schema</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <label>Named Setting(BH4SF)</label>
    <pluralLabel>Named Settings(BH4SF)</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

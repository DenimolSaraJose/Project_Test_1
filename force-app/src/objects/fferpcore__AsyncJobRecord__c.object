    <fields>
        <fullName>fferpcore__Complete__c</fullName>
        <deprecated>false</deprecated>
        <description>Has processing of this record completed.</description>
        <formula>AND(
            OR(ISPICKVAL(fferpcore__Status__c, &apos;COMPLETE&apos;), ISPICKVAL(fferpcore__Status__c, &apos;ERROR&apos;)), 
            OR(
                ISBLANK(fferpcore__FinalizerCallableName__c),
                ISPICKVAL(fferpcore__FinalizerStatus__c, &apos;COMPLETE&apos;), 
                ISPICKVAL(fferpcore__FinalizerStatus__c, &apos;ERROR&apos;)
            )
        )</formula>
        <label>Complete</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

    <fields>
        <fullName>c2g__AuditDataDeleteBatchChunkSize__c</fullName>
        <defaultValue>2000</defaultValue>
        <deprecated>false</deprecated>
        <description>Defines the number of audit data line items processed by the Audit Data Delete Batch process in a single chunk. The default value is 2,000.</description>
        <externalId>false</externalId>
        <inlineHelpText>Defines the number of audit data line items processed by the Audit Data Delete Batch process in a single chunk. The default value is 2,000.</inlineHelpText>

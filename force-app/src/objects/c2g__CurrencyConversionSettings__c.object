<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Currency Conversion Settings</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__CreateZeroCRVDocumentsAsDiscarded__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Custom field set name to create zero CRV documents as &apos;Discarded&apos;</description>
        <inlineHelpText>If selected, zero value documents created by currency revaluation are created with a status of &quot;Discarded&quot;.</inlineHelpText>
        <label>Create zero CRV documents as &apos;Discarded&apos;</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__DeleteCRVDiscardedDocuments__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Custom field set name to delete zero value discarded CRV documents</description>
        <inlineHelpText>If selected, zero value  documents created by currency revaluation with the status &apos;Discarded&apos; are automatically deleted.</inlineHelpText>
        <label>Delete Discarded CRV Documents</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Currency Conversion Settings</label>
    <visibility>Public</visibility>
</CustomObject>

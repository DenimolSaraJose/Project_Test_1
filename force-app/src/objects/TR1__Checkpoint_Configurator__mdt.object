<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Custom Metadata that allows admins to override the Off Limits Line Item&apos;s behavior type and set a specific behavior for a chosen action.</description>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Specifies if it is an active setting record</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Specifies if it is an active setting record</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>Action for which a checkpoint is setup to enforce a given behavior</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Action for which a checkpoint is setup to enforce a given behavior</inlineHelpText>
        <label>Checkpoint</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>TR1__Override_Block_Behavior__c</fullName>
        <deprecated>false</deprecated>
        <description>Block behavior set on Off Limits Line Item will be overridden with these values:

None - The off-limit behavior is respected
Warn - Apply warning behavior
Allow - Apply no off-limits</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>None - The off-limit behavior is respected
Warn - Apply warning behavior
Allow - Apply no off-limits</inlineHelpText>
        <label>Override Block Behavior</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>None</fullName>
                    <default>true</default>
                    <label>None</label>
                </value>
                <value>
                    <fullName>Warn</fullName>
                    <default>false</default>
                    <label>Warn</label>
                </value>
                <value>
                    <fullName>Allow</fullName>
                    <default>false</default>
                    <label>Allow</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Override_Warn_Behavior__c</fullName>
        <deprecated>false</deprecated>
        <description>Warn behavior set on Off Limits Line Item will be overridden with these values:

None - The off-limit behavior is respected
Block - Apply blocking behavior
Allow - Apply no off-limits</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>None - The off-limit behavior is respected
Block - Apply blocking behavior
Allow - Apply no off-limits</inlineHelpText>
        <label>Override Warn Behavior</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>None</fullName>
                    <default>true</default>
                    <label>None</label>
                </value>
                <value>
                    <fullName>Block</fullName>
                    <default>false</default>
                    <label>Block</label>
                </value>
                <value>
                    <fullName>Allow</fullName>
                    <default>false</default>
                    <label>Allow</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Checkpoint Configurator</label>
    <pluralLabel>Checkpoint Configurator</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

    <validationRules>
        <fullName>TR1__Default_Rank_On_Block_Type_Rule</fullName>
        <active>true</active>
        <description>The default Rank value should be positive Integer number.</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(TR1__Default_Rank_On_Block_Type__c)),
TR1__Default_Rank_On_Block_Type__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>TR1__Default_Rank_On_Block_Type__c</errorDisplayField>
        <errorMessage>The default Rank value should be positive Integer number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Default_Rank_On_Warn_Type_Rule</fullName>
        <active>true</active>
        <description>The default Rank value should be positive Integer number.</description>
        <errorConditionFormula>AND(
NOT(ISBLANK(TR1__Default_Rank_On_Warn_Type__c)),
TR1__Default_Rank_On_Warn_Type__c &lt;= 0
)</errorConditionFormula>
        <errorDisplayField>TR1__Default_Rank_On_Warn_Type__c</errorDisplayField>
        <errorMessage>The default Rank value should be positive Integer number.</errorMessage>
    </validationRules>

        <inlineHelpText>Controls how the sync with Textkernel will behave</inlineHelpText>
        <label>Sync Behaviour</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Do not call sync (only generate the index record)</fullName>
                    <default>false</default>
                    <label>Allow configured service to perform sync</label>
                </value>
                <value>
                    <fullName>Call a scheduler to sync in another transaction</fullName>
                    <default>true</default>
                    <label>Call a scheduler to sync in another transaction</label>
                </value>
                <value>
                    <fullName>Call sync in same transaction</fullName>
                    <default>false</default>
                    <label>Call sync in same transaction</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Sync_Debug__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Admin only setting: getting debug logs for Textkernel syncs</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Admin only setting: getting debug logs for Textkernel syncs</inlineHelpText>
        <label>Sync Debug</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Threshold__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Max queue size in BHTK_Indexing_Status__c table (=number of records ready for indexing). If number of unprocessed records exceeds threshold value, then they will be processed externally (not as &apos;queueable&apos;)</inlineHelpText>
        <label>Threshold</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Trigger_Indexing_Call_For_Async_Jobs__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Allow IndexStatus records being created when changes are done in Async Contexts, like a Batch class</inlineHelpText>
        <label>Trigger indexing call for Async jobs</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Use_round_robin_offset__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Enable round-robin offset mechanizm to avoid indexing concurrencies</inlineHelpText>
        <label>Use round-robin offset</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__User_sharing_field__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The fieldname used for sharing on the user object, see documentation for guidelines on how to configure sharing.</inlineHelpText>
        <label>User sharing field</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Textkernel configuration</label>
    <pluralLabel>Textkernel configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

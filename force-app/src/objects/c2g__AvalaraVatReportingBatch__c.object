        <summaryFilterItems>
            <field>c2g__AvalaraVatReportingLog__c.c2g__LogType__c</field>
            <operation>equals</operation>
            <value>Error</value>
        </summaryFilterItems>
        <summaryForeignKey>c2g__AvalaraVatReportingLog__c.c2g__AvalaraVatReportingBatch__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>c2g__TotalNumberOfExternal__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of logs where Log Type is External.</description>
        <label>Total Number of External</label>
        <summaryFilterItems>
            <field>c2g__AvalaraVatReportingLog__c.c2g__LogType__c</field>
            <operation>equals</operation>
            <value>External</value>
        </summaryFilterItems>
        <summaryForeignKey>c2g__AvalaraVatReportingLog__c.c2g__AvalaraVatReportingBatch__c</summaryForeignKey>

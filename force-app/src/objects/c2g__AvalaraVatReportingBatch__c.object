    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <customHelpPage>c2g__helpavalaravatreportingbatch</customHelpPage>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Stores the status and details of Avalara VAT Reporting batch Apex jobs.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__ApexJobId__c</fullName>
        <deprecated>false</deprecated>
        <description>Unique identifier for the current batch Apex job.</description>
        <externalId>false</externalId>
        <label>Apex Job ID</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__BatchProcess__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the batch process record. The record is deleted automatically when the process completes.</description>
        <label>Batch Process</label>
        <referenceTo>c2g__fflib_BatchProcess__c</referenceTo>
        <relationshipName>AvalaraVatReportingProcessBatch</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__NotificationType__c</fullName>
        <deprecated>false</deprecated>
        <description>The type of notification sent when the process completed: Successful, Failure, or Mixed.</description>
        <externalId>false</externalId>
        <formula>IF( c2g__TotalNumberOfLogs__c = 0, &apos;Successful&apos;,
IF ( AND( c2g__TotalNumberOfErrors__c=0,c2g__TotalNumberOfAborts__c=0,c2g__TotalNumberOfExternal__c=0),
&apos;Successful&apos;,
IF(c2g__TotalNumberOfErrors__c = c2g__TotalNumberOfLogs__c,
&apos;Failure&apos;,
IF(c2g__TotalNumberOfAborts__c &gt; 0,
&apos;Failure&apos;,
IF( c2g__TotalNumberOfExternal__c &gt; 0,
&apos;Failure&apos;,
&apos;Mixed&apos;
)
)
)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Notification Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>The current status of the batch job: &quot;Processing&quot;, &quot;Complete&quot;, or &quot;Error&quot;.</description>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Processing</fullName>
                    <default>false</default>
                    <label>Processing</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__TotalNumberOfAborts__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of logs where Log Type is Abort.</description>
        <label>Total Number of Aborts</label>
        <summaryFilterItems>
            <field>c2g__AvalaraVatReportingLog__c.c2g__LogType__c</field>
            <operation>equals</operation>
            <value>Abort</value>
        </summaryFilterItems>
        <summaryForeignKey>c2g__AvalaraVatReportingLog__c.c2g__AvalaraVatReportingBatch__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>c2g__TotalNumberOfErrors__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of logs where Log Type is Error.</description>

    <recordTypes>
        <fullName>GeneralDomain</fullName>
        <active>true</active>
        <description>A general domain describes an area of expertise at a high level, using broad statements to determine overall proficiency without breaking the subject into specific components.</description>
        <label>General Domain</label>
        <picklistValues>
            <picklist>ScoreType__c</picklist>
            <values>
                <fullName>Statement</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Value</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>SelectionType__c</picklist>
            <values>
                <fullName>Multiple</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Single</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>GranularDomain</fullName>
        <active>true</active>
        <description>A granular domain breaks an area of expertise into individual, experience-based skills. Each skill is assessed - either via a simple yes/no (experienced or not experienced) or on a scaled metric.</description>
        <label>Granular Domain</label>
        <picklistValues>
            <picklist>ScoreType__c</picklist>
            <values>
                <fullName>Skill Set</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>SelectionType__c</picklist>
            <values>
                <fullName>Multiple</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Single</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>

    <fields>
        <fullName>TR1__Contact_Daxtra_Id__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>TR1__Contact__r.TR1__External_Candidate_Id__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>External Candidate Id</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Contact_Details__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/&quot;+ TR1__Contact__c ,  TR1__Contact__r.FirstName &amp;&quot; &quot; &amp;  TR1__Contact__r.LastName, &quot;_blank&quot;) 
&amp; BR() &amp; HYPERLINK( &quot;mailto:&quot; &amp; TR1__Contact__r.Email , TR1__Contact__r.Email,&quot;_self&quot;)
&amp; BR() &amp; TR1__Contact__r.Phone</formula>
        <label>Contact Details</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Contact__c</fullName>
        <deprecated>false</deprecated>
        <label>Contact</label>
        <lookupFilter>
            <active>false</active>
            <filterItems>
                <field>Contact.TR1__Is_Calllist_Contact__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>Call List Members</relationshipLabel>
        <relationshipName>Call_List_Members</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>true</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>TR1__Email__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/_ui/core/email/author/EmailAuthor?p2_lkid=&quot; &amp; TR1__Contact__c &amp; &quot;&amp;rtype=003&amp;p3_lkid=&quot; &amp; TR1__Call_List__r.Id &amp; &quot;&amp;retURL=%2F&quot; &amp; TR1__Call_List__c , IMAGE(&quot;/resource/TR1__SLDS092/assets/icons/utility/email_60.png&quot;,&quot;Email&quot;,32,32),&quot;_parent&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Email</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Log_a_Call__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;/apex/TR1__calllog?CallListId=&quot;+TR1__Call_List__c+&quot;&amp;retURL=&quot;+TR1__Call_List__c+&quot;&amp;contactId=&quot;+TR1__Contact__c,IMAGE(&quot;/resource/TR1__SLDS092/assets/icons/utility/call_60.png&quot;,&quot;Log a Call&quot;,32,32),&quot;_parent&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Log a Call</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

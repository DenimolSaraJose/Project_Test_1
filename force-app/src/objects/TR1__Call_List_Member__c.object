    <fields>
        <fullName>TR1__Call_List__c</fullName>
        <deprecated>false</deprecated>
        <label>Call List</label>
        <referenceTo>TR1__Call_List__c</referenceTo>
        <relationshipLabel>Call List Members</relationshipLabel>

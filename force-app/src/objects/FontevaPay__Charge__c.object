    <fields>
        <fullName>FontevaPay__Reconciliation__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(TEXT(FontevaPay__EPayment__r.OrderApi__Amount__c)), NULL,
CASE(FontevaPay__Type__c, 
&apos;Charge&apos;, FontevaPay__EPayment__r.OrderApi__Amount__c, 
&apos;Refund&apos;, FontevaPay__EPayment__r.OrderApi__Amount__c * -1,
&apos;Transfer&apos;, 0,
NULL
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Reconciliation</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>

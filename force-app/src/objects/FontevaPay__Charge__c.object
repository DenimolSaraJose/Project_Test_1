    <validationRules>
        <fullName>FontevaPay__StripeAccountId_Required_for_Adjustment</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
                ISPICKVAL(FontevaPay__Type__c, &apos;Adjustment&apos;),
                ISBLANK(FontevaPay__Stripe_Connected_Account_Id__c)
            )</errorConditionFormula>
        <errorDisplayField>FontevaPay__Stripe_Connected_Account_Id__c</errorDisplayField>
        <errorMessage>Stripe Connected Account Id field is required when Type is Adjustment</errorMessage>
    </validationRules>

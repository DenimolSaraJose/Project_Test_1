    <fields>
        <fullName>FontevaPay__Issue__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(FontevaPay__EPayment__c) &amp;&amp; (NOT(ISPICKVAL(FontevaPay__Type__c, &apos;Transfer&apos;)) || (ISPICKVAL(FontevaPay__Type__c, &apos;Transfer&apos;) &amp;&amp; ISBLANK(FontevaPay__Parent_Charge__c))), $Label.FontevaPay__Missing_Epayment_Issue, 
    IF(ISBLANK(FontevaPay__Sales_Order__c), $Label.FontevaPay__Missing_Order_Issue,
        IF((NOT(ISPICKVAL(FontevaPay__Type__c, &apos;Transfer&apos;)) || (ISPICKVAL(FontevaPay__Type__c, &apos;Transfer&apos;) &amp;&amp; ISBLANK(FontevaPay__Parent_Charge__c))) &amp;&amp; FontevaPay__Reconciliation__c != FontevaPay__Amount__c , $Label.FontevaPay__Mismatch_Amount_Issue,
            NULL
        )
    )
)</formula>
        <label>Issue</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

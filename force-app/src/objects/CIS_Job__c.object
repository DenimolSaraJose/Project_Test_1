                    <fullName>Chair - Pathway 2</fullName>
                    <default>false</default>
                    <label>Chair - Pathway 2</label>
                </value>
                <value>
                    <fullName>Team Member - Pathway 2</fullName>
                    <default>false</default>
                    <label>Team Member - Pathway 2</label>
                </value>
                <value>
                    <fullName>Peer - LC Protocol</fullName>

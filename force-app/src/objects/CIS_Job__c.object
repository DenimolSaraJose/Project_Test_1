    </fields>
    <fields>
        <fullName>Publish__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>Check if you want to make this position public</inlineHelpText>
        <label>Publish</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Recommended_as_Co_Chair__c</fullName>
        <label>Recommended as Co-Chair</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Yes</fullName>
                    <default>false</default>
                    <label>Yes</label>
                </value>
                <value>
                    <fullName>Not at this time</fullName>
                    <default>false</default>
                    <label>Not at this time</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ReferenceId__c</fullName>
        <caseSensitive>true</caseSensitive>
        <externalId>true</externalId>
        <inlineHelpText>Deprecated Record ID (TalentRover)</inlineHelpText>
        <label>Reference ID</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Selected_Candidate__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Selected Candidate</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>CIS Jobs (Selected Candidate)</relationshipLabel>
        <relationshipName>CIS_Jobs_Selected_Candidate</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Total_Applications__c</fullName>
        <label>Total Applications</label>
        <summaryForeignKey>CIS_Application__c.Job__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Writing_Ability__c</fullName>
        <label>Writing Ability</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Excellent</fullName>
                    <default>false</default>
                    <label>Excellent</label>
                </value>
                <value>
                    <fullName>Good</fullName>
                    <default>false</default>
                    <label>Good</label>
                </value>
                <value>
                    <fullName>Average</fullName>
                    <default>false</default>
                    <label>Average</label>
                </value>
                <value>
                    <fullName>Weak</fullName>
                    <default>false</default>
                    <label>Weak</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>CIS Job</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Job_Start_Date__c</columns>
        <columns>Application_Deadline__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>All_Open_Positions</fullName>
        <columns>NAME</columns>
        <columns>Country__c</columns>
        <columns>Position__c</columns>
        <columns>Job_Start_Date__c</columns>
        <columns>End_Date__c</columns>
        <columns>Application_Deadline__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Job_Start_Date__c</field>
            <operation>greaterOrEqual</operation>
            <value>1/1/2026</value>
        </filters>
        <filters>
            <field>Community_Status__c</field>
            <operation>equals</operation>
            <value>Published</value>
        </filters>
        <label>All Open Positions</label>
    </listViews>
    <nameField>
        <label>Job Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>CIS Jobs</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Contact__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Position__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>End_Date__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Community_User_can_not_change_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISCHANGED(OwnerId),
ISPICKVAL( $User.UserType , &quot;PowerCustomerSuccess&quot;))</errorConditionFormula>
        <errorMessage>You&apos;re not allowed to change the owner of this Position.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>c2g__DaysToPay__c</fullName>
        <deprecated>false</deprecated>
        <description>Number of days the customer took to pay. This value is used to calculate the Average Days to Pay on the Account object.</description>
        <externalId>false</externalId>
        <formula>IF(AND(ISPICKVAL(c2g__TransactionLineItem__r.c2g__Transaction__r.c2g__TransactionType__c, &apos;Invoice&apos;), c2g__AccountOutstandingValue__c == 0), c2g__MatchingDate__c -  c2g__TransactionLineItem__r.c2g__Transaction__r.c2g__TransactionDate__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Days to Pay</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>

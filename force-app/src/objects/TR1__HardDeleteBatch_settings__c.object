<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Used in HardDeleteBatch global class to delete the records and remove it from the Recycle Bin based on the SOQL query provided in the setting</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__SOQL_query__c</fullName>
        <deprecated>false</deprecated>
        <description>SOQL query for HardDeleteBatch</description>
        <externalId>false</externalId>
        <label>SOQL query</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>HardDeleteBatch settings</label>
    <visibility>Public</visibility>
</CustomObject>

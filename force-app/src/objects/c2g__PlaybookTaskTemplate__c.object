    <fields>
        <fullName>c2g__CalculateDueDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of days to calculate the due date of the accounting playbook tasks generated from the accounting playbook task template.</description>
        <externalId>false</externalId>
        <inlineHelpText>The number of days to calculate the due date of the accounting playbook tasks generated from this accounting playbook task template.</inlineHelpText>
        <label>Calculate Due Date</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>

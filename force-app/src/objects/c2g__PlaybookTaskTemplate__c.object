        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>c2g__ExcludePublicHolidays__c</fullName>
        <deprecated>false</deprecated>
        <description>If selected, the public holidays defined for the org are excluded when counting the number of days to calculate the due date of the task generated from the playbook task template.</description>
        <formula>c2g__PlaybookTemplate__r.c2g__ExcludePublicHolidays__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exclude Public Holidays</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ExcludeWeekends__c</fullName>
        <deprecated>false</deprecated>
        <description>If selected, the weekends are excluded when counting the number of days to calculate the due date of the task generated from the playbook task template.</description>
        <formula>c2g__PlaybookTemplate__r.c2g__ExcludeWeekends__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exclude Weekends</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

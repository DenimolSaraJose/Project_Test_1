    <validationRules>
        <fullName>Business_Manager_needed</fullName>
        <active>true</active>
        <errorConditionFormula>IF( Business_Manager_needed__c   &gt;=   2 , true, false)</errorConditionFormula>
        <errorDisplayField>Business_Manager_needed__c</errorDisplayField>
        <errorMessage>Business Manager needed  can only be stored 0 or 1.</errorMessage>
    </validationRules>

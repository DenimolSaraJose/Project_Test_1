    <fields>
        <fullName>Invoice_Description__c</fullName>
        <externalId>false</externalId>
        <formula>IF(

NOT(ISBLANK( Opportunity__c )),  Opportunity__r.Name ,


Description__c &amp; IF( ISPICKVAL( Billing_period_of_Contract__c  ,&quot;Yearly&quot;), &quot; - &quot; &amp; &quot;Start Date &quot; &amp;TEXT(DAY(Start_date__c)) &amp; &quot;-&quot;&amp;  TEXT(MONTH(Start_date__c)) &amp;&quot;-&quot; &amp;  TEXT(YEAR(Start_date__c))  &amp; &quot; - &quot; &amp; &quot;End Date &quot; &amp; TEXT(DAY( End_Date2__c )) &amp; &quot;-&quot;&amp; TEXT(MONTH(End_Date2__c)) &amp;&quot;-&quot;&amp; TEXT(YEAR(End_Date2__c)) , 
 
 IF( ISPICKVAL( Type__c  ,&quot;Membership Evaluation&quot;), &quot; - &quot; &amp; &quot;Start Date &quot; &amp;TEXT(DAY(Start_date__c)) &amp; &quot;-&quot;&amp;  TEXT(MONTH(Start_date__c)) &amp;&quot;-&quot; &amp;  TEXT(YEAR(Start_date__c))  &amp; &quot; - &quot; &amp; &quot;End Date &quot; &amp; TEXT(DAY( End_Date2__c )) &amp; &quot;-&quot;&amp; TEXT(MONTH(End_Date2__c)) &amp;&quot;-&quot;&amp; TEXT(YEAR(End_Date2__c)), 

 IF( ISPICKVAL( Type__c  ,&quot;Team Evaluation&quot;), &quot; - &quot; &amp; &quot;Start Date &quot; &amp;TEXT(DAY(Start_date__c)) &amp; &quot;-&quot;&amp;  TEXT(MONTH(Start_date__c)) &amp;&quot;-&quot; &amp;  TEXT(YEAR(Start_date__c))  &amp; &quot; - &quot; &amp; &quot;End Date &quot; &amp; TEXT(DAY( End_Date2__c )) &amp; &quot;-&quot;&amp; TEXT(MONTH(End_Date2__c)) &amp;&quot;-&quot;&amp; TEXT(YEAR(End_Date2__c)),
	
 IF( ISPICKVAL( Type__c  ,&quot;Preparatory Evaluation&quot;), &quot; - &quot; &amp; &quot;Start Date &quot; &amp;TEXT(DAY(Start_date__c)) &amp; &quot;-&quot;&amp;  TEXT(MONTH(Start_date__c)) &amp;&quot;-&quot; &amp;  TEXT(YEAR(Start_date__c))  &amp; &quot; - &quot; &amp; &quot;End Date &quot; &amp; TEXT(DAY( End_Date2__c )) &amp; &quot;-&quot;&amp; TEXT(MONTH(End_Date2__c)) &amp;&quot;-&quot;&amp; TEXT(YEAR(End_Date2__c)),
 &quot;&quot;))))
 
 )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Invoice Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>

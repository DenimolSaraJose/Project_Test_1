    <fields>
        <fullName>c2g__Description__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the description of the Invoice filter criteria.</description>
        <externalId>false</externalId>
        <inlineHelpText>Description of the Invoice filter criteria.</inlineHelpText>
        <label>Description</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__FieldAPIName__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the API name of the Invoice record filter criteria.</description>
        <externalId>false</externalId>
        <inlineHelpText>API name of the field used to filter records with the specified value. This field must exist on the Invoice object or a related object.</inlineHelpText>
        <label>Field API Name</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__InvoiceConsolidationRule__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores parent Invoice Consolidation Rule.</description>
        <label>Invoice Consolidation Rule</label>
        <referenceTo>c2g__InvoiceConsolidationRule__c</referenceTo>
        <relationshipLabel>Invoice Filter Criteria</relationshipLabel>
        <relationshipName>InvoiceFilterCriteria</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>c2g__Value__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the value of the Invoice record filter criteria.</description>
        <externalId>false</externalId>
        <inlineHelpText>Required value of the filter field. Records that have this value for the specified field are returned by the rule. Date values must be entered as YYYY-MM-DD.</inlineHelpText>
        <label>Value</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Invoice Filter Criteria</label>
    <nameField>
        <displayFormat>IFC-{0000000}</displayFormat>
        <label>Invoice Filter Criteria</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Invoice Filter Criteria</pluralLabel>

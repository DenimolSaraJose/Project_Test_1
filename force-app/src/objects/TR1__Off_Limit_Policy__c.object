    <fields>
        <fullName>TR1__Additional_Days_on_Role_Update__c</fullName>
        <deprecated>false</deprecated>
        <description>Days added to Off Limit Duration after triggering the update behavior on Job Role Change. The &apos;clock&apos; starts on the Job Role change date, so effectively the value in this field is the &apos;new&apos; Duration</description>
        <externalId>false</externalId>
        <inlineHelpText>Days added to Off Limit Duration after triggering the update behavior on Job Role Change. The &apos;clock&apos; starts on the Job Role change date, so effectively the value in this field is the &apos;new&apos; Duration</inlineHelpText>
        <label>Additional Days on Role Update</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Additional_Days_on_Stage_Update__c</fullName>
        <deprecated>false</deprecated>

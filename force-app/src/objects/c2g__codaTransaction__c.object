    <fields>
        <fullName>c2g__HomeCredits__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(c2g__Credits__c &lt; 0, c2g__Credits__c * -1, c2g__Credits__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Shows the total of credit values in home currency, displayed without a minus sign.</inlineHelpText>
        <label>Home Credits</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>

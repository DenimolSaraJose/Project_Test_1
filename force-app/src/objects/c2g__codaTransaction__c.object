        <fullName>c2g__AvalaraIntegrationStatus__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the current status of transaction.</description>
        <inlineHelpText>Stores Avalara VAT Reporting status of transaction.</inlineHelpText>
        <label>Avalara Integration Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Excluded</fullName>
                    <default>false</default>
                    <label>Excluded</label>
                </value>
                <value>
                    <fullName>FF Error</fullName>
                    <default>false</default>
                    <label>FF Error</label>
                </value>
                <value>
                    <fullName>Ready for Sending</fullName>
                    <default>false</default>
                    <label>Ready for Sending</label>
                </value>
                <value>
                    <fullName>Repo Error</fullName>
                    <default>false</default>
                    <label>Repo Error</label>
                </value>
                <value>
                    <fullName>Sent to Avalara</fullName>
                    <default>false</default>
                    <label>Sent to Avalara</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

    <fields>
        <fullName>isEligibleForRenewal__c</fullName>
        <description>The membership is eligible for renewal within three months before renewal date</description>
        <formula>ISPICKVAL(Membership_Status__c, &apos;Active&apos;) &amp;&amp; 
!ISPICKVAL(Application_Status__c,&apos;Renewal&apos;) &amp;&amp;
(TODAY() &gt;= ADDMONTHS(Membership_Renewal_Date__c, -3) &amp;&amp; TODAY() &lt;= Membership_Renewal_Date__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The membership is eligible for renewal within three months before renewal date</inlineHelpText>
        <label>Eligible for Renewal</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Membership</label>
    <listViews>

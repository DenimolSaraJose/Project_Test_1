<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata providing customization options for the migration of ATSv1 records to ATSv2 data model</description>
    <fields>
        <fullName>TR1__v1Field__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Enter API name of ATSv1 field to get the data from</inlineHelpText>
        <label>ATSv1 Source field</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__v1Object__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>ATSv1 object to get the data from.Values:Application/Submittal/Send Out/Offer. Or SendoutSchedule for overrides on schedules</inlineHelpText>
        <label>ATSv1 Source Object</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Application</fullName>
                    <default>true</default>
                    <label>Application</label>
                </value>
                <value>
                    <fullName>Submittal</fullName>
                    <default>false</default>
                    <label>Submittal</label>
                </value>
                <value>
                    <fullName>Send_Out</fullName>
                    <default>false</default>
                    <label>Send_Out</label>
                </value>
                <value>
                    <fullName>Offer</fullName>
                    <default>false</default>
                    <label>Offer</label>
                </value>
                <value>
                    <fullName>SendoutSchedule</fullName>
                    <default>false</default>
                    <label>SendoutSchedule</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__v2Field__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Enter API name of ATSv2 field you want to give an overridden value</inlineHelpText>
        <label>ATSv2 Destination field</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__v2Skip__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>If enabled, no data will be migrated into ATSv2 Destination field. It will be empty.</inlineHelpText>
        <label>ATSv2 Skip</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__v2Stage__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Used to configure overrides for fields at different stages.</inlineHelpText>
        <label>ATSv2 Stage</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Application</fullName>
                    <default>true</default>
                    <label>Application</label>
                </value>
                <value>
                    <fullName>Submittal</fullName>
                    <default>false</default>
                    <label>Submittal</label>
                </value>
                <value>
                    <fullName>Send Out</fullName>
                    <default>false</default>
                    <label>Send Out</label>
                </value>
                <value>
                    <fullName>Offer</fullName>
                    <default>false</default>
                    <label>Offer</label>
                </value>
                <value>
                    <fullName>Closing Report</fullName>
                    <default>false</default>
                    <label>Closing Report</label>
                </value>
                <value>
                    <fullName>All</fullName>
                    <default>false</default>
                    <label>All</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__v2value__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>If you want the ATSv2 Destination field to be populated with a default value, enter the value here</inlineHelpText>
        <label>ATSv2 Default Value</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>ATSv1 Migration</label>
    <pluralLabel>ATSv1 Migrations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

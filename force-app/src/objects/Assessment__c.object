    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>Assessment_Compact_Layout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Assessment_Compact_Layout</fullName>
        <fields>AssessmentLink__c</fields>
        <label>Assessment Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>AssessmentDate__c</fullName>
        <label>Assessment Date</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>AssessmentLink__c</fullName>
        <externalId>false</externalId>
        <formula>CASE( Competency__r.RecordType.DeveloperName,
&apos;Skill&apos;, HYPERLINK(&apos;/&apos; + Id, Skill__r.Name + &apos; (&apos; + Name + &apos;)&apos;, &apos;_self&apos;),
&apos;Expertise&apos;, CASE( Expertise__r.RecordType.DeveloperName,
&apos;GeneralDomain&apos;, HYPERLINK(&apos;/&apos; + Id, Expertise__r.Name + &apos; (&apos; + Name + &apos;)&apos;, &apos;_self&apos;),
&apos;GranularDomain&apos;, HYPERLINK(&apos;/&apos; + Id, Expertise__r.Name + &apos; - &apos; + Skill__r.Name + &apos; (&apos; + Name + &apos;)&apos;, &apos;_self&apos;),
&apos;N/A&apos;),
&apos;N/A&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Assessment</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AssessmentSource__c</fullName>
        <label>Assessment Source</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Self</fullName>
                    <default>false</default>
                    <label>Self</label>
                </value>
                <value>
                    <fullName>Peer</fullName>
                    <default>false</default>
                    <label>Peer</label>
                </value>
                <value>
                    <fullName>System</fullName>
                    <default>false</default>
                    <label>System</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Assignment__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Assignment</label>
        <referenceTo>Assignment__c</referenceTo>
        <relationshipLabel>Assessments</relationshipLabel>
        <relationshipName>Performance</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Competency__c</fullName>
        <label>Competency</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>Competency__c.Contact__c</field>
                <operation>equals</operation>
                <valueField>$Source.Contact__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Competency__c</referenceTo>
        <relationshipName>Performance</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipName>Performance</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Expertise__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Expertise</label>
        <referenceTo>Expertise__c</referenceTo>
        <relationshipLabel>Assessments</relationshipLabel>
        <relationshipName>Assessments</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>IsSelfAssessment__c</fullName>
        <formula>ISPICKVAL( AssessmentSource__c, &apos;Self&apos; )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Self-assessment</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ScoreCategory__c</fullName>
        <externalId>true</externalId>
        <label>Score Category</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ScoreType__c</fullName>
        <externalId>false</externalId>
        <formula>Competency__r.ScoreType__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Score Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ScoreValue__c</fullName>
        <externalId>false</externalId>
        <label>Score Value</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Score__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(ScoreType__c,
&apos;Statement&apos;, TEXT(ScoreValue__c) + &apos;%&apos;,
&apos;Rating&apos;, TEXT(ScoreValue__c) + &apos;%&apos;,
TEXT(ScoreValue__c)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Score</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Skill__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Skill</label>
        <referenceTo>Skill__c</referenceTo>
        <relationshipLabel>Assessments</relationshipLabel>
        <relationshipName>Assessments</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Statement__c</fullName>
        <externalId>false</externalId>
        <label>Statement</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Assessment</label>
    <nameField>
        <displayFormat>PBA-{0000}</displayFormat>
        <label>Assessment Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Assessments</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

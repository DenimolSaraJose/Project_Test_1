    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <compactLayouts>
        <fullName>c2g__OpportunityProductCompactLayout</fullName>
        <fields>Name</fields>
        <fields>OpportunityId</fields>
        <fields>Product2Id</fields>
        <fields>ProductCode</fields>
        <fields>Quantity</fields>
        <fields>UnitPrice</fields>
        <fields>TotalPrice</fields>
        <label>Opportunity Product Compact Layout (Accounting)</label>
    </compactLayouts>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>Account__c</fullName>
        <externalId>false</externalId>
        <formula>Opportunity.AccountId</formula>
        <label>Account</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Accounting_Company__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
Opportunity.Account.c2g__CODAAccountTradingCurrency__c = &quot;EUR&quot;, &quot;aAh0Y000000TRt4SAG&quot;, &quot;aAh0Y000000TRt9SAG&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accounting Company</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Accounting_Currency__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Accounting_Company__c = &quot;aAh0Y000000TRt4SAG&quot;, 
CASE(TEXT(CurrencyIsoCode),
&apos;AED&apos;, &apos;aAM0Y00000001Dw&apos;,
&apos;AUD&apos;, &apos;aAM0Y00000001Dv&apos;,
&apos;CAD&apos;, &apos;aAM0Y00000001Dq&apos;,
&apos;CHF&apos;, &apos;aAM0Y00000001Du&apos;,
&apos;CNY&apos;, &apos;aAM0Y00000001Do&apos;,
&apos;EUR&apos;, &apos;aAM0Y00000001Dr&apos;,
&apos;GBP&apos;, &apos;aAM0Y00000001Dy&apos;,
&apos;HKD&apos;, &apos;aAM0Y00000001Ds&apos;,
&apos;INR&apos;, &apos;aAM0Y00000001Dp&apos;,
&apos;JPY&apos;, &apos;aAM1n000000k9h2&apos;,
&apos;KWD&apos;, &apos;aAM1n000000L07y&apos;,
&apos;SGD&apos;, &apos;aAM0Y00000001Dt&apos;,
&apos;THB&apos;, &apos;aAM1n000000k9gx&apos;,
&apos;USD&apos;, &apos;aAM0Y00000001Dx&apos;,
&apos;ZAR&apos;, &apos;aAM0Y000000k9fz&apos;, &quot;&quot;),

IF(Accounting_Company__c = &quot;aAh0Y000000TRt9SAG&quot;, 
CASE(TEXT(CurrencyIsoCode),
&apos;CAD&apos;, &apos;aAM0Y00000001Di&apos;,
&apos;CHF&apos;, &apos;aAM0Y00000001Dm&apos;,
&apos;EUR&apos;, &apos;aAM0Y00000001D9&apos;,
&apos;GBP&apos;, &apos;aAM0Y00000001Dh&apos;,
&apos;HUF&apos;, &apos;aAM0Y00000001Dj&apos;,
&apos;INR&apos;, &apos;aAM0Y00000001Dl&apos;,
&apos;KWD&apos;, &apos;aAM1n000000L083&apos;,
&apos;PLN&apos;, &apos;aAM0Y00000001Dg&apos;,
&apos;THB&apos;, &apos;aAM0Y00000001Dn&apos;,
&apos;TRY&apos;, &apos;aAM0Y00000001Dk&apos;,
&apos;USD&apos;, &apos;aAM0Y00000001D8&apos;, &quot;&quot;), &quot;&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accounting Currency</label>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Billing_Contract__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Billing Contract</label>
        <referenceTo>Billing_Contract__c</referenceTo>

    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Object to store the message details (like subject, personalization strings, contact document links, content distribution links, etc.) that are needed for rendering all necessary data in emails sent via Marketing Cloud.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>TR1__BCC_Emails__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the list of email addresses to be used as blind carbon copy for messages being sent to Marketing Cloud.</description>
        <inlineHelpText>Stores the list of email addresses to be used as blind carbon copy for messages being sent to Marketing Cloud.</inlineHelpText>
        <label>BCC Emails</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__CC_Emails__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the list of email addresses to be used as carbon copy for messages being sent to Marketing Cloud.</description>

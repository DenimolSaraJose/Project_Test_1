    <fields>
        <fullName>TR1__Contact_Document_Links_JSON__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the information of Contact Document Links being sent to Marketing Cloud.</description>
        <inlineHelpText>Stores the information of Contact Document Links being sent to Marketing Cloud.</inlineHelpText>
        <label>Contact Document Links JSON</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__HTML_Body__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the merged HTML body value of the fully-editable message being sent to Marketing Cloud. If desired, more elaborate headers and footers can be added on the Marketing Cloud side.</description>
        <inlineHelpText>Stores the merged HTML body value of the fully-editable message being sent to Marketing Cloud. If desired, more elaborate headers and footers can be added on the Marketing Cloud side.</inlineHelpText>
        <label>HTML Body</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__SF_Content_Distribution_Links_JSON__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the information of Salesforce Content Distribution links to the shared documents being sent to Marketing Cloud.</description>
        <inlineHelpText>Stores the information of Salesforce Content Distribution links to the shared documents being sent to Marketing Cloud.</inlineHelpText>
        <label>SF Content Distribution Links JSON</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Signature__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the user&apos;s signature being sent to Marketing Cloud to be merged to the email body.</description>
        <inlineHelpText>Stores the user&apos;s signature being sent to Marketing Cloud to be merged to the email body.</inlineHelpText>
        <label>Signature</label>
        <length>4000</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Subject__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the subject of the message being sent to Marketing Cloud.</description>
        <inlineHelpText>Stores the subject of the message being sent to Marketing Cloud.</inlineHelpText>
        <label>Subject</label>
        <length>1024</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>

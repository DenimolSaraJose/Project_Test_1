        <fullName>c2g__SignedBankCharge__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF( text(c2g__Type__c) = &quot;Refund&quot;, c2g__ChargesAmount__c *-1, c2g__ChargesAmount__c )</formula>

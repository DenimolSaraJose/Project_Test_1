    </fields>
    <fields>
        <fullName>c2g__PaymentNumber__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Payment Number</label>
        <referenceTo>c2g__codaPayment__c</referenceTo>
        <relationshipLabel>Cash Entries</relationshipLabel>
        <relationshipName>CashEntries</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__PaymentStatus__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>if( NOT( ISPICKVAL( c2g__Status__c, &apos;Complete&apos; ) ),
$Label.c2g__NotApplicable,
if( c2g__Transaction__r.c2g__DocumentOutstandingTotal__c == 0, $Label.c2g__Paid,
if( c2g__Transaction__r.c2g__DocumentTotal__c == c2g__Transaction__r.c2g__DocumentOutstandingTotal__c, $Label.c2g__codaPurchaseInvoiceFieldStatusUnpaid,
$Label.c2g__codaPurchaseInvoiceFieldStatusPartPaid ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__PaymentTotal__c</fullName>
        <deprecated>false</deprecated>
        <description>Document total generated in the transaction.</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(c2g__Type__c,&apos;Payment&apos;) || ISPICKVAL(c2g__Type__c,&apos;Payment Refund&apos;),-1 * c2g__Transaction__r.c2g__DocumentTotal__c, c2g__Transaction__r.c2g__DocumentTotal__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__PaymentType__c</fullName>
        <deprecated>false</deprecated>
        <description>Convert type for final community users.</description>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(c2g__Type__c, &apos;Receipt&apos;), $Label.c2g__CommunitiesCashEntryTypePayment, IF( ISPICKVAL(c2g__Type__c, &apos;Payment&apos;), $Label.c2g__Paid, IF( ISPICKVAL(c2g__Type__c, &apos;Payment Refund&apos;), $Label.c2g__CommunitiesCashEntryTypeRefunded, $Label.c2g__CommunitiesCashEntryTypeRefund)))</formula>
        <label>Payment Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>

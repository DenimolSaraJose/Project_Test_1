    <fields>
        <fullName>c2g__AccountTotal__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(c2g__Type__c,&apos;Payment&apos;) || ISPICKVAL(c2g__Type__c,&apos;Payment Refund&apos;),-1 * c2g__Transaction__r.c2g__AccountTotal__c, c2g__Transaction__r.c2g__AccountTotal__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>

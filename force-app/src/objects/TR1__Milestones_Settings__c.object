<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Setting for configuring Milestones functionality</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Overdue_Banner_Color__c</fullName>
        <deprecated>false</deprecated>
        <description>The color of the Overdue banner. Can be in the following formats: &apos;#FB9D5A&apos; or &apos;red&apos;</description>
        <externalId>false</externalId>
        <inlineHelpText>The color of the Overdue banner. Can be in the following formats: &apos;#FB9D5A&apos; or &apos;red&apos;</inlineHelpText>
        <label>Overdue Banner Color</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Overdue_Days__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines the number of days after Due Date to start showing the Banner.</description>
        <externalId>false</externalId>
        <inlineHelpText>Defines the number of days after Due Date to start showing the Banner.</inlineHelpText>
        <label>Overdue Days</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Urgent_Overdue_Banner_Color__c</fullName>
        <deprecated>false</deprecated>
        <description>The color of the Urgent Overdue banner. Can be in the following formats: &apos;#FB9D5A&apos; or &apos;red&apos;</description>
        <externalId>false</externalId>
        <inlineHelpText>The color of the Urgent Overdue banner. Can be in the following formats: &apos;#FB9D5A&apos; or &apos;red&apos;</inlineHelpText>
        <label>Urgent Overdue Banner Color</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Urgent_Overdue_Days__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines the number of days after Due Date to start showing the Urgent Banner.</description>
        <externalId>false</externalId>
        <inlineHelpText>Defines the number of days after Due Date to start showing the Urgent Banner.</inlineHelpText>
        <label>Urgent Overdue Days</label>

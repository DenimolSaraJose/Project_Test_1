    <fields>
        <fullName>TR1__Active_for_Additional_Message_Channels__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Flag which allows you to activate/deactivate an email activity configuration record for all additional message channels (e.g. if it&apos;s disabled then activities for all message channels will not be created). Note: email channel is controlled by another flag called &apos;&apos;Active&quot;.</description>
        <inlineHelpText>Flag which allows you to activate/deactivate an email activity configuration record for all additional message channels (e.g. if it&apos;s disabled then activities for all message channels will not be created). Note: email channel is controlled by another flag called &apos;&apos;Active&quot;.</inlineHelpText>
        <label>Active for Additional Message Channels</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

    <fields>
        <fullName>c2g__AddressIsValid__c</fullName>
        <deprecated>false</deprecated>
        <formula>NOT
( ISBLANK(c2g__ShortStreet__c) &amp;&amp;
  ISBLANK(c2g__City__c) &amp;&amp;
  ISBLANK(c2g__StateProvince__c) &amp;&amp;
  ISBLANK(c2g__ZipPostCode__c) &amp;&amp;
  ISBLANK(c2g__Country__c)
) &amp;&amp;
( c2g__ShortStreet__c  =  c2g__ValidatedStreet__c ) &amp;&amp;
( c2g__City__c =  c2g__ValidatedCity__c ) &amp;&amp;
( c2g__StateProvince__c =  c2g__ValidatedStateProvince__c ) &amp;&amp;
( c2g__ZipPostCode__c =  c2g__ValidatedZipPostalCode__c ) &amp;&amp;
( c2g__Country__c =  c2g__ValidatedCountry__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Validated</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

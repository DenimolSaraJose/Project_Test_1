    <webLinks>
        <fullName>LTE__View_Document</fullName>
        <availability>online</availability>
        <description>This button will display the PDF version of the financial document.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>View Document</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/31.0/connection.js&quot;)}
            var connection = sforce.connection;
            var myquery = &quot;SELECT Id FROM Framework__Registry__mdt WHERE Framework__Is_Enabled__c = TRUE AND Framework__Key__c = &apos;DefaultSite&apos; AND Framework__Category__c != NULL&quot;;
            result = sforce.connection.query(myquery);
            records = result.getArray(&quot;records&quot;);
            if (records.length === 0) {
                alert(&quot;{!$Label.LTE__View_Document_Error}&quot;);
            }
            else {
                window.open(&apos;{!$Site.Prefix}/apex/LTE__ViewDocument?recordId={!CASESAFEID(OrderApi__Sales_Order__c.Id)}&apos;);
            }</url>
    </webLinks>

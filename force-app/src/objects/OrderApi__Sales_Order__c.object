        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Print Proforma Invoice(s)</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/31.0/connection.js&quot;)}
var records = {!GETRECORDIDS( $ObjectType.OrderApi__Sales_Order__c )};
if(records.length&lt;1) {
 alert(&quot;{!$Label.OrderApi__Validation_No_Records_Selected}&quot;);
} else {
 location.href = &apos;{!$Site.Prefix}/apex/{!$Setup.OrderApi__App_Config__c.OrderApi__Namespace_Prefix__c}proforma_invoice_email_pdf?soIds=&apos; + records.join(&apos;,&apos;);
}</url>
    </webLinks>
    <webLinks>
        <fullName>OrderApi__Sales_Receipt</fullName>
        <availability>online</availability>
        <description>Valid for Sales Orders that post to Receipt only - log a check payment or process an epayment.</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Process Payment</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>alert(&apos;{!$Label.OrderApi__Sales_Order_Process_Payment_Button_Error}&apos;);</url>
    </webLinks>
    <webLinks>
        <fullName>OrderApi__Send_Proforma_Invoice</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Proforma Invoice</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/31.0/connection.js&quot;)}
if({!!OrderApi__Sales_Order__c.OrderApi__Is_Closed__c}) {
 alert(&quot;{!$Label.OrderApi__Sales_Order_Not_Closed}&quot;);
} else if ({!OrderApi__Sales_Order__c.OrderApi__Is_Posted__c}) {
 alert(&quot;{!$Label.OrderApi__Sales_Order_Already_Posted}&quot;);
} else {
location.href = &apos;{!$Site.Prefix}/apex/{!$Setup.OrderApi__App_Config__c.OrderApi__Namespace_Prefix__c}sales_order_proforma_invoice?sales_order={!OrderApi__Sales_Order__c.Id}&apos;;
}</url>
    </webLinks>
    <webLinks>
        <fullName>OrderApi__Send_Proforma_Invoice_Email</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Proforma Invoice Email</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/31.0/connection.js&quot;)}
var records = {!GETRECORDIDS( $ObjectType.OrderApi__Sales_Order__c )};
if(records.length&lt;1) {
 alert(&quot;{!$Label.OrderApi__Validation_No_Records_Selected}&quot;);
} else {
 location.href = &apos;{!$Site.Prefix}/apex/{!$Setup.OrderApi__App_Config__c.OrderApi__Namespace_Prefix__c}proforma_bulk_invoice_composer?soIds=&apos; + records.join(&apos;,&apos;);
}</url>
    </webLinks>

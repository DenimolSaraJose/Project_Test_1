        <fullName>DonorApi__Forecast_Category__c</fullName>
        <deprecated>false</deprecated>
        <description>**Required** Select the category forecast category for the gift opportunity, used to classify the gift opportunities by best case, committed, open, won, lost, and on hold.</description>
        <inlineHelpText>**Required** Select the category forecast category for the gift opportunity, used to classify the gift opportunities by best case, committed, open, won, lost, and on hold.</inlineHelpText>
        <label>Forecast Category</label>
        <required>false</required>

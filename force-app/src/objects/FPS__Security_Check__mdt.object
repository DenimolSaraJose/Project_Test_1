<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Flows that validate org security settings for Fonteva software.</description>
    <fields>
        <fullName>FPS__Is_Enabled__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Whether or not the security check is enabled</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Is Enabled</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>FPS__Order__c</fullName>
        <deprecated>false</deprecated>
        <description>The display order for security checks</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Order</label>
        <precision>6</precision>
        <required>true</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Fonteva Security Check</label>
    <pluralLabel>Fonteva Security Checks</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>CTCM__G_BankAccount__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>Use this to indicate the bank account you want to pay G-Payments to. The N-payments will be paid from the current bank account.
If no G-Bank account is selected, both payments will be paid from the normal bank account.</inlineHelpText>
        <label>G Bank Account</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>c2g__codaBankAccount__c.c2g__BankAccountCurrency__c</field>
                <operation>equals</operation>
                <valueField>$Source.c2g__BankAccountCurrency__c</valueField>
            </filterItems>
            <filterItems>
                <field>$Source.OwnerId</field>
                <operation>equals</operation>
                <valueField>$Source.OwnerId</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>c2g__codaBankAccount__c</referenceTo>
        <relationshipLabel>N-Bank Accounts</relationshipLabel>
        <relationshipName>Bank_Accounts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Filter_Activity_Type__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>This field contains a list of activity types that will be displayed by default in the activity timeline.
The standard field value is &apos;all, Email, ListEmail, Call, Events, Task&apos;</inlineHelpText>
        <label>Filter Activity Type</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Filter_Date_Range__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The field contains a time range that contains the displayed activities..
The standard field value is &apos;allTime&apos;</inlineHelpText>
        <label>Filter Date Range</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Show_All_Activities__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Boolean value, according to which either all activities related to the candidate will be displayed, or only those that the current user is the owner of.
The standard field value is &apos;true&apos;</inlineHelpText>
        <label>Show All Activities</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__is_All_Activities__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <label>is All Activities</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>DaxtraActivity Properties</label>
    <visibility>Public</visibility>
</CustomObject>

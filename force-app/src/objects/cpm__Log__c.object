    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>cpm__Logged_By_User_Link__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(
  ISBLANK(cpm__Logged_By__c),
  HYPERLINK(OwnerId, Owner:User.FirstName + &apos; &apos; + Owner:User.LastName, &apos;_top&apos;),
  HYPERLINK(cpm__Logged_By__c, cpm__Logged_By__r.FirstName + &apos; &apos; + cpm__Logged_By__r.LastName, &apos;_top&apos;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Logged By</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Logged_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Logged By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Logs</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Message__c</fullName>
        <deprecated>false</deprecated>
        <label>Message</label>
        <length>32768</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>cpm__Origin__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Origin</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Type__c</fullName>
        <deprecated>false</deprecated>
        <label>Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Informal</fullName>
                    <default>false</default>
                    <label>Informal</label>
                </value>
                <value>
                    <fullName>Warning</fullName>
                    <default>false</default>
                    <label>Warning</label>
                </value>
                <value>
                    <fullName>Error</fullName>
                    <default>false</default>
                    <label>Error</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Log</label>
    <listViews>
        <fullName>cpm__All</fullName>
        <columns>NAME</columns>
        <columns>cpm__Type__c</columns>
        <columns>cpm__Origin__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>cpm__Message__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterThan</operation>
            <value>5/5/2022 12:00 AM</value>
        </filters>
        <filters>
            <field>cpm__Type__c</field>
            <operation>equals</operation>
            <value>Error</value>
        </filters>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>LOG-{0}</displayFormat>
        <label>Log Name</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>

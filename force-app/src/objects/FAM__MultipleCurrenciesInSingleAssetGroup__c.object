<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>FAM__Allow__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Allows you to override a previous validation that forced any single asset group to only allow one currency per group. Using this permission set, a single asset group with multiple currencies is allowed.</description>
        <label>Allow</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Allow multiple Currencies in Asset Group</label>
    <visibility>Public</visibility>
</CustomObject>

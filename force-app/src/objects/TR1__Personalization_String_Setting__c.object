    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Object to store the settings for personalization blocks used in email messages sent via Marketing Cloud.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>TR1__Default_Value__c</fullName>
        <deprecated>false</deprecated>
        <description>Default value of the personalization string.</description>
        <inlineHelpText>Default value of the personalization string.</inlineHelpText>
        <label>Default Value</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Field_API_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the API name of field for each personalization string for partially-editable message whose value will be populated into the &apos;Message Detail&apos; object.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the API name of field for each personalization string for partially-editable message whose value will be populated into the &apos;Message Detail&apos; object.</inlineHelpText>
        <label>Field API Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Personalization_String_Merge_Token__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the merge token used for specifying the location of the personalization string.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the merge token used for specifying the location of the personalization string. The token text you specify in this field will be replaced by the value entered in the corresponding input field of personalization string within the 2020 Email Editor. The token must be surrounded by double square brackets in the email markup, e.g. [[Your unique personalization String Merge Token]].</inlineHelpText>
        <label>Personalization String Merge Token</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Personalization String Setting</label>
    <nameField>
        <label>Personalization String Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Personalization String Settings</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

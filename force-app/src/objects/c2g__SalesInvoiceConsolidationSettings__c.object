<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the scope size of the Sales Invoice Consolidation and Max Lines on Sales Invoice.</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__InvoiceConsolidationBatchScope__c</fullName>
        <defaultValue>200</defaultValue>
        <deprecated>false</deprecated>
        <description>Scope size for the Sales Invoice Consolidation process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Scope size for the Sales Invoice Consolidation process.</inlineHelpText>
        <label>SIN Consolidation Scope Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__InvoiceUnconsolidationBatchScope__c</fullName>
        <defaultValue>2000</defaultValue>
        <deprecated>false</deprecated>
        <description>Scope size for the Sales Invoice Line Items to Undo Consolidation.</description>
        <externalId>false</externalId>
        <inlineHelpText>Scope size for the Sales Invoice Line Items to Undo Consolidation.</inlineHelpText>
        <label>SIN Undo Consolidation Scope Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__MaxLinesPerConsolidation__c</fullName>
        <defaultValue>9000</defaultValue>
        <deprecated>false</deprecated>
        <description>Maximum number of lines that can be added to a consolidated sales invoice.</description>
        <externalId>false</externalId>
        <inlineHelpText>Maximum number of lines that can be added to a consolidated sales invoice.</inlineHelpText>
        <label>Consolidation Line Limit</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Sales Invoice Consolidation Settings</label>
    <visibility>Public</visibility>
</CustomObject>

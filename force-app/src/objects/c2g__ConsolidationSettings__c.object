<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the behavior of Consolidations in Accounting.</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__HierarchyRefProcessTransactionsLimit__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines the maximum number of transactions in an hierarchy reference process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Defines the maximum number of transactions in an hierarchy reference process.</inlineHelpText>
        <label>Hierarchy Process Transaction Limit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__HierarchyReferenceProcessScopeSize__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines the scope size for the hierarchy reference process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Defines the scope size for the hierarchy reference process.</inlineHelpText>
        <label>Hierarchy Reference Process Scope Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__ReportFilter__c</fullName>
        <deprecated>false</deprecated>
        <description>Name of the filter configured on the consolidation report.</description>
        <externalId>false</externalId>
        <inlineHelpText>Name of the filter configured on the consolidation report.</inlineHelpText>
        <label>Filter Configured on Report</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__ReportId__c</fullName>
        <deprecated>false</deprecated>
        <description>Contains the ID of the consolidation report. If blank, the consolidation report for the financial year of the ultimate parent company that contains the selected date on the Consolidation Group page is not displayed.</description>
        <externalId>false</externalId>
        <inlineHelpText>If blank, the consolidation report for the financial year of the ultimate parent company that contains the selected date on the Consolidation Group page is not displayed.</inlineHelpText>
        <label>Consolidation Report ID</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Consolidation Settings</label>
    <visibility>Public</visibility>
</CustomObject>

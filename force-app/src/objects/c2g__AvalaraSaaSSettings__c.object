<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the behaviour of Avalara VAT Reporting SaaS.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__APIKey__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>This is the API key required for the Avalara SaaS Reporting.</description>
        <externalId>false</externalId>
        <label>API Key</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>c2g__AccountID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <description>This is the Account ID required for the Avalara SaaS Reporting.</description>
        <externalId>false</externalId>
        <label>Account ID</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>c2g__Environment__c</fullName>
        <deprecated>false</deprecated>
        <description>The Avalara SaaS environment to which you want to connect. Default is Production.</description>
        <label>Environment</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>c2g__IncludeIntrastatData__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When selected, includes the Intrastat data in the Avalara VAT Reporting XML file. Default is deselected.</description>
        <label>Include Intrastat Data</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__StoreFiles__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When selected, all XML files sent to Avalara VAT Reporting are stored in Files. Deselected by default.</description>
        <label>Store Files</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Avalara VAT Reporting SaaS Settings</label>
    <visibility>Public</visibility>
</CustomObject>

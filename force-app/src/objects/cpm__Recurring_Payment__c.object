    <fields>
        <fullName>cpm__Yearly_value__c</fullName>
        <deprecated>false</deprecated>
        <description>Calculates the revenue per year based on the Amount * the Frequency.</description>
        <formula>cpm__Amount__c * CASE(TEXT( cpm__Frequency__c ), &quot;One-time&quot;, 1, &quot;Monthly&quot;, 12, &quot;Quarterly&quot;, 4, &quot;Twice a year&quot;, 2, &quot;Weekly&quot;, 52, &quot;Daily&quot;, 365, 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>How much the Recurring Payment creates in revenue each year.</inlineHelpText>
        <label>Yearly value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>cpm__ls_coll_date__c</fullName>
        <deprecated>false</deprecated>
        <description>The last time this Recurring Payment was processed in a payment run and had a installment created.</description>
        <inlineHelpText>The last date this Recurring Payment was included in a payment run.</inlineHelpText>
        <label>Last Collection Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>

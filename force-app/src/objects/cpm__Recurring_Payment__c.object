    <fields>
        <fullName>cpm__Mandate__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <label>Mandate</label>
        <lookupFilter>
            <active>true</active>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <filterItems>
                <field>cpm__Mandate__c.cpm__Active__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <filterItems>
                <field>cpm__Mandate__c.cpm__Payment_Profile__c</field>
                <operation>equals</operation>
                <valueField>$Source.cpm__Payment_Profile__c</valueField>
            </filterItems>
            <filterItems>
                <field>$Source.cpm__Payment_Profile__c</field>
                <operation>equals</operation>
                <value></value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>cpm__Mandate__c</referenceTo>
        <relationshipLabel>Recurring Payments</relationshipLabel>
        <relationshipName>Recurring_Payments</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Mandatory_payment__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Donations are by definition voluntary payments, but payments for memberships or products may be mandatory. Use this checkbox to indicate so.</description>
        <inlineHelpText>Is payment mandatory or voluntary?</inlineHelpText>
        <label>Mandatory payment</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>cpm__Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The name of the debitor. whether it be a Organisation or a Contact.</description>
        <externalId>false</externalId>
        <formula>IF (ISBLANK(cpm__Account__c) , cpm__Contact__r.FirstName + &apos; &apos; + cpm__Contact__r.LastName , cpm__Account__r.Name )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The name of the debitor.</inlineHelpText>
        <label>Name</label>
        <required>false</required>

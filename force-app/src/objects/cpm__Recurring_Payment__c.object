    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__Account_or_Contact_should_be_selected</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISBLANK(cpm__Account__c), ISBLANK(cpm__Contact__c))</errorConditionFormula>
        <errorMessage>An Account or Contact needs to be selected</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Default_Bank_Statement_is_required</fullName>
        <active>true</active>
        <errorConditionFormula>IF ( ISBLANK ( cpm__Bank_Statement_Description__c ) , true , false )</errorConditionFormula>
        <errorDisplayField>cpm__Bank_Statement_Description__c</errorDisplayField>
        <errorMessage>Default Bank Statement Description is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Frequency_is_required</fullName>
        <active>true</active>
        <description>Frequency is a required field on all commitments.</description>
        <errorConditionFormula>ISPICKVAL(cpm__Frequency__c, &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>cpm__Frequency__c</errorDisplayField>
        <errorMessage>Frequency is a required field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__IBAN_with_direct_debit</fullName>
        <active>false</active>
        <errorConditionFormula>AND( ISPICKVAL( cpm__Payment_Method__c , &quot;Direct Debit&quot;), 
OR(  cpm__Payment_Profile__r.RecordType.DeveloperName == &quot;IBAN&quot;, cpm__Payment_Profile__r.RecordType.DeveloperName == &quot;Legacy_Bank_Account&quot; ) )</errorConditionFormula>
        <errorDisplayField>cpm__Payment_Profile__c</errorDisplayField>
        <errorMessage>A IBAN or bank account is required with payment method &quot;Direct Debit&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Payment_Method_Required</fullName>
        <active>true</active>
        <description>A payment method is required for every Recurring Payment.</description>
        <errorConditionFormula>ISPICKVAL(  cpm__Payment_Method__c , &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>cpm__Payment_Method__c</errorDisplayField>
        <errorMessage>Payment Method is a required field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Payment_Processor_is_required</fullName>
        <active>false</active>
        <errorConditionFormula>IF ( ISBLANK ( TEXT(cpm__Payment_Processor__c) ) , true , false )</errorConditionFormula>
        <errorDisplayField>cpm__Payment_Processor__c</errorDisplayField>
        <errorMessage>Payment Processor is a required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Status_required</fullName>
        <active>true</active>
        <description>The status is required for every Recurring Payment.</description>
        <errorConditionFormula>ISPICKVAL( cpm__Status__c , &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>cpm__Status__c</errorDisplayField>
        <errorMessage>Status is a required field</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

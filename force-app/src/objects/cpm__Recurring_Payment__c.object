    <fields>
        <fullName>cpm__End_Date__c</fullName>
        <deprecated>false</deprecated>
        <description>The date on which the Recurring Payment ends. After this date the Active checkbox should be set to inactive.</description>
        <inlineHelpText>The date on which the Recurring Payment ends.</inlineHelpText>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>cpm__Expected_Remaining_Revenue__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
        <description>A calculated forecast of the expect revenue remaining this year from this Recurring Payment.</description>
        <inlineHelpText>The amount of money we expect to get from this Recurring Payment for the remainder of this year.</inlineHelpText>
        <label>Expected Remaining Revenue</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>cpm__Final_Payment_Reference__c</fullName>
        <deprecated>false</deprecated>
        <description>The payment reference for this Recurring Payment.</description>
        <externalId>false</externalId>
        <formula>IF ( NOT ( ISBLANK ( cpm__Custom_Payment_Reference__c ) ) , cpm__Custom_Payment_Reference__c , cpm__Generated_Payment_Reference__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The payment reference for this Recurring Payment.</inlineHelpText>
        <label>Final Payment Reference</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Frequency__c</fullName>
        <deprecated>false</deprecated>
        <description>The billing cycle for this Recurring Payment. every billing cycle a installment is created to facilitate collection.</description>
        <inlineHelpText>How often this Recurring Payment should be collected.</inlineHelpText>
        <label>Frequency</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>One-time</fullName>
                    <default>false</default>
                    <label>One-time</label>
                </value>
                <value>
                    <fullName>Monthly</fullName>
                    <default>false</default>
                    <label>Monthly</label>
                </value>
                <value>
                    <fullName>Quarterly</fullName>
                    <default>false</default>
                    <label>Quarterly</label>
                </value>
                <value>
                    <fullName>Twice a year</fullName>
                    <default>false</default>
                    <label>Twice a year</label>
                </value>
                <value>
                    <fullName>Yearly</fullName>
                    <default>false</default>
                    <label>Yearly</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

    <fields>
        <fullName>cpm__Recount_collected_installments__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Checking this checkbox manually triggers a recount of the number of collected installments field.</description>
        <inlineHelpText>Checking this checkbox manually triggers a recount of the number of collected installments field.</inlineHelpText>
        <label>Recount collected installments</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>cpm__Recurring_Payment_Forecast__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>/*
IF( OR( BLANKVALUE( End_Date__c ), NOT( OR(Next_Collection_Date__c &gt; End_Date__c, Next_Collection_Date__c &gt; DATEVALUE( &apos;12-31-&apos;&amp;TEXT(YEAR(TODAY())) ) ) ) ,
IF( OR( BLANKVALUE( End_Date__c ), Next_Collection_Date__c &gt; DATEVALUE( &apos;12-31-&apos;&amp;TEXT( YEAR( TODAY() ) ) ) ),

)

)
*/
TEXT( DATEVALUE( TEXT( YEAR( today() ) )&amp;&quot;-12-31&quot; ) - cpm__Next_Collection_Date__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The number of collectable days remaining in the current year.</inlineHelpText>
        <label>Recurring Payment Forecast</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Setup_URL__c</fullName>
        <deprecated>false</deprecated>
        <description>A URL to a payment page where the payer can update how the recurring payment will be paid. The update can change, for example, payment method and processor, mandate, payment profile and payment reference.</description>
        <inlineHelpText>A URL to a payment page where the payer can update how the recurring donation will be paid.</inlineHelpText>
        <label>Setup URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>

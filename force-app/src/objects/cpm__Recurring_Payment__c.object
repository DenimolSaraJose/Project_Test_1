    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>A Recurring Payment represents a financial agreement between a contact or organisation and us.</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>cpm__Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The debitor organisation.</description>
        <inlineHelpText>The debitor organisation.</inlineHelpText>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Recurring Payments</relationshipLabel>
        <relationshipName>Recurring_Payments</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicated whether the Recurring Payment is active. This field is not automatically updated. this needs to be implemented by the Implementing Partner.</description>
        <inlineHelpText>If checked this Recurring Payment is included in payment runs.</inlineHelpText>
        <label>Active</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>cpm__Amount__c</fullName>
        <deprecated>false</deprecated>
        <description>The amount the Recurring Payment is for. This is the amount that every billing cycle is billed to the debitor.</description>
        <inlineHelpText>The amount per billing cycle (frequency)</inlineHelpText>
        <label>Amount</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>cpm__Bank_Statement_Description__c</fullName>
        <deprecated>false</deprecated>
        <description>The description provided to the bank or payment provider for use on the bank statement of the debitor. When using a payment provider be sure to always have this field contain the name of the organisation. As this is not otherwise displayed on the bank statement.</description>
        <inlineHelpText>The description provided to the debitor. When using a payment provider be sure to always have this field contain the name of the organisation. As this is not otherwise displayed on the bankstatement.</inlineHelpText>
        <label>Default Bank Statement Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>

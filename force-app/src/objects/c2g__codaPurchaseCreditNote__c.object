        <deprecated>false</deprecated>
        <description>The total value of items and expenses on the puchase credit note, applicable for withholding tax.</description>
        <externalId>false</externalId>
        <formula>ROUND((((c2g__WithholdingExpenseNetTotal__c + c2g__WithholdingProductNetTotal__c) * BLANKVALUE(c2g__WithholdingRate__c, 0)) / 100) * -1, BLANKVALUE(c2g__CreditNoteCurrencyDecimalPlaces__c, 2))</formula>
        <label>Withholding Total</label>
        <precision>18</precision>
        <required>false</required>

        <label>For unit test</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Object_type__c</fullName>
        <deprecated>false</deprecated>
        <description>Specify whether the configuration is for a candidate or job</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Specify whether the configuration is for a candidate or job</inlineHelpText>
        <label>Object type</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Candidate</fullName>
                    <default>true</default>
                    <label>Candidate</label>
                </value>
                <value>
                    <fullName>Job</fullName>
                    <default>false</default>
                    <label>Job</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

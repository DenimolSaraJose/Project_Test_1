        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Password of the searcher</inlineHelpText>
        <label>Password</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Searcher_Access_Type__c</fullName>
        <deprecated>false</deprecated>
        <description>Searcher access type field to indicate the type of credentials: org-wide, user specific, or not required.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Searcher Access Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Org-wide</fullName>
                    <default>true</default>
                    <label>Org-wide</label>
                </value>
                <value>
                    <fullName>User specific</fullName>
                    <default>false</default>
                    <label>User specific</label>
                </value>
                <value>
                    <fullName>Not required</fullName>
                    <default>false</default>
                    <label>Not required</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Searcher__c</fullName>
        <deprecated>false</deprecated>
        <description>External Searcher reference for TK Search! configuration. When appended with the country, forms the key used for the external searcher in TK Search!.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Searcher name</inlineHelpText>
        <label>TK Search! Reference</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__TK_Source_Reference__c</fullName>
        <deprecated>false</deprecated>
        <description>External Searcher reference for TK Source! configuration. When appended with the country, forms the key used for the external searcher in TK Source!.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>External Searcher reference for TK Source! configuration. When appended with the country, forms the key used for the external searcher in TK Source!.</inlineHelpText>
        <label>TK Source! Reference</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Username__c</fullName>
        <deprecated>false</deprecated>
        <description>Deprecated</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Username of the searcher</inlineHelpText>
        <label>Username</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Textkernel searcher authentication</label>
    <pluralLabel>Textkernel searcher authentications</pluralLabel>
    <validationRules>
        <fullName>TR1__ExternalSearcherReferenceIsRequired</fullName>
        <active>true</active>
        <description>A reference for TK Search! or TK! Source must be specified</description>
        <errorConditionFormula>AND(ISBLANK(TR1__Searcher__c),ISBLANK(TR1__TK_Source_Reference__c))</errorConditionFormula>
        <errorMessage>At least one reference for TK Search! or TK Source! is required</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>AccountPrivilegeAccountId__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Account_Privilege__r.Account__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Supporting field for flow</inlineHelpText>
        <label>Account Privilege Account Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccountPrivilegeAccountName__c</fullName>
        <externalId>false</externalId>
        <formula>Account_Privilege__r.Account__r.Name</formula>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Privilege__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Account Privilege</label>
        <referenceTo>Account_Privilege__c</referenceTo>
        <relationshipLabel>Contact Privileges</relationshipLabel>
        <relationshipName>Contact_Privileges</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Active__c</fullName>
        <formula>AND(Start_Date__c &lt;= TODAY(), OR(ISBLANK(End_Date__c), End_Date__c &gt; TODAY()))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>start date must be equal or less than today and the end date is either blank or greater than today</inlineHelpText>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipName>Privilege_Assignments</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Distribution_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(!ISBLANK(Account_Privilege__c), TEXT(Account_Privilege__r.Privilege__r.Distribution_Type__c), TEXT(Privilege__r.Distribution_Type__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Distribution Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ExternalName__c</fullName>
        <externalId>false</externalId>
        <formula>IF(!ISBLANK(Account_Privilege__c), Account_Privilege__r.Privilege__r.ExternalName__c, Privilege__r.ExternalName__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>External name of the master privilege record</inlineHelpText>
        <label>External Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsDefault__c</fullName>
        <description>A default privilege is assigned automatically and cannot be revoked.</description>
        <formula>IF(!ISBLANK(Account_Privilege__c), Account_Privilege__r.Privilege__r.IsDefault__c, Privilege__r.IsDefault__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>A default privilege is assigned automatically and cannot be revoked.</inlineHelpText>
        <label>Default</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsDelegatedAdmin__c</fullName>
        <formula>IF(!ISBLANK(Account_Privilege__c), Account_Privilege__r.Privilege__r.Delegated_Admin__c, Privilege__r.Delegated_Admin__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Delegated Admin</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PrivilegeAlignedWithMembershipStatus__c</fullName>
        <formula>Account_Privilege__r.Privilege__r.AlignedWithMembershipStatus__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Supporting formula field for flow.</inlineHelpText>
        <label>Aligned With Membership</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Privilege__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Privilege</label>
        <referenceTo>Privilege__c</referenceTo>
        <relationshipLabel>Contact Privileges</relationshipLabel>
        <relationshipName>Contact_Privileges</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>System__c</fullName>
        <externalId>false</externalId>
        <formula>IF(!ISBLANK(Account_Privilege__c), TEXT(Account_Privilege__r.Privilege__r.System__c), TEXT(Privilege__r.System__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Contact Privilege</label>
    <nameField>
        <displayFormat>CPRV-{000000}</displayFormat>
        <label>Contact Privilege Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Contact Privileges</pluralLabel>

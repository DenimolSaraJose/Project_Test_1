        <formula>ffvat__W5__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>W5</inlineHelpText>
        <label>PAYG Tax Withheld 4</label>
        <precision>18</precision>

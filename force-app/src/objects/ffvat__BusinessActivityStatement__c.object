    <fields>
        <fullName>ffvat__Amount5A__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF ( AND ( ISBLANK(ffvat__T9__c), ISBLANK(ffvat__T11__c) ),ffvat__T7__c, IF(ISBLANK(ffvat__T9__c),ffvat__T11__c,ffvat__T9__c))</formula>
        <inlineHelpText>T7 or T9 or T11</inlineHelpText>
        <label>PAYG Income Tax Instalment 5A</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

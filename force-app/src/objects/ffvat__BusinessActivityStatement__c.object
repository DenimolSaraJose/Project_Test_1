    <fields>
        <fullName>ffvat__Amount8A__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>ffvat__Amount1A__c + ffvat__Amount1C__c + ffvat__Amount1E__c + ffvat__Amount4__c + ffvat__Amount5A__c + ffvat__Amount6A__c + ffvat__Amount7__c + ffvat__Amount7C__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>1A + 1C + 1E + 4 + 5A + 6A + 7 + 7C</inlineHelpText>
        <label>Total Amount 8A</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ffvat__Amount8B__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>ffvat__Amount1B__c + ffvat__Amount1D__c + ffvat__Amount1F__c + ffvat__Amount5B__c + ffvat__Amount6B__c + ffvat__Amount7D__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>1B + 1D + 1F + 5B + 6B + 7D</inlineHelpText>
        <label>Total Amount 8B</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>

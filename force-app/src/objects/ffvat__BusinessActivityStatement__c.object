        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF ( ISBLANK( ffvat__F3__c ), ffvat__F1__c , ffvat__F3__c )</formula>
        <inlineHelpText>F1 or F3</inlineHelpText>
        <label>FBT Instalment 6A</label>

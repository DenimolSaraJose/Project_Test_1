    </fields>
    <fields>
        <fullName>ffvat__Amount9__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>ABS( ffvat__Amount8A__c - ffvat__Amount8B__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Absolute value of 8A - 8B</inlineHelpText>
        <label>Your Payment or Refund Amount 9</label>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Registration of the remote site settings that needs to be implemented</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>cpm__IsActive__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Wether the custom remote site setting is activated or not.</description>
        <label>IsActive</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>cpm__Provided_By__c</fullName>
        <deprecated>false</deprecated>
        <description>The Package the Setting belongs to.</description>
        <externalId>false</externalId>
        <label>Provided By</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__URL__c</fullName>
        <deprecated>false</deprecated>
        <description>The endpoint of the custom remote site setting.</description>
        <label>URL</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>cpm__Uses_Metadata_API__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>true is this remote site setting used the metadata api.</description>
        <label>Uses Metadata API</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Custom Remote Site Setting</label>
    <visibility>Public</visibility>
</CustomObject>

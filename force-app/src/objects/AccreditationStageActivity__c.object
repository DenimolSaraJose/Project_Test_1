    <fields>
        <fullName>SchoolReportDueDate__c</fullName>
        <description>Date is calculated based on the Evaluation Visit start date, the calculation differs depending on the stage.</description>
        <formula>CASE(AccreditationCycleStage__r.AccreditationStage__r.Name,
&apos;Team Evaluation&apos;, BLANKVALUE(AccreditationCycleStage__r.SchoolReportDueDate__c, BLANKVALUE(SchoolReportDueDateOverride__c, AccreditationCycleStage__r.EvaluationVisitStartDate__c - 56)),
&apos;Preparatory Engagement&apos;, BLANKVALUE(AccreditationCycleStage__r.SchoolReportDueDate__c, BLANKVALUE(SchoolReportDueDateOverride__c, AccreditationCycleStage__r.EvaluationVisitStartDate__c - 56)),
&apos;Preparatory Evaluation&apos;, BLANKVALUE(AccreditationCycleStage__r.SchoolReportDueDate__c, BLANKVALUE(SchoolReportDueDateOverride__c, AccreditationCycleStage__r.EvaluationVisitStartDate__c - 28)),
BLANKVALUE(SchoolReportDueDateOverride__c, NULL)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>This can be overridden. If not applicable the School Report Due date on the Accreditation Cycle Stage should be used.</inlineHelpText>
        <label>School Report Due Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>

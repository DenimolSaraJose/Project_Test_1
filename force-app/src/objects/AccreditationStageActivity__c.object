    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Accreditation_Prevent_Empty_Visit_Dates</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(IsEvaluationVisitDatesConfirmed__c)
&amp;&amp; IsEvaluationVisitDatesConfirmed__c
&amp;&amp; (
  ISBLANK(AccreditationCycleStage__r.EvaluationVisitStartDate__c) ||
  ISBLANK(AccreditationCycleStage__r.EvaluationVisitEndDate__c)
)</errorConditionFormula>
        <errorMessage>The Evaluation Visit dates have not been set!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Changing_Assigned_RecordType</fullName>
        <active>true</active>
        <description>This validation rule prevents changing the RecordType once it has been assigned to an Accreditation Stage Activity. This assignment is done via an Apex trigger handler in the beforeInsert context.</description>
        <errorConditionFormula>ISCHANGED(RecordTypeId) &amp;&amp;
!ISNEW()</errorConditionFormula>
        <errorMessage>You cannot change the RecordType once it has been assigned.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Override_Without_Visit_Dates</fullName>
        <active>true</active>
        <description>This validation rule prevents setting override dates when the evaluation visit dates have not been set.</description>
        <errorConditionFormula>!ISNEW() &amp;&amp;
CONTAINS(RecordType.DeveloperName, &apos;Evaluation_Visit&apos;) &amp;&amp;
ISBLANK(AccreditationCycleStage__r.EvaluationVisitStartDate__c) &amp;&amp;
(!ISBLANK(SchoolReportDueDateOverride__c) || !ISBLANK(EarlySubmissionDueDateOverride__c))</errorConditionFormula>
        <errorMessage>You cannot set the override date for either the School Report Due Date or the Early Submission Due Date when the Evaluation Visit Dates have not been set.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

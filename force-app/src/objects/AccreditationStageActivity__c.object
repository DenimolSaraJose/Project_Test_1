    <fields>
        <fullName>Semester__c</fullName>
        <externalId>false</externalId>
        <formula>RIGHT(TEXT(YEAR(DATEVALUE(TEXT(YEAR(StartDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(StartDate__c)) &amp; &quot;-1&quot;))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(DATEVALUE(TEXT(YEAR(StartDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(StartDate__c)) &amp; &quot;-1&quot;)) &lt;= 6, &quot;1&quot;, &quot;2&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Semester</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

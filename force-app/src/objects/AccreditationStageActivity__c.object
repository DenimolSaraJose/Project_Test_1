    <fields>
        <fullName>EarlySubmissionDueDate__c</fullName>
        <description>Date is calculated based on the Evaluation Visit start date, the calculation differs depending on the stage.</description>
        <formula>CASE(AccreditationCycleStage__r.AccreditationStage__r.Name,
&apos;Team Evaluation&apos;, BLANKVALUE(EarlySubmissionDueDateOverride__c, ADDMONTHS(AccreditationCycleStage__r.EvaluationVisitStartDate__c, -8)),
&apos;Preparatory Evaluation&apos;, BLANKVALUE(EarlySubmissionDueDateOverride__c, AccreditationCycleStage__r.EvaluationVisitStartDate__c -70),
BLANKVALUE(EarlySubmissionDueDateOverride__c, NULL)
)</formula>
        <label>Early Submission Due Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>

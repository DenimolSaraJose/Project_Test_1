<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configuration for storing tax rates. Used for the Fonteva/FinancialForce tax integration. This will house the Netherlands&apos; Tax Rate.</description>
    <fields>
        <fullName>Tax_Rate__c</fullName>
        <description>The Tax Rate (VAT)</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The Tax Rate (VAT)</inlineHelpText>
        <label>Tax Rate</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Percent</type>
    </fields>
    <label>Tax Configuration</label>
    <pluralLabel>Tax Configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>TR1__Not_Started_Stage__c</fullName>
        <deprecated>false</deprecated>
        <description>The color of Not Started stages. Not Started stages can be of the types &quot;skipped&quot; and &quot;future&quot;. &quot;Skipped&quot; stages are set by TR1__Skipped_Stages__c field on TR1__Application_v2__c. &quot;Future&quot; stages are all stages after the &quot;Current&quot; stage</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The color of Not Started stages</inlineHelpText>
        <label>Not Started Stage</label>

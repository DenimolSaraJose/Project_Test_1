            <values>
                <fullName>Not Submitted</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Submitted</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>FontevaPay__ACH_Dispute_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>CONTAINS(FontevaPay__Dispute__r.FontevaPay__Charge__r.FontevaPay__Payment_Method_Type__c, &apos;bank_account&apos;)</errorConditionFormula>
        <errorMessage>Dispute Evidence Record cannot be created for ACH Payment Method.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FontevaPay__Block_Evidence_Edits_Once_Submitted</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE(FontevaPay__Submission_Status__c), &apos;Submitted&apos;)</errorConditionFormula>
        <errorMessage>This Evidence has been submitted and cannot be altered or deleted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FontevaPay__Enforce_Dispute_Status_Needs_Response</fullName>
        <active>true</active>
        <errorConditionFormula>FontevaPay__Dispute__r.FontevaPay__Status__c &lt;&gt; &apos;needs_response&apos; &amp;&amp; FontevaPay__Dispute__r.FontevaPay__Status__c &lt;&gt; &apos;warning_needs_response&apos;</errorConditionFormula>
        <errorMessage>The dispute submission process is complete for this record.  Evidence cannot be submitted.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FontevaPay__Enforce_Single_Evidence_Record</fullName>
        <active>true</active>
        <errorConditionFormula>ISNEW() &amp;&amp; FontevaPay__Dispute__r.FontevaPay__Evidence_Record_Count__c  &gt; 0</errorConditionFormula>
        <errorMessage>You can only add a single evidence record to a dispute.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FontevaPay__Preserve_Documents_Once_Submitted</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(FontevaPay__Submission_Status__c, &apos;Submitted&apos;) &amp;&amp; ISCHANGED( FontevaPay__Document_Count__c )</errorConditionFormula>
        <errorMessage>You cannot add, delete, or edit documentation once the dispute evidence is submitted.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>CTPISA__ApprovalReminderEmailAddressId__c</fullName>
        <deprecated>false</deprecated>
        <description>This ID is the organization-wide email address associated with the remainder mail for approval request.</description>
        <externalId>false</externalId>
        <inlineHelpText>This ID is the organization-wide email address associated with the remainder mail for approval request.</inlineHelpText>
        <label>ApprovalReminderEmailAddressId</label>
        <length>40</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__CustomLogging__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Turn on the custom logging of error logs</description>
        <inlineHelpText>Turn on the custom logging of error logs</inlineHelpText>
        <label>CustomLogging</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Disable_UBL_Invoices__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If we check this check box UBL invoices will not be fetched from Storecove</description>
        <label>Disable UBL Invoices</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Double_Line_Description_Default_Height__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled the height of the invoice scan line description will be defaulted to twice the height for improved visibility of the same</description>
        <inlineHelpText>If enabled the height of the invoice scan line description will be defaulted to twice the height for improved visibility of the same</inlineHelpText>
        <label>Double Line Description Default Height</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__EnableMultiplePO__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>To Enable the feature of Multiple Purchase order in and invoice scan</description>
        <inlineHelpText>To Enable the feature of Multiple Purchase order in and invoice scan</inlineHelpText>
        <label>EnableMultiplePO</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__EnablePO__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>To Enable the feature to attach Purchase Order in Invoice Scan</description>
        <inlineHelpText>To Enable the feature to attach Purchase Order in Invoice Scan</inlineHelpText>
        <label>EnablePO</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__EnableProductLine__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>To Enable the feature to create the Product line item for Payable Invocie</description>
        <inlineHelpText>To Enable the feature to create the Product line item for Payable Invocie</inlineHelpText>
        <label>EnableProductLine</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Enable_Error_Message_Override__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Enable this setting to get the error message feature to override the amounts in the header with the sum of the lines.</inlineHelpText>
        <label>Enable Error Message Override</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Enable_Export_Tax_Status_for_output_VAT__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If enabled and vendor account has tax status as Export then output VAT code is enabled for Invoice scan lines.</inlineHelpText>
        <label>Enable Export Tax Status for output VAT</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Enable_Quick_Approve_Reject__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>It enables quick Approve/Reject button, which enables user to approve/reject without comments and be directed to items to approve list.</inlineHelpText>
        <label>Enable Quick Approve/Reject</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Enable_Vouchering_Before_Receipt__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If this is checked the Validation: The Voucher Quantity should not be higher than the quantity for the PO Line</description>
        <label>Enable Vouchering Before Receipt</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Enable_quick_approve_with_comment__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If we enable this then we can give comment manually while approving.</description>
        <inlineHelpText>If we enable this then we can give comment manually while approving.</inlineHelpText>
        <label>Enable quick approve with comment</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Exclude_PO_Line_Status__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Specify any PO line status that you wish to filter out of the options to match PO lines from. (To specify more than 1 status use a coma to separate)</inlineHelpText>
        <label>Exclude PO Line Status</label>
        <length>80</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__FAM_integration__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If we enable this AP Voucher will be linked to the Payable Invoice record after submitting for approval</description>
        <inlineHelpText>If we enable this AP Voucher will be linked to the Payable Invoice record after submitting for approval</inlineHelpText>
        <label>FAM integration</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__FieldSetForDynamicPOLinesFields__c</fullName>
        <deprecated>false</deprecated>
        <description>To specify fieldsset name for dyanamically adding fields from purchase order lines while mapping PO Lines on Invoice Scan.</description>
        <externalId>false</externalId>
        <label>FieldSetForDynamicPOLinesFields</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__Field_API_Name_Custom_Item_Code_Map_PO__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>If you reference a custom field API name from the PO lines object in this custom setting, then the values displayed in the PO lines screen item name/description column will display the value of the referenced field for each PO line instead of the standard Item name or Description</inlineHelpText>
        <label>Field API Name Custom Item Code Map PO</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__Force_email_acknowledgement__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>For forcing email acknowledgement when invoice is sent to PISA via email</inlineHelpText>
        <label>Force email acknowledgement</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Ingest_IBAN_BBAN__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If we enable this then we are sending IBAN &amp; BBAN</description>
        <label>Ingest IBAN &amp; BBAN</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Invoice_Scan_Status_Handler_Override__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If we are checking this then we can manually change the Invoice Scan Status manually, but currently we are not using this field in components for this functionality.</description>
        <label>Invoice Scan Status Handler Override</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__List_View_for_Quick_Approve_Reject__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, the quick approve and quick reject buttons will redirect the user to the Invoice Scan List view, instead of pending approvals tab</description>
        <inlineHelpText>If enabled, the quick approve and quick reject buttons will redirect the user to the Invoice Scan List view, instead of pending approvals tab</inlineHelpText>
        <label>List View for Quick Approve/Reject</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__Make_Quantity_Received_Read_Only__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Enable this custom setting to make the &quot;quantity received&quot; field read only in the map PO lines interface.</inlineHelpText>
        <label>Make Quantity Received Read Only</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__New_FF_PO_Company_Name_Field_API_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>API name in SCMC__Purchase_Order__c while sending approval in Invoice scan</description>
        <externalId>false</externalId>
        <label>New FF PO Company Name Field API Name</label>
        <length>50</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__New_FF_PO_Company_Name_Map__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled it should refer &apos;New FF PO Company Name Field API Name&apos; in SCMC__Purchase_Order__c while sending approval in Invoice scan and If enabling this we should provide field reference on &quot;New FF PO Company Name Field API Name&quot;  in Feature Activation Custom setting.</description>
        <label>New FF PO Company Name Map</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__NumberOfDimensions__c</fullName>
        <deprecated>false</deprecated>
        <description>To configure the number of dimension shown in invoice scan line.Default 4</description>
        <externalId>false</externalId>
        <inlineHelpText>To configure the number of dimension shown in invoice scan line.Default 4</inlineHelpText>
        <label>NumberOfDimensions</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTPISA__SendNewPayableInvoiceEmail__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>To configure the acknowledgment for invoice send to email address in workflow</description>
        <inlineHelpText>To configure the acknowledgment for invoice send to email address in workflow</inlineHelpText>
        <label>SendNewPayableInvoiceEmail</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__ShowDifference__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>To show the difference in vat value in invoice scan and sum of invoice scan line</description>
        <inlineHelpText>To show the difference in vat value in invoice scan and sum of invoice scan line</inlineHelpText>
        <label>ShowDifference</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Feature Activation</label>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>c2g__PaymentStatus__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>if( NOT( ISPICKVAL( c2g__CreditNoteStatus__c, &apos;Complete&apos; ) ),
$Label.c2g__NotApplicable,
if( c2g__Transaction__r.c2g__DocumentOutstandingTotal__c == 0, $Label.c2g__Paid,
if( c2g__Transaction__r.c2g__DocumentTotal__c == c2g__Transaction__r.c2g__DocumentOutstandingTotal__c, $Label.c2g__codaPurchaseInvoiceFieldStatusUnpaid,
$Label.c2g__codaPurchaseInvoiceFieldStatusPartPaid ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

        <fullName>c2g__RoundedCreditNoteTotal__c</fullName>
        <deprecated>false</deprecated>
        <description>If credit note currency is CHF, displays the credit note total rounded to 0.05.</description>
        <externalId>false</externalId>
        <formula>IF ( c2g__CreditNoteCurrency__r.Name = &apos;CHF&apos;, ( ROUND(c2g__CreditNoteTotal__c * 20,0) )/20, c2g__CreditNoteTotal__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rounded Credit Note Total</label>

    <fields>
        <fullName>CIS_Process_to_Invoice_Copy__c</fullName>
        <formula>AND( ISPICKVAL( c2g__CreditNoteStatus__c , &quot;Complete&quot;), ( CIS_Invoice_Copy_Created__c  = False) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Process to Invoice Copy</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CIS_Sales_Credit_Note_Copy__c</fullName>
        <description>This field was forgotten by CloudTeamCompany (Pia) in the change set. Since we already refreshed the Sandbox, this field was created by CIS based on a similar field on the Sales Invoice.</description>
        <formula>AND( ISPICKVAL(c2g__CreditNoteStatus__c, &quot;Complete&quot;), (CIS_Invoice_Copy_Created__c = False) )</formula>
        <inlineHelpText>Invoice Copy related field</inlineHelpText>
        <label>Process to Invoice Copy</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

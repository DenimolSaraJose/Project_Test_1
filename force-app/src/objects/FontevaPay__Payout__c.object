    <fields>
        <fullName>FontevaPay__Is_Charges_Count_Mismatch__c</fullName>
        <deprecated>false</deprecated>
        <formula>(FontevaPay__Charges_Count__c + FontevaPay__Refunds_Count__c + FontevaPay__Transfers_Count__c + FontevaPay__Adjustments_Count__c) != FontevaPay__Related_Charges_Count__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Is Charges Count Mismatch</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

        <errorMessage>Closing Report field value can&apos;t be changed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__End_Date_cannot_be_before_Start_Date</fullName>
        <active>true</active>
        <description>End Date cannot be earlier than Start Date</description>
        <errorConditionFormula>TR1__End_Date__c &lt; TR1__Start_Date__c</errorConditionFormula>
        <errorMessage>End Date cannot be earlier than Start Date</errorMessage>
    </validationRules>

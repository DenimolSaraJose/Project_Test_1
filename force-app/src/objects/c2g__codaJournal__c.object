    <fields>
        <fullName>c2g__Credits1__c</fullName>
        <deprecated>false</deprecated>
        <description>Shows the total of credit values in document currency, displayed without a minus sign.</description>
        <externalId>false</externalId>
        <formula>IF(c2g__Credits__c &lt; 0, c2g__Credits__c * -1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Shows the total of credit values in document currency, displayed without a minus sign.</inlineHelpText>
        <label>Credits</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__Credits__c</fullName>
        <deprecated>false</deprecated>
        <description>Shows the total of credit values in document currency, displayed with a minus sign.</description>
        <label>Credits</label>
        <summarizedField>c2g__codaJournalLineItem__c.c2g__Value__c</summarizedField>
        <summaryFilterItems>
            <field>c2g__codaJournalLineItem__c.c2g__Value__c</field>
            <operation>lessThan</operation>
            <value>0</value>
        </summaryFilterItems>
        <summaryForeignKey>c2g__codaJournalLineItem__c.c2g__Journal__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>c2g__Debits__c</fullName>

    <validationRules>
        <fullName>Enforce_Depr_Schdle_Journal_With_Setting</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
                Not($Setup.FAM__Fixed_Asset_Management_Settings__c.Ignore_FAM_FFA_validation_rules__c),

                AND( ISCHANGED(Depreciation_Schedule__c) )
            )</errorConditionFormula>
        <errorDisplayField>Depreciation_Schedule__c</errorDisplayField>
        <errorMessage>The Depreciation Schedule field cannot be modified.</errorMessage>
    </validationRules>

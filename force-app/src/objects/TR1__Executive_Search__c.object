    <fields>
        <fullName>TR1__Async_Update_Off_Limit_Lookups__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When checked, the update on Account and Contact Off Limit Lookups are done asynchronously, allowing a possible have logic attached to these standard objects to run with new limits</description>
        <inlineHelpText>When checked, the update on Account and Contact Off Limit Lookups are done asynchronously, allowing a possible have logic attached to these standard objects to run with new limits</inlineHelpText>
        <label>Async Update of Off Limit Lookups</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Create_derived_Job_Roles__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If this checkbox is selected, Job Role records will be created against new Job records for the Contact in TR1__Contact__c / TR1__Hiring_Manager__c . The Job Role records will be read-only and will get updated when TR1__Contact__c / TR1__Hiring_Manager__c get updated.</inlineHelpText>
        <label>Create ‘derived’ Job Roles</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

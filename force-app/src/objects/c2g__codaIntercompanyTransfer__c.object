        <fullName>c2g__IntercompanyCancelingJournals</fullName>
        <active>true</active>
        <compactLayoutAssignment>c2g__IntercompanyTransferCancellingJournalCompactLayout</compactLayoutAssignment>
        <description>The source document is a canceling journal. This option provides access to the intercompany transfer canceling journal page layout.</description>
        <label>Intercompany Canceling Journals</label>
        <picklistValues>
            <picklist>c2g__DestinationDocumentPaymentMethod__c</picklist>

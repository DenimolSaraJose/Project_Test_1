            <values>
                <fullName>Check</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Electronic</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>c2g__DestinationDocumentType__c</picklist>
            <values>
                <fullName>Payment</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Payment Refund</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Receipt</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Refund</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>c2g__ProcessingStatus__c</picklist>
            <values>
                <fullName>Available</fullName>
                <default>false</default>

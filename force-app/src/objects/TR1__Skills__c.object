    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>TR1__Allow_Active_Master_Skill</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( OR ( AND(ISNEW(),NOT(ISBLANK(TR1__Master_Skill__c))), ISCHANGED(TR1__Master_Skill__c) ), NOT ISPICKVAL(TR1__Master_Skill__r.TR1__Status__c, &quot;Active&quot;) )</errorConditionFormula>
        <errorDisplayField>TR1__Master_Skill__c</errorDisplayField>
        <errorMessage>Inactive skills cannot be selected in the master skill field. Please select an active master skill</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__DurationYearsLessThanZero</fullName>
        <active>true</active>
        <errorConditionFormula>TR1__DurationYears__c &lt; 0</errorConditionFormula>
        <errorDisplayField>TR1__DurationYears__c</errorDisplayField>
        <errorMessage>Duration (Years) cannot be less than 0</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__End_date_greater_than_Start_date</fullName>
        <active>true</active>
        <errorConditionFormula>TR1__End_Date__c &lt; TR1__Start_Date__c</errorConditionFormula>
        <errorMessage>End date should be greater than or equal to Start date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Expiration_date_greater_than_start_date</fullName>
        <active>true</active>
        <errorConditionFormula>TR1__Expiration_Date__c &lt;  TR1__Start_Date__c</errorConditionFormula>
        <errorMessage>Expiration date should be greater than or equal to Start Date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__NotManualSkillWithEndGreaterStartDate</fullName>
        <active>false</active>
        <description>The end date should be greater than or equal to the start date and should not be a &apos;Manual&apos; source type.</description>
        <errorConditionFormula>AND(
 (TR1__End_Date__c  &lt; TR1__Start_Date__c ),
 (ISPICKVAL(TR1__Source__c, &apos;Manual&apos;))
)</errorConditionFormula>
        <errorMessage>The end date should be greater than or equal to the start date and should not be a &apos;Manual&apos; source type.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

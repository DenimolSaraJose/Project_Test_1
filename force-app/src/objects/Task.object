        <description>Prevents re-opening a Task related to an Accreditation Activity that has a correlating field configured.</description>
        <errorConditionFormula>RecordType.DeveloperName = &apos;AccreditationStageActivity&apos;
&amp;&amp; !ISBLANK(CorrelationField__c)
&amp;&amp; ISCHANGED(Status)
&amp;&amp; ISPICKVAL(PRIORVALUE(Status), &apos;Completed&apos;)</errorConditionFormula>
        <errorMessage>This Task cannot be reopened because of it&apos;s configuration. Please contact your System Administrator for assistance.</errorMessage>
    </validationRules>
</CustomObject>

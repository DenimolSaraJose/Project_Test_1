    <listViews>
        <fullName>LCRF19</fullName>
        <columns>TR1__Account__c</columns>
        <columns>NAME</columns>
        <columns>TR1__Hiring_Manager__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CIS_RRecruitment_Fair__c</field>
            <operation>equals</operation>
            <value>London 19</value>
        </filters>
        <label>LCRF19</label>
        <sharedTo>
            <group>CIS_Recruitment_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Open_C_R_Vacancies</fullName>
        <columns>NAME</columns>
        <columns>TR1__Open_Date__c</columns>
        <columns>Application_Deadline__c</columns>
        <columns>TR1__Status__c</columns>
        <columns>TR1__Job_Owner__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>TR1__Job__c.TR1__Permanent</value>
        </filters>
        <filters>
            <field>TR1__Hiring_Manager__c</field>
            <operation>contains</operation>
            <value>jan,eaglesham,o&apos;brien,hartevelt,huijskens,Cornacchio</value>
        </filters>
        <filters>
            <field>TR1__Status__c</field>
            <operation>equals</operation>
            <value>Open</value>
        </filters>
        <label>Open C&amp;R Vacancies</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Published</fullName>
        <columns>NAME</columns>
        <columns>TR1__Job_Owner__c</columns>
        <columns>TR1__Job_Contact__c</columns>
        <columns>TR1__Job_Title__c</columns>
        <columns>TR1__Job_Number__c</columns>
        <columns>LAST_UPDATE</columns>
        <columns>Publish__c</columns>
        <columns>TR1__Job_Stage__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Publish__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>RECORDTYPE</field>
            <operation>notEqual</operation>
            <value>TR1__Job__c.Accreditation</value>
        </filters>
        <filters>
            <field>My_School__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Published</label>
        <sharedTo>
            <group>School_Recruiter</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>TR1__All_Jobs</fullName>
        <columns>NAME</columns>
        <columns>Start_Date_del__c</columns>
        <columns>Application_Deadline__c</columns>
        <columns>TR1__Job_Stage__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterThan</operation>
            <value>7/31/2018 12:00 AM</value>
        </filters>
        <label>All</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>X23_2_All_positions</fullName>

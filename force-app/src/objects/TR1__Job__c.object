        </filters>
        <filters>
            <field>RECORDTYPE</field>
            <operation>equals</operation>
            <value>TR1__Job__c.Accreditation</value>
        </filters>
        <filters>
            <field>Community_Status__c</field>
            <operation>equals</operation>
            <value>Published</value>
        </filters>

        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Overfill_Job__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>The field is used to mark Overfill Jobs to create an unlimited number of Closing Reports.</description>
        <inlineHelpText>Allows to create an unlimited number of Closing Reports that will not be taken into account when the Job will be automatically closed</inlineHelpText>
        <label>Overfill Job</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Overfill_Number__c</fullName>
        <deprecated>false</deprecated>
        <description>This field shows the numerical excess of Placements over Openings.</description>
        <externalId>false</externalId>
        <formula>IF((TR1__Number_Of_Placements__c - TR1__Number_of_Openings__c) &gt;= 0, TR1__Number_Of_Placements__c - TR1__Number_of_Openings__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Number of overfilled placements</inlineHelpText>
        <label>Overfill Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Overfill_Percent__c</fullName>
        <deprecated>false</deprecated>
        <description>This field shows the percentage of excess Placements over Openings.</description>
        <formula>IF((TR1__Number_Of_Placements__c - TR1__Number_of_Openings__c) &gt;= 0, (TR1__Number_Of_Placements__c - TR1__Number_of_Openings__c) / TR1__Number_of_Openings__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Percentage of exceeding Placements over Openings</inlineHelpText>
        <label>Overfill %</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>TR1__Ownership__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>TEXT (TR1__Account__r.Ownership)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Ownership</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Perm_Estimated_Additional_Compensation__c</fullName>

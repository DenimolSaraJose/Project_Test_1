    <fields>
        <fullName>TR1__Job_Forecasting__c</fullName>
        <deprecated>false</deprecated>
        <formula>if( ((TR1__Non_Rejected_Applications__c &gt;= 1 &amp;&amp; TR1__Non_Rejected_Applications__c &lt; 10)&amp;&amp;  (TR1__Non_Rejected_Submittals__c  + TR1__Stage_1_Send_Out_Schedules__c + TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.05,
if( ((TR1__Non_Rejected_Applications__c &gt;= 10)&amp;&amp;  (TR1__Non_Rejected_Submittals__c  + TR1__Stage_1_Send_Out_Schedules__c + TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.10,
if( ( (TR1__Non_Rejected_Submittals__c &gt;=1 &amp;&amp; TR1__Non_Rejected_Submittals__c &lt;3 )  &amp;&amp; (TR1__Stage_1_Send_Out_Schedules__c + TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.15,
if(( (TR1__Non_Rejected_Submittals__c =3)  &amp;&amp;  (TR1__Stage_1_Send_Out_Schedules__c + TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.20,
if(( (TR1__Non_Rejected_Submittals__c &gt;= 4)  &amp;&amp;  (TR1__Stage_1_Send_Out_Schedules__c + TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0) ),0.25,
if(( (TR1__Stage_1_Send_Out_Schedules__c =1)  &amp;&amp;  ( TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.30,
if(( (TR1__Stage_1_Send_Out_Schedules__c &gt;= 2)  &amp;&amp;  (TR1__Stage_2_Send_Out_Schedules__c + TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)) ,0.35,
if(( (TR1__Stage_2_Send_Out_Schedules__c =1)  &amp;&amp;  (TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)) ,0.40,
if(( (TR1__Stage_2_Send_Out_Schedules__c =2)  &amp;&amp;  (TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)) ,0.45,
if(( (TR1__Stage_2_Send_Out_Schedules__c &gt;=3)  &amp;&amp;  ( TR1__Stage_3_Send_Out_Schedules__c+ TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)) ,0.70, 
if(( (TR1__Stage_3_Send_Out_Schedules__c =1)  &amp;&amp;  ( TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c + TR1__Non_Rejected_Offers__c  =0)),0.60,
if(( (TR1__Stage_3_Send_Out_Schedules__c &gt;= 2)  &amp;&amp;  ( TR1__Stage_4_Send_Out_Schedules__c+ TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.70,
if(( (TR1__Stage_4_Send_Out_Schedules__c =1)  &amp;&amp;  ( TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.75,
if(( (TR1__Stage_4_Send_Out_Schedules__c &gt;= 2)  &amp;&amp;  ( TR1__Stage_5_Send_Out_Schedules__c +TR1__Non_Rejected_Offers__c  =0)),0.80,
if(( (TR1__Stage_5_Send_Out_Schedules__c &gt;=1)  &amp;&amp;  ( TR1__Non_Rejected_Offers__c  =0)),0.85,
if(( TR1__Non_Rejected_Offers__c  &gt;0),0.90,0))))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Job Forecasting</label>

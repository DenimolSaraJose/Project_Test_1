    <fields>
        <fullName>TR1__Job_Stage_Banner__c</fullName>
        <deprecated>false</deprecated>
        <description>Used in New ATS Model, showing the most advanced stage for the Job</description>
        <externalId>false</externalId>
        <formula>IF(
ISPICKVAL(TR1__Status__c, &apos;Closed&apos;),
IF(
ISPICKVAL(TR1__Closed_Reason__c, &apos;Filled&apos;),
IMAGE(&apos;/resource/&apos; + $Label.TR1__ATSv2_JobBannerSRNameForFilled, $Label.TR1__ATSv2_Job_Stage_Filled),
IMAGE(&apos;/resource/&apos; + $Label.TR1__ATSv2_JobBannerSRNameForLost, $Label.TR1__ATSv2_Job_Stage_Lost)
),
IF(TR1__Most_Advanced_Stage__c != &apos;&apos;, IMAGE(&apos;/resource/&apos; + TR1__Most_Advanced_Stage__c, TR1__Most_Advanced_Stage__c),
IMAGE(&apos;/resource/&apos; + $Label.TR1__ATSv2_JobBannerSRNameForNoCandidates, $Label.TR1__ATSv2_Job_Stage_No_Candidates)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Job Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Job_Stage__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(
    ISPICKVAL(TR1__Status__c, &apos;Closed&apos;),
    IF(
        ISPICKVAL(TR1__Closed_Reason__c, &apos;Filled&apos;),
        IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForFilled, &quot;Filled&quot;),
        IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForLost, &quot;Lost&quot;)
    ),
    IF( TR1__Overfill_Job__c &amp;&amp; (TR1__Number_Of_Placements__c - TR1__Number_of_Openings__c &gt; 0 ) , IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForOverfilled, &quot;Overfill&quot;), IF(
        TR1__No_of_Current_Offers__c &gt; 0,
        IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForOffer, &quot;Offer&quot;),
        IF(
            TR1__No_of_Current_Sendouts__c &gt; 0, /*********Change to new rollupField******/
            IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForSendOut, &quot;SendOut&quot;),
            IF(
                TR1__No_of_Current_Submittals__c &gt; 0,
                IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForSubmittal, &quot;Submittal&quot;),
                IF(
                    TR1__No_of_Current_Applications__c &gt; 0,
                    IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForApplication, &quot;Application&quot;),
                    IMAGE(&apos;/resource/&apos; + $Label.TR1__JobBannerStaticResourceNameForNoCandidates, &quot;No Candidates&quot;)
                )
            )
        )
    )
) 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Job Stage</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

    <fields>
        <fullName>AccreditationCycleStageLink__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(AccreditationCycleStage__c), &apos;N/A&apos;, HYPERLINK(
&quot;/&quot; &amp; AccreditationCycleStage__c,
AccreditationCycleStage__r.StageName__c,
&quot;_self&quot;
))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accreditation Cycle Stage Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>

    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Community_User_can_not_change_Owner</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
ISCHANGED(OwnerId), 
ISPICKVAL( $User.UserType , &quot;PowerCustomerSuccess&quot;))</errorConditionFormula>
        <errorMessage>You&apos;re not allowed to change the owner of this Position.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Contact_field_required</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISBLANK( TR1__Contact__c ),
RecordTypeId &lt;&gt; &quot;0120Y0000002RiQQAU&quot;
)</errorConditionFormula>
        <errorDisplayField>TR1__Contact__c</errorDisplayField>
        <errorMessage>Please choose a contact, this field is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Estimated_EndDate_GreaterThan_Start_Date</fullName>
        <active>true</active>
        <description>Estimated End Date should  not be less than Start Date</description>
        <errorConditionFormula>TR1__Estimated_End_Date__c &lt; TR1__Estimated_Start_Date__c</errorConditionFormula>
        <errorMessage>Estimated End Date should not be less than Start date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Ext_job_fields_required_for_posting</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
TR1__Post_Externally__c  = TRUE,
( LEN (TR1__Client_Description__c ) == 0 ))</errorConditionFormula>
        <errorDisplayField>TR1__Client_Description__c</errorDisplayField>
        <errorMessage>Client Description required when posting externally.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Ext_job_fields_required_for_posting_educ</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
TR1__Post_Externally__c  = TRUE,
( LEN (  TR1__Education_Requirements__c  ) == 0 ))</errorConditionFormula>
        <errorDisplayField>TR1__Education_Requirements__c</errorDisplayField>
        <errorMessage>Education Requirements required when posting externally.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Ext_job_fields_required_for_posting_expr</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
TR1__Post_Externally__c  = TRUE,
( LEN (  TR1__Experience_Requirements__c  ) == 0 ))</errorConditionFormula>
        <errorDisplayField>TR1__Experience_Requirements__c</errorDisplayField>
        <errorMessage>Experience Requirements required when posting externally.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Ext_job_fields_required_for_posting_requ</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
TR1__Post_Externally__c  = TRUE,
( LEN ( TR1__Responsibilities__c ) == 0 ))</errorConditionFormula>
        <errorDisplayField>TR1__Responsibilities__c</errorDisplayField>
        <errorMessage>Responsibilities required when posting externally.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Max_PayBill_Rate_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>OR( 
AND( 
!ISNULL(TR1__Maximum_Pay_Rate__c), 
!ISNULL(TR1__Maximum_Bill_Rate__c), 
TR1__Maximum_Pay_Rate__c &gt; TR1__Maximum_Bill_Rate__c 
), 
AND( 
!ISNULL(TR1__Maximum_Pay_Rate__c), 
ISNULL(TR1__Maximum_Bill_Rate__c) 
), 
AND( 
ISNULL(TR1__Maximum_Pay_Rate__c), 
!ISNULL(TR1__Maximum_Bill_Rate__c) 
) 
)</errorConditionFormula>
        <errorMessage>Maximum Pay Rate should not be greater then Maximum Bill Rate or any one of the rate should not be blank</errorMessage>
    </validationRules>

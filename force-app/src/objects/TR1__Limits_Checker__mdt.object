<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configure Salesforce limits thresholds checks by feature</description>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates if the limit checker is active or not</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Indicates if the limit checker is active or not</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Email_Notification_Body__c</fullName>
        <deprecated>false</deprecated>
        <description>The body used in the email sent as a notification when the threshold is exceeded</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The body used in the email sent as a notification when the threshold is exceeded</inlineHelpText>
        <label>Email Notification Body</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Email_Notification_Subject__c</fullName>
        <deprecated>false</deprecated>
        <description>The subject used in the email sent as a notification when the threshold is exceeded</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The subject used in the email sent as a notification when the threshold is exceeded</inlineHelpText>
        <label>Email Notification Subject</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Global_Threshold__c</fullName>
        <deprecated>false</deprecated>
        <description>When the percentage value entered in this field is exceeded, the Limit Checker will stop the transaction. Default value is 90. Minimum 1 - Maximum 99. This applies to all monitored limits.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>When the percentage value entered in this field is exceeded, the Limit Checker will stop the transaction. Default value is 90. Minimum 1 - Maximum 99. This applies to all monitored limits.</inlineHelpText>
        <label>Global Threshold %</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Module_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Module Acronym used in BHLO logs. Must have 4 characters or less</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Module Acronym used in BHLO logs. Must have 4 characters or less</inlineHelpText>
        <label>Module Name</label>
        <length>4</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__ProfileId_or_UserId_to_Notify_by_Email__c</fullName>
        <deprecated>false</deprecated>
        <description>The Id of the profile or the Id of the user (15 or 18 digits) that will receive an email if a SF limit exceeds the threshold</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The Id of the profile or the Id of the user (15 or 18 digits) that will receive an email if a SF limit exceeds the threshold</inlineHelpText>
        <label>ProfileId or UserId to Notify by Email</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Warning_Frequency__c</fullName>
        <deprecated>false</deprecated>
        <description>The value in this field determines how frequently a BHLO log record is created and an email is sent once a Salesforce limit threshold is exceeded</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The value in this field determines how frequently a BHLO log record is created and an email is sent once a Salesforce limit threshold is exceeded</inlineHelpText>
        <label>Warning Frequency</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Daily</fullName>
                    <default>true</default>
                    <label>Daily (only once a day if the threshold is exceeded)</label>
                </value>
                <value>
                    <fullName>Every time</fullName>
                    <default>false</default>
                    <label>Every time (the threshold is exceeded)</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Limits Checker</label>
    <listViews>
        <fullName>TR1__All</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>NamespacePrefix</columns>
        <columns>TR1__Active__c</columns>
        <columns>TR1__Global_Threshold__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>Limits Checker</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

    <label>xRB Soft Date Configuration</label>
    <listViews>
        <fullName>fferpcore__All</fullName>
        <columns>NAME</columns>
        <columns>fferpcore__Description__c</columns>
        <columns>fferpcore__Type__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Soft Date Configuration Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>xRB Soft Date Configurations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>fferpcore__Opening_Balance_Not_Equals_Year_to_Date</fullName>
        <active>true</active>
        <errorConditionFormula>fferpcore__Opening_Balance__c  =  True &amp;&amp; fferpcore__Year_to_Date__c =  True</errorConditionFormula>
        <errorDisplayField>fferpcore__Opening_Balance__c</errorDisplayField>
        <errorMessage>It is not possible to select both Opening Balance and Year to Date together as they are not compatible. Deselect one or both of these options and try again.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

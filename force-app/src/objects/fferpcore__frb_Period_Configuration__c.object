        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fferpcore__Type__c</fullName>
        <deprecated>false</deprecated>
        <description>The soft date configuration type to be selected as a value on the xRB Soft Date Configuration object.</description>
        <label>Soft Date Configuration Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>fferpcore__frb_PeriodConfigurationType</valueSetName>
        </valueSet>
    </fields>

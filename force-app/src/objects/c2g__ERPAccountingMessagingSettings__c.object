<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Manages Foundations integration messages in Accounting.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__APIBalancingLineDescription__c</fullName>
        <deprecated>false</deprecated>
        <description>The description Accounting applies to balancing lines created using the Accounting Journal API.</description>
        <inlineHelpText>The description Accounting applies to balancing lines created using the Accounting Journal API.</inlineHelpText>
        <label>API Balancing Line Description</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>c2g__APIJournalDescription__c</fullName>
        <deprecated>false</deprecated>
        <description>The description Accounting applies to journals created using the Accounting Journal API.</description>
        <inlineHelpText>The description Accounting applies to journals created using the Accounting Journal API.</inlineHelpText>
        <label>API Journal Description</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>c2g__APISuspenseAccount__c</fullName>
        <deprecated>false</deprecated>
        <description>The Salesforce record ID of the general ledger account to use as a suspense account for balancing lines created using the Accounting Journal API. Required when journal line items exceed the Manual Journal Line Limit in Document Line Volume Settings.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Salesforce record ID of the general ledger account to use as a suspense account for balancing lines created using the Accounting Journal API. Required when journal line items exceed the Manual Journal Line Limit in Document Line Volume Settings.</inlineHelpText>
        <label>API Suspense Account</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>FDN Accounting Messaging Settings</label>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>TR1__Action__c</fullName>
        <deprecated>false</deprecated>
        <description>Do nothing: do not update the field. Override: replace existing value with new value. Merge: add the new value to the existing one (for multi-select picklists). Conditional Override: replace existing value with new value only if the new value is not blank.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Action</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>

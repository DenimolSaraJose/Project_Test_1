            <value>Year End</value>
        </filters>
        <label>Year End Playbooks</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <label>Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Accounting Playbooks</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>

            <field>c2g__PlaybookType__c</field>
            <operation>equals</operation>
            <value>Period End</value>
        </filters>
        <label>Period End Playbooks</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>c2g__YearEnd</fullName>
        <columns>c2g__Overdue__c</columns>
        <columns>NAME</columns>
        <columns>c2g__PlaybookType__c</columns>
        <columns>c2g__DueDate__c</columns>
        <columns>c2g__Status__c</columns>
        <columns>c2g__PlaybookOwner__c</columns>
        <columns>c2g__Year__c</columns>
        <columns>c2g__YearEndDate__c</columns>

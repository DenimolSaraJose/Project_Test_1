    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>c2g__PlaybookLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>c2g__PlaybookLayout</fullName>
        <fields>Name</fields>
        <label>Accounting Playbook Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Stores all the accounting playbooks that are used to manage the related accounting activities.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__Autogenerated__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that the playbook was generated from a template.</description>
        <label>Auto-Generated</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__Company__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The company for the accounting playbook.</description>
        <label>Company</label>
        <referenceTo>c2g__codaCompany__c</referenceTo>
        <relationshipName>PlaybookCompany</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__Description__c</fullName>
        <deprecated>false</deprecated>
        <description>The description of the accounting playbook.</description>
        <label>Description</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>c2g__DueDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The due date till when the accounting playbook is valid. This date cannot be earlier than the start date of the playbook.</description>
        <label>Due Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__Overdue__c</fullName>
        <deprecated>false</deprecated>
        <description>Displays a flag icon when the accounting playbook due date is earlier than the current date.</description>
        <externalId>false</externalId>
        <formula>IF(AND(c2g__DueDate__c &lt; TODAY(), NOT(ISPICKVAL(c2g__Status__c, &quot;Complete&quot;))), IMAGE(&apos;/resource/c2g__playbooks/images/priority.png&apos;, &apos;zero&apos;), NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Overdue</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__PeriodEndDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The period end date of the company selected for the accounting playbook. This field is not editable.</description>
        <formula>c2g__Period__r.c2g__EndDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Period End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__Period__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The period for the accounting playbook. Displays the periods in a drop-down list, starting from the current period.</description>
        <label>Period</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>The period must belong to the selected company.</errorMessage>
            <filterItems>
                <field>c2g__codaPeriod__c.c2g__OwnerCompany__c</field>
                <operation>equals</operation>
                <valueField>$Source.c2g__Company__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>c2g__codaPeriod__c</referenceTo>
        <relationshipName>PlaybookPeriod</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__PlaybookOwner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The owner of the accounting playbook.</description>
        <label>Playbook Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>PlaybookOwner</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__PlaybookType__c</fullName>
        <deprecated>false</deprecated>
        <description>The type of the accounting playbook. This type is displayed - Period End.</description>
        <label>Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Period End</fullName>
                    <default>false</default>
                    <label>Period End</label>
                </value>
                <value>
                    <fullName>Year End</fullName>
                    <default>false</default>
                    <label>Year End</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__StartDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The start date for the accounting playbook. By default, the period end date is displayed as the start date. This field is editable and mandatory.</description>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>The status of the accounting playbook. These statuses are displayed - Not Started, In Progress, and Completed.</description>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Started</fullName>
                    <default>true</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Complete</fullName>
                    <default>false</default>
                    <label>Complete</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__YearEndDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The year end date of the company selected for the accounting playbook. This field is not editable.</description>
        <formula>c2g__Year__r.c2g__EndDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Year End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__Year__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The year for the accounting playbook. Displays the years in a drop-down list, starting from the current year.</description>
        <label>Year</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>The year must belong to the selected company.</errorMessage>
            <filterItems>
                <field>c2g__codaYear__c.c2g__OwnerCompany__c</field>
                <operation>equals</operation>
                <valueField>$Source.c2g__Company__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>c2g__codaYear__c</referenceTo>
        <relationshipLabel>Accounting Playbooks</relationshipLabel>
        <relationshipName>PlaybookYear</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Accounting Playbook</label>
    <listViews>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings to manage permission checks within Accounting. This setting is temporary and will be deprecated in a future release.</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__DisablePermissionChecks__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates whether the Accounting permission checks introduced in Fall 2021 are disabled or enabled. This setting is temporary and will be deprecated in a future release.</description>
        <inlineHelpText>Indicates whether the FFA permission checks introduced in Fall 2021 are disabled or enabled. This setting is temporary and will be deprecated in a future release.</inlineHelpText>
        <label>Disable Permission Checks</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Accounting Permission Settings</label>
    <visibility>Public</visibility>
</CustomObject>

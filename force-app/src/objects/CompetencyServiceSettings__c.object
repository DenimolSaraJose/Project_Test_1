    </fields>
    <fields>
        <fullName>CompetencyFieldAPINames__c</fullName>
        <defaultValue>&apos;&apos;</defaultValue>
        <description>Enable values to display as badges in the myCompetencies LWC&apos;s for the field API names listed.</description>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>TR1__Account_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>TextKernel Portal account name</inlineHelpText>
        <label>Account Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Configuration_Service_Password__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>A password that gives access to different configuration web services of the TextKernel Portal</inlineHelpText>
        <label>Configuration Service Password</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Configuration_Service_Username__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>A username that gives access to different configuration web services of the TextKernel Portal</inlineHelpText>
        <label>Configuration Service Username</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Intermediate_Certificate__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>REQUIRED. The text content of the intermediate certificate between &quot;BEGIN CERTIFICATE&quot; and &quot;END CERTIFICATE&quot; parts. The intermediate certificate is provided by Bullhorn.</inlineHelpText>
        <label>Intermediate Certificate</label>
        <length>5000</length>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__JWT_Issuer__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Concatenation of the Subject and Issuer common names (CN values) of the
signing certificate, without the CN= prefix separated by colon.</inlineHelpText>
        <label>JWT Issuer</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Login_URL__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>JWT login URL of a TextKernel Portal instance. Must end with &quot;jwt&quot; parameter and equals sign (=).
Example: https://someinstance.textkernel.nl/ tkportal/sso/jwt/login?jwt=</inlineHelpText>
        <label>Login URL</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Multi_tenants_settings__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>For Multi-tenant environments only</inlineHelpText>
        <label>Multi-tenant settings</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>bhsf_talentrover_uat</fullName>
                    <default>false</default>
                    <label>bhsf_talentrover_uat</label>
                </value>
                <value>
                    <fullName>bhsf_talentrover</fullName>
                    <default>false</default>
                    <label>bhsf_talentrover</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Root_Certificate__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>REQUIRED. The text content of the root certificate between &quot;BEGIN CERTIFICATE&quot; and &quot;END CERTIFICATE&quot; parts. The root certificate is provided by Bullhorn.</inlineHelpText>
        <label>Root Certificate</label>
        <length>5000</length>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Search_Policy_URL__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>An endpoint URL of the TextKernel Portal Search Policy API</inlineHelpText>
        <label>Search Policy URL</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Signing_Certificate_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>&quot;Unique Name&quot; of the signing certificate in the org. Can be found on the detail page of the signing certificate in Setup -&gt; Certificate and Key Management.</inlineHelpText>
        <label>Signing Certificate Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Signing_Certificate__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>REQUIRED. The text content of a signing certificate between &quot;BEGIN CERTIFICATE&quot; and &quot;END CERTIFICATE&quot; parts. A signing certificate is a CA-signed certificate created in the org and signed by Bullhorn.</inlineHelpText>
        <label>Signing Certificate</label>
        <length>5000</length>
        <type>LongTextArea</type>
        <visibleLines>10</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__User_Config_URL__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>An endpoint URL of the TextKernel Portal User Configuration API</inlineHelpText>
        <label>User Config URL</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>TextKernel Portal Configuration</label>
    <pluralLabel>TextKernel Portal Configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

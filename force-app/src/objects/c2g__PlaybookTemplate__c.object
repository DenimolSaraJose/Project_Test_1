    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>c2g__PlaybookTemplateLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>c2g__PlaybookTemplateLayout</fullName>
        <fields>Name</fields>
        <label>Accounting Playbook Template Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Stores all the accounting playbook templates.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__Autogenerated__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that the template was generated automatically by the Feature Console.</description>
        <label>Auto-Generated</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__CalculateDueDate__c</fullName>
        <deprecated>false</deprecated>
        <description>Depending on the template type, the number of days counted from the period end date or year end date to calculate the due date for accounting playbooks generated from the template.</description>
        <externalId>false</externalId>
        <inlineHelpText>The number of days counted from the period end date to calculate the due date for the accounting playbooks generated from this template.</inlineHelpText>
        <label>Calculate Due Date</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__CalculateStartDate__c</fullName>
        <deprecated>false</deprecated>
        <description>Depending on the template type, the number of days counted from the period end date or year end date to calculate the start date for accounting playbooks generated from the template.</description>
        <externalId>false</externalId>
        <inlineHelpText>The number of days counted from the period end date to calculate the start date of playbooks generated from this template.</inlineHelpText>
        <label>Calculate Start Date</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__Description__c</fullName>
        <deprecated>false</deprecated>
        <description>The description of the accounting playbook template.</description>
        <externalId>false</externalId>
        <label>Description</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__ExcludePublicHolidays__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, the public holidays defined for the org are excluded when counting the number of days to calculate the start date and the due date of the playbook generated from the playbook template.</description>
        <label>Exclude Public Holidays</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ExcludeWeekends__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, the weekends are excluded when counting the number of days to calculate the start date and the due date of the playbook generated from the playbook template.</description>
        <label>Exclude Weekends</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__PlaybookOwner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The owner of the accounting playbook template.</description>
        <label>Playbook Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>PlaybookTemplates</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__PlaybookType__c</fullName>
        <deprecated>false</deprecated>
        <description>The type of the accounting playbook template. This type is displayed - Period End.</description>
        <label>Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Period End</fullName>
                    <default>false</default>
                    <label>Period End</label>
                </value>
                <value>
                    <fullName>Year End</fullName>
                    <default>false</default>
                    <label>Year End</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Accounting Playbook Template</label>
    <listViews>
        <fullName>c2g__All</fullName>
        <columns>NAME</columns>
        <columns>c2g__Description__c</columns>
        <columns>c2g__CalculateStartDate__c</columns>
        <columns>c2g__CalculateDueDate__c</columns>
        <columns>c2g__PlaybookOwner__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <nameField>
        <label>Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Accounting Playbook Templates</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <startsWith>Vowel</startsWith>
    <visibility>Public</visibility>
</CustomObject>

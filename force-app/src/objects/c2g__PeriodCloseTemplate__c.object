    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__Days__c</fullName>
        <deprecated>false</deprecated>
        <description>The number of days before or after the period closing date when you want to run the scheduler. If the days are before the period closing date, then the value is negative.</description>
        <externalId>false</externalId>
        <label>Days</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>The objects supported by Generic Browse Component</description>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Determines if this configuration is used.</inlineHelpText>
        <label>Is Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__ConfigurationLabel__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>Custom label API name. The label will be shown when a user needs to choose between multiple recordType configurations for the same object.</inlineHelpText>
        <label>Configuration Label</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Fieldset__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of a fieldset on the same object. Fields in it will be displayed in the header of the generic browse component.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of a fieldset on the same object. Fields in it will be displayed in the header of the generic browse component.</inlineHelpText>
        <label>Fieldset to Display</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__GroupActions__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Allows the Generic Browse Component to show group actions for this object</inlineHelpText>
        <label>Enable Group Actions</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__HeaderIcon__c</fullName>
        <deprecated>false</deprecated>
        <description>The icon to be used for in the Generic Browse Component for this Object</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The icon to be used for in the Generic Browse Component for this Object</inlineHelpText>
        <label>Header Icon</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Object_API_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of the object to be supported by the Generic Browse Component.</inlineHelpText>
        <label>Object API Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Objectname__c</fullName>
        <caseSensitive>false</caseSensitive>
        <defaultValue>text(Now())</defaultValue>
        <deprecated>false</deprecated>
        <description>Populated by backend action, do not make any change.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Populated by backend action, do not make any change.</inlineHelpText>
        <label>(Deprecated)Unique Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>TR1__PulldownFieldset__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of a fieldset on the same object. Fields in it will be displayed in the selected records pulldown of the generic browse component.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of a fieldset on the same object. Fields in it will be displayed in the selected records pulldown of the generic browse component.</inlineHelpText>
        <label>Pulldown Fieldset to display</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__RecordType__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>If multiple Generic Browse Object records exist for 1 object it will be able to use a specific Browse per record type. Use the DeveloperName of the recordType.</inlineHelpText>
        <label>RecordType</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Source__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Where is this object called from, either ATS or a listview</inlineHelpText>
        <label>Source</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>ATS</fullName>
                    <default>false</default>
                    <label>ATS</label>
                </value>
                <value>
                    <fullName>Listview</fullName>
                    <default>true</default>
                    <label>Listview</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__TabWidth__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Defines the percentage of the screen width used by the left tab. The rest will be used by the right tab.</inlineHelpText>
        <label>Left Tab Width %</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Generic Browse Supported Object</label>
    <pluralLabel>Generic Browse Supported Objects</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

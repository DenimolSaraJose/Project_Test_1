    <fields>
        <fullName>c2g__AvalaraVATReportingDocumentIndicator__c</fullName>
        <deprecated>false</deprecated>
        <description>Document indicator required for the Avalara VAT Reporting integration. If blank and the Document Type is &quot;Invoice&quot;, &quot;1 - Invoice&quot; is used. If blank and the Document Type is &quot;Credit Note&quot;, &quot;5 - Canceled Invoice&quot; is used.</description>
        <inlineHelpText>Document indicator required for the Avalara VAT Reporting integration. If blank and the Document Type is &quot;Invoice&quot;, &quot;1 - Invoice&quot; is used. If blank and the Document Type is &quot;Credit Note&quot;, &quot;5 - Canceled Invoice&quot; is used.</inlineHelpText>
        <label>Avalara VAT Reporting Document Indicator</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>1 - Invoice</fullName>
                    <default>false</default>
                    <label>1 - Invoice</label>
                </value>
                <value>
                    <fullName>2 - Simplified Invoice</fullName>
                    <default>false</default>
                    <label>2 - Simplified Invoice</label>
                </value>
                <value>
                    <fullName>3 - Ticket</fullName>
                    <default>false</default>
                    <label>3 - Ticket</label>
                </value>
                <value>
                    <fullName>4 - Advance Payment</fullName>
                    <default>false</default>
                    <label>4 - Advance Payment</label>
                </value>
                <value>
                    <fullName>5 - Canceled Invoice</fullName>
                    <default>false</default>
                    <label>5 - Canceled Invoice</label>
                </value>
                <value>
                    <fullName>6 - Receipts - Italy</fullName>
                    <default>false</default>
                    <label>6 - Receipts - Italy</label>
                </value>
                <value>
                    <fullName>7 - Summary Invoice</fullName>
                    <default>false</default>
                    <label>7 - Summary Invoice</label>
                </value>
                <value>
                    <fullName>8 - Simplified Invoice with Partner Details - Spain</fullName>
                    <default>false</default>
                    <label>8 - Simplified Invoice with Partner Details - Spain</label>
                </value>
                <value>
                    <fullName>9 - Regular Invoice without Partner Information - Spain</fullName>
                    <default>false</default>
                    <label>9 - Regular Invoice without Partner Information - Spain</label>
                </value>
                <value>
                    <fullName>10 - Customs - Customs additional Assessment - Spain</fullName>
                    <default>false</default>
                    <label>10 - Customs - Customs additional Assessment - Spain</label>

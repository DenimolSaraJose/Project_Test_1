    <fields>
        <fullName>c2g__PaymentStatus__c</fullName>
        <deprecated>false</deprecated>
        <description>Transaction Payment Status of the Accounting transaction to which this billing document relates.</description>
        <externalId>false</externalId>
        <formula>if(OR(NOT(ISPICKVAL(fferpcore__DocumentStatus__c, &apos;Complete&apos;)),
      NOT(ISPICKVAL(c2g__PostingStatus__c, &apos;Posted&apos;))),
$Label.c2g__NotApplicable,
if( c2g__Transaction__r.c2g__DocumentOutstandingTotal__c == 0, $Label.c2g__Paid,
if( c2g__Transaction__r.c2g__DocumentTotal__c == c2g__Transaction__r.c2g__DocumentOutstandingTotal__c, $Label.c2g__codaPurchaseInvoiceFieldStatusUnpaid,
$Label.c2g__codaPurchaseInvoiceFieldStatusPartPaid ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Transaction Payment Status of the FinancialForce Accounting transaction to which this billing document relates.</inlineHelpText>
        <label>Payment Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

    <fields>
        <fullName>c2g__AutoCreateSalesInvoiceCheckbox__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates whether a sales invoice or credit note is automatically created from the billing document. This is selected by default. Once the sales invoice or credit note is created, this is automatically deselected.</description>
        <inlineHelpText>Indicates whether a sales invoice or credit note is automatically created from the billing document. This is selected by default. Once the sales invoice or credit note is created, this is automatically deselected.</inlineHelpText>
        <label>Auto Create Sales Invoice or Credit Note</label>

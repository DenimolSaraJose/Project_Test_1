    <fields>
        <fullName>TR1__Standard_stage_for_multiple_Selection__c</fullName>
        <deprecated>false</deprecated>
        <description>Determines the to-be executed standard stage when a user selects more than 1 applicant. Use this setting when the overridden stage modal does not support multiple selection.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Determines the to-be executed standard stage when a user selects more than 1 applicant. Use this setting when the overridden stage modal does not support multiple selection.</inlineHelpText>
        <label>Standard stage for multiple Selection</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Internal Interview</fullName>
                    <default>false</default>
                    <label>Internal Interview</label>
                </value>
                <value>
                    <fullName>Submittal</fullName>
                    <default>false</default>
                    <label>Submittal</label>
                </value>
                <value>
                    <fullName>Send Out</fullName>
                    <default>false</default>
                    <label>Send Out</label>
                </value>
                <value>
                    <fullName>Offer</fullName>
                    <default>false</default>
                    <label>Offer</label>
                </value>
                <value>
                    <fullName>Closing Report</fullName>
                    <default>false</default>

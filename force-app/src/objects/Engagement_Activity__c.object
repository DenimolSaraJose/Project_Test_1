    <fields>
        <fullName>Current_Semester_1__c</fullName>
        <formula>IF( CONTAINS(RecordType.Name,&apos;Report&apos;)||RecordType.Name=&apos;FRPP&apos;, IF( School_Report_Due__c &gt;= addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),6)&amp;&amp; School_Report_Due__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),6), true, false),IF ( Start_Date__c &gt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),6)&amp;&amp; Start_Date__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),6),true,false))</formula>
        <label>Current Semester + 1</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Current_Semester_2__c</fullName>
        <formula>IF( CONTAINS(RecordType.Name,&apos;Report&apos;)||RecordType.Name=&apos;FRPP&apos;, IF( School_Report_Due__c &gt;= addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),12)&amp;&amp; School_Report_Due__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),12), true, false),IF ( Start_Date__c &gt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),12)&amp;&amp; Start_Date__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),12),true,false))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Semester + 2</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Current_Semester_3__c</fullName>
        <formula>IF( CONTAINS(RecordType.Name,&apos;Report&apos;)||RecordType.Name=&apos;FRPP&apos;, IF( School_Report_Due__c &gt;= addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),18)&amp;&amp; School_Report_Due__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),18), true, false),IF ( Start_Date__c &gt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),18)&amp;&amp; Start_Date__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),18),true,false))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Semester + 3</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Current_Semester_4__c</fullName>
        <formula>IF( CONTAINS(RecordType.Name,&apos;Report&apos;)||RecordType.Name=&apos;FRPP&apos;, IF( School_Report_Due__c &gt;= addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),24)&amp;&amp; School_Report_Due__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),24), true, false),IF ( Start_Date__c &gt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1),24)&amp;&amp; Start_Date__c &lt;=addMonths(DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),24),true,false))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>

    <fields>
        <fullName>Account_Region__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK( Engagement__r.School_Name__r.Country_Code__c ), &quot;None&quot;,
IF(CONTAINS(&quot;AG:AI:AW:BB:BL:BQ:BS:CU:CW:DM:DO:GD:GP:HT:JM:KN:LC:KY:MF:MS:MQ:PR:SX:TC:TT:VC:VI:VG&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Caribbean&quot;,
IF(CONTAINS(&quot;CF:CM:GA:GQ:ST:TD:CD:CG&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Central Africa&quot;,
IF(CONTAINS(&quot;BZ:CR:GT:HN:NI:PA:SV&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Central America&quot;,
IF(CONTAINS(&quot;KG:KZ:TJ:TM:UZ&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Central Asia&quot;,
IF(CONTAINS(&quot;BI:DJ:ER:ET:KE:RW:SC:SD:SO:SS:TZ:UG&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;East Africa&quot;,
IF(CONTAINS(&quot;CN:JP:KP:KR:MN:MO:TW:HK&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;East Asia&quot;,
IF(CONTAINS(&quot;AL:AM:AZ:BA:BG:BY:CZ:EE:GE:HR:HU:MD:ME:MK:PL:RO:RU:RS:SI:UA:SK:XK&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Eastern Europe&quot;,
IF(CONTAINS(&quot;AE:BH:IL:IQ:IR:JO:KW:LB:OM:PS:QA:SA:TR:YE:SY&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Middle East&quot;,
IF(CONTAINS(&quot;DZ:EG:EH:LY:MA:TN&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;North Africa&quot;,
IF(CONTAINS(&quot;BM:CA:GL:MX:PM:US&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;North America&quot;,
IF(CONTAINS(&quot;DK:FI:FO:IS:NO:SE:XQ:AX:SJ&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Northern Europe&quot;,
IF(CONTAINS(&quot;AS:AU:CC:CK:CX:FJ:FM:GU:HM:KI:MH:MP:NC:NF:NR:NU:PF:NZ:PG:PW:PN:SB:TK:TO:TV:UM:VU:WF:WS&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Oceania &quot;,
IF(CONTAINS(&quot;AQ:AR:BO:BR:BV:CL:CO:EC:FK:GF:GS:GY:PE:PY:SR:UY:VE&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;South America&quot;,
IF(CONTAINS(&quot;AF:BD:BT:IN:IO:LK:MV:NP:PK&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;South Asia&quot;,
IF(CONTAINS(&quot;BN:ID:KH:LA:MM:MY:PH:SG:TH:TL:VN&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;South-east Asia&quot;,
IF(CONTAINS(&quot;AO:BW:KM:LS:MG:MU:MW:MZ:NA:RE:SZ:TF:YT:ZA:ZM:ZW&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Southern Africa&quot;,
IF(CONTAINS(&quot;AD:CY:ES:GI:GR:IT:MT:PT:SM:VA&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Southern Europe&quot;,
IF(CONTAINS(&quot;BF:BJ:CI:CV:GH:GM:GN:GW:LR:ML:MR:NE:NG:SL:SN:TG:SH&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;West Africa&quot;,
IF(CONTAINS(&quot;AT:BE:CH:DE:FR:GB:GG:IE:IM:JE:LI:LT:LU:LV:MC:NL&quot;, Engagement__r.School_Name__r.Country_Code__c ),&quot;Western Europe&quot;,
&quot;Other&quot;))))))))))))))))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Region</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

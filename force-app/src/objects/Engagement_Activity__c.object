    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>CopyEditingSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>IF(  RecordType.DeveloperName = &apos;Preparatory_Evaluation&apos; ,
(AND(NOT(ISBLANK( Copy_Editing_Submitted__c ))
, ISBLANK( Review_Completed_By__c ))
) 
, NULL )</errorConditionFormula>
        <errorDisplayField>Review_Completed_By__c</errorDisplayField>
        <errorMessage>Completed by field must be filled to send the submission email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Membership_Engagement_Visit_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>(
    (
        LEN(Notes__c) = 0 ||
        !ISCHANGED(Notes__c)
    ) &amp;&amp;
    ISCHANGED(Activity_Status__c)
) &amp;&amp;
(
    ISPICKVAL(Activity_Status__c, &quot;Cancelled&quot;) ||
    ISPICKVAL(PRIORVALUE(Activity_Status__c), &quot;Cancelled&quot;)
)</errorConditionFormula>
        <errorDisplayField>Notes__c</errorDisplayField>
        <errorMessage>When the status is set to cancelled, a note must be added or updated to enable saving.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Quality_Assurance_Submitted</fullName>
        <active>true</active>
        <description>If Quality Assurance is checked, QA Lead Person needs to be filled in</description>
        <errorConditionFormula>AND( Quality_Assurance__c = true, QA_Lead_Person__c = &quot;&quot;)</errorConditionFormula>
        <errorDisplayField>QA_Lead_Person__c</errorDisplayField>
        <errorMessage>Please fill in this field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ReviewSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>AND ( NOT (ISBLANK(  Review_Submitted__c  )), 
ISBLANK(  Publication_Completed_By__c  ))</errorConditionFormula>
        <errorDisplayField>Publication_Completed_By__c</errorDisplayField>
        <errorMessage>Completed by must be filled to send the submission email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SchoolReport_DraftSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>IF(  RecordType.DeveloperName = &apos;FRPP&apos; ,
AND (NOT (ISBLANK( School_Report_Draft_Submitted_del__c )), 
ISBLANK( School_Report_Review_Completed_By__c  )
) ,
IF(  RecordType.DeveloperName = &apos;Supplementary_Report&apos; ,
AND (NOT (ISBLANK( School_Report_Draft_Submitted_del__c )), 
ISBLANK( School_Report_Review_Completed_By__c )
) ,
IF(  RecordType.DeveloperName = &apos;Special_Report&apos; ,
AND (NOT (ISBLANK( School_Report_Draft_Submitted_del__c )), 
ISBLANK( School_Report_Review_Completed_By__c )
) 
, NULL )))</errorConditionFormula>
        <errorDisplayField>School_Report_Review_Completed_By__c</errorDisplayField>
        <errorMessage>School Report Review Completed by field must be filled to send the submission email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SchoolReport_ReviewDateSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>AND (
NOT (
ISBLANK( School_Report_Review_Date_Submitted__c   )), 
ISBLANK( School_Report_Publication_Completed_By__c   )
)</errorConditionFormula>
        <errorDisplayField>School_Report_Publication_Completed_By__c</errorDisplayField>
        <errorMessage>School Report Review Completed by must be filled to send the submission email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>SchoolReport_SchoolSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>IF(  RecordType.DeveloperName = &apos;FRPP&apos; ,
AND (NOT (ISBLANK( School_Submission_Submitted__c )), 
ISBLANK( School_Report_Draft_Completed_By__c )
) ,
IF(  RecordType.DeveloperName = &apos;Supplementary_Report&apos; ,
AND (NOT (ISBLANK( School_Submission_Submitted__c )), 
ISBLANK( School_Report_Draft_Completed_By__c )
) ,
IF(  RecordType.DeveloperName = &apos;Special_Report&apos; ,
AND (NOT (ISBLANK( School_Submission_Submitted__c )), 
ISBLANK( School_Report_Draft_Completed_By__c )
) 
, NULL )))</errorConditionFormula>
        <errorDisplayField>School_Report_Draft_Completed_By__c</errorDisplayField>
        <errorMessage>School Report Draft Completed by field must be filled to send the submission email.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TeamEvaluation_CopyEditingSubmitted</fullName>
        <active>false</active>
        <errorConditionFormula>IF( RecordType.DeveloperName = &apos;Team_Evaluation&apos;
, ( AND ( NOT( ISBLANK(  Copy_Editing_Submitted__c  ))
, ISBLANK(  Copy_Editing_Completed_By__c  )))
, null )</errorConditionFormula>
        <errorDisplayField>Copy_Editing_Completed_By__c</errorDisplayField>
        <errorMessage>Evaluation Report &quot;completed by&quot; fields must be filled</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TeamEvaluation_ReadersResponsesSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>IF( RecordType.DeveloperName = &apos;Team_Evaluation&apos;
, ( AND ( NOT( ISBLANK( Reader_s_Responses_Submitted__c ))
, ISBLANK( Revised_Draft_Completed_By__c )))
, null )</errorConditionFormula>
        <errorDisplayField>Revised_Draft_Completed_By__c</errorDisplayField>
        <errorMessage>Evaluation Report &quot;completed by&quot; fields must be filled, Revised Draft Completed By or Review Completed by.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TeamEvaluation_RevisedDraftSubmitted</fullName>
        <active>true</active>
        <errorConditionFormula>IF( RecordType.DeveloperName = &apos;Team_Evaluation&apos;
, ( AND ( NOT( ISBLANK(  Revised_Draft_Submitted__c  ))
, ISBLANK(   Review_Completed_By__c   )))
, null )</errorConditionFormula>
        <errorDisplayField>Review_Completed_By__c</errorDisplayField>
        <errorMessage>Evaluation Report &quot;completed by&quot; fields must be filled.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

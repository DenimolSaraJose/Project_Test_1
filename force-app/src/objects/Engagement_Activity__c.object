    <fields>
        <fullName>Activity_status_progress__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(Report_Status__c, &quot;Accepted&quot;), &quot;Main report complete&quot;, 
IF( ISPICKVAL(Report_Status__c, &quot;Part 1 + Domain A Submitted&quot;), &quot;Early submission submitted&quot;, 
IF( ISPICKVAL(Report_Status__c, &quot;Part 1 + Domain A Submitted&quot;), &quot;Early submission submitted&quot;, 
IF( ISPICKVAL(Report_Status__c, &quot;Domain A Submitted&quot;), &quot;Early submission submitted&quot;, 
IF( ISPICKVAL(Activity_Status__c , &quot;Active&quot;), &quot;Early submission in progress&quot;, 
IF( ISPICKVAL(Activity_Status__c , &quot;Outcome Published&quot;), &quot;Outcome Published&quot;,
&quot;&quot; 
))))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Activity status progress</label>
        <required>false</required>

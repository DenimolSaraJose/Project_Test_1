        <formula>IF(!ISBLANK(Start_Date__c), RIGHT(TEXT(YEAR(DATEVALUE(TEXT(YEAR(Start_Date__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(Start_Date__c)) &amp; &quot;-1&quot;))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(DATEVALUE(TEXT(YEAR(Start_Date__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(Start_Date__c)) &amp; &quot;-1&quot;)) &lt;= 6, &quot;1&quot;, &quot;2&quot;), IF(!ISBLANK(School_Report_Due__c), RIGHT(TEXT(YEAR(DATEVALUE(TEXT(YEAR(School_Report_Due__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(School_Report_Due__c)) &amp; &quot;-1&quot;))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(DATEVALUE(TEXT(YEAR(School_Report_Due__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(School_Report_Due__c)) &amp; &quot;-1&quot;)) &lt;= 6, &quot;1&quot;, &quot;2&quot;), NULL))</formula>
        <label>Semester</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sign_Off_Due__c</fullName>
        <description>Field used in Evaluation Report Outcome workflow (together with Sign Off Submitted On and Sign Off Submitted By fields). Last step before publication.</description>
        <label>Sign Off Due</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Sign_Off_Submitted_By__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Field used in Evaluation Report Outcome workflow (together with Sign Off Due and Sign Off Submitted On). Last step before report publication.</description>
        <label>Sign Off Submitted By</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Accreditation_Activitiesaj8W</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sign_Off_Submitted_On__c</fullName>
        <description>Field used in Evaluation report Outcome workflow (together with Sign Off Due and Sign Off Submitted By). Last step before publication</description>
        <label>Sign Off Submitted On</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>SortDate__c</fullName>
        <description>Used solely for Data Migration</description>
        <formula>CASE(RecordType.DeveloperName,

&apos;FRPP&apos;,
BLANKVALUE(School_Submission_Due__c, School_Report_Due__c),

&apos;Annual_Report&apos;,
IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate))),

&apos;Supplementary_Report&apos;,
IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate))),

&apos;Special_Report&apos;,
IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate))),

&apos;Supplementary_Evaluation&apos;,
BLANKVALUE(Start_Date__c, IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate)))),

&apos;Special_Evaluation&apos;,
BLANKVALUE(Start_Date__c, IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate)))),

&apos;Substantive_Change_Evaluation&apos;,
IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate))),

&apos;Five_Year_Evaluation&apos;,
BLANKVALUE(Start_Date__c, IF((!ISBLANK(School_Submission_Submitted__c) &amp;&amp; !ISBLANK(School_Report_Due__c) &amp;&amp; School_Submission_Submitted__c &lt; School_Report_Due__c), School_Submission_Submitted__c, BLANKVALUE(School_Report_Due__c, DATEVALUE(CreatedDate)))),

BLANKVALUE(Start_Date__c, BLANKVALUE(Domain_A_due__c, BLANKVALUE(Part_1_Domain_A_due__c, DATEVALUE(CreatedDate))))

)</formula>
        <label>SortDate</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>

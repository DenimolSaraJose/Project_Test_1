    <fields>
        <fullName>Current_Semester__c</fullName>
        <formula>IF( CONTAINS(RecordType.Name,&apos;Report&apos;)||RecordType.Name=&apos;FRPP&apos;, IF( School_Report_Due__c &gt;= DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1) &amp;&amp; School_Report_Due__c &lt;=DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)), true, false),IF ( Start_Date__c &gt;=DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,1,7),1) &amp;&amp; Start_Date__c &lt;=DATE(YEAR(TODAY()),if(MONTH(TODAY())&lt;=6,6,12),if(MONTH(TODAY())&lt;=6,30,31)),true,false))</formula>

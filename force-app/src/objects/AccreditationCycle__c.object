    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>AccreditationCycleCompactLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>AccreditationCycleCompactLayout</fullName>
        <fields>Name</fields>

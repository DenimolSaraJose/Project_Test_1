        <fields>nCompletedStages__c</fields>
        <fields>CompletionPercentage__c</fields>
        <fields>EstimatedCompletionDate__c</fields>
        <label>Accreditation Cycle Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>

        <fullName>AccreditationTrack__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Accreditation Framework</label>
        <referenceTo>AccreditationTrack__c</referenceTo>
        <relationshipLabel>Accreditation Cycles</relationshipLabel>
        <relationshipName>AccreditationCycles</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Accreditation__c</fullName>
        <label>Accreditation</label>
        <referenceTo>Accreditation__c</referenceTo>
        <relationshipLabel>Accreditation Cycles</relationshipLabel>
        <relationshipName>AccreditationCycles</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>CompletedDate__c</fullName>
        <label>Cycle Completed Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>CompletionPercentage__c</fullName>
        <description>Progress towards completion as a percentage; based on the Start Date of the current Stage and the total duration of the Accreditation Cycle. Once the Accreditation Cycle has been &apos;Completed&apos; this field will reflect that status.</description>
        <formula>IF(!IsCompleted__c, (((EstimatedCompletionDate__c - StagesEarliestStartDate__c) - (EstimatedCompletionDate__c - CurrentStageStartDate__c)) / (EstimatedCompletionDate__c - StagesEarliestStartDate__c)), 1)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Progress towards completion as a percentage; based on the Start Date of the current Stage and the total duration of the Accreditation Cycle. Once the Accreditation Cycle has been &apos;Completed&apos; this field will reflect that status.</inlineHelpText>
        <label>Complete (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>CurrentCycleStageLink__c</fullName>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(CurrentCycleStageName__c), &apos;N/A&apos;, HYPERLINK(
&quot;/&quot; &amp; CurrentCycleStageName__c,
CurrentCycleStageName__r.StageName__c,
&quot;_self&quot;
))</formula>
        <label>Current Cycle Stage Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentCycleStageName__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Current Cycle Stage Name</label>
        <referenceTo>AccreditationCycleStage__c</referenceTo>
        <relationshipLabel>Accreditation Cycles</relationshipLabel>
        <relationshipName>AccreditationCycles</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CurrentDuration__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
CEILING(((IF(
!IsCompleted__c, TODAY(), BLANKVALUE(CompletedDate__c, TODAY())) - StartDate__c)/7)) &gt; 0, CEILING(((IF(!IsCompleted__c, TODAY(), BLANKVALUE(CompletedDate__c, TODAY())) - StartDate__c)/7))
, NULL
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Current duration for the Acceditation Cycle in weeks (rounded up).</inlineHelpText>
        <label>Current Duration (weeks)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentIAC__c</fullName>
        <description>Current IAC for Accreditation Cycle, configured at Accreditation Stage</description>
        <externalId>false</externalId>
        <inlineHelpText>This field is showing the current IAC for this accreditation cycle. The IAC varies by accreditation stage and is configured there.</inlineHelpText>
        <label>IAC</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentSSA__c</fullName>
        <description>Current SSA for Accreditation Cycle, configured at Accreditation Stage</description>
        <externalId>false</externalId>
        <inlineHelpText>This field is showing the current SSA for this accreditation cycle. The SSA varies by accreditation stage and is configured there.</inlineHelpText>
        <label>SSA</label>
        <length>80</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentStageDueDate__c</fullName>
        <formula>CurrentCycleStageName__r.DueDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Stage Due Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>CurrentStageName__c</fullName>
        <externalId>false</externalId>
        <formula>CurrentCycleStageName__r.AccreditationStage__r.Name</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Stage Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentStageOrder__c</fullName>
        <description>Current Accreditation Cycle Stage (in order).</description>
        <externalId>false</externalId>
        <formula>CurrentCycleStageName__r.Order__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Current Accreditation Cycle Stage (in order).</inlineHelpText>
        <label># Current Stage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CurrentStageStartDate__c</fullName>
        <formula>CurrentCycleStageName__r.StartDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Stage Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>CurrentStageStatus__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(CurrentCycleStageName__r.Status__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Current Stage Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>EstimatedCompletionDate__c</fullName>
        <label>Estimated Completion Date</label>
        <summarizedField>AccreditationCycleStage__c.DueDate__c</summarizedField>
        <summaryForeignKey>AccreditationCycleStage__c.AccreditationCycle__c</summaryForeignKey>
        <summaryOperation>max</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>EstimatedDurationTotal__c</fullName>
        <externalId>false</externalId>
        <formula>ROUND(((BLANKVALUE(EstimatedCompletionDate__c, TODAY()) - StartDate__c)/7),0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Estimated Total Duration (weeks)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IAA__c</fullName>
        <externalId>false</externalId>
        <formula>Accreditation__r.Account__r.IAA__r.FirstName + &apos; &apos; +
IF(!ISBLANK(Accreditation__r.Account__r.IAA__r.MiddleName), Accreditation__r.Account__r.IAA__r.MiddleName + &apos; &apos;, &apos;&apos;) +
Accreditation__r.Account__r.IAA__r.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IAA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsClosed__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Closed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsCompleted__c</fullName>
        <description>Accreditation Cycles with status &apos;Completed&apos; are marked as &apos;Complete&apos; and apply for closure.</description>
        <formula>ISPICKVAL(Status__c, &apos;Completed&apos;)</formula>
        <label>Completed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsNew__c</fullName>
        <description>Indictates if an Accreditation Cycle is new; this applies to the first Cycle only with status equals &apos;Planned&apos; and a Start Date that is within 2 months of the Accreditation Registration Date. This helper field is used in list views.</description>
        <formula>ISPICKVAL(Status__c, &apos;Planned&apos;) &amp;&amp;
RIGHT(Name, 2) = &apos;#1&apos; &amp;&amp;
StartDate__c - ADDMONTHS(Accreditation__r.RegistrationDate__c, 2) &lt;= 0</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indictates if an Accreditation Cycle is new; this applies to the first Cycle only with status equals &apos;Planned&apos; and a Start Date that is within 2 months of the Accreditation Registration Date. This helper field is used in list views.</inlineHelpText>
        <label>New</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserCurrentIAC__c</fullName>
        <formula>IF ( $User.Id = CurrentCycleStageName__r.IAC__r.Id, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User Current IAC</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserCurrentSSA__c</fullName>
        <description>If checked the user is registered as the SSA for the current Stage, this field is used as a filter for certain components on Lightning Record pages.</description>
        <formula>IF ( $User.Id = CurrentCycleStageName__r.SSA__r.Id, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User Current SSA</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserIAA__c</fullName>
        <description>If checked the user is registered as a IAA for the related Account, this field is used as a filter for certain components on Lightning Record pages.</description>
        <formula>IF ( $User.Id = Accreditation__r.Account__r.IAA__c, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User IAA</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserSSEO__c</fullName>
        <description>If checked the user is registered as a SSEO for the related Account, this field is used as a filter for certain components on Lightning Record pages.</description>
        <formula>IF ( $User.Id = Accreditation__r.Account__r.SSEO__c, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User SSEO</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>NextAccreditationCycle__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Next Accreditation Cycle</label>
        <referenceTo>AccreditationCycle__c</referenceTo>
        <relationshipLabel>Consecutive Accreditation Cycles</relationshipLabel>
        <relationshipName>AccreditationCycles</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>PreviousAccreditationCycle__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Previous Accreditation Cycle</label>
        <referenceTo>AccreditationCycle__c</referenceTo>
        <relationshipLabel>Preceding Accreditation Cycles</relationshipLabel>
        <relationshipName>PrecedingAccreditationCycles</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SSEO__c</fullName>
        <externalId>false</externalId>
        <formula>Accreditation__r.Account__r.SSEO__r.FirstName + &apos; &apos; +
IF(!ISBLANK(Accreditation__r.Account__r.SSEO__r.MiddleName), Accreditation__r.Account__r.SSEO__r.MiddleName + &apos; &apos;, &apos;&apos;) +
Accreditation__r.Account__r.SSEO__r.LastName</formula>
        <label>SSEO</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SemesterNextCycle__c</fullName>
        <description>Calculates the semester in which the next Accreditation Cycle should start</description>
        <externalId>false</externalId>
        <formula>IF(
!ISBLANK(CompletedDate__c),
RIGHT(TEXT(YEAR(ADDMONTHS(DATEVALUE(TEXT(YEAR(CompletedDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(CompletedDate__c)) &amp; &quot;-1&quot;), 6))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(ADDMONTHS(DATEVALUE(TEXT(YEAR(CompletedDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(CompletedDate__c)) &amp; &quot;-1&quot;), 6)) &lt;= 6, &quot;1&quot;, &quot;2&quot;),
IF(
!ISBLANK(EstimatedCompletionDate__c),
RIGHT(TEXT(YEAR(ADDMONTHS(DATEVALUE(TEXT(YEAR(EstimatedCompletionDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(EstimatedCompletionDate__c)) &amp; &quot;-1&quot;), 6))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(ADDMONTHS(DATEVALUE(TEXT(YEAR(EstimatedCompletionDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(EstimatedCompletionDate__c)) &amp; &quot;-1&quot;), 6)) &lt;= 6, &quot;1&quot;, &quot;2&quot;),
&quot;N/A&quot;))</formula>
        <inlineHelpText>Semester when the next Accreditation Cycle should start. As long as the current Accreditation Cycle is not completed, the semester is based on the &apos;Estimated Completion Date&apos;. Once the current Accreditation Cycle has been completed, the semester is based on the actual &apos;Completed Date&apos;.</inlineHelpText>
        <label>Semester Next Cycle</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Semester__c</fullName>
        <externalId>false</externalId>
        <formula>RIGHT(TEXT(YEAR(DATEVALUE(TEXT(YEAR(StartDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(StartDate__c)) &amp; &quot;-1&quot;))), 2) &amp; &quot;-&quot; &amp; IF(MONTH(DATEVALUE(TEXT(YEAR(StartDate__c)) &amp; &quot;-&quot; &amp; TEXT(MONTH(StartDate__c)) &amp; &quot;-1&quot;)) &lt;= 6, &quot;1&quot;, &quot;2&quot;)</formula>
        <label>Semester</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

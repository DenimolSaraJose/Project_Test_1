    <fields>
        <fullName>AccountName__c</fullName>
        <description>Used in Accreditation Cycle list view(s)</description>
        <externalId>false</externalId>
        <formula>Accreditation__r.Account__r.Name</formula>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Accreditation Cycles</relationshipLabel>
        <relationshipName>AccreditationCycles</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>AccreditationCycleLink__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(
&quot;/&quot; &amp; Id,
Name,
&quot;_self&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accreditation Cycle Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccreditationCycleOutcome__c</fullName>
        <description>Current outcome for this Accreditation Cycle, this does not include recommendations.</description>
        <externalId>false</externalId>
        <inlineHelpText>This reflects the most recent outcome of an accreditation stage within a cycle and is not limited to the accreditation decision. Team’s recommendations are excluded.</inlineHelpText>
        <label>Latest Outcome in Cycle</label>
        <length>3</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccreditationName__c</fullName>
        <description>Used in Accreditation Cycle list view(s)</description>
        <externalId>false</externalId>
        <formula>Accreditation__r.Name</formula>
        <label>Accreditation Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccreditationTrackName__c</fullName>
        <externalId>false</externalId>
        <formula>AccreditationTrack__r.Name</formula>
        <label>Accreditation Framework Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Prevent_Changing_Start_Date</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(StartDate__c) &amp;&amp;
!ISPICKVAL(Status__c, &apos;Planned&apos;)</errorConditionFormula>
        <errorMessage>You can only adjust the Start Date for Accreditation Cycles with status &apos;Planned&apos;...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Changing_Status_Closed_Cycle</fullName>
        <active>true</active>
        <description>This validation rule prevents changing the cycle status once the Accreditation Cycle has been closed.</description>
        <errorConditionFormula>IsClosed__c &amp;&amp;
IsChanged(Status__c) &amp;&amp;
ISPICKVAL(PRIORVALUE(Status__c), &apos;Completed&apos;)</errorConditionFormula>
        <errorMessage>You cannot change the status once the Accreditation Cycle is closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_In_Progress_Before_Start_Date</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(Status__c) &amp;&amp;
ISPICKVAL(PRIORVALUE(Status__c), &apos;Planned&apos;) &amp;&amp;
ISPICKVAL(Status__c, &apos;In Progress&apos;) &amp;&amp;
StartDate__c &gt; TODAY()</errorConditionFormula>
        <errorMessage>You cannot change the status to &apos;In Progress&apos; since the Cycle&apos;s Start Date has not been reached yet...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Manually_Updating_CompletedDate</fullName>
        <active>true</active>
        <description>This validation rule prevents manually setting or updating the Completed Date.</description>
        <errorConditionFormula>ISCHANGED(CompletedDate__c ) &amp;&amp; !ISBLANK( CompletedDate__c ) &amp;&amp; !ISPICKVAL( Status__c, &apos;Completed&apos;)</errorConditionFormula>
        <errorMessage>Please use the &apos;Status&apos; -field and mark this Accreditation Cycle as &apos;Complete&apos;, it is not possible to manually set or update the &apos;Completed Date&apos;.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Overlap_With_Previous_Cycle</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
!ISBLANK(PreviousAccreditationCycle__c) &amp;&amp;
ISCHANGED(StartDate__c) &amp;&amp;
StartDate__c &lt; BLANKVALUE(PreviousAccreditationCycle__r.CompletedDate__c,  PreviousAccreditationCycle__r.EstimatedCompletionDate__c)</errorConditionFormula>
        <errorMessage>The Start Date cannot be set to a date before the (estimated) completion date of the previous Accreditation Cycle...</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Event to notify the User on individual Non-CV parsing complete</description>
    <eventType>HighVolume</eventType>
    <fields>
        <fullName>TR1__Is_Error__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Value is true in case of Non-CV parsing error</description>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Is Error</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Record_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines the Record Id related to the parsing result: Contact Id in case of success and Debug Log Id in case of error</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>Record Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__User_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>User Id who executed the parsing action</description>
        <externalId>false</externalId>
        <isFilteringDisabled>false</isFilteringDisabled>
        <isNameField>false</isNameField>
        <isSortingDisabled>false</isSortingDisabled>
        <label>User Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Non-CV Parsing</label>
    <pluralLabel>Non-CVs Parsing</pluralLabel>
    <publishBehavior>PublishImmediately</publishBehavior>
</CustomObject>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Main settings for Power Notes feature</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Chatter_Default__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If checked, &apos;Post to Chatter&apos; checkbox on PowerNotes page is enabled by default</inlineHelpText>
        <label>Chatter Default</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Hide_Post_to_chatter_checkbox__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If checked, &apos;Post to Chatter&apos; checkbox is not shown on Power Notes page</inlineHelpText>
        <label>Hide &apos;Post to chatter&apos; checkbox</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Hide_Save_New__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If checked, &apos;Save&amp;New&apos; button won&apos;t be shown on New Power Notes page</description>
        <inlineHelpText>If checked, &apos;Save&amp;New&apos; button won&apos;t be shown on New Power Notes page</inlineHelpText>
        <label>Hide Save&amp;New</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Hide_Save_New_for_ATS__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If checked, &apos;Save&amp;New&apos; button won&apos;t be shown on New Power Notes page called from Job ATS or Candidate ATS</description>
        <inlineHelpText>If checked, &apos;Save&amp;New&apos; button won&apos;t be shown on New Power Notes page called from Job ATS or Candidate ATS</inlineHelpText>
        <label>Hide Save&amp;New for ATS</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Include_signature__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Include user signature to CC email messages</inlineHelpText>
        <label>Include signature?</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__No_Updating_For_PowerShare_Notes__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, users will not be able to change/edit/update the text entered in PowerShare middle section text field</description>
        <inlineHelpText>If enabled, users will not be able to change/edit/update the text entered in PowerShare middle section text field</inlineHelpText>
        <label>No Updating for PowerShare Notes</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Only_Contacts_For_CC__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Show Contact records only in CC field if checked</description>
        <inlineHelpText>Show Contact records only in CC field if checked</inlineHelpText>
        <label>Show Contacts only in CC field</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Only_Users_For_CC__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Show Users records only in CC field if checked. Not supported if ‘New Email Model Provider’=‘SFMC’</description>
        <inlineHelpText>Show Users records only in CC field if checked. Not supported if ‘New Email Model Provider’=‘SFMC’</inlineHelpText>
        <label>Show Users only in CC field</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Power_Note_List_description_expanded__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If checked, Notes descriptions are expanded by default in the Power Note List</inlineHelpText>
        <label>Power Note List description expanded</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Show_email_cc__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If checked, CC field is shown on Power Note creation page and email message can be sent to the populated recipients</inlineHelpText>
        <label>Show email CC</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Task_Offset_Size__c</fullName>
        <defaultValue>20</defaultValue>
        <deprecated>false</deprecated>
        <description>The number of activities in one block, displayed in the Power Notes list at a time, exceeding which it will display the Show More button.</description>
        <externalId>false</externalId>
        <inlineHelpText>The number of tasks in one block, displayed in the Power Notes list at a time, exceeding which it will display the Show More button.</inlineHelpText>
        <label>Activity Offset Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Tasks_Limit_Size__c</fullName>
        <defaultValue>2000</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The max number of all displayed tasks on the Power Notes List, when exceeded, the warning message will be displayed.</inlineHelpText>
        <label>Activities Limit Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Power Notes</label>
    <visibility>Public</visibility>
</CustomObject>

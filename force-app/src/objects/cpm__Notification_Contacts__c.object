<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <description>Information about right contacts at customer in case of billing or errors</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>cpm__Email__c</fullName>
        <deprecated>false</deprecated>
        <description>E-mail address of contact person/group</description>
        <externalId>false</externalId>
        <label>Email Address</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Organization_Id__c</fullName>
        <defaultValue>$Organization.Id</defaultValue>
        <deprecated>false</deprecated>
        <description>Organization Id, to be use on data warehouse</description>
        <externalId>false</externalId>
        <label>Organization Id</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Type__c</fullName>
        <deprecated>false</deprecated>
        <description>Type of the contact person/group</description>
        <externalId>false</externalId>
        <label>Type</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__isActive__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <label>Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Notification Contacts</label>
    <visibility>Public</visibility>
</CustomObject>

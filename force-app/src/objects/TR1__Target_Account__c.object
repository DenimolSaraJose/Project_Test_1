    <fields>
        <fullName>TR1__Account_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>A Text field to enter an Account name, if no Account record exists.</description>
        <externalId>false</externalId>
        <inlineHelpText>A Text field to enter an Account name, if no Account record exists.</inlineHelpText>
        <label>Account Name</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>A lookup to the Account record. Search for an Account to add as a Target Account.</description>
        <inlineHelpText>A lookup to the Account record. Search for an Account to add as a Target Account.</inlineHelpText>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Target Accounts</relationshipLabel>
        <relationshipName>Target_Accounts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TR1__Job__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The Job this Target Account is being researched for.</description>
        <inlineHelpText>The Job this Target Account is being researched for.</inlineHelpText>
        <label>Job</label>
        <referenceTo>TR1__Job__c</referenceTo>
        <relationshipLabel>Target Accounts</relationshipLabel>
        <relationshipName>Target_Accounts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TR1__Notes__c</fullName>
        <deprecated>false</deprecated>
        <description>Additional notes for this Target Account record.</description>
        <inlineHelpText>Additional notes for this Target Account record.</inlineHelpText>
        <label>Notes</label>
        <length>131072</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Source_Account_List__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The Account List from which this Target Account was created.</description>
        <inlineHelpText>The Account List from which this Target Account was created.</inlineHelpText>
        <label>Source Account List</label>
        <referenceTo>TR1__Account_List__c</referenceTo>
        <relationshipLabel>Target Accounts</relationshipLabel>
        <relationshipName>Target_Accounts</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TR1__Source_Text__c</fullName>
        <deprecated>false</deprecated>
        <description>The source from which this Target Account was created.</description>
        <externalId>false</externalId>
        <inlineHelpText>The source from which this Target Account was created.</inlineHelpText>
        <label>Source</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Indicates the status of the relationship between the Job and Target Account.</description>
        <inlineHelpText>Indicates the status of the relationship between the Job and Target Account.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Research Not Started</fullName>
                    <default>true</default>
                    <label>Research Not Started</label>
                </value>
                <value>
                    <fullName>Research In Progress</fullName>
                    <default>false</default>
                    <label>Research In Progress</label>
                </value>
                <value>
                    <fullName>Research Completed</fullName>
                    <default>false</default>
                    <label>Research Completed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Target Account</label>
    <nameField>
        <displayFormat>TA-{0}</displayFormat>
        <label>Target Account Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Target Accounts</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>TR1__Must_have_Account</fullName>
        <active>true</active>
        <description>Target accounts must have a lookup to Account or at least an account name</description>
        <errorConditionFormula>AND( ISBLANK( TR1__Account_Name__c ) ,  ISBLANK(TR1__Account__r.Id) )</errorConditionFormula>
        <errorMessage>Target account must have an Account name or a reference to an Account</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Must_have_Job</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK( TR1__Job__r.Id)</errorConditionFormula>
        <errorMessage>A target account must have a job</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

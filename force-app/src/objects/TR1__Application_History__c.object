    <fields>
        <fullName>TR1__Days_in_Stage__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>if((TR1__Stage_End_Date__c - TR1__Stage_Start_Date__c=0),1,(TR1__Stage_End_Date__c - TR1__Stage_Start_Date__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>

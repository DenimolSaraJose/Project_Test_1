<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that filter the list of features on the Feature Console page. These settings are automatically generated when a user filters the list of features to ensure the selections persist when they return to the page.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>fferpcore__Application__c</fullName>
        <deprecated>false</deprecated>
        <description>An automatically generated list of applications to filter the list of features by.</description>
        <externalId>false</externalId>
        <inlineHelpText>An automatically generated list of applications to filter the list of features by.</inlineHelpText>
        <label>Application</label>
        <length>79</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fferpcore__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>An automatically generated list of statuses to filter the list of features by.</description>
        <externalId>false</externalId>
        <inlineHelpText>An automatically generated list of statuses to filter the list of features by.</inlineHelpText>
        <label>Status</label>
        <length>19</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Feature Console Filter Settings</label>
    <visibility>Public</visibility>
</CustomObject>

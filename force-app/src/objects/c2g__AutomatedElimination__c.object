        <fullName>c2g__UseReportingCurrency__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that the Reporting Currency should be used for the destination transaction.</description>
        <inlineHelpText>If selected, the Reporting Currency is used instead of the Dual Currency. All the selected companies, including the Destination Company, must use the same Reporting Currency.</inlineHelpText>
        <label>Use Reporting Currency</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>

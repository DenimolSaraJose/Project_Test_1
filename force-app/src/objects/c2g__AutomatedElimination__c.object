    <fields>
        <fullName>c2g__DestinationCompany__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the company that transactions will be posted to. This company must be marked as an Elimination Company.</description>
        <inlineHelpText>Destination company used in the automated elimination process. Only elimination companies are available.</inlineHelpText>
        <label>Destination Company</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>The selected Destination Company is not marked as Elimination. Choose an Elimination Company and try again.</errorMessage>
            <filterItems>
                <field>c2g__codaCompany__c.c2g__EliminationCompany__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>c2g__codaCompany__c</referenceTo>
        <relationshipLabel>Automated Eliminations</relationshipLabel>
        <relationshipName>AutomatedEliminations</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__DestinationDimension1__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>Lookup to the Dimensions used by the last transaction line item of the transaction generated by the  Automated Elimination Process.This transaction line item contains the total source value retrieved by that transaction.</description>
        <label>Destination Dimension 1</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>c2g__codaDimension1__c.c2g__Disabled__c</field>
                <operation>equals</operation>
                <value>False</value>
            </filterItems>
            <isOptional>true</isOptional>
        </lookupFilter>
        <referenceTo>c2g__codaDimension1__c</referenceTo>
        <relationshipLabel>Automated Eliminations</relationshipLabel>
        <relationshipName>AutomatedEliminations</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>

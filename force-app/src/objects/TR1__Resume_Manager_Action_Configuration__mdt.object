<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata defining and controlling the standard and custom actions displayed in the Resume Manager.</description>
    <fields>
        <fullName>TR1__Action_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of the action to be used in the Resume Manager.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of the action to be used in the Resume Manager.</inlineHelpText>
        <label>Action Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Boolean flag for enabling/disabling this action in the Resume Manager.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Boolean flag for enabling/disabling this action in the Resume Manager.</inlineHelpText>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Component_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The name of the Aura component to be invoked by running this action.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The name of the Aura component to be invoked by running this action. Note: the component name should contain the namespace prefix e.g. either use the default namespace like c:ComponentName, or, if the namespace is enabled, use that namespace.</inlineHelpText>
        <label>Component Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Custom_Label__c</fullName>
        <deprecated>false</deprecated>
        <description>The Custom Label API name which is used for the translation of the action name if the specified label has appropriate translations.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The Custom Label API name which is used for the translation of the action name if the specified label has appropriate translations. Should be populated with Namespace prefix (if applicable). E.g.: TR1.Custom_label</inlineHelpText>
        <label>Custom Label</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Display_Location__c</fullName>
        <defaultValue>&apos;Bar&apos;</defaultValue>
        <deprecated>false</deprecated>
        <description>Controls whether the particular action location is in the bar or in the dropdown. Possible values are Bar and Dropdown. If nothing is specified the default location will be in the bar.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Controls whether the particular action location is in the bar or in the dropdown. Possible values are Bar and Dropdown. If nothing is specified the default location will be in the bar.</inlineHelpText>
        <label>Display Location</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Bar</fullName>
                    <default>true</default>
                    <label>Bar</label>
                </value>
                <value>
                    <fullName>Dropdown</fullName>
                    <default>false</default>
                    <label>Dropdown</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Flow_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The API name of the Flow to be invoked by running this action.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The API name of the Flow to be invoked by running this action.</inlineHelpText>
        <label>Flow Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Icon_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The name of the SLDS icon that will be shown in the Bar for the custom action (if the ‘Display Location’ is set as &apos;Bar&apos;).</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The name of the SLDS icon that will be shown in the Bar for the custom action (if the ‘Display Location’ is set as &apos;Bar&apos;). Note: only the &apos;utility&apos; category can be used in the Bar.</inlineHelpText>
        <label>Icon Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Order_Number__c</fullName>
        <deprecated>false</deprecated>
        <description>Controls the order of the action in the Resume Manager.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Controls the order of the action in the Resume Manager.</inlineHelpText>
        <label>Order Number</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Resume Manager Action Configuration</label>
    <pluralLabel>Resume Manager Action Configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

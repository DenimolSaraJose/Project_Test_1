    <fields>
        <fullName>Payment_Status_Test__c</fullName>
        <externalId>false</externalId>
        <formula>if(NOT(CIS_Invoice_Status__c ==&apos;Complete&apos;) ,
&apos;Not Applicable&apos;,
if( CIS_Sales_Invoice__r.c2g__Transaction__r.c2g__DocumentOutstandingTotal__c  == 0,&apos;Paid&apos;,
if(  CIS_Sales_Invoice__r.c2g__Transaction__r.c2g__DocumentOutstandingTotal__c   ==  CIS_Sales_Invoice__r.c2g__Transaction__r.c2g__DocumentOutstandingTotal__c , &apos;Unpaid&apos;,
&apos;Part Paid&apos; ) ) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Status Test</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

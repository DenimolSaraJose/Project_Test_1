        <description>This validation rule prevents creating outcome records when the Accreditation Cycle is closed</description>
        <errorConditionFormula>/*ISNEW() &amp;&amp; AccreditationCycle__r.IsClosed__c*/
true</errorConditionFormula>
        <errorMessage>The Accreditation Cycle is closed, it is not possible to add new outcomes...</errorMessage>
    </validationRules>

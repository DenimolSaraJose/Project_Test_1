    <fields>
        <fullName>TR1__AccountRecordType__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>The Account Record Type Developer Name to init Account Pool V2 Accounts.
If empty or wrong a User default Record Type will be used.</inlineHelpText>
        <label>Account Record Type</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Always_Add_Default_Account__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>For Contacts created manually ONLY, enable this setting to have AccountId added if Contact record is saved with Account = blank</inlineHelpText>
        <label>Always Add Default Account</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Contact_records_filter__c</fullName>
        <deprecated>false</deprecated>
        <description>Filters for Contact records in JSON format. Used for filtering out Contact records for Account pool assignment. If the filter is &apos;TRUE&apos; the Account lookup will be empty.</description>
        <inlineHelpText>Filters for Contact records in JSON format. Used for filtering out Contact records for Account pool assignment. If the filter is &apos;TRUE&apos; the Account lookup will be empty.</inlineHelpText>
        <label>Contact records filter</label>
        <length>32768</length>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>TR1__Default_Account_Owner__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <inlineHelpText>Populates with current user on Save or you can enter a preferred User.</inlineHelpText>
        <label>Default Account Owner</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Account_Pool_v2</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>TR1__Distribution_Algorithm__c</fullName>
        <deprecated>false</deprecated>
        <label>Distribution Algorithm</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Random</fullName>
                    <default>true</default>
                    <label>Random</label>
                </value>
                <value>
                    <fullName>Round-Robin</fullName>
                    <default>false</default>
                    <label>Round-Robin</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Maximum_Amount_of_Candidates_per_Account__c</fullName>
        <deprecated>false</deprecated>
        <description>Max value should not be bigger than 10k. This is not a hard limit and the final count could be above or under the limit by a few units.</description>
        <externalId>false</externalId>
        <inlineHelpText>Max value should not be bigger than 10k. This is not a hard limit and the final count could be above or under the limit by a few units.</inlineHelpText>
        <label>Maximum Amount of Candidates per Account</label>
        <precision>10</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>

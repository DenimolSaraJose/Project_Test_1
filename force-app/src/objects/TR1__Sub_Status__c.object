    <fields>
        <fullName>TR1__Is_Active__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>If checked then this is the current sub status for this combination of stage and application. If unchecked then this represents a previous status and is used to track history. There can be only 1 active Sub Status for each combination of Application and ATS Stage.</description>
        <inlineHelpText>If checked then this is the current sub status for this combination of stage and application. If unchecked then this represents a previous status and is used to track history. There can be only 1 active Sub Status for each combination of Application and ATS Stage.</inlineHelpText>
        <label>Is Active</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

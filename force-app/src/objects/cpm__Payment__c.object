    <fields>
        <fullName>cpm__Name__c</fullName>
        <deprecated>false</deprecated>
        <description>The name of the debitor. whether it be a organisation or contact.</description>
        <externalId>false</externalId>
        <formula>IF (ISBLANK(cpm__Account__c) , cpm__Contact__r.FirstName &amp; &quot; &quot; &amp; cpm__Contact__r.LastName , cpm__Account__r.Name )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The name of the debitor.</inlineHelpText>
        <label>Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

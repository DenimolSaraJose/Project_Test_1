    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__Collection_date_not_empty</fullName>
        <active>true</active>
        <errorConditionFormula>ISBLANK(cpm__Collection_Date__c)</errorConditionFormula>
        <errorMessage>Collection date can&apos;t be empty</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Lock_Fiscal_Period</fullName>
        <active>true</active>
        <errorConditionFormula>cpm__Collection_Date__c &lt;=  $Setup.cpm__Lock_Fiscal_Periods__c.cpm__Lock_Payments_Up_To__c</errorConditionFormula>
        <errorMessage>Fiscal period is closed. You can&apos;t edit this record</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>c2g__DocumentOrdering__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(TEXT(c2g__DocumentType__c)), NULL,
	IF(ISPICKVAL(c2g__DocumentType__c,
	&apos;Translation&apos;),
	SUBSTITUTE( Name ,
	&apos;CRV&apos;,&apos;CRT&apos;), Name))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Document Ordering</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

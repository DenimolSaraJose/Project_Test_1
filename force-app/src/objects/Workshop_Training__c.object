    <validationRules>
        <fullName>Agency_Validation_Rule</fullName>
        <active>true</active>
        <description>CIS Agency value is only editable non community user.</description>
        <errorConditionFormula>If(  $User.ContactId &lt;&gt; null &amp;&amp; ISPICKVAL( Agency__c, &apos;CIS&apos;),true, false)</errorConditionFormula>
        <errorDisplayField>Agency__c</errorDisplayField>
        <errorMessage>If you are currently enrolled in CIS Evaluator training, you will see a record of this once you receive your certificate. If there is CIS Evaluator training missing from your portfolio, please write to us at accreditation@cois.org</errorMessage>
    </validationRules>
    <visibility>Public</visibility>

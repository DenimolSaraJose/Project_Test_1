        <label>Mandate Schedule Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Mandate Schedules</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__ProcessingDate_must_be_in_the_future</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
      AND(
       NOT(ISPICKVAL( cpm__Status__c , &apos;Verified&apos;)),
       NOT(ISPICKVAL( cpm__Status__c , &apos;Done&apos;)),
       NOT(ISPICKVAL( cpm__Status__c , &apos;Pending Verification&apos;)),
       cpm__Processing_Date__c &lt;= TODAY()), true, false )</errorConditionFormula>
        <errorDisplayField>cpm__Processing_Date__c</errorDisplayField>
        <errorMessage>Processing Date must be in the future</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Processing_Date_Required_For_BACS_Manual</fullName>
        <active>true</active>
        <errorConditionFormula>AND(cpm__Sub_Type__c = &apos;MANUAL&apos;, ISBLANK(cpm__Processing_Date__c) , CreatedDate &gt;=  DATETIMEVALUE(DATE(2021,7,20)) )</errorConditionFormula>
        <errorDisplayField>cpm__Processing_Date__c</errorDisplayField>
        <errorMessage>Processing Date is a required field for BACS Manual (FinDock as processor)</errorMessage>
    </validationRules>

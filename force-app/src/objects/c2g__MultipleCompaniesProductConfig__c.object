    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Stores product details related to the Multiple Companies Configuration.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__Company__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The Accounting company that relates to the multiple companies product config.</description>
        <label>Company</label>
        <referenceTo>c2g__codaCompany__c</referenceTo>
        <relationshipLabel>Multiple Companies Product Config</relationshipLabel>
        <relationshipName>MCPCompanies</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__InputVATCode__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The input VAT/GST tax code that relates to the multiple companies product config.</description>
        <label>Input VAT/GST Code</label>
        <referenceTo>c2g__codaTaxCode__c</referenceTo>
        <relationshipLabel>Multiple Companies Product Config</relationshipLabel>
        <relationshipName>MCPInputVATCodes</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__OutputVATCode__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The output VAT/GST tax code that relates to the multiple companies product config.</description>
        <label>Output VAT/GST Code</label>
        <referenceTo>c2g__codaTaxCode__c</referenceTo>
        <relationshipLabel>Multiple Companies Product Config</relationshipLabel>
        <relationshipName>MCPOutputVATCodes</relationshipName>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__PlaceOfSupply__c</fullName>
        <deprecated>false</deprecated>
        <description>The place of supply of the multiple companies product config.</description>
        <label>VAT/GST Place of Supply Rules</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>With Account</fullName>
                    <default>true</default>
                    <label>With Account</label>
                </value>
                <value>
                    <fullName>With Customer</fullName>
                    <default>false</default>
                    <label>With Customer</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>The product that relates to the multiple companies product config.</description>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Multiple Companies Product Config</relationshipLabel>
        <relationshipName>MCPProducts</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>c2g__ReverseCharge__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, the Output Tax Code and Output Tax Rate fields for each payable line item are automatically populated when you create the line items. To automatically populate the fields, you must also select the Enable Place of Supply Rules checkbox on the Accounting company that relates to payable document.</description>
        <label>VAT/GST Reverse Charge</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Multiple Companies Product Config</label>
    <nameField>
        <displayFormat>MCP-{0000}</displayFormat>
        <label>Multiple Companies Product Config Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Multiple Companies Product Configs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>FAM__AutoPostDepreciationJournals__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>This option only applies when generating depreciation journals for fixed assets with Accounting depreciation books. If selected, depreciation journals are posted automatically, with the status of Complete, and the corresponding transactions are created.</description>
        <inlineHelpText>This option only applies when generating depreciation journals for fixed assets with Accounting depreciation books. If selected, depreciation journals are posted automatically, with the status of Complete, and the corresponding transactions are created.</inlineHelpText>
        <label>Auto-Post Depreciation Journals</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>

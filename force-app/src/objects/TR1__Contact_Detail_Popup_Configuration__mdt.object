<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Setting controls Contact object layout displayed on Contact Detail PopUp based on User&apos;s profile and User&apos;s Brand. At least one field (Brand or Profile) should be populated.</description>
    <fields>
        <fullName>TR1__Brand__c</fullName>
        <deprecated>false</deprecated>
        <description>User&apos;s Brand</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Brand</label>
        <length>30</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__ExcludeAccountField__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Exclude Account Field</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__ExcludeNameField__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Exclude Name Field</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Layout_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>Object layout name with the following structure: &quot;Contact-&quot; + namespace prefix if needed + Layout name (ex. &apos;Contact-TR1__Contact Popup Layout&apos;)</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Layout Name</label>
        <length>50</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Profile_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>User&apos;s profile Id.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>This field helps identify which layout should be used in USAM contact detail popup if there is a mismatch in the profile name translation.</inlineHelpText>
        <label>Profile Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Profile_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>User&apos;s profile name</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Profile Name</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Contact Detail Popup Configuration</label>
    <pluralLabel>Contact Detail Popup Configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>List</customSettingsType>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>CTCM__AdditionalWhereclause__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Enter the additional WHERE clause you would like to assign to this filter. The where clause should be related to the transaction (c2g__codatransaction__c) object.
For example: &quot;c2g__Account__r.accountNumber != null&quot;</inlineHelpText>
        <label>Additional Where clause</label>
        <length>255</length>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTCM__Onlyinvoicesofaccountswithmandates__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Check this box to only show Invoices of which the related account has a Direct Debit mandate.</inlineHelpText>
        <label>Only invoices of accounts with mandates</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTCM__Onlyinvoiceswithmandates__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>Check this box to only show Invoices with a Direct Debit mandate.</inlineHelpText>
        <label>Only invoices with mandates</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Direct Debit Filters</label>
    <visibility>Public</visibility>
</CustomObject>

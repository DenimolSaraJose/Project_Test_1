    </fields>
    <fields>
        <fullName>c2g__Disabled__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When selected, indicates that values for this dimension are not in use. To assign to documents, mappings, or definitions, it must not be selected. Default is not selected.</description>
        <inlineHelpText>When selected, indicates that values for this dimension are not in use. To assign to documents, mappings, or definitions, it must not be selected.</inlineHelpText>
        <label>Disabled</label>
        <trackHistory>false</trackHistory>

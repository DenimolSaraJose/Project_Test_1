    <fields>
        <fullName>fferpcore__Eva_Filter__c</fullName>
        <deprecated>false</deprecated>
        <description>The historical data limit to apply to EvAs included in your app.</description>
        <inlineHelpText>Limiting your EvA data can improve the speed of your dataflow.
		If --None-- is selected, all historical and future EvAs are included in your app.
		If Include Previous Year is selected, all future EvAs, plus historical EvAs from the previous year are included in your app.
		If Include Previous Two Years is selected, all future EvAs, plus historical EvAs from the previous two years are included in your app.</inlineHelpText>
        <label>EvA Historical Data Limit</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Include Previous Year</fullName>
                    <default>false</default>
                    <label>Include Previous Year</label>
                </value>
                <value>
                    <fullName>Include Previous Two Years</fullName>
                    <default>false</default>
                    <label>Include Previous Two Years</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

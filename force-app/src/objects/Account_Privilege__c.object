    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>AccountPrivilegeCompactLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>AccountPrivilegeCompactLayout</fullName>
        <fields>Name</fields>
        <fields>ExternalName__c</fields>
        <fields>Start_Date__c</fields>
        <fields>PrivilegeAlignedWithMembershipStatus__c</fields>
        <fields>Active__c</fields>
        <label>Account Privilege Compact Layout</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Account Privileges</relationshipLabel>
        <relationshipName>Account_Privileges</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Active__c</fullName>
        <formula>AND(Start_Date__c &lt;= TODAY(), OR(ISBLANK(End_Date__c), End_Date__c &gt; TODAY()))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>start date must be equal or less than today and the end date is either blank or greater than today</inlineHelpText>
        <label>Active</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Distribution_Type__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Privilege__r.Distribution_Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Distribution Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>End_Date__c</fullName>
        <label>End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>ExternalName__c</fullName>
        <externalId>false</externalId>
        <formula>Privilege__r.ExternalName__c</formula>
        <inlineHelpText>External name of the master privilege record</inlineHelpText>
        <label>External Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsDefault__c</fullName>
        <description>A default privilege is assigned automatically and cannot be revoked.</description>
        <formula>Privilege__r.IsDefault__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>A default privilege is assigned automatically and cannot be revoked.</inlineHelpText>
        <label>Default</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PrivilegeAlignedWithMembershipStatus__c</fullName>
        <formula>Privilege__r.AlignedWithMembershipStatus__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Aligned With Membership</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PrivilegeType__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Privilege__r.Type__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The privilege type as registered on the master privilege

Internal = systems that are being used by internal employees
External = systems that are used my members</inlineHelpText>
        <label>Privilege Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Privilege__c</fullName>
        <label>Privilege</label>
        <referenceTo>Privilege__c</referenceTo>
        <relationshipLabel>Account Privileges</relationshipLabel>
        <relationshipName>Account_Privileges</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Start_Date__c</fullName>
        <label>Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>System__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT( Privilege__r.System__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>System</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Account Privilege</label>
    <nameField>
        <displayFormat>APRV-{00000}</displayFormat>
        <label>Account Privilege Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Account Privileges</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>Invalid_End_Date</fullName>
        <active>true</active>
        <description>Once an End Date has been set it can only be updated or cleared to a different date in the future. This way we prevent reactivating existing and inactive Account Privileges.</description>
        <errorConditionFormula>!ISBLANK(PRIORVALUE( End_Date__c )) 
&amp;&amp; PRIORVALUE( End_Date__c ) &lt;= TODAY()
&amp;&amp; ISCHANGED(End_Date__c)
&amp;&amp; (
      End_Date__c &lt;= TODAY()
      || ISBLANK(End_Date__c)
)</errorConditionFormula>
        <errorDisplayField>End_Date__c</errorDisplayField>
        <errorMessage>Once the End Date has been set it can only be updated or cleared to a different date in the future.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

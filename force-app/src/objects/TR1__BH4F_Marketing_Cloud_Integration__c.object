<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Settings that controls the logic of sending messages via Marketing Cloud.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Calendar_File_Expiration_Period__c</fullName>
        <defaultValue>2</defaultValue>
        <deprecated>false</deprecated>
        <description>Stores the amount of time (in days) an ICS file remains after the interview date/time has passed - if the timestamp has passed, the file will be automatically deleted (including all related Content Document child records like ContentDocumentLink, ContentDistribution, ConentVersion, etc).</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the amount of time (in days) an ICS file remains after the interview date/time has passed - if the timestamp has passed, the file will be automatically deleted (including all related Content Document child records like ContentDocumentLink, ContentDistribution, ConentVersion, etc).</inlineHelpText>
        <label>Calendar File Expiration Period</label>
        <precision>5</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Content_Distribution_Expiration_Period__c</fullName>
        <defaultValue>30</defaultValue>
        <deprecated>false</deprecated>
        <description>Shared links to the files attached from 2020 Email Editor will expire after the number of days specified in this field.</description>
        <externalId>false</externalId>
        <inlineHelpText>Content Distribution Expiration Period (in days)</inlineHelpText>
        <label>Content Distribution Expiration Period</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Create_Activities_for_Message_Channels__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, a Task record is created for each Additional Message Channel selected within the Email Editor (Note: this doesn&apos;t affect the creation of Activities for the existing built-in Email channel).</description>
        <inlineHelpText>If enabled, a Task record is created for each Additional Message Channel selected within the Email Editor (Note: this doesn&apos;t affect the creation of Activities for the existing built-in Email channel).</inlineHelpText>
        <label>Create Activities for Message Channels</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Data_Extension_Maximum_Field_Length__c</fullName>
        <defaultValue>4000</defaultValue>
        <deprecated>false</deprecated>
        <description>Specifies the maximum number of characters that can be stored in the data extension field on Marketing Cloud.</description>
        <externalId>false</externalId>
        <inlineHelpText>Specifies the maximum number of characters that can be stored in the data extension field on Marketing Cloud.</inlineHelpText>
        <label>Data Extension Maximum Field Length</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Default_Campaign_Id__c</fullName>
        <deprecated>false</deprecated>
        <description>When no template is selected within 2020 Email Editor this Campaign Id will be used as a default for further mapping with the Marketing Cloud email template.</description>
        <externalId>false</externalId>
        <inlineHelpText>When no template is selected within 2020 Email Editor this Campaign Id will be used as a default for further mapping with the Marketing Cloud email template.</inlineHelpText>
        <label>(deprecated) Default Campaign Id</label>
        <length>18</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Default_Campaign_Unique_Name__c</fullName>
        <deprecated>false</deprecated>
        <description>When no template is selected within 2020 Email Editor, this Campaign will be used as a default for further mapping with the Marketing Cloud email template</description>
        <externalId>false</externalId>
        <inlineHelpText>When no template is selected within 2020 Email Editor, this Campaign will be used as a default for further mapping with the Marketing Cloud email template</inlineHelpText>
        <label>Default Campaign Unique Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Enable_Preview_from_SFMC_Cloud_Page__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Flag controlling whether to enable SFMC message preview through a SFMC Cloud Page embedded into the BH4SF Email Editor as an iframe. Note: Enabling this also requires the use of SFMC Templates through Campaign Template Mapping, SF Templates are no longer used.</description>
        <inlineHelpText>Flag controlling whether to enable SFMC message preview through a SFMC Cloud Page embedded into the BH4SF Email Editor as an iframe. Note: Enabling this also requires the use of SFMC Templates through Campaign Template Mapping, SF Templates are no longer used.</inlineHelpText>
        <label>Enable Preview from SFMC Cloud Page</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Iframe_Base_Url__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the Marketing Cloud page URL responsible for generating and displaying email template preview that is embedded as an iframe in the BH4SF Email Editor.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the Marketing Cloud page URL responsible for generating and displaying email template preview that is embedded as an iframe in the BH4SF Email Editor.</inlineHelpText>
        <label>Iframe Base Url</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Internal_Interview_Cancel_Template__c</fullName>
        <deprecated>false</deprecated>
        <description>Used as a default email template for the Cancel Internal Interview notification for the SFMC email provider. If the External Id as Template Key is enabled, the value supports only External Id defined on Campaign Template Mapping. Otherwise, the Campaign Unique Name is supported. If the field is empty, a notification will not be triggered.</description>
        <externalId>false</externalId>
        <inlineHelpText>Used as a default email template for the Cancel Internal Interview notification for the SFMC email provider. If the External Id as Template Key is enabled, the value supports only External Id defined on Campaign Template Mapping. Otherwise, the Campaign Unique Name is supported. If the field is empty, a notification will not be triggered.</inlineHelpText>
        <label>Internal Interview Cancel Template</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Language_Selection_Required__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>When checked, the language dropdown on the BH4SF Email Editor will be required.</description>
        <inlineHelpText>When checked, the language dropdown on the BH4SF Email Editor will be required.</inlineHelpText>
        <label>Language Selection Required</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Sendout_Interview_Cancel_Template__c</fullName>
        <deprecated>false</deprecated>
        <description>Used as default email template for the Cancel SendOut Interview notification for the SFMC email provider. If the External Id as Template Key is enabled, the value supports only External Id defined on Campaign Template Mapping. Otherwise, the Campaign Unique Name is supported. If the field is empty, a notification will not be triggered.</description>
        <externalId>false</externalId>
        <inlineHelpText>Used as default email template for the Cancel SendOut Interview notification for the SFMC email provider. If the External Id as Template Key is enabled, the value supports only External Id defined on Campaign Template Mapping. Otherwise, the Campaign Unique Name is supported. If the field is empty, a notification will not be triggered.</inlineHelpText>
        <label>Sendout Interview Cancel Template</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Subject_Maximum_Field_Length__c</fullName>
        <defaultValue>150</defaultValue>
        <deprecated>false</deprecated>
        <description>Specifies the maximum number of characters that can be populated as subject for fully-editable email templates.</description>
        <externalId>false</externalId>
        <inlineHelpText>Specifies the maximum number of characters that can be populated as subject for fully-editable email templates.</inlineHelpText>
        <label>Subject Maximum Field Length</label>
        <precision>10</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Support_Additional_Message_Channels__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enables the creation of campaign members with messages triggered from the 2020 Email Editor. This allows you to send messages through additional media, e.g. WhatsApp or text messages.</description>
        <inlineHelpText>Enables the creation of campaign members with messages triggered from the 2020 Email Editor. This allows you to send messages through additional media, e.g. WhatsApp or text messages.</inlineHelpText>
        <label>Support Additional Message Channels</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Use_External_Id_as_Template_Key__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If enabled, the value of the &apos;External Id&apos; field on a Campaign Template Mapping record is used as a Template Key instead of the &apos;Campaign Unique Name&apos; field within the BH4SF Email Editor when the &apos;Enable Preview from SFMC Cloud Page&apos; is enabled.</description>
        <inlineHelpText>If enabled, the value of the &apos;External Id&apos; field on a Campaign Template Mapping record is used as a Template Key instead of the &apos;Campaign Unique Name&apos; field within the BH4SF Email Editor when the &apos;Enable Preview from SFMC Cloud Page&apos; is enabled.</inlineHelpText>
        <label>Use External Id as Template Key</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Use_Language_Picklist_Default_Value__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Controls how the default value of the language dropdown is determined. If checked, the default value will be the default value from the ‘Available Languages’ global value set. If not checked, the default value will be the user’s language (if the user’s language isn’t in the available values, there will be no default value).</description>
        <inlineHelpText>Controls how the default value of the language dropdown is determined. If checked, the default value will be the default value from the ‘Available Languages’ global value set. If not checked, the default value will be the user’s language (if the user’s language isn’t in the available values, there will be no default value).</inlineHelpText>
        <label>Use Language Picklist Default Value</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Marketing Cloud Integration</label>
    <visibility>Public</visibility>
</CustomObject>

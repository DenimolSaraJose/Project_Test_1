        <fullName>Check_For_Valid_Email</fullName>
        <active>true</active>
        <description>Check work email, unfortunately so called &apos;plus addressing&apos; is not allowed...</description>
        <errorConditionFormula>!ISBLANK(Email) &amp;&amp; NOT(REGEX(Email, &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_For_Valid_Personal_Email</fullName>
        <active>true</active>
        <description>Checks the personal email, unfortunately so called &apos;plus addressing&apos; is not allowed</description>
        <errorConditionFormula>!ISBLANK(Personal_Email__c) &amp;&amp; NOT(REGEX(Personal_Email__c , &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>Personal_Email__c</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Check_For_Valid_Work_Email</fullName>
        <active>true</active>
        <description>Checks the work email, unfortunately so called &apos;plus addressing&apos; is not allowed</description>
        <errorConditionFormula>!ISBLANK(Work_Email__c) &amp;&amp; NOT(REGEX(Work_Email__c, &quot;^(([^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+(\\.[^&lt;&gt;()\\[\\]\\\\.,;:%#~`=?&amp;/$^*!+\\s@\&quot;]+)*)|(\&quot;.+\&quot;))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$&quot;))</errorConditionFormula>
        <errorDisplayField>Work_Email__c</errorDisplayField>
        <errorMessage>Invalid Email</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
AND($Profile.Name &lt;&gt; &quot;System Administrator&quot;,$Profile.Name &lt;&gt;&quot;Super User Profile&quot;),
ISCHANGED( Email)
)</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Error, change your email address under My Profile</errorMessage>
    </validationRules>

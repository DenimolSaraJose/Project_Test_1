    <fields>
        <fullName>cpm__Processing_Date_Conflict_Strategy__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Strategy used to determine what action to take if the calculated Processing Date is not a working day based on the selected business hours. This only applies to Auto Create records.</inlineHelpText>
        <label>Processing Date Conflict Strategy</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Previous working day</fullName>
                    <default>false</default>
                    <label>Previous working day</label>
                </value>
                <value>
                    <fullName>Next working day</fullName>
                    <default>true</default>
                    <label>Next working day</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Repeat_Frequency__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Best explained with an example. If value is 3:
- Weekly: Mandate schedule records will be generated once every 3 weeks. 
- Monthly: Mandate schedule records will be generated every quarter. 
Typical value: 1, so once every week or month.</inlineHelpText>
        <label>Repeat Frequency</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Run_Date_Conflict_Strategy__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Strategy used to determine what action to take if the calculated Run Date is not a working day based on the selected business hours. This only applies to Auto Create records.</inlineHelpText>
        <label>Run Date Conflict Strategy</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Previous working day</fullName>
                    <default>true</default>
                    <label>Previous working day</label>
                </value>
                <value>
                    <fullName>Next working day</fullName>
                    <default>false</default>
                    <label>Next working day</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Run_of_Days_before_Processing_date__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <inlineHelpText>Used to calculate the run date. Processing date is calculated first and then this field is used to determine the run date. If a Business Hours record is attached, business days will be subtracted. If not, days, including weekends, are subtracted.</inlineHelpText>
        <label>Run # of Business Days before Proc. Date</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Start_Date__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Start date of the period that mandate schedule records will be generated for. Mandate schedule records will be generated with a processing date as of the start date, but not before the start date.</inlineHelpText>
        <label>Start Date</label>
        <required>true</required>
        <trackTrending>false</trackTrending>

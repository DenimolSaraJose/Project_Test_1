    <fields>
        <fullName>cpm__Monthly_Day_Strategy__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>Strategy used to calculate the Processing / Run day. Available strategies: 
- Day of Month: Day of month specified in field Targeted Day of Month will be used. 
- First Monday: First Monday of this month
- Last Friday: Last Friday of this month</inlineHelpText>
        <label>Monthly Day Strategy</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Day of Month</fullName>
                    <default>false</default>
                    <label>Day of Month</label>
                </value>
                <value>
                    <fullName>First Monday</fullName>
                    <default>false</default>
                    <label>First Monday</label>
                </value>
                <value>
                    <fullName>Last Friday</fullName>
                    <default>false</default>
                    <label>Last Friday</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

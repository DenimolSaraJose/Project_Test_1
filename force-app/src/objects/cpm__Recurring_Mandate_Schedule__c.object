    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>cpm__Day_of_month_validation</fullName>
        <active>true</active>
        <errorConditionFormula>if (AND (RecordType.DeveloperName == &apos;Monthly&apos;,
ISPICKVAL( cpm__Monthly_Day_Strategy__c , &apos;Day of Month&apos;),
ISBLANK(TEXT( cpm__Targeted_Day_of_Month__c ))
),true,false)</errorConditionFormula>
        <errorDisplayField>cpm__Targeted_Day_of_Month__c</errorDisplayField>
        <errorMessage>Targeted Day of Month is required for &apos;Day of Month&apos; strategy</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__End_Date_required_for_non_auto_create</fullName>
        <active>true</active>
        <description>End date is a required field if the record is a non auto create record</description>
        <errorConditionFormula>IF ( AND (!cpm__Auto_Create__c, ISBLANK( cpm__End_Date__c )), true, false)</errorConditionFormula>
        <errorDisplayField>cpm__End_Date__c</errorDisplayField>
        <errorMessage>End Date is a required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Monthly_Strategy_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>if (AND (RecordType.DeveloperName == &apos;Monthly&apos;,ISBLANK(TEXT( cpm__Monthly_Day_Strategy__c ))),true,false)</errorConditionFormula>
        <errorDisplayField>cpm__Monthly_Day_Strategy__c</errorDisplayField>
        <errorMessage>Monthly Day Strategy is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Process_Day_required_for_Weekly</fullName>
        <active>true</active>
        <errorConditionFormula>if (AND (RecordType.DeveloperName == &apos;Weekly&apos;,
cpm__Process_on_Monday__c = false,
cpm__Process_on_Tuesday__c = false,
cpm__Process_on_Wednesday__c = false,
cpm__Process_on_Thursday__c = false,
cpm__Process_on_Friday__c = false,
cpm__Process_on_Saturday__c = false,
cpm__Process_on_Sunday__c = false
),true,false)</errorConditionFormula>
        <errorMessage>Please select one or more days to process on</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Processing_Date_Conflict_Required</fullName>
        <active>true</active>
        <description>Processing date conflict strategy is required when it is an Auto Create Record</description>
        <errorConditionFormula>AND (cpm__Auto_Create__c, cpm__Sub_Type__c == &apos;MANUAL&apos;, ISBLANK(TEXT(cpm__Processing_Date_Conflict_Strategy__c)))</errorConditionFormula>
        <errorDisplayField>cpm__Processing_Date_Conflict_Strategy__c</errorDisplayField>
        <errorMessage>Processing Date Conflict Strategy is required</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Repeat_Frequency_ge_1</fullName>
        <active>true</active>
        <errorConditionFormula>cpm__Repeat_Frequency__c &lt; 1</errorConditionFormula>
        <errorMessage>Repeat Frequency must be 1 or higher</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>cpm__Run_Date_Conflict_Required</fullName>
        <active>true</active>
        <description>Run date conflict strategy is required when it is an Auto Create Record</description>
        <errorConditionFormula>if (AND (cpm__Auto_Create__c, cpm__Sub_Type__c != &apos;MANUAL&apos;, ISBLANK(TEXT(  cpm__Run_Date_Conflict_Strategy__c  ))),true,false)</errorConditionFormula>
        <errorDisplayField>cpm__Run_Date_Conflict_Strategy__c</errorDisplayField>
        <errorMessage>Run Date Conflict Strategy is required</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

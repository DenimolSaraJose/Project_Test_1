    <fields>
        <fullName>cpm__Business_Hours__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <deprecated>false</deprecated>
        <description>For all previewed mandate schedule records it will be checked if the calculated run and processing dates are on a working day. If not, it will be clearly indicated to the user in the Generated Mandate Scheduled Preview section. The related Business Hours record defined by this field is used to determine whether a specific date is a valid working day. Note that 13:00 / 1pm is used to check if a specific date is a valid working day.</description>
        <inlineHelpText>Business Hours record that is used for checking if calculated run and processing dates are on a working day.</inlineHelpText>
        <label>Business Hours</label>
        <referenceTo>BusinessHours</referenceTo>
        <relationshipLabel>Recurring Mandate Schedules</relationshipLabel>
        <relationshipName>Recurring_Mandate_Schedules</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>cpm__End_Date__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>End date of the period that mandate schedule records will be generated for. Mandate schedule records will be generated with a processing date until the end date, but not after the end date.</inlineHelpText>
        <label>End Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>cpm__Exclude_from_Auto_Run__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <inlineHelpText>If you are creating a schedule that you want to run manually by changing the schedule status, please select this option. If Auto Run is enabled in the FinDock Setup, this schedule will otherwise be run automatically.</inlineHelpText>
        <label>Exclude from Auto-Run</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

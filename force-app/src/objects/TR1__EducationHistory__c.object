    <fields>
        <fullName>TR1__Start_date__c</fullName>
        <deprecated>false</deprecated>
        <description>Convert the Start Date from text to proper type as required by Textkernel Integration</description>
        <formula>DATE(VALUE(LEFT(TR1__StartDate__c, 4)), VALUE(MID(TR1__StartDate__c, 6, 2)), VALUE(RIGHT(TR1__StartDate__c, 2)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Start date</label>
        <required>false</required>

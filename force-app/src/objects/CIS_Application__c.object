        <columns>Application_status__c</columns>
        <columns>Applied_on__c</columns>
        <columns>Start_Date__c</columns>
        <columns>End_Date__c</columns>
        <columns>Applicant__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>My_Applications__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>My Expressions of Interest</label>
    </listViews>
    <nameField>
        <displayFormat>APP-{00000000}-{00000}</displayFormat>
        <label>CIS Application Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>CIS Applications</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Job__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Applicant__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Job_Contact__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>School__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>I_agree_Evaluator_Code_of_Conduct</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
NOT(ISBLANK($User.ContactId)),
 I_agree_to_CIS_Professional_Expectations__c  = FALSE )</errorConditionFormula>
        <errorDisplayField>I_agree_to_CIS_Professional_Expectations__c</errorDisplayField>
        <errorMessage>This is a required field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Permission_Secured</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
On_Behalf_Of__c &lt;&gt; TRUE,
Permission_Secured__c  = FALSE, NOT( $Profile.Name = &apos;System Administrator&apos;) )</errorConditionFormula>
        <errorDisplayField>Permission_Secured__c</errorDisplayField>
        <errorMessage>This is a required field.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

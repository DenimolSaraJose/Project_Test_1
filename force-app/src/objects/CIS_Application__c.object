    <fields>
        <fullName>Available_for_Multiple_Visits__c</fullName>
        <inlineHelpText>CIS works in two semsters: Semester 1 refers to visits taking place between 1 January to 30 June.
Semester 2 refers to visits taking place between 1 July to 31 December.</inlineHelpText>
        <label>Available for Multiple Visits</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Multiple this semester</fullName>
                    <default>false</default>
                    <label>Multiple this semester</label>
                </value>
                <value>
                    <fullName>Only one this semester</fullName>
                    <default>false</default>
                    <label>Only one this semester</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

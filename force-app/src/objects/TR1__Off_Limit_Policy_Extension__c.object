    <fields>
        <fullName>TR1__ATS_Stage__c</fullName>
        <deprecated>false</deprecated>
        <description>The ATS Stage value that can determine a change to the Off Limits Duration when certain criteria are met</description>
        <inlineHelpText>The ATS Stage value that can determine a change to the Off Limits Duration when certain criteria are met</inlineHelpText>
        <label>ATS Stage</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>

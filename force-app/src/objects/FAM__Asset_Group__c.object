    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ReadWrite</externalSharingModel>
    <fields>
        <fullName>Accumulated_Depreciation_GL_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Lookup to the account to use to reduce the value of the asset on the balance sheet. This field works the same way as the corresponding field on the asset and is used when the field in the sub group or asset is empty.</description>
        <inlineHelpText>Lookup to the account to use to reduce the value of the asset on the balance sheet. This field works the same way as the corresponding field on the asset and is used when the field in the sub group or asset is empty.</inlineHelpText>
        <label>Accumulated Depreciation GL Account</label>
        <referenceTo>c2g__codaGeneralLedgerAccount__c</referenceTo>
        <relationshipLabel>Asset Groups (Accumulated Depreciation GL Account)</relationshipLabel>
        <relationshipName>Asset_Groups1</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>

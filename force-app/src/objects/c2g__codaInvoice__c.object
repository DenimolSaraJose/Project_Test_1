    <webLinks>
        <fullName>Email_PDF_SDocs</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Email PDF SDocs</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&apos;/soap/ajax/35.0/connection.js&apos;)}
{!REQUIRESCRIPT(&apos;/soap/ajax/35.0/apex.js&apos;)}

var records ={!GETRECORDIDS($ObjectType.c2g__codaInvoice__c)};

if (records[0] == null) { alert(&quot;Please select at least one row&quot;) } 
else 
{
    var r = confirm(&quot;Are you sure you want to send emails?&quot;);
    if(r == true)
    {
       sforce.apex.execute(&quot;SalesInvoiceSendEmailWebservice&quot;,&quot;sendEmails&quot;,{invoiceIdList: records});
       location.reload(true);
    }
}</url>
    </webLinks>

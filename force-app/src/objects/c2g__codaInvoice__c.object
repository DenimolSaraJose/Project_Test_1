        <fullName>Conga_Batch_Email_Sales_Invoice_Fonteva__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;&amp;Id=&quot; + Id +
&quot;&amp;queryid=[SIPT1]aDq1n000000XasV,[SIIG]aDq1n000000XasW,[SILIG]aDq1n000000XasX,[SID]aDq1n000000XasY,[SIVTC]aDq1n000000XasZ,[SIDST]aDq1n000000Xasa,[SIPT4]aDq1n000000Xasb,[SIILI]aDq1n000000Xasc,[SIDST3]aDq1n000000Xasd,[SICF]aDq1n000000Xase,[SIPT5]aDq1n000000Xasf,[SIPT3]aDq1n000000Xasg,[SIA]aDq1n000000Xash, [SIDST4]aDq1n000000Xasi,[SILI]aDq1n000000Xasj,[SIPT2]aDq1n000000Xask,[SIDST2]aDq1n000000Xasl,[SIDSV]aDq1n000000Xasm,[SIDTL]aDq1n000000Xasn,[SILIC]aDq1n000000Xaso,[SICTC1]aDq1n000000Xasp,[SICTC2]aDq1n000000Xasq&quot; +
&quot;&amp;EmailFromID=0D21n000000L2wC&quot;+
&quot;&amp;EmailAdditionalTo=&quot; + CTC_Event_Attendee_Email__c + &quot;,&quot; + Finance_Contact_Email__c +
&quot;&amp;EmailCC=&quot; + c2g__Account__r.Invoice_Email_cc__c +
&quot;&amp;EmailSubject=&quot;+&quot;Invoice for CIS Services:&quot; + &quot;+&quot; + c2g__InvoiceDescription__c +
&quot;&amp;OFN=&quot; + Name +
&quot;&amp;DefaultPDF=1&quot; +
&quot;&amp;TemplateID=aDy1n00000005nKCAQ&quot; +
&quot;&amp;CETID=aDp7Q000000x4XNSAY&quot; +
&quot;&amp;UF0=1&quot; +
&quot;&amp;MFTS0=Sales_Invoice_Sent__c&quot; +
&quot;&amp;MFTSValue0=TRUE&quot; +
&quot;&amp;SC0=1&quot; +
&quot;&amp;SC1=Attachments&quot; +
&quot;&amp;CurrencyCulture=en-GB&quot; +
&quot;&amp;QMode=SendEmail&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Conga Batch Email Sales Invoice Fonteva</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Conga_Batch_Email_Sales_Invoice__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;&amp;Id=&quot; + Id +
&quot;&amp;queryid=[SIPT1]aDq1n000000XasV,[SIIG]aDq1n000000XasW,[SILIG]aDq1n000000XasX,[SID]aDq1n000000XasY,[SIVTC]aDq1n000000XasZ,[SIDST]aDq1n000000Xasa,[SIPT4]aDq1n000000Xasb,[SIILI]aDq1n000000Xasc,[SIDST3]aDq1n000000Xasd,[SICF]aDq1n000000Xase,[SIPT5]aDq1n000000Xasf,[SIPT3]aDq1n000000Xasg,[SIA]aDq1n000000Xash, [SIDST4]aDq1n000000Xasi,[SILI]aDq1n000000Xasj,[SIPT2]aDq1n000000Xask,[SIDST2]aDq1n000000Xasl,[SIDSV]aDq1n000000Xasm,[SIDTL]aDq1n000000Xasn,[SILIC]aDq1n000000Xaso,[SICTC1]aDq1n000000Xasp,[SICTC2]aDq1n000000Xasq&quot; +
&quot;&amp;EmailFromID=0D21n000000L2wC&quot;+
&quot;&amp;EmailToId=&quot; + Finance_Contact_Email__c +
&quot;&amp;EmailCC=&quot; + c2g__Account__r.Invoice_Email_cc__c +
&quot;&amp;EmailSubject=&quot;+&quot;Invoice for CIS Services:&quot; + &quot;+&quot; + c2g__InvoiceDescription__c +
&quot;&amp;OFN=&quot; + Name +
&quot;&amp;DefaultPDF=1&quot; +
&quot;&amp;TemplateID=&quot; + IF (c2g__InvoiceCurrency__r.Name=&apos;EUR&apos;,&apos;aDy1n00000005nKCAQ&apos;,&apos;aDy1n00000005pMCAQ&apos;) +
/* &quot;&amp;CongaEmailTemplate=&quot; + IF (c2g__InvoiceCurrency__r.Name=&apos;EUR&apos;,&apos;aDp7Q000000gICMSA2&apos;,&apos;aDp7Q000000gICRSA2&apos;) + */ 
&quot;&amp;CETID=&quot;+IF(c2g__InvoiceCurrency__r.Name=&apos;EUR&apos;,&apos;aDp7Q000000gICMSA2&apos;,&apos;aDp7Q000000gICRSA2&apos;)+
&quot;&amp;UF0=1&quot; +
&quot;&amp;MFTS0=Sales_Invoice_Sent__c&quot; +
&quot;&amp;MFTSValue0=TRUE&quot; +
&quot;&amp;SC0=1&quot; +
&quot;&amp;SC1=Attachments&quot; +
&quot;&amp;CurrencyCulture=en-GB&quot; +
&quot;&amp;QMode=SendEmail&quot;</formula>

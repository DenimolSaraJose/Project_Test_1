    <fields>
        <fullName>c2g__WithholdingTotal__c</fullName>
        <deprecated>false</deprecated>
        <description>Total gross value of product lines on the sales invoice, used to withhold tax.</description>
        <externalId>false</externalId>
        <formula>ROUND(((c2g__WithholdingNetTotal__c * BLANKVALUE(c2g__WithholdingRate__c, 0)) / 100) * -1, BLANKVALUE(c2g__InvoiceCurrencyDecimalPlaces__c, 2))</formula>
        <label>Withholding Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>

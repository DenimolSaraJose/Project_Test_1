        <fullName>attachSalesInvoicePdf__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;&amp;solmgr=1&quot; + &quot;&amp;id=&quot; + Id + &quot;&amp;QueryId=[SIPT1]aDq1n000000XasV,[SIIG]aDq1n000000XasW,[SILIG]aDq1n000000XasX,[SID]aDq1n000000XasY,[SIVTC]aDq1n000000XasZ,[SIDST]aDq1n000000Xasa,[SIPT4]aDq1n000000Xasb,[SIILI]aDq1n000000Xasc,[SIDST3]aDq1n000000Xasd,[SICF]aDq1n000000Xase,[SIPT5]aDq1n000000Xasf,[SIPT3]aDq1n000000Xasg,[SIA]aDq1n000000Xash,[SIDST4]aDq1n000000Xasi,[SILI]aDq1n000000Xasj,[SIPT2]aDq1n000000Xask,[SIDST2]aDq1n000000Xasl,[SIDSV]aDq1n000000Xasm,[SIDTL]aDq1n000000Xasn,[SILIC]aDq1n000000Xaso,[SICTC1]aDq1n000000Xasp,[SICTC2]aDq1n000000Xasq&quot; + &quot;&amp;DefaultPDF=1&quot; + &quot;&amp;DS7=1&quot; + &quot;&amp;TemplateId=&quot; + ffaci__CongaTemplate__c + &quot;&amp;DV0=&quot; + IF ( ISPICKVAL(c2g__InvoiceStatus__c, &quot;Complete&quot;), &quot;&quot;, &quot;Draft&quot;) + &quot;&amp;CurrencyCulture=&quot; + ffaci__CurrencyCulture__c + &quot;&amp;DV1=&quot; + ffaci__CurrencyCulture__c + &quot;&amp;qmode=Attachments&quot; + &quot;&amp;OFN=CSR_&quot; + Name</formula>
        <label>Attach Sales Invoice PDF</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

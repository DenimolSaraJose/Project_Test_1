    <fields>
        <fullName>c2g__RoundedInvoiceTotal__c</fullName>
        <deprecated>false</deprecated>
        <description>If invoice currency is CHF, displays the invoice total rounded to 0.05.</description>
        <externalId>false</externalId>
        <formula>IF ( c2g__InvoiceCurrency__r.Name = &apos;CHF&apos;, ( ROUND(c2g__InvoiceTotal__c * 20,0) )/20, c2g__InvoiceTotal__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rounded Invoice Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>

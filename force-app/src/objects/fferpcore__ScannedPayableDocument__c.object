    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>fferpcore__DisableEditWhenStatusCompleteOrDiscarded</fullName>
        <active>true</active>
        <description>Message when the record cannot be edited as the status is complete or discarded.</description>
        <errorConditionFormula>OR(
        ISPICKVAL(PRIORVALUE(fferpcore__Status__c), &apos;Complete&apos;),
        ISPICKVAL(PRIORVALUE(fferpcore__Status__c), &apos;Discarded&apos;)
        )</errorConditionFormula>
        <errorMessage>The record could not be edited because the status is set to complete or discarded.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>

    <fields>
        <fullName>Accreditation_Partner_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(AND(ISNULL(Start_Date__c), ISNULL(End_Date__c)),AND(Start_Date__c &lt;= TODAY(), ISNULL(End_Date__c)),AND(Start_Date__c &lt;= TODAY(), End_Date__c &gt;= TODAY())), &quot;Current&quot;,IF(AND(Start_Date__c &lt; TODAY(), End_Date__c &lt; TODAY()),&quot;Previous&quot;,&quot;Future&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Accreditation Partner Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Accreditation__c</fullName>
        <label>Accreditation</label>

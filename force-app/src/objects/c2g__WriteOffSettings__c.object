<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the behavior of the AR Write-Off.</description>
    <enableEnhancedLookup>false</enableEnhancedLookup>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__RunParallel__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that the process runs using parallel processing.</description>
        <inlineHelpText>Indicates that the process runs using parallel processing.</inlineHelpText>
        <label>Run Parallel</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ScopeSize__c</fullName>
        <defaultValue>20</defaultValue>
        <deprecated>false</deprecated>
        <description>Scope size for the Write-Off Process.</description>
        <externalId>false</externalId>
        <inlineHelpText>Scope size for the Write-Off Process.</inlineHelpText>
        <label>Scope Size</label>
        <precision>4</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__UseDetailedMonitoring__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Indicates that detailed monitoring is to be used for the process.</description>
        <inlineHelpText>Indicates that detailed monitoring is to be used for the process.</inlineHelpText>
        <label>Use Detailed Monitoring</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__WriteOffReasonCode__c</fullName>
        <deprecated>false</deprecated>
        <description>Field for entering the Write-Off reasons, separated by a semicolon. The values available to enter will be shown as a picklist on the Journal Details screen, of the Write-Off process.</description>
        <inlineHelpText>Reasons for processing Write-Offs. These values are available for the Accounts Receivable Write-Off process. Separate values with a semicolon ( ; ).</inlineHelpText>
        <label>Write-Off Reason Code</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <label>Write-Off Settings</label>
    <visibility>Public</visibility>
</CustomObject>

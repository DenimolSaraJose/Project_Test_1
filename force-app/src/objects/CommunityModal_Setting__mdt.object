<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>ContactFieldAPINames__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Contact Field API Names</label>
        <length>32768</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>MaximumInquiryAttempts__c</fullName>
        <defaultValue>3</defaultValue>
        <description>Maximum number of inquiries for a specific field</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Maximum Inquiry Attempts</label>
        <precision>3</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ModalContentType__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Modal content type</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Broadcast</fullName>
                    <default>false</default>
                    <label>Broadcast</label>
                </value>
                <value>
                    <fullName>Inquiry</fullName>
                    <default>false</default>
                    <label>Inquiry</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ShowCloseButton__c</fullName>
        <defaultValue>false</defaultValue>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Show close-button</label>
        <type>Checkbox</type>
    </fields>
    <label>CommunityModal Setting</label>
    <listViews>
        <fullName>All</fullName>
        <columns>MasterLabel</columns>
        <columns>DeveloperName</columns>
        <columns>ModalContentType__c</columns>
        <columns>ShowCloseButton__c</columns>
        <columns>IsActive__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <language>en_US</language>
    </listViews>
    <pluralLabel>CommunityModal Settings</pluralLabel>
    <validationRules>
        <fullName>Maximum_Inquiry_Attempts_is_required</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(ModalContentType__c, &quot;Inquiry&quot;) &amp;&amp; (ISBLANK(MaximumInquiryAttempts__c) || MaximumInquiryAttempts__c = 0)</errorConditionFormula>
        <errorMessage>The maximum inquiry attempts is required!</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

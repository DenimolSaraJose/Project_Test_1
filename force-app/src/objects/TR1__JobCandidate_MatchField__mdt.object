    <fields>
        <fullName>TR1__Scale__c</fullName>
        <deprecated>false</deprecated>
        <description>This setting allows to set up the importance of each of the Job Candidate Match Fields used in the Match Query.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Define the Importance of each Job to ‘Candidate Match’ fields in the Match Query by selecting from the picklist values. If value is not specified, Job Candidate Match Fields will have their default value.</inlineHelpText>
        <label>Scale</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>REQUIRED</fullName>
                    <default>false</default>
                    <label>REQUIRED</label>
                </value>
                <value>
                    <fullName>STRONGLY_FAVORED</fullName>
                    <default>false</default>
                    <label>STRONGLY_FAVORED</label>
                </value>
                <value>
                    <fullName>FAVORED</fullName>
                    <default>false</default>
                    <label>FAVORED</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Job Candidate Match Field</label>
    <pluralLabel>Job Candidate Match Fields</pluralLabel>
    <visibility>Public</visibility>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>TR1__Field_Type__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Type of the field on the Salesforce side by which the search and ranking is performed. Only the specified types are supported</inlineHelpText>
        <label>SF Field Type</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>DOUBLE</fullName>
                    <default>false</default>
                    <label>CURRENCY / DOUBLE / PERCENT</label>
                </value>
                <value>
                    <fullName>DATETIME</fullName>
                    <default>false</default>
                    <label>DATE / DATETIME</label>
                </value>
                <value>
                    <fullName>MULTIPICKLIST</fullName>
                    <default>false</default>
                    <label>MULTIPICKLIST</label>
                </value>
                <value>
                    <fullName>STRING</fullName>
                    <default>true</default>
                    <label>STRING / PICKLIST</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__SF_Field_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>API name of the field on the Salesforce side by which the search and ranking is performed</inlineHelpText>
        <label>SF Field Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Search_Match_UI_Configuration__c</fullName>
        <deprecated>false</deprecated>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Search Match UI Configuration object from which the MCMB settings will be inherited</inlineHelpText>
        <label>Search &amp; Match UI Configuration</label>
        <referenceTo>TR1__Search_And_Match_UI_Configuration__mdt</referenceTo>
        <relationshipLabel>Search Weight Configurations</relationshipLabel>
        <relationshipName>Search_Weight_Configurations</relationshipName>
        <required>true</required>
        <type>MetadataRelationship</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Serching_Value__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The value by which the search and ranking will be performed. Metadata supports processing values for fields of the multiselect type. To do this, enter the necessary values separated by the character &apos;;&apos; without spaces</inlineHelpText>
        <label>Searching Value</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__TK_Field_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The name of the field on the TK side by which the search and ranking is performed</inlineHelpText>
        <label>TK Field Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Weight__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>The weight of the value by which the search is performed. Search results that match values with a higher weight will be displayed higher in the list than the rest of the results</inlineHelpText>
        <label>Weight</label>
        <precision>2</precision>
        <required>true</required>
        <scale>1</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Search Weight Configuration</label>
    <pluralLabel>Search Weight Configurations</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

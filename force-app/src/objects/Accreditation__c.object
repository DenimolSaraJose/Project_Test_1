    <fields>
        <fullName>RegistrationDueDateOverride__c</fullName>
        <description>THIS FIELD IS NOT USED YET
https://dev.azure.com/COIS-ORG/IT%20Service%20Requests/_workitems/edit/131</description>
        <inlineHelpText>The calculated Registration Due Date can be overriden by setting a date in this field.</inlineHelpText>
        <label>Registration Due Date Override</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>RegistrationDueDate__c</fullName>
        <formula>BLANKVALUE(RegistrationDueDateOverride__c, ADDMONTHS(OriginatingMembership__r.Status_to_Active__c, 24))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>By when a school is required to register.</inlineHelpText>
        <label>Registration Due Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>

    <fields>
        <fullName>CurrentCycleStageLink__c</fullName>
        <description>Current Cycle Stage name, presented as clickable link</description>
        <externalId>false</externalId>
        <formula>IF((ISBLANK(CurrentCycleStage__c) || !ISPICKVAL($User.UserType, &apos;Standard&apos;)), &apos;N/A&apos;, HYPERLINK(
  &quot;/&quot; &amp;  CurrentCycleStage__c, 
   CurrentCycleStage__r.StageName__c,
  &quot;_self&quot;
))</formula>
        <label>Current Cycle Stage Link</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>

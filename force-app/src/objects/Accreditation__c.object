    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Prevent_Override_Registration_Due_Date</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(RegistrationDueDateOverride__c) &amp;&amp;
!ISNULL(RegistrationDueDateOverride__c) &amp;&amp;
!$Permission.Override_Registration_Due_Date</errorConditionFormula>
        <errorMessage>You are not allowed to override the Registration Due Date...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Revert_Status_Prospect</fullName>
        <active>true</active>
        <errorConditionFormula>ISNEW() &amp;&amp;
ISCHANGED(Status__c) &amp;&amp;
ISPICKVAL(Status__c, &apos;Prospect&apos;) &amp;&amp;
!$Permission.Revert_Accreditation_Status</errorConditionFormula>
        <errorDisplayField>Account__c</errorDisplayField>
        <errorMessage>You cannot revert the status to &apos;Prospect&apos;...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Update_Account</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(Account__c)</errorConditionFormula>
        <errorMessage>You are not allowed to update the Account...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Update_Accreditation_Name</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(Name) &amp;&amp;
!IsVRBypassed__c</errorConditionFormula>
        <errorMessage>You are not allowed to update the Accreditation name...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Update_Status</fullName>
        <active>true</active>
        <description>Custom permission &apos;Update Accreditation Status&apos; or &apos;Update Accreditation Status To Closed&apos; must be assigned (for closing an Accreditation record).</description>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(Status__c) &amp;&amp;
!$Permission.Update_Accreditation_Status &amp;&amp;
!IsVRBypassed__c &amp;&amp;
(ISPICKVAL(Status__c, &apos;Closed&apos;) &amp;&amp; !$Permission.Update_Accreditation_Status_To_Closed)</errorConditionFormula>
        <errorMessage>You are not allowed to update the Accreditation status...</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Update_Status_From_Closed</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED( Status__c ) &amp;&amp;
ISPICKVAL( PRIORVALUE( Status__c ), &apos;Closed&apos; )</errorConditionFormula>
        <errorMessage>You cannot update the Accreditation status once it is closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Update_Status_To_Withdrawn</fullName>
        <active>true</active>
        <errorConditionFormula>!ISNEW() &amp;&amp;
ISCHANGED(Status__c) &amp;&amp;
(ISPICKVAL(Status__c, &apos;Withdrawn by CIS&apos;) || ISPICKVAL(Status__c, &apos;Withdrawn by Member&apos;)) &amp;&amp;
!$Permission.Update_Accreditation_Status_To_Withdrawn</errorConditionFormula>
        <errorMessage>You are not allowed to update the Accreditation status to withdrawn...</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>

        <externalId>false</externalId>
        <formula>Account__r.ReportManager__r.FirstName + &apos; &apos; +
IF(!ISBLANK(Account__r.ReportManager__r.MiddleName), Account__r.ReportManager__r.MiddleName + &apos; &apos;, &apos;&apos;) +

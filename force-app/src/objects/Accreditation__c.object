    <fields>
        <fullName>Framework__c</fullName>
        <label>OBSOLETE Framework</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>8th Edition</fullName>
                    <default>false</default>
                    <label>8th Edition</label>
                </value>
                <value>
                    <fullName>CIS International Accreditation 2016</fullName>
                    <default>false</default>
                    <label>CIS International Accreditation 2016</label>
                </value>
                <value>
                    <fullName>CIS International Accreditation 2019</fullName>
                    <default>false</default>
                    <label>CIS International Accreditation 2019</label>
                </value>
                <value>
                    <fullName>New Framework</fullName>
                    <default>true</default>
                    <label>New Framework</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>IAA__c</fullName>
        <externalId>false</externalId>
        <formula>Account__r.IAA__r.FirstName + &apos; &apos; +
IF(!ISBLANK(Account__r.IAA__r.MiddleName), Account__r.IAA__r.MiddleName + &apos; &apos;, &apos;&apos;) +
Account__r.IAA__r.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IAA</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>IsNewAccreditationCycleAllowed__c</fullName>
        <description>Boolean that indicates if creating a new Accreditation Cycle record is allowed. It is used to show or /hide the button &apos;New Accreditation Cycle&apos; on the Accreditation Record page and for validation.</description>
        <formula>(
  nCycles__c = 0 || nPlannedCycles__c = 0
) &amp;&amp;
(
   ISPICKVAL(Status__c, &apos;Registered&apos;) ||
   ISPICKVAL(Status__c, &apos;Accredited&apos;) 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>New Accreditation Cycle Allowed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserIAA__c</fullName>
        <description>If checked the user is registered as a IAA for the related Account, this field is used as a filter for certain components on Lightning Record pages.</description>
        <formula>IF ( $User.Id =  Account__r.IAA__r.Id, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User IAA</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsUserSSEO__c</fullName>
        <description>If checked the user is registered as a SSEO for the related Account, this field is used as a filter for certain components on Lightning Record pages.</description>
        <formula>IF ( $User.Id =  Account__r.SSEO__r.Id, true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>User SSEO</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>IsVRBypassed__c</fullName>
        <formula>BLANKVALUE(ValidationBypassDateTime__c, $System.OriginDateTime) &gt; NOW() - 0.00005787037 /*Five Seconds*/</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsVRBypassed</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

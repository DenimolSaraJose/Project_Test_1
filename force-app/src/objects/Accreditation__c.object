    <fields>
        <fullName>AccreditationOutcome2__c</fullName>
        <description>Current Accreditation Outcome, this does not include recommendations.</description>
        <externalId>false</externalId>
        <formula>BLANKVALUE(Account__r.Aggregate_Result__r.AccreditationOutcome__c, &apos;N/A&apos;)</formula>
        <inlineHelpText>This reflects the school&apos;s most recent accreditation decision.</inlineHelpText>
        <label>OBSOLETE Accreditation Decision</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

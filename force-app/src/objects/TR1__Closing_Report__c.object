    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>TR1__Bill_rate_lower_than_pay_rate</fullName>
        <active>true</active>
        <description>Bill rate cannot be lower than pay rate.</description>
        <errorConditionFormula>TR1__Pay_Rate__c &gt;  TR1__Bill_Rate__c</errorConditionFormula>
        <errorDisplayField>TR1__Bill_Rate__c</errorDisplayField>
        <errorMessage>Bill rate cannot be lower than pay rate.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_adminfeepct_change</fullName>
        <active>false</active>
        <description>Not permitted to change admin fee % once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(    TR1__Administrative_Fee_Percentage__c  ),
NOT(ISBLANK( PRIORVALUE( TR1__Job_Credit__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__Administrative_Fee_Percentage__c</errorDisplayField>
        <errorMessage>Not permitted to change rate on closing report.  To modify rate please click rate change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_billrate_change</fullName>
        <active>false</active>
        <description>Not permitted to change bill rate once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(   TR1__Bill_Rate__c  ),
NOT(ISBLANK( PRIORVALUE( TR1__Job_Credit__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__Bill_Rate__c</errorDisplayField>
        <errorMessage>Not permitted to change rate on closing report.  To modify rate please click rate change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_candcredit_change</fullName>
        <active>false</active>
        <description>Not permitted to change once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(   TR1__Candidate_Credit__c  ),
NOT(ISBLANK( PRIORVALUE(  TR1__Account__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__Candidate_Credit__c</errorDisplayField>
        <errorMessage>Not permitted to change user credit on closing report.  To modify please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_candidatepct_change</fullName>
        <active>false</active>
        <description>Not permitted to change once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(  TR1__Candidate_Percentage__c ),
NOT(ISBLANK( PRIORVALUE( TR1__Job_Credit__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__Candidate_Percentage__c</errorDisplayField>
        <errorMessage>Not permitted to change rate on closing report.  To modify please contact your system administrator.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_dtbillratemult_change</fullName>
        <active>true</active>
        <description>Not permitted to change admin fee % once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(    TR1__DT_Bill_Rate_Multiplier_Percentage__c    ),
NOT(ISBLANK( PRIORVALUE( TR1__Job_Credit__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__DT_Bill_Rate_Multiplier_Percentage__c</errorDisplayField>
        <errorMessage>Not permitted to change rate on closing report.  To modify rate please click rate change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>TR1__Prevent_jobcredit_change</fullName>
        <active>false</active>
        <description>Not permitted to change once closing report has been saved, except system admin.</description>
        <errorConditionFormula>AND(
ISCHANGED(   TR1__Job_Credit__c  ),
NOT(ISBLANK( PRIORVALUE(  TR1__Account__c  ))),
NOT(ISNEW()),
$UserRole.Name &lt;&gt; &quot;Corporate&quot;)</errorConditionFormula>
        <errorDisplayField>TR1__Job_Credit__c</errorDisplayField>
        <errorMessage>Not permitted to change user credit on closing report.  To modify please contact your system administrator.</errorMessage>
    </validationRules>

        <fullName>c2g__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>Displays the status of the accounting playbook task.</description>
        <label>Status</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Started</fullName>
                    <default>true</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>In Progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>Done</fullName>
                    <default>false</default>
                    <label>Done</label>
                </value>
                <value>
                    <fullName>Blocked</fullName>
                    <default>false</default>
                    <label>Blocked</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>c2g__Validation__c</fullName>
        <deprecated>false</deprecated>
        <description>This field displays the playbook validation process status for the task.</description>
        <inlineHelpText>Displays the status of the playbook validation process. This process checks that task actions have been performed. It does not change the status of the task. For more information, see Accounting Playbook Validations in the Certinia Help.</inlineHelpText>
        <label>Validation</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Not Launched</fullName>
                    <default>true</default>
                    <label>Not Launched</label>
                </value>
                <value>
                    <fullName>Successful</fullName>
                    <default>false</default>
                    <label>Successful</label>
                </value>
                <value>
                    <fullName>Unsuccessful</fullName>
                    <default>false</default>
                    <label>Unsuccessful</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

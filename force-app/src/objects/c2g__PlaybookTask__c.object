    <fields>
        <fullName>c2g__Overdue__c</fullName>
        <deprecated>false</deprecated>
        <description>Displays a flag icon when the accounting playbook task due date is earlier than the current date.</description>
        <externalId>false</externalId>
        <formula>IF(AND(c2g__DueDate__c &lt; TODAY(), NOT(ISPICKVAL(c2g__Status__c, &quot;Done&quot;))), IMAGE(&apos;/resource/c2g__playbooks/images/priority.png&apos;, &apos;zero&apos;), NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Overdue</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__PeriodEndDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The period end date of the company selected for the accounting playbook. This field is auto-populated from the Period End Date field on the related accounting playbook.</description>
        <formula>c2g__Playbook__r.c2g__PeriodEndDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>

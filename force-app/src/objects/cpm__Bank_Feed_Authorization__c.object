    </fields>
    <fields>
        <fullName>cpm__Authorization_Reference__c</fullName>
        <deprecated>false</deprecated>
        <description>The reference of the authorization. Used to communicate about this authorization with the AISP.</description>
        <externalId>false</externalId>
        <label>Authorization Reference</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Consent_Id__c</fullName>
        <deprecated>false</deprecated>

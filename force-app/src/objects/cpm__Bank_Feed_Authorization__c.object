        <unique>false</unique>
    </fields>
    <fields>
        <fullName>cpm__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>The status of the authorization.</description>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Connected</fullName>
                    <default>false</default>
                    <label>Connected</label>
                </value>
                <value>
                    <fullName>Disconnected</fullName>
                    <default>false</default>
                    <label>Disconnected</label>
                </value>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Expired</fullName>
                    <default>false</default>
                    <label>Expired</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>cpm__Valid_for__c</fullName>
        <deprecated>false</deprecated>
        <description>The amount of days this authorization is valid for. Provided by the AISP, used to calculate the Expiry_Date__c.</description>
        <externalId>false</externalId>
        <label>Valid for</label>
        <precision>18</precision>
        <required>false</required>

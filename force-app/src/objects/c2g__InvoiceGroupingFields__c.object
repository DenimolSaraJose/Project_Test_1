        <deprecated>false</deprecated>
        <description>Stores the API name of the consolidation grouping field.</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the API name of the field used to group invoices with the same value. This field must exist on the Invoice object. You do not need to enter the Company, Account and Currency fields as they are used automatically.</inlineHelpText>
        <label>Field API Name</label>
        <length>255</length>

    <listViews>
        <fullName>AllOpenCases</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>NAME</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>C_R_Application_Status__c</columns>
        <columns>CASES.CREATED_DATE_DATE_ONLY</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CASES.STATUS</field>
            <operation>notEqual</operation>
            <value>Closed</value>
        </filters>
        <label>All Open Cases</label>
    </listViews>
    <listViews>
        <fullName>CIS_Salesforce_Support_Case</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>CASES.LAST_UPDATE_DATE_ONLY</columns>
        <columns>CASES.STATUS</columns>
        <columns>NAME</columns>
        <columns>Service_Area__c</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.PRIORITY</columns>
        <columns>CASES.CREATED_DATE_DATE_ONLY</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>CASES.STATUS</field>
            <operation>equals</operation>
            <value>New,In Progress,Pending,Escalated,On Hold</value>
        </filters>
        <label>CIS Salesforce Support</label>
        <language>en_US</language>
        <queue>CIS_Salesforce_Support</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>C_R_Candidate_Queue_Case</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>NAME</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>C_R_Application_Status__c</columns>
        <columns>CASES.CREATED_DATE_DATE_ONLY</columns>
        <columns>OWNER_NAME</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>CASES.STATUS</field>
            <operation>notEqual</operation>
            <value>Closed</value>
        </filters>
        <label>Open Potential Candidate Queue</label>
        <queue>C_R_Candidate_Queue</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>IngenicoConfirmations_Case</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>CreatedDate_only__c</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>CASES.SUBJECT</field>
            <operation>notContain</operation>
            <value>CANCEL/DENY</value>
        </filters>
        <label>IngenicoConfirmations</label>
        <queue>IngenicoConfirmations</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>IngenicoConfirmations_SIN_NL</fullName>
        <booleanFilter>(1 OR 2 )AND 3</booleanFilter>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>NAME</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>CASES.PRIORITY</columns>
        <columns>CASES.CREATED_DATE</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <filterScope>Queue</filterScope>
        <filters>
            <field>CASES.SUBJECT</field>
            <operation>contains</operation>
            <value>NL</value>
        </filters>
        <filters>
            <field>CASES.SUBJECT</field>
            <operation>contains</operation>
            <value>SIN</value>
        </filters>
        <filters>
            <field>CASES.SUBJECT</field>
            <operation>contains</operation>
            <value>status: 9</value>
        </filters>
        <label>IngenicoConfirmations - SIN/NL</label>
        <language>en_US</language>
        <queue>IngenicoConfirmations</queue>
        <sharedTo>
            <group>CIS_Finance_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>MyCases</fullName>
        <columns>CASES.CASE_NUMBER</columns>
        <columns>NAME</columns>
        <columns>CASES.SUBJECT</columns>
        <columns>CASES.STATUS</columns>
        <columns>CASES.PRIORITY</columns>
        <columns>CASES.CREATED_DATE</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>CASES.STATUS</field>
            <operation>equals</operation>
            <value>New,In Progress,Pending,Escalated,On Hold</value>
        </filters>
        <label>My Cases</label>
        <language>en_US</language>
    </listViews>
    <listViews>
        <fullName>MyOpenCases</fullName>
        <filterScope>Mine</filterScope>
        <filters>
            <field>CASES.CLOSED</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <label>My Open Cases</label>
    </listViews>
    <recordTypeTrackFeedHistory>false</recordTypeTrackFeedHistory>
    <recordTypeTrackHistory>true</recordTypeTrackHistory>
    <recordTypes>
        <fullName>CIS_Salesforce_Support</fullName>
        <active>true</active>
        <businessProcess>CIS Salesforce Support process</businessProcess>
        <description>A record type for cases submitted to CIS Salesforce support</description>
        <label>CIS Salesforce Support</label>
        <picklistValues>
            <picklist>Origin</picklist>
            <values>
                <fullName>Email</fullName>
                <default>true</default>
            </values>
            <values>
                <fullName>Phone</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Priority</picklist>
            <values>
                <fullName>High</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Low</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Medium</fullName>
                <default>true</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Reason</picklist>
            <values>
                <fullName>Complex functionality</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Existing problem</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Instructions not clear</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>New problem</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>User didn%27t attend training</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Service_Area__c</picklist>
            <values>
                <fullName>C%26R</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Communications%2FPardot</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Finance</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>General Administration</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>HE</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>R%26D</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>SS%26E</fullName>
                <default>false</default>
            </values>
        </picklistValues>
        <picklistValues>
            <picklist>Type</picklist>
            <values>
                <fullName>C%26R Candidate Portfolio submitted</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Evaluator Candidate Portfolio submitted</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Feature Request</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Problem</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Question</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>

    <fields>
        <fullName>Educator_Application_Type__c</fullName>
        <externalId>false</externalId>
        <formula>IF(INCLUDES(  Contact.Educator_application_type__c  , &quot;Accreditation Evaluator&quot;), &quot;Accreditation Evaluator&quot;, NULL)  + BR() + 
IF(INCLUDES( Contact.Educator_application_type__c , &quot;Career and Recruitment Candidate&quot;), &quot;Career and Recruitment Candidate&quot;, NULL)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>

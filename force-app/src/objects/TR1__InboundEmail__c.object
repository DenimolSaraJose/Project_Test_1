    <fields>
        <fullName>TR1__Status__c</fullName>
        <deprecated>false</deprecated>
        <inlineHelpText>not started : Email waiting to be processed
in progress : Email is currently being processed.
completed : Email was processed successfully
failed : The latest attempt to process this email has failed
aborted :This email either misses required data, or has failed too many times.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>not started</fullName>
                    <default>false</default>
                    <label>Not Started</label>
                </value>
                <value>
                    <fullName>in progress</fullName>
                    <default>false</default>
                    <label>In Progress</label>
                </value>
                <value>
                    <fullName>completed</fullName>
                    <default>false</default>
                    <label>Completed</label>
                </value>
                <value>
                    <fullName>failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
                <value>
                    <fullName>aborted</fullName>
                    <default>false</default>
                    <label>Aborted</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

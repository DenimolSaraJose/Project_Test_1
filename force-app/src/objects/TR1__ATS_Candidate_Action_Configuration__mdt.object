    <fields>
        <fullName>TR1__Disable_for_Closed_Jobs__c</fullName>
        <deprecated>false</deprecated>
        <description>Controlling the availability of action for closed jobs</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Controlling the availability of action for closed jobs. Enable/Disable values will override Custom Setting configuration.
Values:
&apos;None&apos; - &apos;Disable ATSv2 actions for Closed Jobs&apos; from the ATS Configuration Custom Setting will be applied
&apos;Enabled&apos; - enable action on Closed Jobs 
&apos;Disabled&apos; - disable action on Closed Jobs</inlineHelpText>
        <label>Disable for Closed Jobs</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Enabled</fullName>
                    <default>true</default>
                    <label>Enabled</label>
                </value>
                <value>
                    <fullName>Disabled</fullName>
                    <default>false</default>
                    <label>Disabled</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Display_Location__c</fullName>
        <defaultValue>&apos;Dropdown&apos;</defaultValue>
        <deprecated>false</deprecated>
        <description>Controls whether the particular action location is in the bar or in the dropdown</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Controls whether the particular action location is in the bar or in the dropdown</inlineHelpText>
        <label>Display Location</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Dropdown</fullName>
                    <default>true</default>
                    <label>Dropdown</label>
                </value>
                <value>
                    <fullName>Bar</fullName>
                    <default>false</default>
                    <label>Bar</label>
                </value>
                <value>
                    <fullName>Right bar</fullName>
                    <default>false</default>
                    <label>Right bar</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

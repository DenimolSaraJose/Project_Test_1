<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>This setting contains the settings for the Textkernel Binary Retrieval Service.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Delete_After_Days__c</fullName>
        <defaultValue>3</defaultValue>
        <deprecated>false</deprecated>
        <description>Specifies the number of days to keep old Automation Events before they are deleted (0 to 99)</description>
        <externalId>false</externalId>
        <inlineHelpText>Specifies the number of days to keep old Automation Events before they are deleted (0 to 99)</inlineHelpText>
        <label>Delete Automation Events after days</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Named_Credential__c</fullName>
        <defaultValue>&quot;TK_Binary&quot;</defaultValue>
        <deprecated>false</deprecated>
        <description>State here the Named Credential of Textkernel Binary Retrieval Service.</description>
        <externalId>false</externalId>
        <inlineHelpText>State here the Named Credential of Textkernel Binary Retrieval Service.</inlineHelpText>
        <label>Named Credential</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Retry_Attempts__c</fullName>
        <defaultValue>5</defaultValue>
        <deprecated>false</deprecated>
        <description>Specifies the number of Candidate Import retry attempts from 0 to 99.</description>
        <externalId>false</externalId>
        <inlineHelpText>Specifies the number of Candidate Import retry attempts from 0 to 99.</inlineHelpText>
        <label>Import Retry Attempts</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Textkernel AutomationAPI</label>
    <visibility>Public</visibility>
</CustomObject>

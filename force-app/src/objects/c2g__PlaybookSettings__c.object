<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the behavior of accounting playbooks.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>c2g__BellNotifications__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enables bell notifications.</description>
        <label>Bell Notifications</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__ChatterNotifications__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enables Chatter notifications.</description>
        <label>Chatter Notifications</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__EmailNotifications__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Enables email notifications.</description>
        <label>Email Notifications</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__EnableTaskApprovalFeature__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Displays the Approvers Section and all the related messages for the task.</description>
        <label>Enable Task Approval Feature</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__NotifyApproversOfApprovedTask__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, approvers are notified about the tasks marked as Approved.</description>
        <label>Notify Approvers of Approved Tasks</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__NotifyApproversOfDoneTask__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, approvers are notified about the tasks marked as Done.</description>
        <label>Notify Approvers of Done Tasks</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__NotifyAssigneeOfApprovedTask__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, assignees are notified about the tasks marked as Approved.</description>
        <label>Notify Assignee of Approved Tasks</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__NotifyAssigneeOfAssignedTask__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>If selected, assignees are notified when they are assigned to a task.</description>
        <label>Notify Assignee of Assigned Tasks</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>c2g__PlaybookProcessScopeSize__c</fullName>
        <deprecated>false</deprecated>
        <description>Batch scope size for the Accounting Playbook Creation Process.</description>
        <externalId>false</externalId>
        <label>Playbook Process Scope Size</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Playbook Settings</label>
    <visibility>Public</visibility>
</CustomObject>

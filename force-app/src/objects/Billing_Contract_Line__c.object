    </fields>
    <fields>
        <fullName>Income_ScheduleId__c</fullName>
        <externalId>false</externalId>
        <formula>Product__r.c2g__CODAIncomeSchedule__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Income ScheduleId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Line_description__c</fullName>
        <label>Line description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Membership__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Membership</label>
        <referenceTo>Membership__c</referenceTo>
        <relationshipLabel>Billing Contract Lines</relationshipLabel>
        <relationshipName>Billing_Contract_Lines</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Number_of_installments__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(
TEXT(Billing_frequency__c),
&apos;Monthly&apos;, CEILING(Contract__r.Duration__c),
&apos;Quarterly&apos;, CEILING(Contract__r.Duration__c/3),
&apos;Yearly&apos;, CEILING(Contract__r.Duration__c/12),
&apos;One-off&apos;, CEILING(Contract__r.Duration__c/12),
0
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Number of installments</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Billing Contract Lines</relationshipLabel>
        <relationshipName>Billing_Contract_Lines</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Quantity__c</fullName>
        <externalId>false</externalId>
        <label>Quantity</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Sales_Invoice_Line_Item__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Sales Invoice Line Item</label>
        <referenceTo>c2g__codaInvoiceLineItem__c</referenceTo>
        <relationshipLabel>Billing Contract Lines</relationshipLabel>
        <relationshipName>Billing_Contract_Lines</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Sales_price__c</fullName>
        <label>Sales price</label>
        <precision>18</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Tax_CodeId__c</fullName>
        <externalId>false</externalId>
        <formula>IF(

(ISPICKVAL( Contract__r.Account__r.c2g__CODAVATStatus__c, &quot;Home&quot;) ||


ISPICKVAL( Contract__r.Account__r.c2g__CODAVATStatus__c, &quot;EC Non-registered&quot;)) ,



  Product__r.c2g__CODATaxCode__c ,  Contract__r.Account__r.c2g__CODAOutputVATCode__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tax CodeId</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Tax_Code__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Tax Code</label>
        <referenceTo>c2g__codaTaxCode__c</referenceTo>
        <relationshipLabel>Billing Contract Lines</relationshipLabel>
        <relationshipName>Billing_Contract_Lines</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Total_amount_per_installment__c</fullName>
        <description>Total amount for the total project length</description>
        <formula>CASE( 
TEXT( Contract__r.Schedule_type__c ), 
&apos;Multiply By&apos;, Quantity__c * Sales_price__c, 
&apos;Divide By&apos;, Quantity__c * Sales_price__c / Number_of_installments__c,
0 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Total amount for the total project length</inlineHelpText>
        <label>Total amount per installment</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Total_contract_line_value__c</fullName>
        <formula>CASE( 
TEXT( Contract__r.Schedule_type__c ), 
&apos;Multiply By&apos;, Quantity__c * Sales_price__c * Number_of_installments__c, 
&apos;Divide By&apos;, Quantity__c * Sales_price__c,
0 
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total contract line value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <label>Billing Contract Line</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>BCL{000000}</displayFormat>
        <label>Billing Contract Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Billing Contract Lines</pluralLabel>
    <searchLayouts/>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

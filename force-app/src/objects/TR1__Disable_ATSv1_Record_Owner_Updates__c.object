<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>This custom setting controls if record owner should be updated on Application, Submittal and Send Out objects upon Contact record owner update.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Do_Not_Update_Application_Record_Owner__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Check this if you don&apos;t want Application records owner to be updated when Contact record owner is updated</description>
        <inlineHelpText>Check this if you don&apos;t want Application records owner to be updated when Contact record owner is updated</inlineHelpText>
        <label>Do Not Update Application Record Owner</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Do_Not_Update_Send_Out_Record_Owner__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Check this if you don’t want Send Out records owner to be updated when Contact record owner is updated</description>
        <inlineHelpText>Check this if you don’t want Send Out records owner to be updated when Contact record owner is updated</inlineHelpText>
        <label>Do Not Update Send Out Record Owner</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TR1__Do_Not_Update_Submittal_Record_Owner__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Check this if you don’t want Submittal records owner to be updated when Contact record owner is updated</description>
        <inlineHelpText>Check this if you don’t want Submittal records owner to be updated when Contact record owner is updated</inlineHelpText>
        <label>Do Not Update Submittal Record Owner</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Disable ATSv1 Record Owner Updates</label>
    <visibility>Public</visibility>
</CustomObject>

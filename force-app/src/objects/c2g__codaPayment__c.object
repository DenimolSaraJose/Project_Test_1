    <webLinks>
        <fullName>CTCM__Generate_Bank_File</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <height>600</height>
        <linkType>page</linkType>
        <masterLabel>Generate XML Bank File</masterLabel>
        <openType>sidebar</openType>
        <page>CTCM__Payments</page>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
    </webLinks>
    <webLinks>
        <fullName>CTCM__Generate_SEPA_Bank_File</fullName>
        <availability>online</availability>
        <displayType>massActionButton</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Generate SEPA Bank File</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <requireRowSelection>true</requireRowSelection>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/29.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/29.0/apex.js&quot;)}


var records = {!GETRECORDIDS($ObjectType.c2g__codaPayment__c)};

if(records.length != 0){

sforce.apex.execute(&quot;CTCM.XmlBankFileGenerator&quot;,&quot;generateXml&quot;,{recordIds:records});

window.location.reload();

}else {
alert(&quot;No payment files were selected. Please select a payment file and try again.&quot;);
}</url>
    </webLinks>

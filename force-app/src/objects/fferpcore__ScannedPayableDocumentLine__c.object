    <fields>
        <fullName>fferpcore__InvoiceLineNumber__c</fullName>
        <deprecated>false</deprecated>
        <description>Invoice line number of the scanned payable document line.</description>
        <externalId>false</externalId>
        <inlineHelpText>The invoice line number on the scanned payable document line.</inlineHelpText>
        <label>Invoice Line Number</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fferpcore__LineDescription__c</fullName>
        <deprecated>false</deprecated>
        <description>Description of the scanned payable document line.</description>
        <inlineHelpText>Description that relates to the scanned payable document line.</inlineHelpText>
        <label>Line Description</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>fferpcore__NetValue__c</fullName>
        <deprecated>false</deprecated>
        <description>Net value of the scanned payable document line.</description>
        <externalId>false</externalId>
        <inlineHelpText>Net Value for scanned payable document line.</inlineHelpText>
        <label>Net Value</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>fferpcore__ScannedPayableDocumentNumber__c</fullName>

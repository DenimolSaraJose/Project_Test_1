    <validationRules>
        <fullName>CTCM__Alternative_Bank_Currency_Mandatory</fullName>
        <active>true</active>
        <errorConditionFormula>if(AND(NOT(ISBLANK(CTCM__Alternative_Bank_IBAN_Number__c)), ISBLANK(CTCM__Alternative_Bank_Currency__c)),TRUE,FALSE)</errorConditionFormula>
        <errorDisplayField>CTCM__Alternative_Bank_Currency__c</errorDisplayField>
        <errorMessage>If Alternative Bank IBAN Number is filled then Alternative Bank Currency is mandatory.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CTCM__Alternative_Bank_Currency_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>if(AND(c2g__CODAAccountTradingCurrency__c!=null,c2g__CODAAccountTradingCurrency__c== CTCM__Alternative_Bank_Currency__c),TRUE,FALSE)</errorConditionFormula>
        <errorDisplayField>CTCM__Alternative_Bank_Currency__c</errorDisplayField>
        <errorMessage>Alternative Bank Currency should not be same as Account Trading Currency.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CTCM__G_Bank_IBAN_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(CONTAINS( CTCM__G_Bank_IBAN_Number__c , &apos;Test&apos;)= false,
OR(CONTAINS( CTCM__G_Bank_IBAN_Number__c , &apos; &apos;), 
MOD( 
VALUE( 
SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE(( 
SUBSTITUTE( 
RPAD( MID(CTCM__G_Bank_IBAN_Number__c ,5,LEN(CTCM__G_Bank_IBAN_Number__c) ) ,LEN(CTCM__G_Bank_IBAN_Number__c), MID(CTCM__G_Bank_IBAN_Number__c,1,4) ),&quot;A&quot;,&quot;10&quot;)) 
,&quot;B&quot;,&quot;11&quot;)),&quot;C&quot;,&quot;12&quot;)),&quot;D&quot;,&quot;13&quot;)),&quot;E&quot;,&quot;14&quot;)),&quot;F&quot;,&quot;15&quot;)),&quot;G&quot;,&quot;16&quot;)),&quot;H&quot;,&quot;17&quot;)),&quot;I&quot;,&quot;18&quot;)),&quot;J&quot;,&quot;19&quot;)),&quot;K&quot;,&quot;20&quot;)),&quot;L&quot;,&quot;21&quot;)),&quot;M&quot;,&quot;22&quot;)),&quot;N&quot;,&quot;23&quot;)),&quot;O&quot;,&quot;24&quot;)),&quot;P&quot;,&quot;25&quot;)),&quot;Q&quot;,&quot;26&quot;)),&quot;R&quot;,&quot;27&quot;)),&quot;S&quot;,&quot;28&quot;)),&quot;T&quot;,&quot;29&quot;)),&quot;U&quot;,&quot;30&quot;)),&quot;V&quot;,&quot;31&quot;)),&quot;W&quot;,&quot;32&quot;)),&quot;X&quot;,&quot;33&quot;)),&quot;Y&quot;,&quot;34&quot;)),&quot;Z&quot;,&quot;35&quot;)) 
,97) 
&lt;&gt;1)

)</errorConditionFormula>
        <errorDisplayField>CTCM__G_Bank_IBAN_Number__c</errorDisplayField>
        <errorMessage>G Bank IBAN Number format is incorrect. Please enter the IBAN number without spaces.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CTCM__IBAN_validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(CONTAINS( c2g__CODABankIBANNumber__c , &apos;Test&apos;)= false,
OR(CONTAINS( c2g__CODABankIBANNumber__c , &apos; &apos;), 
MOD( 
VALUE( 
SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE((SUBSTITUTE(( 
SUBSTITUTE( 
RPAD( MID(c2g__CODABankIBANNumber__c ,5,LEN(c2g__CODABankIBANNumber__c) ) ,LEN(c2g__CODABankIBANNumber__c), MID(c2g__CODABankIBANNumber__c,1,4) ),&quot;A&quot;,&quot;10&quot;)) 
,&quot;B&quot;,&quot;11&quot;)),&quot;C&quot;,&quot;12&quot;)),&quot;D&quot;,&quot;13&quot;)),&quot;E&quot;,&quot;14&quot;)),&quot;F&quot;,&quot;15&quot;)),&quot;G&quot;,&quot;16&quot;)),&quot;H&quot;,&quot;17&quot;)),&quot;I&quot;,&quot;18&quot;)),&quot;J&quot;,&quot;19&quot;)),&quot;K&quot;,&quot;20&quot;)),&quot;L&quot;,&quot;21&quot;)),&quot;M&quot;,&quot;22&quot;)),&quot;N&quot;,&quot;23&quot;)),&quot;O&quot;,&quot;24&quot;)),&quot;P&quot;,&quot;25&quot;)),&quot;Q&quot;,&quot;26&quot;)),&quot;R&quot;,&quot;27&quot;)),&quot;S&quot;,&quot;28&quot;)),&quot;T&quot;,&quot;29&quot;)),&quot;U&quot;,&quot;30&quot;)),&quot;V&quot;,&quot;31&quot;)),&quot;W&quot;,&quot;32&quot;)),&quot;X&quot;,&quot;33&quot;)),&quot;Y&quot;,&quot;34&quot;)),&quot;Z&quot;,&quot;35&quot;)) 
,97) 
&lt;&gt;1)

)</errorConditionFormula>
        <errorDisplayField>c2g__CODABankIBANNumber__c</errorDisplayField>
        <errorMessage>IBAN Number format is incorrect. Please enter the IBAN number without spaces.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Community_user_not_change_account_Name</fullName>
        <active>true</active>
        <errorConditionFormula>NOT(ISNEW())&amp;&amp;  NOT(RecordType.Id = &quot;0120Y0000002HYP&quot;)  &amp;&amp; Ischanged(Name) &amp;&amp;  ISPICKVAL( $User.UserType , &quot;PowerCustomerSuccess&quot;)</errorConditionFormula>
        <errorMessage>You&apos;re not allowed to change your Account name, please contact your representative from CIS. Apologies for any inconvenience caused.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Lock_Account_Currency</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED( CurrencyIsoCode ),
OR(
NOT( ISBLANK( c2g__CODAAccountsReceivableControl__c )),
NOT( ISBLANK( c2g__CODAAccountsPayableControl__c ))
)
)</errorConditionFormula>
        <errorDisplayField>CurrencyIsoCode</errorDisplayField>
        <errorMessage>This Account is in use by FinancialForce Accounting. You cannot change its currency.</errorMessage>
    </validationRules>
    <webLinks>
        <fullName>APXTConga4__Conga_Composer_OAuth</fullName>
        <availability>online</availability>
        <description>*** DO NOT USE THIS BUTTON ON A PAGE LAYOUT ***

OAuth buttons require additional setup. Please see the Composer Installation Guide for more details.

COPY THE URL FROM THIS BUTTON and paste it into your own custom button or link. Then add optional parameters to finely tune the button&apos;s behavior. See the Composer Configuration Guide for details.</description>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>660</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Conga Composer (OAuth)</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>/apex/APXTConga4__Conga_Composer
?serverUrl={!API.Partner_Server_URL_520}

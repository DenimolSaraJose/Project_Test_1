        <active>false</active>
        <errorConditionFormula>IF( AND(CTPISA__Number_of_lines__c&gt;0,  CTPISA__InvoiceTotalVATIncluded__c &lt;&gt;  CTPISA__Total_NetValue_of_Lines__c,OR(ISPICKVAL( CTPISA__Status__c , &quot;InApproval&quot;),ISPICKVAL( CTPISA__Status__c , &quot;Approved&quot;)) ) , true, false)</errorConditionFormula>
        <errorMessage>Sum of Invoice scan lines(Net Value) should match with InvoiceTotalVATIncluded</errorMessage>
    </validationRules>

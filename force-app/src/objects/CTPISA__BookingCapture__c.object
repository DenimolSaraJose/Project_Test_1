        <deprecated>false</deprecated>
        <formula>ISPICKVAL(CTPISA__ApprovalStatus__c, &apos;Approved&apos;)
&amp;&amp; CTPISA__NeedsApprovalToPostPayableInvoice__c = true
&amp;&amp; NOT(ISPICKVAL(CTPISA__PayableInvoice__r.c2g__InvoiceStatus__c, &apos;Complete&apos;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Needs Posting</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__NeedsReleasing__c</fullName>
        <deprecated>false</deprecated>
        <formula>ISPICKVAL(CTPISA__ApprovalStatus__c, &apos;Approved&apos;)
&amp;&amp; CTPISA__NeedsApprovalToPostPayableInvoice__c = false 
&amp;&amp; ISPICKVAL(CTPISA__PayableInvoice__r.c2g__InvoiceStatus__c, &apos;Complete&apos;)
&amp;&amp; CTPISA__PayableInvoice__r.c2g__HoldStatus__c = &apos;On Hold&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Needs Releasing</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>CTPISA__NextAttemptAfter__c</fullName>
        <deprecated>false</deprecated>
        <description>The date/time after which another attempt will take place to retrieve the booking results.</description>
        <formula>IF( ISBLANK( CTPISA__LastAttempt__c ),
CreatedDate,
CTPISA__LastAttempt__c 
) 
+ IF(
CTPISA__Attempts__c &gt; 0,
( 
(2^(CTPISA__Attempts__c)) /14400
), 0
)
+ 
IF(CTPISA__Attempts__c == 0, 60 / 86400, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>The date/time after which another attempt will take place to retrieve the booking results.</inlineHelpText>
        <label>NextAttemptAfter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>

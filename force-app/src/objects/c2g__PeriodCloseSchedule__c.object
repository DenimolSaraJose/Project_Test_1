        <label>Period End Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>c2g__RunDate__c</fullName>
        <deprecated>false</deprecated>
        <description>The date derived from the value entered in the Days field on which the closing of periods is scheduled.</description>
        <label>Scheduled Run Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>

        <deprecated>false</deprecated>
        <description>Comma separated list of skill types API names to be sent to candidate matching engine. Only skills of these types on the Job record will be used to find Candidates.</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Specify API names of Skill Types that are taken into account when matching Jobs to Candidates based on MCMB. Type values must be written through the separator ‘,’. Example: to have only Language and IT Skill types, enter Language_Skill, IT_Skill. If this field is blank, then all Skills types will be taken into account.</inlineHelpText>
        <label>Skill Types Used In Match Queries</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>

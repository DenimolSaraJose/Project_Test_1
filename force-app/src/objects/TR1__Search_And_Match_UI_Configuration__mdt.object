    <fields>
        <fullName>TR1__Advanced_Search_Date_Options__c</fullName>
        <deprecated>false</deprecated>
        <description>Defines search criteria options used for date fields in Advanced Search.</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Defines search criteria options used for date fields in Advanced Search. Date: equal, not equal to, greater than, less than. Date Range: only criteria added in Advanced Search Date Range field. Dates and Data Range: both options.</inlineHelpText>
        <label>Advanced Search Date Options</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Dates</fullName>
                    <default>true</default>
                    <label>Dates</label>
                </value>
                <value>
                    <fullName>DateRange</fullName>
                    <default>false</default>
                    <label>Date Range</label>
                </value>
                <value>
                    <fullName>DatesAndDateRange</fullName>
                    <default>false</default>
                    <label>Dates and Date Range</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

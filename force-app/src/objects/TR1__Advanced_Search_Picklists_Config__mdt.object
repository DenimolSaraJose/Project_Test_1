<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows to add Contact dependent picklists to Advanced search filter on Search and Match page</description>
    <fields>
        <fullName>TR1__Controlling_Field__c</fullName>
        <deprecated>false</deprecated>
        <description>Contact controlling picklist field API name</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Controlling Field</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Dependent_Field__c</fullName>
        <deprecated>false</deprecated>
        <description>Contact dependent picklist field API name</description>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Dependent Field</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__User_control_field__c</fullName>
        <deprecated>false</deprecated>
        <description>Selected value of the controlling picklist can be configured based on User Country or Brand</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>User control field</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Country</fullName>
                    <default>true</default>
                    <label>Country</label>
                </value>
                <value>
                    <fullName>Brand</fullName>
                    <default>false</default>
                    <label>Brand</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Advanced Search Picklists Config</label>
    <pluralLabel>Advanced Search Picklists Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

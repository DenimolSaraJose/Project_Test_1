    <fields>
        <fullName>TR1__Application_Fields_Info__c</fullName>
        <deprecated>false</deprecated>
        <description>Application fields to display in table if data source is Application. By default column width is equal to 100. columnWidth param determines by how many percent the target column will be more than the other columns. Example : [ {&quot;fieldAPIName&quot; : &quot;TR1__Stage__c&quot;, &quot;fieldLabel&quot; : &quot;Stage&quot;, &quot;columnWidth&quot; : &quot;100&quot;}, {&quot;fieldAPIName&quot; : &quot;TR1__Reject__c&quot;, &quot;fieldLabel&quot; : &quot;Reject&quot;} ]</description>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <inlineHelpText>Each object contains info about fieldAPIName, fieldLabel, columnWidth. fieldAPIName and fieldLabel is required
By default column width is equal to 100. columnWidth param determines by how many percent the target column will be more than average column.</inlineHelpText>
        <label>Application Fields Info</label>
        <length>5000</length>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>

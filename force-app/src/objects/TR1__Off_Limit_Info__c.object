    <fields>
        <fullName>TR1__State_Processing_Required__c</fullName>
        <deprecated>false</deprecated>
        <description>Formula field that calculates if the info record needs processing or not</description>
        <formula>NOT(ISBLANK(TR1__State_Processing_Last_Required__c)) &amp;&amp; (ISBLANK(TR1__State_Processing_Last_Performed__c) || TR1__State_Processing_Last_Performed__c &lt;= TR1__State_Processing_Last_Required__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Formula field that calculates if the info record needs processing or not</inlineHelpText>
        <label>State Processing Required</label>

    <label>Academic Year Figures</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>My_Academic_Year_Figures</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <label>My Academic Year Figures</label>
        <sharedTo>
            <group>All_Community_Members</group>
        </sharedTo>
    </listViews>
    <nameField>
        <label>Academic Year Figures</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Academic Year Figures</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Number_format_for_min_SAT_scores</fullName>
        <active>true</active>
        <description>Only original SAT scores number format  should be input.</description>
        <errorConditionFormula>AND(
   NOT(ISBLANK(Minimum_SAT_Score__c)),
   NOT(ISNUMBER(Minimum_SAT_Score__c ))
)</errorConditionFormula>
        <errorMessage>Please introduce original SAT score (1230 or 1410 for example)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Percentage_rule</fullName>
        <active>false</active>
        <description>To keep percentage fields under 100%</description>
        <errorConditionFormula>OR(
    of_total_above_who_are_overse__c &gt; 1.0,
    of_total_above_who_are_overse__c &lt; 0.0
)</errorConditionFormula>
        <errorDisplayField>total_nationalities_in_faculty__c</errorDisplayField>
        <errorMessage>Please enter a percentage between 0 and 100</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Percentage_rulenationalfac</fullName>
        <active>false</active>
        <description>To keep percentage fields under 100%</description>
        <errorConditionFormula>OR(
      total_faculty_who_are_national_faculty__c  &gt; 1.0,
    total_faculty_who_are_national_faculty__c &lt; 0.0
)</errorConditionFormula>
        <errorDisplayField>total_nationalities_in_faculty__c</errorDisplayField>
        <errorMessage>Please enter a percentage between 0 and 100</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Percentage_rulenationalstudents</fullName>
        <active>false</active>
        <description>To keep percentage fields under 100%</description>
        <errorConditionFormula>OR(
     of_national_student_enrolment__c  &gt; 1.0,
    of_national_student_enrolment__c  &lt; 0.0
)</errorConditionFormula>
        <errorDisplayField>total_nationalities_in_faculty__c</errorDisplayField>
        <errorMessage>Please enter a percentage between 0 and 100</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Percentage_ruleoverseas</fullName>
        <active>false</active>

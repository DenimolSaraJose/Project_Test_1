    <fields>
        <fullName>AYF_Record_Id__c</fullName>
        <externalId>false</externalId>
        <formula>CASESAFEID(Id)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AYF Record Id</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AYF_Update_Form_for_Schools__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;https://survey.cois.org/s3/School-Academic-Year-Figures-Update?Id=&quot; &amp; Id ,&quot;AYF Update Form for Schools&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AYF Update Form for Schools</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AYF_Update_Form_for_Universities__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;https://survey.cois.org/s3/University-Academic-Year-Figures-Update?Id=&quot; &amp; Id ,&quot;AYF Update Form for Universities&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>AYF Update Form for Universities</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AYF_updated_hidden__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To be used for Pardot Dynamic List.</description>
        <label>AYF updated hidden</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Academic_Year_Figures__c</fullName>
        <formula>IF( Account__r.Id = $User.Account_ID__c, true, false)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Academic Year Figures</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Account__c</fullName>
        <label>Institution</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Academic Year Figures</relationshipLabel>
        <relationshipName>Annual_Figures</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>AlchemerAYFID__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>Unique ID generated by Alchemer, pushed to Salesforce via Alchemer-SF integration. This allows Alchemer to lookup the AYF again in the same survey</description>
        <externalId>true</externalId>
        <label>AlchemerAYFID</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Annual_tuition_and_fees_home_undergrads__c</fullName>
        <externalId>false</externalId>
        <inlineHelpText>Resident student: An enrolled student who is a citizen or resident of the country where the institution is located. For U.S. institutions with different rates for in-state/out-of-state students, please use out-of-state/non-resident. Convert to US Dollars.</inlineHelpText>
        <label>Tuition + fees, resident undergraduate</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Contains settings that control the behavior of FinancialForce Financial Report Builder.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>ff_frb__ExportDefaultLogoFilename__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <label>Export Default Logo Filename</label>
        <length>200</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ff_frb__ReportColumnLimit__c</fullName>
        <deprecated>false</deprecated>
        <description>You must enter a whole number value between 0 and 99 to define the number of columns displayed in your Financial Report Builder reports.</description>
        <externalId>false</externalId>
        <label>Report Column Limit</label>
        <precision>2</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ff_frb__ReportRowQueryLimit__c</fullName>
        <deprecated>false</deprecated>
        <description>You must enter a whole number value between 0 and 999,999 to define the number of rows displayed in your Financial Report Builder reports. This setting is overridden by any query limits applied in Analytics.</description>
        <externalId>false</externalId>
        <label>Report Row Query Limit</label>
        <precision>6</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Financial Report Builder Settings</label>
    <visibility>Public</visibility>
</CustomObject>

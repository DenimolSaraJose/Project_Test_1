    <validationRules>
        <fullName>CTPISA__Net_Value_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>False</errorConditionFormula>
        <errorMessage>The (Unit Price X Quantity) should be equal to the Net Value of the of the Booking Capture Line.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CTPISA__Unit_Price_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>False</errorConditionFormula>
        <errorMessage>The (Unit Price X Quantity) of the Booking Capture Lines should not be different than the net value of the Line.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>

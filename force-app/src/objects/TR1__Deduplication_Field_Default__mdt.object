<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>When the Package de-duplication has been disabled, the Standard Salesforce Duplicate Management rules are invoked when a Resume is parsed. In certain instances, customers will need to specify default values before evaluating the Contact records against the Duplicate Rules for example the Record Type. We can use this Custom Metadata to specify Field Defaults in such instances.</description>
    <fields>
        <fullName>TR1__Default_Field_Value__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Default Field Value</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__Field_API_Name__c</fullName>
        <caseSensitive>false</caseSensitive>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Field API Name</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>TR1__Object_API_Name__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Object API Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Deduplication Field Default</label>
    <pluralLabel>Deduplication Field Defaults</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

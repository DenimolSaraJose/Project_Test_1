    <fields>
        <fullName>TR1__EndDateYearsOfExperience__c</fullName>
        <deprecated>false</deprecated>
        <description>Convert the End Date from text to proper type as required by Textkernel Integration to use it for calculation of years of experience</description>
        <externalId>false</externalId>
        <formula>IF(TR1__EndDate__c = &apos;present&apos;,
&apos;__NOWSTRING__&apos;,
TEXT(DATE(VALUE(LEFT(TR1__EndDate__c, 4)), VALUE(MID(TR1__EndDate__c, 6, 2)), VALUE(RIGHT(TR1__EndDate__c, 2)))))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>End date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TR1__EndDate__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>

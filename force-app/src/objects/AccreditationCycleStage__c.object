        <fullName>AccreditationStage__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>The Accreditation Stage record (template) associated with this Accreditation Cycle Stage record.</description>
        <inlineHelpText>The Accreditation Stage record (template) associated with this Accreditation Cycle Stage record.</inlineHelpText>
        <label>Accreditation Stage</label>
        <referenceTo>AccreditationStage__c</referenceTo>
        <relationshipLabel>Accreditation Cycle Stages</relationshipLabel>

    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>c2g__BankConnectionsLogLayout</compactLayoutAssignment>
    <compactLayouts>
        <fullName>c2g__BankConnectionsLogLayout</fullName>
        <fields>Name</fields>
        <label>Bank Connections Log Layout</label>
    </compactLayouts>
    <customHelpPage>c2g__codahelpbankconnectionslog</customHelpPage>
    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>Tracks the use of the bank connections process to establish or update a connection to a bank.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>c2g__SessionID__c</fullName>
        <deprecated>false</deprecated>
        <description>Session ID provided by the external source. The session ID is a unique identifier associated with a bank connection instance.</description>
        <externalId>false</externalId>
        <label>Session ID</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>c2g__Status__c</fullName>
        <deprecated>false</deprecated>
        <description>The status of bank account connection: Close, Error, Failure, Open, or Success.</description>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Open</fullName>
                    <default>true</default>
                    <label>Open</label>
                </value>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Failure</fullName>
                    <default>false</default>
                    <label>Failure</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Bank Connections Log</label>
    <listViews>
        <fullName>c2g__All</fullName>
        <columns>NAME</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>CREATED_DATE</columns>
        <columns>c2g__Status__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>BCL-{000000000}</displayFormat>
        <label>Bank Connections Log Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Bank Connection Logs</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

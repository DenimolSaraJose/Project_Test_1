    <webLinks>
        <fullName>MobileApi__Fonteva_Mobile</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Fonteva Mobile</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>(function() {
    var width = 1000;
    var height = 550;
    var title = &quot;&quot;;
    
    var box = new SimpleDialog(&quot;salesforce&quot; + Math.random(), true);
    box.setTitle(title);
    box.displayX = true;
    box.isMovable = false;
    box.createDialog();
    box.setWidth(width);
    // set your html content here
    box.setContentInnerHTML(
    
    &apos;&lt;iframe src=&quot;/apex/MobileApi__FontevaMobilePage?Id={!EventApi__Event__c.Id}&quot; style=&quot;border:none;&quot; width=&quot;100%&quot; height=&quot;&apos;+ (height - 30)+&apos;px&quot; /&gt;&apos;
    );
    //set the height of the modal
    box.dialog.children[1].style.height = height + &apos;px&apos;;
    box.show();
    document.body.style.overflow=&apos;hidden&apos;;
    
    //if displayX is set to true, then override standard close event by this code
    box.dialog.getElementsByClassName(&apos;dialogClose&apos;)[0].onclick = function() {
    box.hide();
    document.body.style.overflow=&apos;auto&apos;;
    // you can add code to reload the page or redirect to another page
    };
    
    // if you want to be able to close the modal from the Visualforce page
    window.addEventListener(&apos;message&apos;, function(event){
    if (event.data === &apos;close&apos;){
    box.hide();
    location.reload();																						
    }else{
        box.hide();																
        }
    });
        
    })();</url>
    </webLinks>

NOT(ISBLANK($User.ContactId)),
I_agree_to_the_Evaluator_Code_of_Conduct__c = FALSE )</errorConditionFormula>
        <errorDisplayField>I_agree_to_the_Evaluator_Code_of_Conduct__c</errorDisplayField>
        <errorMessage>This is a required field.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>I_have_secured</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
RecordType.Name = &quot;Accreditation&quot;,
On_behalf_of__c &lt;&gt; TRUE,
I_do_not_require_approval_from_a_superv__c = FALSE, NOT( $Profile.Id = &apos;00e0Y000001FS1I&apos;) )</errorConditionFormula>
        <errorDisplayField>I_do_not_require_approval_from_a_superv__c</errorDisplayField>
        <errorMessage>This is a required field.</errorMessage>
    </validationRules>

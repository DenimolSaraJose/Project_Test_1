        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>I_do_not_require_approval_from_a_superv__c</fullName>
        <defaultValue>false</defaultValue>
        <inlineHelpText>This confirms that I have secured permission to be released from school on the dates listed for this evaluation from a supervisor who has the authority to do so.</inlineHelpText>
        <label>I have secured permission to participate</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Important2__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;Please save the dates until you are notified of the outcome.&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Important</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Important__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;*Please enter the details of your Supervisor below. The person listed should have the authority to approve your leave during these visit dates. Please note, if you are shortlisted they will be contacted to approve your participation.&quot;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Important</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Link_to_CIS_Evaluator_Code_of_Conduct__c</fullName>
        <defaultValue>&quot;https://info.cois.org/cis-evaluator-professional-expectations&quot;</defaultValue>
        <label>CIS Evaluator Professional Expectations</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Link_to_Code_of_Conduct__c</fullName>
        <externalId>false</externalId>
        <formula>HYPERLINK(&quot;https://community.cois.org/educators/s/code-of-conduct&quot;, 
&quot;CIS Code of Conduct&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Link to Code of Conduct</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Longlist_Number__c</fullName>

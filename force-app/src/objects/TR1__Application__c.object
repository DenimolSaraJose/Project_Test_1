    <fields>
        <fullName>Accreditation_activity__c</fullName>
        <externalId>false</externalId>
        <formula>TR1__Job__r.Accreditation_Activity__r.Name</formula>
        <label>Accreditation activity</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Applicant_Name_Text__c</fullName>
        <description>Used for Email template, lookup field is not possible.</description>
        <externalId>false</externalId>
        <formula>TR1__Applicant__r.FirstName + &quot; &quot; +  TR1__Applicant__r.LastName</formula>
        <label>Applicant Name Text</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Application_ID__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Unique ID for the data migration</description>
        <externalId>true</externalId>
        <label>Application ID</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Application_Status_textcopy__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Application_status__c)</formula>
        <label>Application Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Application_status__c</fullName>
        <label>Application status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Applied</fullName>
                    <default>true</default>
                    <label>Applied</label>
                </value>
                <value>
                    <fullName>Not Selected</fullName>
                    <default>false</default>
                    <label>Not Selected</label>
                </value>
                <value>
                    <fullName>Under Revision</fullName>
                    <default>false</default>
                    <label>Under Revision</label>
                </value>
                <value>
                    <fullName>Selected</fullName>
                    <default>false</default>
                    <label>Selected</label>
                </value>
                <value>
                    <fullName>Accepted</fullName>
                    <default>false</default>
                    <label>Accepted</label>
                </value>
                <value>
                    <fullName>Withdrawn</fullName>
                    <default>false</default>
                    <label>Withdrawn</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Applied_on__c</fullName>
        <label>Applied on</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Available_for_Multiple_Visits__c</fullName>
        <inlineHelpText>CIS works in two semsters: Semester 1 refers to visits taking place between 1 January to 30 June. 
Semester 2 refers to visits taking place between 1 July to 31 December.</inlineHelpText>
        <label>Available for Multiple Visits?</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Multiple this semester</fullName>
                    <default>false</default>
                    <label>Multiple this semester</label>
                </value>
                <value>
                    <fullName>Only one this semester</fullName>
                    <default>false</default>
                    <label>Only one this semester</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>CISApplicant__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>

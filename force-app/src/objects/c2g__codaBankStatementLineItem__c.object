    <fields>
        <fullName>CTCM__Cash_Match_Process__c</fullName>
        <deprecated>false</deprecated>
        <formula>NOT(OR(ISBLANK(CTCM__Matched_Account__c),c2g__Amount__c &lt; 0))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Cash Match Process</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

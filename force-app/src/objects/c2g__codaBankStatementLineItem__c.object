    <fields>
        <fullName>CTCM__Calc_AccountName__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(FIND(
		&quot;/IBAN/&quot;, 
		c2g__Description__c
        )&gt; 0, 
MID(
	c2g__Description__c, 
	FIND(
		&quot;/NAME/&quot;, 
		c2g__Description__c
        )+6, 
	FIND(
		&quot;/&quot;, 
		c2g__Description__c,
		FIND(
			&quot;/NAME/&quot;, 
			c2g__Description__c
		)+6
	)- (FIND(
		&quot;/NAME/&quot;, 
		c2g__Description__c
        )+6)
),
 TRIM(MID(c2g__Description__c,105,26))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Account name as detected in the bankstatement</inlineHelpText>
        <label>Account Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTCM__Calc_SIN_Number__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(FIND(
		&quot;SIN&quot;, 
		c2g__Description__c
        )&gt; 0,
MID(c2g__Description__c, FIND(&quot;SIN&quot;, c2g__Description__c),9),&quot;&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Detected Sales Invoice Number from bank statement line.</inlineHelpText>
        <label>SIN Number</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTCM__Cash_Entry__c</fullName>

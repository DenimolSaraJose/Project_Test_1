    <fields>
        <fullName>CTCM__Process__c</fullName>
        <deprecated>false</deprecated>
        <formula>if (TEXT(CTCM__Cash_Match_Status__c) == &apos;Closed&apos; ||( CTCM__StornoCode__c== null &amp;&amp; (ISBLANK ( CTCM__Matched_Account__c) || c2g__Amount__c &lt;0)) , false,true)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Process</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>

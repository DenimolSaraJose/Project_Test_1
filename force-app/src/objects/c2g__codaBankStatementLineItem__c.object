    <fields>
        <fullName>CTCM__calc_IBAN__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(FIND(
		&quot;/IBAN/&quot;, 
		c2g__Description__c
        )&gt; 0,  
MID(
	c2g__Description__c, 
	FIND(
		&quot;/IBAN/&quot;, 
		c2g__Description__c
        )+6, 
	FIND(
		&quot;/&quot;, 
		c2g__Description__c,
		FIND(
			&quot;/IBAN/&quot;, 
			c2g__Description__c
		)+6
	)- (FIND(
		&quot;/IBAN/&quot;, 
		c2g__Description__c
        )+6)
)
,
MID(c2g__Description__c,40,FIND(&quot; &quot;, c2g__Description__c,41)-40)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Detected IBAN number form bank statement line</inlineHelpText>
        <label>IBAN (deprecated)</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTCM__calc_REFERENCE__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(FIND(
		&quot;/IBAN/&quot;, 
		c2g__Description__c
        )&gt; 0,  
MID(
	c2g__Description__c, 
	FIND(
		&quot;/REMI/&quot;, 
		c2g__Description__c
        )+6, 
	FIND(
		&quot;/&quot;, 
		c2g__Description__c,
		FIND(
			&quot;/REMI/&quot;, 
			c2g__Description__c
		)+6
	)- (FIND(
		&quot;/REMI/&quot;, 
		c2g__Description__c
        )+6)
)
,
MID(c2g__Description__c,131,LEN(c2g__Description__c)-131)
)</formula>
        <label>calc REFERENCE (deprecated)</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CTCM__calc_REFERENCE_line1__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>LEFT(CTCM__calc_REFERENCE__c, 32)</formula>

    <fields>
        <fullName>TR1__Default_Email_Folder__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the API name of the email template folder that will be pre-selected in the Email Editor for the current Email Page Type record.</description>
        <inlineHelpText>Stores the API name of the email template folder that will be pre-selected in the Email Editor for the current Email Page Type record.</inlineHelpText>
        <label>Default Email Folder</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>TR1__Email_Template_Folders</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>TR1__Default_Email_Template__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores the identifier of the email template that will be pre-selected in the Email Editor for the current Email Page Type record. The following 3 types are supported: Classic Salesforce Email Template Developer Name, or External Id/Campaign Unique Name(SFMC Integration only).</description>
        <externalId>false</externalId>
        <inlineHelpText>Stores the identifier of the email template that will be pre-selected in the Email Editor for the current Email Page Type record. The following 3 types are supported: Classic Salesforce Email Template Developer Name, or External Id/Campaign Unique Name(SFMC Integration only).</inlineHelpText>
        <label>Default Email Template</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>

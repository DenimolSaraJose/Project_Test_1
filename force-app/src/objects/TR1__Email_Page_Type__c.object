    <fields>
        <fullName>TR1__Email_Template_Folders__c</fullName>
        <deprecated>false</deprecated>
        <description>Stores names of the folders under which email templates related to the current email page type should appear. Note: in case if the message preview from SFMC Cloud Page is enabled the folders don’t represent the SF Folders on the org and should match folders specified at some Campaign Template Mappings.</description>
        <inlineHelpText>Stores names of the folders under which email templates related to the current email page type should appear. Note: in case if the message preview from SFMC Cloud Page is enabled the folders don’t represent the SF Folders on the org and should match folders specified at some Campaign Template Mappings.</inlineHelpText>
        <label>Email Template Folders</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>TR1__Email_Template_Folders</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>

        <fullName>TR1__Use_External_Source_for_Templates__c</fullName>
        <defaultValue>false</defaultValue>
        <deprecated>false</deprecated>
        <description>Determines if an external source should be used for this channel’s templates. If unchecked, the Message Body field is used. If Checked, External Key Value is used to refer to an external template.</description>

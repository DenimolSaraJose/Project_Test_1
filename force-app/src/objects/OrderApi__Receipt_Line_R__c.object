    <fields>
        <fullName>OrderApi__Conversion_Gain_Loss__c</fullName>
        <defaultValue>0</defaultValue>
        <deprecated>false</deprecated>
        <description>This value stores the sum of gains and losses created as a result of currency fluctuation for this item in the reporting currency.</description>

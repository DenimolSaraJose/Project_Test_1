<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>That setting will allow to enable and disable different security fixes.</description>
    <enableFeeds>false</enableFeeds>
    <fields>
        <fullName>TR1__Enable_Stored_XSS_Fixes__c</fullName>
        <defaultValue>true</defaultValue>
        <deprecated>false</deprecated>
        <description>Hierarchical Custom Setting for stored XSS – server side DOM sanitization</description>
        <inlineHelpText>Enable server side DOM sanitization</inlineHelpText>
        <label>(Deprecated) Enable Stored XSS Fixes</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Security Toggle</label>
    <visibility>Public</visibility>
</CustomObject>

    <fields>
        <fullName>TR1__Adjusted_Gross_Profit__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF( $Setup.TR1__TalentRoverProperties__c.TR1__Use_Override_Amt_Fields_for_GP_Invoices__c ,  

(TR1__Gross_Profit__c * $Setup.TR1__AdjustedGrossProfit__c.TR1__GrossProfitPercent__c)
, 

((((+ TR1__Adjusted_Bill_Rate__c - TR1__Pay_Rate__c )* TR1__Total_Regular_Hours__c )+((( TR1__Adjusted_Bill_Rate__c * TR1__Closing_Report__r.TR1__OT_Bill_Rate_Multiplier_Percentage__c )-( TR1__Pay_Rate__c *1.5))* TR1__Total_Overtime_Hours__c )+((( TR1__Adjusted_Bill_Rate__c * TR1__Closing_Report__r.TR1__DT_Bill_Rate_Multiplier_Percentage__c )-( TR1__Pay_Rate__c *2))* TR1__Total_Double_Time_Hours__c )- TR1__Burden__c)*$Setup.TR1__AdjustedGrossProfit__c.TR1__GrossProfitPercent__c)

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Adjusted Gross Profit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

    <validationRules>
        <fullName>TR1__Prevent_Use_of_Override_Fields</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
DATEVALUE(CreatedDate) &lt; DATE(2015,12,16)
,
OR(!ISBLANK( TR1__Total_Bill_Override__c ),!ISBLANK( TR1__Total_Pay_Override__c ))
)</errorConditionFormula>
        <errorMessage>To Maintain Data Integrity, Override Fields cannot be populated for Historical Records</errorMessage>
    </validationRules>

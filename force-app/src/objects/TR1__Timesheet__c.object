    <fields>
        <fullName>TR1__Gross_Profit__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF( $Setup.TR1__TalentRoverProperties__c.TR1__Use_Rate_Card_Module__c,
TR1__TotalShiftBillAmount__c - TR1__Total_Shift_Fee__c - TR1__TotalShiftPayAmount__c ,
IF( $Setup.TR1__TalentRoverProperties__c.TR1__Use_Override_Amt_Fields_for_GP_Invoices__c , 

(TR1__Timesheet_Invoice_Total__c -  TR1__Payroll_Amount__c - TR1__Burden__c)

, 

(((TR1__Adjusted_Bill_Rate__c - TR1__Pay_Rate__c )* TR1__Total_Regular_Hours__c )+((( TR1__Adjusted_Bill_Rate__c *  TR1__Closing_Report__r.TR1__OT_Bill_Rate_Multiplier_Percentage__c  )-( TR1__Pay_Rate__c *1.5))* TR1__Total_Overtime_Hours__c )+((( TR1__Adjusted_Bill_Rate__c *  TR1__Closing_Report__r.TR1__DT_Bill_Rate_Multiplier_Percentage__c  )-( TR1__Pay_Rate__c *2))* TR1__Total_Double_Time_Hours__c )-  TR1__Burden__c)

))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Gross Profit</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TR1__Invoice_Amount__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF( 

AND( $Setup.TR1__TalentRoverProperties__c.TR1__Use_Override_Amt_Fields_for_GP_Invoices__c, TR1__Total_Bill_Override__c != 0) ,

TR1__Total_Bill_Override__c, 

((ROUND(TR1__Adjusted_Bill_Rate__c, 2) * TR1__Total_Regular_Hours__c) + (TR1__OT_Bill_Rate__c * TR1__Total_Overtime_Hours__c) + (TR1__Travel_Bill_Rate__c * TR1__Total_Travel_Hours__c) + (TR1__Total_Double_Time_Hours__c * TR1__DT_Bill_Rate__c))

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Invoice Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>

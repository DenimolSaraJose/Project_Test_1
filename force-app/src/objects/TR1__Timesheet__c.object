    <fields>
        <fullName>TR1__Adjusted_Bill_Rate__c</fullName>
        <deprecated>false</deprecated>
        <formula>TR1__Closing_Report__r.TR1__Adjusted_Bill_Rate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Adjusted Bill Rate</label>
        <precision>18</precision>

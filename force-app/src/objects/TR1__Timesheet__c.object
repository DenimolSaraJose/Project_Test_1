    <fields>
        <fullName>TR1__Payroll_Amount__c</fullName>
        <deprecated>false</deprecated>
        <formula>IF( 

AND( $Setup.TR1__TalentRoverProperties__c.TR1__Use_Override_Amt_Fields_for_GP_Invoices__c, TR1__Total_Pay_Override__c &gt; 0) , 

TR1__Total_Pay_Override__c, 


((TR1__Pay_Rate__c * TR1__Total_Regular_Hours__c)
+
((TR1__Pay_Rate__c * 1.5) * TR1__Total_Overtime_Hours__c)
+
((TR1__Pay_Rate__c * 2.0) * TR1__Total_Double_Time_Hours__c))

)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payroll Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>

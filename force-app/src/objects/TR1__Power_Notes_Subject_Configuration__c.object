    <deploymentStatus>Deployed</deploymentStatus>
    <deprecated>false</deprecated>
    <description>This object allows users to configure which subject is available for selection - or as &apos;default&apos; - when a Power Note is created from a supported object, ATSv2, Browse.</description>

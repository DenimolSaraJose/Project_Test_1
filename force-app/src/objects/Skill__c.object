    <recordTypes>
        <fullName>CalculatedSkill</fullName>
        <active>true</active>
        <description>Calculated skills have proficiency levels derived automatically from system data and predefined rules or formulas. These skills provide an objective, up-to-date measure of capability based on real-time metrics and recorded activities.</description>
        <label>Calculated skill</label>
        <picklistValues>
            <picklist>AggregateResultType__c</picklist>
